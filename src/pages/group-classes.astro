---
import '../styles/group-class.css';
import Layout from '../layouts/Layout.astro';
import LessonForm from '../components/LessonForm.astro';
---

<Layout
  title="DJ1 — Online Group Drum Class for Beginners | Jacobo Vega-Albela"
  description="DJ1 — a 10-week online group drum class for complete beginners with Jacobo Vega-Albela. Small group, no kit required to start. Join the pilot cohort waitlist."
  themeColor="#091528"
  og={{
    title: "DJ1 — Online Group Drum Class for Beginners",
    description: "A 10-week online group drum class for complete beginners. Small group, no kit required to start.",
    type: "website"
  }}
>

<main>

  <!-- HERO -->
  <section class="hero" aria-labelledby="heroTitle">
    <div class="wrap">
      <div class="hero-text">
        <p class="hero-eyebrow">Online group drum class</p>
        <h1 id="heroTitle">A 10-week drum class for <em>complete beginners</em>.</h1>
        <p class="hero-sub">Drumset Jumpstart 1 (DJ1) is a small online cohort taught over Zoom &mdash; no drumset required to start.</p>
        <ul class="chips" aria-label="Credentials">
          <li class="chip"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M3 8.5l3.2 3.2L13 5"/></svg>Master's, Eastman School of Music</li>
          <li class="chip"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M3 8.5l3.2 3.2L13 5"/></svg>9 years teaching</li>
          <li class="chip"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M3 8.5l3.2 3.2L13 5"/></svg>Small group, capped at 10</li>
        </ul>
        <LessonForm
          formId="xkoyjkzk"
          formIdSlug="hero-waitlist-form"
          submitLabel="Join the Waitlist"
        />
        <a class="tel-link hero-tel" href="tel:+15858024247" aria-label="Text or call 5 8 5, 8 0 2, 4 2 4 7">Text or call (585) 802-4247</a>
        <p class="trust-line">Google Business Screened &nbsp;·&nbsp; Background-checked &amp; verified</p>
      </div>
      <figure class="hero-img">
        <img src="/DSC04880.webp" alt="Jacobo Vega-Albela at the drumset" width="1000" height="1250" fetchpriority="high">
      </figure>
    </div>
  </section>

  <!-- WHAT'S INCLUDED -->
  <section aria-labelledby="includedTitle">
    <div class="wrap">
      <div class="section-head">
        <span class="section-tag">How it works</span>
        <h2 id="includedTitle">Ten weeks, ninety-minute sessions, ten people.</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </div>
      <div class="included-grid">
        <div class="tile">
          <span class="tile-tag">10 weeks</span>
          <h3>Structured curriculum</h3>
          <p>A guided arc from your first stroke through reading, technique, and groove fundamentals.</p>
        </div>
        <div class="tile">
          <span class="tile-tag">90-minute sessions</span>
          <h3>Long enough to play</h3>
          <p>Each class leaves room for individual feedback &mdash; not just lecture.</p>
        </div>
        <div class="tile">
          <span class="tile-tag">Capped at 10</span>
          <h3>Small group format</h3>
          <p>Small enough that I can hear you. Big enough that you'll learn from each other.</p>
        </div>
        <div class="tile">
          <span class="tile-tag">What to bring</span>
          <h3>Pad, sticks, book</h3>
          <p>A practice pad, a pair of sticks, and Ted Reed's <em>Syncopation</em>. No drumset needed to start.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section aria-labelledby="testimonialsTitle">
    <div class="wrap">
      <div class="section-head">
        <span class="section-tag">What private students say</span>
        <h2 id="testimonialsTitle">Wins from the private studio.</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </div>
      <div class="testimonials-grid">
        <figure class="tcard">
          <blockquote>I had an audition for a jazz camp and decided to take one lesson with Jacobo. He helped me improve so much that I ended up getting in.</blockquote>
          <figcaption>&mdash; <strong>Will</strong>, college student</figcaption>
        </figure>
        <figure class="tcard">
          <blockquote>I got into the conservatory in Brussels &mdash; thank you so much for all your support. I learned a lot from you.</blockquote>
          <figcaption>&mdash; <strong>Annie</strong>, music school graduate</figcaption>
        </figure>
        <figure class="tcard">
          <blockquote>He is a drummer first and a teacher second, so everything he teaches comes from a practical base of knowledge and mastery.</blockquote>
          <figcaption>&mdash; <strong>Joseph</strong>, hobbyist</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- PRICING -->
  <section aria-labelledby="pricingTitle">
    <div class="wrap">
      <div class="section-head">
        <span class="section-tag">Rates</span>
        <h2 id="pricingTitle">Two ways to join.</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </div>
      <div class="pricing-grid">
        <div class="pcard featured">
          <span class="pcard-tag">Best value</span>
          <h3>Full course</h3>
          <p class="price">$250 <small>/ 10 weeks</small></p>
          <p>Locks in your seat for the whole cohort. Works out to $25 per class &mdash; $50 less than drop-in.</p>
        </div>
        <div class="pcard">
          <span class="pcard-tag">Pay as you go</span>
          <h3>Drop-in</h3>
          <p class="price">$30 <small>/ class</small></p>
          <p>One session at a time, no commitment. Subject to space &mdash; full-course students get priority.</p>
        </div>
      </div>
      <p class="pricing-fineprint">Payment via Venmo, Zelle, or PayPal. Full course due before the first class; drop-in pays per session.</p>
      <div class="mid-cta">
        <p><strong>Ready to claim a seat?</strong> The pilot cohort is capped at 10 &mdash; get on the waitlist and I'll be in touch with dates.</p>
        <a class="btn btn-outline" href="/join">Join the Pilot Cohort Waitlist</a>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section aria-labelledby="aboutTitle">
    <div class="wrap">
      <div class="section-head">
        <span class="section-tag">About me</span>
        <h2 id="aboutTitle">Why study with me.</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </div>
      <div class="about-grid">
        <div class="about-text">
          <h3>Practical, honest, steady wins.</h3>
          <p>I'm a working drummer first and a teacher second. Everything I assign comes from a practical base &mdash; the same things I'm using on stage and in the studio.</p>
          <p>Most of my students start as beginners, and there's nothing to &ldquo;catch up on&rdquo; before week one. The path is clarity about what to practice, honest feedback, and steady wins. We figure out where you want to go, then build the habits to get you there.</p>
        </div>
        <div class="about-bg">
          <h3>Background</h3>
          <ul class="bg-list">
            <li><strong>Education</strong>MM, Jazz Studies &amp; Contemporary Media &mdash; Eastman School of Music (2022, Schirmer Prize in Jazz Performance) &middot; BM, Classical Percussion Performance &mdash; New Mexico State University (2019, Crimson Scholar) &middot; Betty Carter's Jazz Ahead alumnus (2023)</li>
            <li><strong>Teaching</strong>Private instructor 2015&ndash;present &middot; K&ndash;12 and adults &middot; Beginners through advanced</li>
            <li><strong>Performance</strong>Western New York Big Band, Las Cruces Symphony, The Swooners, Silver Arrow, Trio 55, Brendan Lanighan Octet &middot; Festivals: Rochester International Jazz Festival, Burlington Discover Jazz Festival, Las Cruces Juneteenth Jazz Festival</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section aria-labelledby="faqTitle">
    <div class="wrap">
      <div class="section-head">
        <span class="section-tag">Good to know</span>
        <h2 id="faqTitle">Frequently asked questions.</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </div>
      <div class="faq-list">
        <details>
          <summary>Do I need a drumset?</summary>
          <div class="faq-body">Nope. You'll start with a practice pad, a pair of sticks, and Ted Reed's <em>Syncopation</em> &mdash; that's it. Many students stay on the pad for months and make great progress before investing in a kit.</div>
        </details>
        <details>
          <summary>Can I sign my kid up?</summary>
          <div class="faq-body">The pilot is for ages 15+. Younger students usually do better in private lessons where I can adapt to their pace and energy &mdash; reach out and we'll find a fit.</div>
        </details>
        <details>
          <summary>What does &ldquo;small group format&rdquo; mean?</summary>
          <div class="faq-body">Class size is capped at 10. Sessions run 90 minutes so I have time to give individual feedback to each student, not just lecture the room.</div>
        </details>
        <details>
          <summary>How does payment work?</summary>
          <div class="faq-body">Venmo, Zelle, or PayPal. The full course ($250) is due before our first class. Drop-in students pay $30 per session as they go.</div>
        </details>
        <details>
          <summary>What if I miss a class?</summary>
          <div class="faq-body">Let me know ahead of time and I'll send notes plus what to practice. With a small cohort there's no formal makeup, but I'll get you caught up before the next session.</div>
        </details>
      </div>
    </div>
  </section>

</main>

<!-- FINAL CTA BAND -->
<section class="cta-band" aria-label="Join the pilot cohort waitlist">
  <div class="cta-band-inner">
    <h2>Ready to drum?</h2>
    <p>The pilot cohort is capped at 10. Get on the waitlist and I'll be in touch as soon as dates and a start week are set.</p>
    <a class="btn btn-primary" href="/join">Join the Pilot Cohort Waitlist</a>
  </div>
</section>

</Layout>