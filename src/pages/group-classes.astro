---
import '../styles/group-class.css';
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import LessonForm from '../components/LessonForm.astro';
import JsonLd from '../components/JsonLd.astro';
import heroImg from '../assets/blog/how-long-hero.webp';
import portraitImg from '../assets/at-drums-cheerful.webp';
import { SITE_URL, PERSON, PERSON_ID, ORGANIZATION_ID } from '../data/schema';

const pageUrl = `${SITE_URL}/group-classes`;
const courseId = `${pageUrl}#dj1`;

const heroSocial = await getImage({
  src: heroImg,
  format: 'webp',
  width: 1200,
});
const heroSocialUrl = new URL(heroSocial.src, SITE_URL).toString();

const faqs = [
  {
    q: 'Do I need a drumset?',
    a: "Nope. You'll start with a practice pad, a pair of sticks, and Ted Reed's Syncopation. That's it. Many students stay on the pad for months and make great progress before investing in a kit.",
  },
  {
    q: 'Can I sign my kid up?',
    a: "The pilot is for ages 15+. Younger students usually do better in private lessons where I can adapt to their pace and energy. Reach out and we'll find a fit.",
  },
  {
    q: 'What does "small group format" mean?',
    a: 'Class size is capped at 10. Sessions run 90 minutes so I have time to give individual feedback to each student, not just lecture the room.',
  },
  {
    q: 'How does payment work?',
    a: 'Venmo, Zelle, or PayPal. The full course ($250) is due before our first class. Drop-in students pay $30 per session as they go.',
  },
  {
    q: 'What if I miss a class?',
    a: "Let me know ahead of time and I'll send notes plus what to practice. With a small cohort there's no formal makeup, but I'll get you caught up before the next session.",
  },
];

const course = {
  '@type': 'Course',
  '@id': courseId,
  name: 'Drumset Jumpstart 1 (DJ1)',
  alternateName: 'DJ1',
  description:
    'A 10-week online group drum class for complete beginners. 90-minute Zoom sessions with a small cohort capped at 10 students. No drumset required to start: just a practice pad, sticks, and Ted Reed\'s Syncopation.',
  url: pageUrl,
  image: heroSocialUrl,
  inLanguage: 'en-US',
  educationalLevel: 'Beginner',
  audience: {
    '@type': 'EducationalAudience',
    educationalRole: 'Beginner drum students, ages 15 and up',
  },
  teaches: [
    'Drumset fundamentals',
    'Stick technique',
    'Music reading for drumset',
    'Basic groove vocabulary',
    'Practice habits',
  ],
  provider: {
    '@id': ORGANIZATION_ID,
    '@type': 'Organization',
    name: 'JVA Music',
    url: SITE_URL,
  },
  instructor: { '@id': PERSON_ID },
  hasCourseInstance: [
    {
      '@type': 'CourseInstance',
      name: 'DJ1 Pilot Cohort',
      courseMode: 'Online',
      courseWorkload: 'PT15H',
      inLanguage: 'en-US',
      maximumAttendeeCapacity: 10,
      location: {
        '@type': 'VirtualLocation',
        url: 'https://zoom.us/',
      },
      instructor: { '@id': PERSON_ID },
      offers: [
        {
          '@type': 'Offer',
          name: 'Full course (10 weeks)',
          price: '250',
          priceCurrency: 'USD',
          category: 'Tuition',
          availability: 'https://schema.org/PreOrder',
          validFrom: '2026-05-04',
          url: `${SITE_URL}/join`,
        },
        {
          '@type': 'Offer',
          name: 'Drop-in (per class)',
          price: '30',
          priceCurrency: 'USD',
          category: 'Tuition',
          availability: 'https://schema.org/PreOrder',
          validFrom: '2026-05-04',
          url: `${SITE_URL}/join`,
        },
      ],
    },
  ],
};

const faqPage = {
  '@type': 'FAQPage',
  '@id': `${pageUrl}#faq`,
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    PERSON,
    course,
    {
      '@type': 'WebPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: 'DJ1: Online Group Drum Class for Beginners',
      about: { '@id': courseId },
      primaryImageOfPage: heroSocialUrl,
      breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
          { '@type': 'ListItem', position: 2, name: 'Group Classes', item: pageUrl },
        ],
      },
    },
    faqPage,
  ],
};
---

<Layout
  title="DJ1: Online Group Drum Class for Beginners | Jacobo Vega-Albela"
  description="DJ1 is a 10-week online group drum class for complete beginners with Jacobo Vega-Albela. Small group, no kit required to start. Join the pilot cohort waitlist."
  themeColor="#091528"
  image={{
    url: heroSocial.src,
    width: 1200,
    height: 1600,
    type: 'image/webp',
    alt: 'Open notebook of hand-written drum exercises resting on a snare drum',
  }}
  og={{
    title: "DJ1: Online Group Drum Class for Beginners",
    description: "A 10-week online group drum class for complete beginners. Small group, no kit required to start.",
    type: "website"
  }}
  stickyOffer={{
    label: 'Join the DJ1 waitlist',
    href: '/join',
    event: 'dj1_waitlist_cta_click',
    location: 'sticky_cta',
  }}
>
  <JsonLd slot="head" data={graph} />

<main>

  <!-- HERO -->
  <section class="hero" aria-labelledby="heroTitle">
    <div class="wrap">
      <div class="hero-text">
        <p class="hero-eyebrow">Online group drum class</p>
        <h1 id="heroTitle">A 10-week online drum class<br />for <em>complete beginners</em>.</h1>
        <p class="hero-sub">Drumset Jumpstart 1 (DJ1) is a small cohort over Zoom, taught live by an <strong>Eastman-trained</strong> jazz drummer. No kit needed to start.</p>
        <div class="hero-teacher">
          <span class="hero-teacher-photo">
            <Image src={portraitImg} alt="Jacobo Vega-Albela smiling behind his drum kit" width={192} height={192} quality={80} loading="eager" />
          </span>
          <div class="hero-teacher-meta">
            <span class="hero-teacher-name">Jacobo Vega-Albela</span>
            <a class="hero-rating" href="#testimonialsTitle">
              <span class="hero-rating-stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
              <span class="hero-rating-text"><strong>5.0</strong> &middot; 11 Google reviews</span>
            </a>
          </div>
        </div>
        <p class="hero-promo">
          <span class="hero-promo-tag">Pilot cohort</span>
          <span class="hero-promo-text">Capped at <strong>10 seats</strong>. Waitlist now open.</span>
        </p>
        <ul class="chips" aria-label="Credentials">
          <li class="chip"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M3 8.5l3.2 3.2L13 5"/></svg>Master's, Eastman School of Music</li>
          <li class="chip"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M3 8.5l3.2 3.2L13 5"/></svg>10+ years teaching</li>
          <li class="chip"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M3 8.5l3.2 3.2L13 5"/></svg>Small group, capped at 10</li>
        </ul>
        <LessonForm
          formId="xkoyjkzk"
          formIdSlug="hero-waitlist-form"
          submitLabel="Request a Waitlist Spot"
          submitEvent="dj1_waitlist_submit"
          submitEventParams={{ form_location: 'group_classes_hero', value: 250, currency: 'USD' }}
        />
        <p class="form-reassure">No payment now. Nothing is due until dates are set and you confirm your seat.</p>
        <a class="tel-link hero-tel" href="tel:+15858024247" aria-label="Text or call 5 8 5, 8 0 2, 4 2 4 7" onclick="gtag('event', 'cta_call_click', { location: 'group_classes_hero' })">Text or call (585) 802-4247</a>
        <p class="trust-line">Google-screened &middot; Background-checked</p>
      </div>
      <figure class="hero-img">
        <Image
          src={heroImg}
          alt="Open notebook of hand-written drum exercises resting on a snare drum"
          widths={[400, 600, 800, 1000]}
          sizes="(max-width: 780px) 100vw, 50vw"
          loading="eager"
          fetchpriority="high"
          decoding="auto"
          quality={78}
        />
      </figure>
    </div>
  </section>

  <!-- WHAT'S INCLUDED -->
  <section aria-labelledby="includedTitle">
    <div class="wrap">
      <div class="section-head">
        <span class="section-tag">How it works</span>
        <h2 id="includedTitle">Ten weeks, ninety-minute sessions, ten people.</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </div>
      <div class="included-grid">
        <div class="tile">
          <span class="tile-tag">10 weeks</span>
          <h3>Structured curriculum</h3>
          <p>A guided arc from your first stroke through reading, technique, and groove fundamentals.</p>
        </div>
        <div class="tile">
          <span class="tile-tag">90-minute sessions</span>
          <h3>Long enough to play</h3>
          <p>Each class leaves room for individual feedback, not just lecture.</p>
        </div>
        <div class="tile">
          <span class="tile-tag">Capped at 10</span>
          <h3>Small group format</h3>
          <p>Small enough that I can hear you. Big enough that you'll learn from each other.</p>
        </div>
        <div class="tile">
          <span class="tile-tag">What to bring</span>
          <h3>Pad, sticks, book</h3>
          <p>A practice pad, a pair of sticks, and Ted Reed's <em>Syncopation</em>. No drumset needed to start. Use my <a href="/metronome/">free online metronome</a> for daily practice, and when you move to the kit, start with my <a href="/pdfs/drumset/three-basic-rock-beats/">Three Basic Rock Beats</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section aria-labelledby="testimonialsTitle">
    <div class="wrap">
      <div class="section-head">
        <span class="section-tag">What beginners say</span>
        <h2 id="testimonialsTitle">First-time drummers, real wins.</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </div>
      <div class="testimonials-grid">
        <figure class="tcard">
          <blockquote>An awesome first drum lesson! Jacobo was thorough, covering everything from reading music to my first drum beat. Highly recommend!</blockquote>
          <figcaption><strong>Naomi</strong>, via Google</figcaption>
        </figure>
        <figure class="tcard">
          <blockquote>Jacobo made me feel comfortable from the very first lesson. He was incredibly patient and understanding. I highly recommend taking lessons with him!</blockquote>
          <figcaption><strong>Nisaa R.</strong>, via Google</figcaption>
        </figure>
        <figure class="tcard">
          <blockquote>Super down to earth guy that knows his stuff. I've taken lessons from a few different people and he has been the best.</blockquote>
          <figcaption><strong>Patrick M.</strong>, via Google</figcaption>
        </figure>
      </div>
      <div class="mid-cta">
        <p><strong>Every one of them started as a beginner.</strong> Grab a waitlist spot and start the same way.</p>
        <a class="btn btn-primary" href="/join" onclick="gtag('event', 'dj1_waitlist_cta_click', { location: 'testimonials' })">Request a Waitlist Spot</a>
      </div>
    </div>
  </section>

  <!-- PRICING -->
  <section aria-labelledby="pricingTitle">
    <div class="wrap">
      <div class="section-head">
        <span class="section-tag">Rates</span>
        <h2 id="pricingTitle">Two ways to join.</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </div>
      <div class="pricing-grid">
        <div class="pcard featured">
          <span class="pcard-tag">Best value</span>
          <h3>Full course</h3>
          <p class="price">$250 <small>/ 10 weeks</small></p>
          <p>Locks in your seat for the whole cohort. Works out to $25 per class, $50 less than drop-in.</p>
        </div>
        <div class="pcard">
          <span class="pcard-tag">Pay as you go</span>
          <h3>Drop-in</h3>
          <p class="price">$30 <small>/ class</small></p>
          <p>One session at a time, no commitment. Subject to space, and full-course students get priority.</p>
        </div>
      </div>
      <p class="pricing-fineprint">Payment via Venmo, Zelle, or PayPal. Full course due before the first class; drop-in pays per session.</p>
      <div class="mid-cta">
        <p><strong>Ready to claim a seat?</strong> The pilot cohort is capped at 10, so get on the waitlist and I'll be in touch with dates.</p>
        <a class="btn btn-primary" href="/join" onclick="gtag('event', 'dj1_waitlist_cta_click', { location: 'pricing_mid' })">Request a Waitlist Spot</a>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section aria-labelledby="aboutTitle">
    <div class="wrap">
      <div class="section-head">
        <span class="section-tag">About me</span>
        <h2 id="aboutTitle">Why study with me.</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </div>
      <div class="about-grid">
        <div class="about-text">
          <h3>Practical, honest, steady wins.</h3>
          <p>I'm a working drummer first and a teacher second. Everything I assign comes from a practical base: the same things I'm using on stage and in the studio.</p>
          <p>Most of my students start as beginners, and there's nothing to &ldquo;catch up on&rdquo; before week one. The path is clarity about what to practice, honest feedback, and steady wins. We figure out where you want to go, then build the habits to get you there.</p>
        </div>
        <div class="about-bg">
          <h3>Background</h3>
          <ul class="bg-list">
            <li><strong>Education</strong>MM, Jazz Studies &amp; Contemporary Media, Eastman School of Music (2022, Schirmer Prize in Jazz Performance) &middot; BM, Classical Percussion Performance, New Mexico State University (2019, Crimson Scholar) &middot; Betty Carter's Jazz Ahead alumnus (2023)</li>
            <li><strong>Teaching</strong>Private instructor 2015-present &middot; K-12 and adults &middot; Beginners through advanced</li>
            <li><strong>Performance</strong>Western New York Big Band, Las Cruces Symphony, The Swooners, Silver Arrow, Trio 55, Brendan Lanighan Octet &middot; Festivals: Rochester International Jazz Festival, Burlington Discover Jazz Festival, Las Cruces Juneteenth Jazz Festival</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section aria-labelledby="faqTitle">
    <div class="wrap">
      <div class="section-head">
        <span class="section-tag">Good to know</span>
        <h2 id="faqTitle">Frequently asked questions.</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </div>
      <div class="faq-list">
        <details>
          <summary>Do I need a drumset?</summary>
          <div class="faq-body">Nope. You'll start with a practice pad, a pair of sticks, and Ted Reed's <em>Syncopation</em>. That's it. Many students stay on the pad for months and make great progress before investing in a kit.</div>
        </details>
        <details>
          <summary>Can I sign my kid up?</summary>
          <div class="faq-body">The pilot is for ages 15+. Younger students usually do better in private lessons where I can adapt to their pace and energy. Reach out and we'll find a fit.</div>
        </details>
        <details>
          <summary>What does &ldquo;small group format&rdquo; mean?</summary>
          <div class="faq-body">Class size is capped at 10. Sessions run 90 minutes so I have time to give individual feedback to each student, not just lecture the room.</div>
        </details>
        <details>
          <summary>How does payment work?</summary>
          <div class="faq-body">Venmo, Zelle, or PayPal. The full course ($250) is due before our first class. Drop-in students pay $30 per session as they go.</div>
        </details>
        <details>
          <summary>What if I miss a class?</summary>
          <div class="faq-body">Let me know ahead of time and I'll send notes plus what to practice. With a small cohort there's no formal makeup, but I'll get you caught up before the next session.</div>
        </details>
      </div>
    </div>
  </section>

</main>

<!-- FINAL CTA BAND -->
<section class="cta-band" aria-label="Request a waitlist spot for the pilot cohort">
  <div class="cta-band-inner">
    <h2>Pilot cohort: 10 seats.</h2>
    <p>Request a waitlist spot and I'll be in touch as soon as dates and a start week are set.</p>
    <a class="btn btn-primary" href="/join" onclick="gtag('event', 'dj1_waitlist_cta_click', { location: 'cta_band' })">Request a Waitlist Spot</a>
  </div>
</section>

</Layout>