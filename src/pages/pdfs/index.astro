---
import { statSync } from 'node:fs';
import { join } from 'node:path';
import sharp from 'sharp';
import '../../styles/global.css';
import Layout from '../../layouts/Layout.astro';
import JsonLd from '../../components/JsonLd.astro';
import manifest from '../../data/pdfs.json';
import { ABOUT_BY_FILE, landingPathFor } from '../../data/pdf-meta';
import { SITE_URL, PERSON, PERSON_ID } from '../../data/schema';

const pageUrl = `${SITE_URL}/pdfs`;

// Resolve a `/public/...` URL path to an absolute on-disk path during
// build. Uses process.cwd() rather than import.meta.url because
// Astro's compiled page modules don't reliably preserve source file
// locations (the same helper anchors the LCP-thumbnail dim lookup
// in src/pages/pdfs/[category]/[slug].astro).
function publicPath(urlPath: string): string {
  return join(process.cwd(), 'public', urlPath.replace(/^\/+/, ''));
}

function pdfFileSize(filePath: string): string | undefined {
  try {
    const bytes = statSync(publicPath(filePath)).size;
    return `${Math.round(bytes / 1024)} kB`;
  } catch {
    return undefined;
  }
}

// Read each thumbnail's intrinsic dimensions at build time so the
// card <img> can carry width/height attributes — prevents CLS as
// images stream in, and lets the LCP candidate (the first card)
// commit layout before the thumbnail's HTTP headers arrive.
async function thumbDimensions(thumbPath: string | undefined): Promise<{ w: number; h: number } | undefined> {
  if (!thumbPath) return undefined;
  try {
    const meta = await sharp(publicPath(thumbPath)).metadata();
    if (meta.width && meta.height) return { w: meta.width, h: meta.height };
  } catch {
    /* ignore — img will render without dims if sharp fails */
  }
  return undefined;
}

const allItems = manifest.categories.flatMap((cat) =>
  cat.items.map((item) => ({
    title: item.title,
    description: item.description,
    file: item.file,
    url: `${SITE_URL}${item.file}`,
    landingPath: landingPathFor(cat.id, item),
    landingUrl: `${SITE_URL}${landingPathFor(cat.id, item)}`,
    category: cat.title,
    categoryId: cat.id,
    fileSize: pdfFileSize(item.file),
    about: ABOUT_BY_FILE[item.file.split('/').pop()!],
  }))
);

// Pre-compute thumbnail dimensions for every card, keyed by file
// path so the JSX render can look them up cheaply.
const thumbDims = new Map<string, { w: number; h: number } | undefined>();
for (const cat of manifest.categories) {
  for (const item of cat.items) {
    if (item.thumbnail) {
      thumbDims.set(item.thumbnail, await thumbDimensions(item.thumbnail));
    }
  }
}

// Identify the first card's thumbnail — it's the LCP candidate on
// mobile (just below the navy hero). We give it eager loading +
// high fetchpriority + a <link rel="preload"> so the fetch starts
// during HTML streaming, and we drop decoding="async" so the
// browser paints it inline with the document instead of deferring.
const firstThumb = manifest.categories[0]?.items[0]?.thumbnail;

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    PERSON,
    {
      '@type': 'CollectionPage',
      '@id': `${pageUrl}#collection`,
      url: pageUrl,
      name: 'Teaching PDFs — Jacobo Vega-Albela',
      description:
        'A free library of teaching PDFs by Jacobo Vega-Albela: single-surface exercises, drumset studies, and transcriptions for drum students at every level.',
      author: { '@id': PERSON_ID },
      inLanguage: 'en-US',
      breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
          { '@type': 'ListItem', position: 2, name: 'PDFs', item: pageUrl },
        ],
      },
      mainEntity: {
        '@type': 'ItemList',
        name: 'Teaching PDFs',
        numberOfItems: allItems.length,
        itemListElement: allItems.map((item, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          url: item.landingUrl,
          item: {
            '@type': 'LearningResource',
            name: item.title,
            ...(item.description && { description: item.description }),
            url: item.landingUrl,
            inLanguage: 'en-US',
            author: { '@id': PERSON_ID },
            isAccessibleForFree: true,
            learningResourceType: item.category,
            mainEntity: {
              '@type': 'DigitalDocument',
              name: item.title,
              url: item.url,
              encodingFormat: 'application/pdf',
              ...(item.fileSize && { contentSize: item.fileSize }),
              ...(item.about && { about: item.about }),
            },
          },
        })),
      },
    },
  ],
};
---

<Layout
  title="Teaching PDFs — Jacobo Vega-Albela"
  description="Free teaching PDFs from Jacobo Vega-Albela — single-surface exercises, drumset exercises, and transcriptions for students at every level."
  themeColor="#091528"
>
  <JsonLd slot="head" data={graph} />
  {firstThumb && (
    <link slot="head" rel="preload" as="image" href={firstThumb} fetchpriority="high" />
  )}

<main>
<header class="pdfs-hero">
  <div class="pdfs-hero-inner">
    <span class="pdfs-eyebrow">Teaching Resources</span>
    <h1 class="pdfs-title">PDFs &amp; Worksheets</h1>
    <p class="pdfs-sub">A growing library of exercises, etudes, and transcriptions I share with my students. Free to download — print them, mark them up, take them to the practice room.</p>
  </div>
</header>

<div class="pdfs-wrap">
  {manifest.categories.map((cat) => (
    <section class="pdf-section" id={cat.id}>
      <div class="pdf-section-head">
        <button class="pdf-section-toggle" type="button" aria-controls={`${cat.id}-body`}>
          <span class="section-tag">{cat.title}</span>
          <span class="section-rule" aria-hidden="true"></span>
          <svg class="pdf-section-chevron" aria-hidden="true" viewBox="0 0 12 8" fill="none">
            <path d="M1 1.5l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
        {/* Strip ⇄ grid. Same list, same links — only the layout
            changes, so expanding never loads a second copy of the
            section into the DOM. */}
        <button
          class="pdf-strip-toggle"
          type="button"
          aria-controls={`${cat.id}-strip`}
          aria-expanded="false"
          data-strip-toggle={cat.id}
        >
          <span class="pdf-strip-toggle-icon pdf-strip-toggle-icon--grid" aria-hidden="true">
            <svg viewBox="0 0 12 12" fill="none">
              <rect x="0.75" y="0.75" width="4" height="4" stroke="currentColor" stroke-width="1.3"></rect>
              <rect x="7.25" y="0.75" width="4" height="4" stroke="currentColor" stroke-width="1.3"></rect>
              <rect x="0.75" y="7.25" width="4" height="4" stroke="currentColor" stroke-width="1.3"></rect>
              <rect x="7.25" y="7.25" width="4" height="4" stroke="currentColor" stroke-width="1.3"></rect>
            </svg>
          </span>
          <span class="pdf-strip-toggle-icon pdf-strip-toggle-icon--row" aria-hidden="true">
            <svg viewBox="0 0 12 12" fill="none">
              <rect x="0.75" y="3.5" width="3" height="5" stroke="currentColor" stroke-width="1.3"></rect>
              <rect x="4.75" y="3.5" width="3" height="5" stroke="currentColor" stroke-width="1.3"></rect>
              <rect x="8.75" y="3.5" width="2.5" height="5" stroke="currentColor" stroke-width="1.3"></rect>
            </svg>
          </span>
          <span class="pdf-strip-toggle-label pdf-strip-toggle-label--open">View all {cat.items.length}</span>
          <span class="pdf-strip-toggle-label pdf-strip-toggle-label--close">Show as strip</span>
        </button>
      </div>
      <div class="pdf-section-body" id={`${cat.id}-body`}>
        <div class="pdf-section-body-inner">
          {cat.blurb && <p class="pdf-section-blurb">{cat.blurb}</p>}
          {/* Each category renders as one horizontal strip: every sheet is
              still in the DOM (all internal links + copy stay crawlable),
              but the section reads as a single line of thumbnails so the
              three-section structure of the library is obvious at a glance.
              Buttons page the strip on hover-capable devices; touch
              devices swipe (buttons are hidden there via @media hover). */}
          <div class="pdf-strip-shell">
            <button
              class="pdf-strip-nav pdf-strip-nav--prev"
              type="button"
              aria-controls={`${cat.id}-strip`}
              aria-label={`Show earlier ${cat.title} sheets`}
            >
              <svg aria-hidden="true" viewBox="0 0 10 16" fill="none" focusable="false">
                <path d="M8 1.5 2 8l6 6.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </button>
            <ul class="pdf-strip" id={`${cat.id}-strip`} aria-label={`${cat.title} sheets`}>
              {cat.items.map((item) => {
              const landing = landingPathFor(cat.id, item);
              const thumb = item.thumbnail ?? '';
              const dims = thumbDims.get(thumb);
              const isLcp = thumb && thumb === firstThumb;
              return (
                <li class="pdf-card-wrap">
                  <a class="pdf-card" href={landing} aria-label={`View details for ${item.title}`}>
                    <div class="pdf-thumb">
                      {/*
                        LCP card: eager + high priority, decoding default
                        (auto/sync) so the browser paints inline with
                        the document. Other cards: lazy + async since
                        they're below the fold and the user may never
                        scroll to them.
                      */}
                      <img
                        src={thumb}
                        alt=""
                        width={dims?.w}
                        height={dims?.h}
                        loading={isLcp ? 'eager' : 'lazy'}
                        fetchpriority={isLcp ? 'high' : undefined}
                        decoding={isLcp ? undefined : 'async'}
                      />
                    </div>
                    <div class="pdf-meta">
                      <div class="pdf-card-title">{item.title}</div>
                      {item.description && <div class="pdf-card-desc">{item.description}</div>}
                      <div class="pdf-card-cta">
                        <span class="pdf-card-cta-label">View &amp; download</span>
                        <span class="pdf-card-cta-arrow" aria-hidden="true">→</span>
                      </div>
                    </div>
                  </a>
                  <a class="pdf-card-pdf-link" href={item.file} target="_blank" rel="noopener" aria-label={`Download ${item.title} PDF directly`}>
                    PDF ↗
                  </a>
                </li>
              );
            })}
            </ul>
            <button
              class="pdf-strip-nav pdf-strip-nav--next"
              type="button"
              aria-controls={`${cat.id}-strip`}
              aria-label={`Show more ${cat.title} sheets`}
            >
              <svg aria-hidden="true" viewBox="0 0 10 16" fill="none" focusable="false">
                <path d="M2 1.5 8 8l-6 6.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </section>
  ))}

  <section class="pdf-handwritten-link" aria-label="Handwritten worksheets">
    <p>
      Looking for the older <a href="/pdfs/handwritten">handwritten worksheets</a>? They're tucked away on a separate page — to be digitized eventually.
    </p>
  </section>
</div>
</main>

<style is:global>
  /* ── PDFs PAGE ─────────────────────────────────────
     Library of teaching PDFs. Tone matches the home page:
     navy hero, cream content area, cobalt/orange accents.
     Cards display a portrait-aspect first-page thumbnail,
     a title, optional description, and an "open" affordance. */

  .pdfs-hero {
    background: var(--navy);
    color: var(--cream);
    padding: calc(var(--header-h) + 64px) 56px 64px;
    position: relative;
    overflow: hidden;
  }

  .pdfs-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 80% at 80% 110%, rgba(26,58,138,0.55) 0%, transparent 60%),
      radial-gradient(ellipse 40% 50% at 10% -10%, rgba(232,101,10,0.15) 0%, transparent 55%);
    pointer-events: none;
  }

  .pdfs-hero-inner {
    position: relative;
    max-width: 1100px;
    margin: 0 auto;
  }

  .pdfs-eyebrow {
    display: inline-block;
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--blue-lt);
    margin-bottom: 16px;
  }

  .pdfs-title {
    font-family: var(--serif);
    font-size: clamp(44px, 5.5vw, 72px);
    font-weight: 300;
    line-height: 1.0;
    letter-spacing: -0.01em;
    margin-bottom: 18px;
  }

  .pdfs-sub {
    max-width: 620px;
    font-size: 14.5px;
    line-height: 1.7;
    color: rgba(245,243,238,0.72);
  }

  .pdfs-wrap {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 56px;
  }

  .pdf-section {
    padding: 64px 0;
    border-top: 1px solid var(--rule);
  }

  .pdf-section:first-of-type {
    border-top: 0;
  }

  /* Section header is a button so it can act as a disclosure
     widget on mobile. On desktop it looks identical to the old
     <div class="section-header"> — chevron hidden, body always
     visible, no pointer cursor. */
  .pdf-section-head {
    display: flex;
    align-items: baseline;
    gap: 18px;
    margin: 0 0 44px;
  }

  .pdf-section-toggle {
    appearance: none;
    background: transparent;
    border: 0;
    padding: 0;
    margin: 0;
    width: 100%;
    display: flex;
    align-items: baseline;
    gap: 20px;
    cursor: default;
    text-align: left;
    font: inherit;
    color: inherit;
  }

  .pdf-section-toggle:focus { outline: none; }
  .pdf-section-toggle:focus-visible {
    outline: 2px solid var(--orange-lt);
    outline-offset: 6px;
    border-radius: 2px;
  }

  .pdf-section-chevron {
    display: none;
    width: 12px;
    height: 8px;
    color: var(--muted);
    transition: transform 0.22s ease;
    flex-shrink: 0;
    align-self: center;
    margin-left: auto;
  }

  .pdf-section-blurb {
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--muted);
    max-width: 700px;
    margin: 0 0 36px;
  }

  /* ── Section strips ─────────────────────────────────
     Each category is one horizontal line of thumbnails
     rather than a tall grid, so the three sections of the
     library read as a set at a glance. Every item still
     renders in the DOM (internal links and copy stay
     crawlable); the strip just scrolls. */
  .pdf-strip-shell {
    position: relative;
  }

  .pdf-strip {
    --strip-fade: 44px;
    list-style: none;
    margin: 0;
    padding: 20px 0 34px;
    display: flex;
    gap: 20px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .pdf-strip::-webkit-scrollbar { display: none; }

  /* The edge fade is driven by data-scroll, which the inline
     script keeps in sync, so it never claims there's more
     content in a direction the user has already reached. */
  .pdf-strip[data-scroll='start'] {
    mask-image: linear-gradient(to right, #000 calc(100% - var(--strip-fade)), transparent 100%);
  }
  .pdf-strip[data-scroll='mid'] {
    mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 var(--strip-fade),
      #000 calc(100% - var(--strip-fade)),
      transparent 100%
    );
  }
  .pdf-strip[data-scroll='end'] {
    mask-image: linear-gradient(to right, transparent 0, #000 var(--strip-fade));
  }

  .pdf-strip > .pdf-card-wrap {
    flex: 0 0 178px;
    scroll-snap-align: start;
  }

  /* In the strip the card's height is driven by its contents: the base
     rule's fixed 3/4 aspect-ratio is a grid affordance (it makes tiles
     uniform), and left in place here it clips the title/CTA. */
  .pdf-strip .pdf-card {
    width: 100%;
    aspect-ratio: auto;
  }

  /* In the strip the card holds a fixed shape: a growing hover
     aspect-ratio would be clipped by the scroll container. */
  .pdf-strip .pdf-card:hover,
  .pdf-strip .pdf-card:focus-visible {
    transform: translateY(-4px);
    aspect-ratio: auto;
    border-color: var(--cobalt);
    box-shadow: 0 12px 26px rgba(9, 21, 40, 0.16);
  }

  .pdf-strip .pdf-thumb {
    flex: none;
    aspect-ratio: 8.5 / 11;
  }

  .pdf-strip .pdf-meta { padding: 12px 13px 13px; }
  .pdf-strip .pdf-card-title { font-size: 15px; }
  /* Strip cards carry title + CTA only. The description stays in the
     markup (and in the JSON-LD) and shows the moment the section is
     expanded into the grid. */
  .pdf-strip .pdf-card-desc { display: none; }
  .pdf-strip .pdf-card-cta { font-size: 9.5px; letter-spacing: 0.14em; }

  /* Strip nav. Pointer-only affordance: touch devices swipe,
     so the buttons never appear there. */
  .pdf-strip-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 7;
    width: 38px;
    height: 38px;
    padding: 0;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--cream);
    border: 1px solid var(--rule);
    color: var(--cobalt);
    cursor: pointer;
    box-shadow: 0 6px 18px rgba(9, 21, 40, 0.1);
    transition: opacity 0.18s ease, background 0.18s ease, color 0.18s ease,
      border-color 0.18s ease;
  }

  .pdf-strip-nav svg { width: 10px; height: 16px; }
  .pdf-strip-nav--prev { left: -19px; }
  .pdf-strip-nav--next { right: -19px; }
  .pdf-strip-nav:hover:not(:disabled) { border-color: var(--cobalt); color: var(--ink); }
  .pdf-strip-nav:focus-visible { outline: 2px solid var(--orange-lt); outline-offset: 2px; }
  .pdf-strip-nav:disabled { opacity: 0; pointer-events: none; }

  /* Nothing to scroll (or no pointer): no nav at all. */
  .pdf-strip-shell[data-scrollable='no'] .pdf-strip-nav { display: none; }
  @media (hover: none) { .pdf-strip-nav { display: none; } }

  /* ── Strip ⇄ grid toggle ────────────────────────────
     The strip is how a section reads by default; "View all N"
     lays the same list out as the full card grid. Only the layout
     swaps — one set of markup, one set of links. */
  .pdf-strip-toggle {
    appearance: none;
    background: transparent;
    border: 0;
    padding: 0;
    margin: 0 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font: inherit;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cobalt);
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    transition: color 0.18s ease;
  }

  .pdf-strip-toggle:hover { color: var(--ink); }
  .pdf-strip-toggle:focus { outline: none; }
  .pdf-strip-toggle:focus-visible {
    outline: 2px solid var(--orange-lt);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .pdf-strip-toggle svg { width: 12px; height: 12px; display: block; }
  .pdf-strip-toggle-label--close,
  .pdf-strip-toggle-icon--row { display: none; }
  .pdf-strip-toggle[aria-expanded='true'] .pdf-strip-toggle-label--open,
  .pdf-strip-toggle[aria-expanded='true'] .pdf-strip-toggle-icon--grid { display: none; }
  .pdf-strip-toggle[aria-expanded='true'] .pdf-strip-toggle-label--close,
  .pdf-strip-toggle[aria-expanded='true'] .pdf-strip-toggle-icon--row { display: inline-block; }

  /* ── Grid mode: the original library view ─────────── */
  .pdf-strip-shell[data-view='grid'] .pdf-strip {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 28px;
    padding: 0;
    overflow: visible;
    scroll-snap-type: none;
    mask-image: none;
  }

  .pdf-strip-shell[data-view='grid'] .pdf-strip > .pdf-card-wrap {
    display: flex;
    scroll-snap-align: none;
  }

  .pdf-strip-shell[data-view='grid'] .pdf-card {
    aspect-ratio: 3 / 4;
  }

  @media (hover: hover) {
    .pdf-strip-shell[data-view='grid'] .pdf-card:hover,
    .pdf-strip-shell[data-view='grid'] .pdf-card:focus-visible {
      aspect-ratio: 8.5 / 14;
      transform: translateY(-4px) scale(1.1);
      box-shadow: 0 18px 40px rgba(9, 21, 40, 0.18);
    }
  }

  .pdf-strip-shell[data-view='grid'] .pdf-thumb {
    flex: 1;
    aspect-ratio: auto;
  }

  .pdf-strip-shell[data-view='grid'] .pdf-meta { padding: 14px 16px 16px; gap: 6px; }
  .pdf-strip-shell[data-view='grid'] .pdf-card-title { font-size: 19px; }
  .pdf-strip-shell[data-view='grid'] .pdf-card-desc {
    display: -webkit-box;
    font-size: 13px;
  }
  .pdf-strip-shell[data-view='grid'] .pdf-card-cta {
    font-size: 10.5px;
    letter-spacing: 0.16em;
    white-space: normal;
  }
  .pdf-strip-shell[data-view='grid'] .pdf-strip-nav { display: none; }
  /* Wrapper holds the primary card link plus a small secondary "PDF"
     direct-download chip so users can grab the file without bouncing
     through the landing page. The chip floats over the card top-right;
     it's removed from the card's layout flow so card sizing stays put. */
  .pdf-card-wrap {
    position: relative;
    display: flex;
  }
  .pdf-card-wrap > .pdf-card { flex: 1; }

  .pdf-card-pdf-link {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 6;
    background: rgba(9, 21, 40, 0.85);
    color: var(--cream);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 5px 9px;
    border-radius: 2px;
    text-decoration: none;
    transition: background 0.18s ease, color 0.18s ease;
  }
  .pdf-card-pdf-link:hover,
  .pdf-card-pdf-link:focus-visible {
    background: var(--orange-dk);
    color: var(--cream);
  }

  .pdf-card {
    display: flex;
    flex-direction: column;
    background: var(--cream);
    border: 1px solid var(--rule);
    border-radius: 4px;
    text-decoration: none;
    color: var(--ink);
    position: relative;
    z-index: 1;
    /* The whole card (thumb + meta) holds a 1:1 aspect when at rest
       and expands to ~portrait-letter-plus-meta on hover, with a
       modest scale-up so the preview reads as a real preview, not
       just a taller crop. aspect-ratio transitions are supported in
       modern Chromium, Safari 18+, and Firefox 138+; older browsers
       snap between sizes (acceptable degradation). */
    aspect-ratio: 3 / 4;
    transition:
      aspect-ratio 0.32s cubic-bezier(0.2, 0, 0.2, 1),
      transform 0.32s cubic-bezier(0.2, 0, 0.2, 1),
      box-shadow 0.32s ease,
      border-color 0.18s ease;
    overflow: hidden;
  }

  .pdf-card:hover,
  .pdf-card:focus-visible {
    transform: translateY(-4px) scale(1.1);
    z-index: 5;
    border-color: var(--cobalt);
    box-shadow: 0 18px 40px rgba(9, 21, 40, 0.18);
  }

  /* Hover-intent: wait 250ms before expanding so a quick pass over
     the grid doesn't fire the animation. No delay on collapse (mouse
     leaves) or on keyboard focus — those should feel immediate. */
  .pdf-card:hover {
    transition-delay: 0.25s;
  }

  .pdf-card:focus-visible {
    outline: 2px solid var(--orange-lt);
    outline-offset: 2px;
  }

  /* Thumb fills whatever vertical space the card has after the meta
     block. Card aspect controls the overall size (square at rest,
     portrait-ish on hover), so the thumb's shape changes implicitly. */
  .pdf-thumb {
    position: relative;
    flex: 1;
    min-height: 0;
    background: #fafaf6;
    border-bottom: 1px solid var(--rule);
    overflow: hidden;
  }

  .pdf-thumb img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }

  /* On hover-capable devices, expand the card to give the thumb
     enough room to show the full first page. The 8.5/14 ratio is
     "letter portrait + room for meta" — at ~226px wide that yields
     a card ~372px tall, with ~290px of thumb (close to 8.5×11). */
  @media (hover: hover) {
    .pdf-card:hover,
    .pdf-card:focus-visible {
      aspect-ratio: 8.5 / 14;
    }
  }

  .pdf-meta {
    padding: 14px 16px 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 0 0 auto;
  }

  .pdf-card-title {
    font-family: var(--serif);
    font-size: 19px;
    font-weight: 400;
    line-height: 1.25;
    color: var(--ink);
  }

  .pdf-card-desc {
    font-size: 13px;
    line-height: 1.55;
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pdf-card-cta {
    padding-top: 2px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cobalt);
  }

  .pdf-card:hover .pdf-card-cta,
  .pdf-card:focus-visible .pdf-card-cta {
    color: var(--orange);
  }

  .pdf-card-cta-arrow {
    font-size: 12px;
    transition: transform 0.18s ease;
  }

  .pdf-card:hover .pdf-card-cta-arrow {
    transform: translate(2px, -2px);
  }

  .pdf-handwritten-link {
    margin-top: 24px;
    padding: 28px 0 64px;
    border-top: 1px solid var(--rule);
    text-align: center;
    font-size: 13px;
    color: var(--muted);
  }

  .pdf-handwritten-link a {
    color: var(--cobalt);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(26, 58, 138, 0.35);
    transition: color 0.18s ease, text-decoration-color 0.18s ease;
  }

  .pdf-handwritten-link a:hover {
    color: var(--orange);
    text-decoration-color: var(--orange-lt);
  }

  @media (max-width: 760px) {
    .pdfs-hero { padding: calc(var(--header-h) + 40px) 28px 48px; }
    .pdfs-wrap { padding: 0 28px; }
    .pdf-strip { gap: 14px; padding: 16px 0 26px; --strip-fade: 30px; }
    .pdf-strip > .pdf-card-wrap { flex: 0 0 148px; }
    .pdf-strip .pdf-card-title { font-size: 14.5px; }
    /* Phones swipe: no paging arrows even where a hybrid device
       reports a hover-capable pointer. */
    .pdf-strip-nav { display: none; }
    /* The CTA must stay on one line in a 148px card. */
    .pdf-strip .pdf-card-cta { font-size: 9px; letter-spacing: 0.08em; white-space: nowrap; }
    .pdf-card-title { font-size: 16px; }

    /* The view control drops to its own line under the section
       header, and only exists once the section is open. */
    .pdf-section-head { flex-wrap: wrap; gap: 10px; margin: 0; }
    .pdf-strip-toggle { margin-left: auto; font-size: 10px; }
    .pdf-section-toggle[aria-expanded='false'] ~ .pdf-strip-toggle { display: none; }

    /* Grid mode reuses the old phone grid. */
    .pdf-strip-shell[data-view='grid'] .pdf-strip {
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 18px;
    }
    .pdf-strip-shell[data-view='grid'] .pdf-card-title { font-size: 16px; }

    /* Section becomes a stacked accordion. The toggle button is the
       full-width tap target; the body collapses with an animated
       grid-template-rows trick (1fr → 0fr) for a smooth height
       transition without needing to know the body's actual height. */
    .pdf-section {
      padding: 0;
      border-top: 0;
    }
    .pdf-section + .pdf-section .pdf-section-toggle {
      border-top: 0;
    }
    .pdf-section:first-of-type .pdf-section-toggle {
      border-top: 1px solid var(--rule);
    }

    .pdf-section-toggle {
      cursor: pointer;
      margin: 0;
      padding: 18px 0;
      border-bottom: 1px solid var(--rule);
      align-items: center;
    }

    .pdf-section-toggle .section-rule { display: none; }
    .pdf-section-chevron { display: inline-block; }

    .pdf-section-toggle[aria-expanded="true"] .pdf-section-chevron {
      transform: rotate(180deg);
    }

    .pdf-section-body {
      display: grid;
      grid-template-rows: 0fr;
      transition: grid-template-rows 0.32s cubic-bezier(0.4, 0, 0.2, 1);
    }
    /* Section expands with a state flag on the section itself, not an
       adjacent-sibling match off the button — the button now sits
       inside .pdf-section-head, so + no longer reaches the body. */
    .pdf-section[data-open="true"] .pdf-section-body {
      grid-template-rows: 1fr;
    }
    .pdf-section-body-inner {
      overflow: hidden;
      min-height: 0;
    }
    .pdf-section[data-open="true"] .pdf-section-body-inner {
      padding: 22px 0 32px;
    }
  }

  /* Dark mode — matches the site's existing prefers-color-scheme treatment:
     dark navy panels, light text, blue-lt accents in place of cobalt. */
  @media (prefers-color-scheme: dark) {
    .pdf-card {
      background: #142544;
      border-color: rgba(91, 141, 232, 0.16);
    }
    .pdf-card:hover,
    .pdf-card:focus-visible {
      border-color: var(--blue-lt);
      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
    }
    .pdf-thumb {
      background: #142544;
      border-bottom-color: rgba(91, 141, 232, 0.16);
    }
    .pdf-strip-nav {
      background: #142544;
      border-color: rgba(91, 141, 232, 0.22);
      color: var(--blue-lt);
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.35);
    }
    .pdf-strip-nav:hover:not(:disabled) { color: #fff; border-color: var(--blue-lt); }
    .pdf-strip-toggle { color: var(--blue-lt); }
    .pdf-strip-toggle:hover { color: #fff; }
    .pdf-card-cta { color: var(--blue-lt); }
    .pdf-card:hover .pdf-card-cta,
    .pdf-card:focus-visible .pdf-card-cta { color: var(--orange-lt); }
    .pdf-handwritten-link a {
      color: var(--blue-lt);
      text-decoration-color: rgba(91, 141, 232, 0.45);
    }
    .pdf-handwritten-link a:hover {
      color: var(--orange-lt);
      text-decoration-color: var(--orange-lt);
    }
  }
</style>

<script is:inline>
  // Mobile collapsibles for the PDF category sections.
  // Each .pdf-section-toggle is a disclosure button on viewports
  // <= 760px and a no-op heading on desktop. We toggle aria-expanded
  // on click; CSS handles the height animation. On resize we sync
  // aria state — added on mobile (default collapsed), removed on
  // desktop so the role of the heading is correctly announced.
  (function () {
    const toggles = document.querySelectorAll(".pdf-section-toggle");
    if (!toggles.length) return;

    const mq = window.matchMedia("(max-width: 760px)");

    function syncForViewport() {
      const isMobile = mq.matches;
      toggles.forEach(function (t, i) {
        if (isMobile) {
          // Open the first section by default so the page doesn't read
          // as empty on first load. Subsequent toggles persist via the
          // !hasAttribute guard until the viewport flips back.
          if (!t.hasAttribute("aria-expanded")) {
            t.setAttribute("aria-expanded", i === 0 ? "true" : "false");
          }
        } else {
          t.removeAttribute("aria-expanded");
        }
        // Mirror the disclosure state onto the section: the CSS that
        // opens the body keys off the section, because the button now
        // lives inside .pdf-section-head and has no adjacent body.
        const sec = t.closest(".pdf-section");
        if (sec) {
          if (isMobile) {
            sec.setAttribute("data-open", t.getAttribute("aria-expanded") === "true" ? "true" : "false");
          } else {
            sec.removeAttribute("data-open");
          }
        }
      });
    }

    toggles.forEach(function (t) {
      t.addEventListener("click", function () {
        // Click is a no-op on desktop where there is no aria-expanded.
        if (!t.hasAttribute("aria-expanded")) return;
        const expanded = t.getAttribute("aria-expanded") === "true";
        t.setAttribute("aria-expanded", expanded ? "false" : "true");
        const sec = t.closest(".pdf-section");
        if (sec) sec.setAttribute("data-open", expanded ? "false" : "true");
      });
    });

    syncForViewport();
    if (mq.addEventListener) {
      mq.addEventListener("change", syncForViewport);
    } else if (mq.addListener) {
      mq.addListener(syncForViewport);
    }
  })();
</script>

<script is:inline>
  // Section strips: page the thumbnails a screenful at a time, keep the
  // edge fade honest about which directions still hold content, and hide
  // the nav where there's nothing to scroll. Touch devices swipe instead
  // (the buttons are display:none under @media (hover: none)).
  (function () {
    var shells = document.querySelectorAll(".pdf-strip-shell");
    if (!shells.length) return;
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    shells.forEach(function (shell) {
      var strip = shell.querySelector(".pdf-strip");
      var prev = shell.querySelector(".pdf-strip-nav--prev");
      var next = shell.querySelector(".pdf-strip-nav--next");
      if (!strip || !prev || !next) return;

      function metrics() {
        var card = strip.querySelector(".pdf-card-wrap");
        if (!card) return { step: strip.clientWidth, max: 0 };
        var gap = parseFloat(getComputedStyle(strip).columnGap) || 0;
        var cardW = card.getBoundingClientRect().width + gap;
        var perScreen = Math.max(1, Math.floor((strip.clientWidth + gap) / cardW));
        return { step: cardW * perScreen, max: strip.scrollWidth - strip.clientWidth };
      }

      function update() {
        var m = metrics();
        var x = strip.scrollLeft;
        shell.dataset.scrollable = m.max > 2 ? "yes" : "no";
        prev.disabled = x <= 2;
        next.disabled = x >= m.max - 2;
        strip.dataset.scroll = x <= 2 ? "start" : x >= m.max - 2 ? "end" : "mid";
      }

      function page(dir) {
        strip.scrollBy({ left: dir * metrics().step, behavior: reduce ? "auto" : "smooth" });
      }

      prev.addEventListener("click", function () { page(-1); });
      next.addEventListener("click", function () { page(1); });
      strip.addEventListener("scroll", update, { passive: true });
      window.addEventListener("resize", update);
      window.addEventListener("load", update);

      // "View all N" ⇄ "Show as strip": the same list re-laid out as the
      // full grid, then back to the one-line strip.
      var viewSection = shell.closest(".pdf-section");
      var viewBtn = viewSection ? viewSection.querySelector(".pdf-strip-toggle") : null;
      if (viewBtn) {
        viewBtn.addEventListener("click", function () {
          var toGrid = shell.dataset.view !== "grid";
          shell.dataset.view = toGrid ? "grid" : "strip";
          viewBtn.setAttribute("aria-expanded", toGrid ? "true" : "false");
          if (!toGrid) strip.scrollLeft = 0;
          update();
        });
      }

      // A collapsed mobile accordion measures 0 until it opens, so
      // re-measure after each disclosure toggle finishes animating.
      document.querySelectorAll(".pdf-section-toggle").forEach(function (t) {
        t.addEventListener("click", function () { setTimeout(update, 380); });
      });

      update();
      setTimeout(update, 400);
    });
  })();
</script>

</Layout>
