---
import '../styles/lessons.css';
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import LessonForm from '../components/LessonForm.astro';
import JsonLd from '../components/JsonLd.astro';
import heroImg from '../assets/DSC04813.webp';
import {
  SITE_URL,
  PERSON,
  PERSON_ID,
  LOCAL_BUSINESS_ID,
  ROCHESTER_AREA,
} from '../data/schema';

const heroSocial = await getImage({
  src: heroImg,
  format: 'webp',
  width: 1200,
});
const heroSocialUrl = new URL(heroSocial.src, SITE_URL).toString();

const pageUrl = `${SITE_URL}/drum-lessons`;

const offers = [
  { name: '60-minute private drum lesson', price: '50' },
  { name: '30-minute private drum lesson', price: '30' },
  { name: '4-pack of 60-minute lessons', price: '180' },
  { name: '4-pack of 30-minute lessons', price: '100' },
  { name: 'Half-price first 60-minute lesson (new students)', price: '25' },
  { name: 'Half-price first 30-minute lesson (new students)', price: '15' },
];

const faqs = [
  {
    q: "What's your cancellation policy?",
    a: '24 hours notice, please. Bulk packs are non-refundable but fully reschedulable with 24h notice. Illness exceptions always apply, just let me know. If I have to cancel late on you, your next lesson is on me.',
  },
  {
    q: 'Do you teach beginners?',
    a: "Yes: K–12 and adults. Most of my students start as beginners, and there's nothing to catch up on before lesson one.",
  },
  {
    q: 'Do you offer virtual lessons?',
    a: "Yes, over Zoom. Same rate as in-person at my studio. It works great once we sort out a basic mic and camera setup, and I'll walk you through that on our first call.",
  },
  {
    q: 'What styles do you teach?',
    a: "Rock, jazz, funk, Latin, and popular music more broadly. I cover reading and ear training, rudiments, technique, and sound on the kit. We'll shape the curriculum to your goals.",
  },
  {
    q: 'Where are you located?',
    a: "Rochester, NY (South Wedge neighborhood). The studio address is shared after booking. I also do house calls and virtual lessons over Zoom.",
  },
];

const localBusiness = {
  '@type': ['LocalBusiness', 'MusicSchool'],
  '@id': LOCAL_BUSINESS_ID,
  name: 'Jacobo Vega-Albela — Private Drum Lessons',
  description:
    'Private drum lessons in Rochester, NY with Jacobo Vega-Albela. By appointment only. K–12 and adults, beginners through advanced, in rock, jazz, funk, Latin, and popular styles. In-person at the South Wedge studio, house calls, or virtual over Zoom.',
  url: pageUrl,
  image: heroSocialUrl,
  telephone: '+1-585-802-4247',
  email: 'mailto:jacobovamusic@gmail.com',
  priceRange: '$$',
  currenciesAccepted: 'USD',
  paymentAccepted: 'Cash, Venmo, Zelle, PayPal',
  founder: { '@id': PERSON_ID },
  employee: { '@id': PERSON_ID },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Rochester',
    addressRegion: 'NY',
    postalCode: '14620',
    addressCountry: 'US',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 43.1413,
    longitude: -77.6097,
  },
  hasMap: 'https://www.google.com/maps/place/Mt+Hope+Ave+%26+Alexander+St,+Rochester,+NY+14620/',
  areaServed: [
    ROCHESTER_AREA,
    {
      '@type': 'AdministrativeArea',
      name: 'Worldwide (virtual lessons over Zoom)',
    },
  ],
  knowsAbout: [
    'Drum lessons',
    'Drumset',
    'Jazz drumming',
    'Rock drumming',
    'Funk drumming',
    'Latin drumming',
    'Drum rudiments',
    'Music reading',
    'Audition preparation',
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Drum lesson rates',
    itemListElement: offers.map((o) => ({
      '@type': 'Offer',
      name: o.name,
      price: o.price,
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
      url: `${SITE_URL}/book`,
      seller: { '@id': PERSON_ID },
    })),
  },
};

const faqPage = {
  '@type': 'FAQPage',
  '@id': `${pageUrl}#faq`,
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
    },
  })),
};

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    PERSON,
    localBusiness,
    {
      '@type': 'WebPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: 'Drum Lessons in Rochester, NY — Jacobo Vega-Albela',
      about: { '@id': LOCAL_BUSINESS_ID },
      primaryImageOfPage: heroSocialUrl,
      breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
          { '@type': 'ListItem', position: 2, name: 'Drum Lessons', item: pageUrl },
        ],
      },
    },
    faqPage,
  ],
};
---

<Layout
  title="Drum Lessons in Rochester, NY — Jacobo Vega-Albela"
  description="Drum lessons in Rochester, NY with Jacobo Vega-Albela. Eastman MM, 10+ years teaching all ages and levels. Your first lesson is half off."
  themeColor="#091528"
  image={{
    url: heroSocial.src,
    width: 1200,
    height: 1800,
    type: 'image/webp',
    alt: 'Black-and-white portrait of Jacobo Vega-Albela holding a cymbal overhead',
  }}
>
  <JsonLd slot="head" data={graph} />
<main>
<!-- HERO -->
<section class="hero" aria-labelledby="heroTitle">
  <div class="wrap">
    <div class="hero-text">
      <p class="hero-eyebrow">Private drum instruction</p>
      <h1 id="heroTitle">Drum Lessons in <em>Rochester, NY</em></h1>
      <p class="hero-sub">Personalized instruction for every age and skill level.</p>
      <ul class="chips" aria-label="Credentials">
        <li class="chip"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M3 8.5l3.2 3.2L13 5"/></svg>Master's, Eastman School of Music</li>
        <li class="chip"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M3 8.5l3.2 3.2L13 5"/></svg>10+ years teaching</li>
        <li class="chip"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M3 8.5l3.2 3.2L13 5"/></svg>All ages &amp; levels</li>
      </ul>
      <p class="hero-price"><strong>$50/hr</strong> &middot; <strong>$30/30min</strong> &nbsp;&middot;&nbsp; <span class="hero-price-promo">First lesson half off</span></p>
      <LessonForm
        formId="xjglgjjj"
        formIdSlug="hero-lesson-form"
        submitEvent="lesson_inquiry_submit"
        submitEventParams={{ form_location: 'lessons_hero' }}
      />
    </div>
    <figure class="hero-img">
      <Image
        src={heroImg}
        alt="Jacobo Vega-Albela holding a cymbal overhead — black-and-white portrait"
        width={1000}
        height={1500}
        widths={[400, 600, 800, 1000]}
        sizes="(max-width: 780px) 100vw, 45vw"
        loading="eager"
        fetchpriority="high"
        quality={55}
      />
    </figure>
    <div class="hero-aside">
      <a class="tel-link" href="tel:+15858024247" aria-label="Text or call 5 8 5, 8 0 2, 4 2 4 7">Text or call (585) 802-4247</a>
      <p class="trust-line">Google Business Screened &nbsp;·&nbsp; Background-checked &amp; verified</p>
    </div>
  </div>
</section>

<!-- TESTIMONIALS -->
<section aria-labelledby="testimonialsTitle">
  <div class="wrap">
    <div class="section-head">
      <span class="section-tag">What students say</span>
      <h2 id="testimonialsTitle">Real wins, real students.</h2>
      <span class="section-rule" aria-hidden="true"></span>
    </div>
    <div class="testimonials-grid">
      <figure class="tcard">
        <blockquote>I had an audition for a jazz camp and decided to have a lesson with Jacobo. In one lesson he helped me improve so much, and I ended up getting into the camp. Highly recommended!</blockquote>
        <figcaption>&mdash; <strong>Will</strong>, college student</figcaption>
      </figure>
      <figure class="tcard">
        <blockquote>I got into the conservatory in Brussels! Thank you so much for all your support &mdash; I learned a lot from you.</blockquote>
        <figcaption>&mdash; <strong>Annie</strong>, music school graduate</figcaption>
      </figure>
      <figure class="tcard">
        <blockquote>My experience working with Jacobo was great. The exercises he writes really helped me with my flow. He is a drummer first and a teacher second, so everything he teaches comes from a practical base of knowledge and mastery.</blockquote>
        <figcaption>&mdash; <strong>Joseph</strong>, hobbyist</figcaption>
      </figure>
    </div>
  </div>
</section>

<!-- PRICING -->
<section aria-labelledby="pricingTitle">
  <div class="wrap">
    <div class="section-head">
      <span class="section-tag">Rates &amp; packages</span>
      <h2 id="pricingTitle">Transparent pricing, no surprises.</h2>
      <span class="section-rule" aria-hidden="true"></span>
    </div>
    <p class="promo-banner"><strong>New students</strong> 50% off your first lesson.</p>
    <div class="pricing-grid">
      <div class="pcard featured">
        <span class="pcard-tag">Most popular</span>
        <h3>Standard rate</h3>
        <p class="price">$50 <small>/ 60 min</small></p>
        <p class="price">$30 <small>/ 30 min</small></p>
        <p>At my home studio in Rochester, or virtual over Zoom &mdash; same rate either way.</p>
      </div>
      <div class="pcard">
        <span class="pcard-tag">4-lesson pack</span>
        <h3>Save ~10%</h3>
        <p class="price">$180 <small>/ four 60-min</small></p>
        <p class="price">$100 <small>/ four 30-min</small></p>
        <p>Steady momentum, slightly better price. Reschedulable with 24h notice.</p>
      </div>
      <div class="pcard">
        <span class="pcard-tag">House calls</span>
        <h3>I come to you</h3>
        <p class="price">Standard <small>+ $0.75/min commute</small></p>
        <p>Round-trip travel time billed transparently &mdash; ideal for younger students.</p>
      </div>
      <div class="pcard">
        <span class="pcard-tag">Collegiate</span>
        <h3>Student discount</h3>
        <p class="price">3 + 1<small> &nbsp;at 50% off</small></p>
        <p>Book three lessons at full price, get the 4th half off. Proof of enrollment required.</p>
      </div>
      <div class="pcard">
        <span class="pcard-tag">K&ndash;12 special</span>
        <h3>Back-to-school</h3>
        <p class="price">Buy 5, get 1<small> free</small></p>
        <p>Runs Jul&ndash;Sep and Jan&ndash;Mar. Great for kids building a habit around the school year.</p>
      </div>
      <div class="pcard">
        <span class="pcard-tag">Referral bonus</span>
        <h3>Bring a friend</h3>
        <p class="price">Both get 1<small> free lesson</small></p>
        <p>Refer a student. Once they complete 3 lessons, you both get a free lesson on me.</p>
      </div>
    </div>
    <p class="pricing-fineprint">Bulk packs are non-refundable but fully reschedulable with 24 hours notice. Illness exceptions always apply.</p>
    <div class="mid-cta">
      <p><strong>Not sure which option fits?</strong> Try a half-price first lesson &mdash; drum with me, then decide.</p>
      <a class="btn btn-outline" data-cta href="/book" onclick="gtag('event', 'lesson_booking_cta_click', { location: 'pricing_mid' })">Book Your Half-Price Lesson</a>
    </div>
  </div>
</section>

<!-- ABOUT -->
<section aria-labelledby="aboutTitle">
  <div class="wrap">
    <div class="section-head">
      <span class="section-tag">About me</span>
      <h2 id="aboutTitle">Why study with me.</h2>
      <span class="section-rule" aria-hidden="true"></span>
    </div>
    <div class="about-grid">
      <div class="about-text">
        <h3>Clarity, honest feedback, steady wins.</h3>
        <p>I help students find their voice with assignments tailored to their individual needs &mdash; and I get results. I teach K&ndash;12 and adults, beginners through advanced, in rock, jazz, funk, Latin, and other popular styles.</p>
        <p>Whether you're picking up sticks for the first time or preparing for a conservatory audition, the path forward is the same: clarity about what to practice, honest feedback, and steady wins. We figure out where you want to go, then build the habits to get you there.</p>
        <p>I'm a working drummer first and a teacher second. Everything I assign comes from a practical base of knowledge &mdash; the same things I'm using on stage and in the studio.</p>
      </div>
      <div class="about-bg">
        <h3>Background</h3>
        <ul class="bg-list">
          <li><strong>Education</strong>MM, Jazz Studies &amp; Contemporary Media &mdash; Eastman School of Music (2022, Schirmer Prize in Jazz Performance) &middot; BM, Classical Percussion Performance &mdash; New Mexico State University (2019, Crimson Scholar) &middot; Betty Carter's Jazz Ahead alumnus (2023)</li>
          <li><strong>Teaching</strong>Private instructor 2015&ndash;present &middot; Lecture-style classes on drumset styles at Eastman &middot; All ages and levels</li>
          <li><strong>Performance</strong>Western New York Big Band, Las Cruces Symphony Orchestra, The Swooners, Silver Arrow, Trio 55, Brendan Lanighan Octet &middot; Festivals: Rochester International Jazz Festival, Burlington Discover Jazz Festival, Las Cruces Juneteenth Jazz Festival</li>
        </ul>
        <p class="press-line"><strong>As featured in</strong>Rochester City Magazine &middot; Las Cruces Bulletin &middot; Bob Osborne's <em>Different Noises</em> &middot; WMSE, WFMU, KURU, KOWS-LP</p>
      </div>
    </div>
  </div>
</section>

<!-- LISTEN -->
<section aria-labelledby="listenTitle">
  <div class="wrap">
    <div class="section-head">
      <span class="section-tag">Hear me play</span>
      <h2 id="listenTitle">What my playing sounds like.</h2>
      <span class="section-rule" aria-hidden="true"></span>
    </div>
    <div class="listen-grid">
      <figure class="media media-bc">
        <div class="media-frame bc">
          <button
            type="button"
            class="media-facade media-facade-bc"
            aria-label="Play 'Un-Belonging' on Bandcamp"
            data-facade="bc"
          >
            <span class="media-facade-eyebrow">Bandcamp</span>
            <span class="media-facade-title">"Un-Belonging"</span>
            <span class="media-facade-sub">577 Records · 2025</span>
            <span class="media-facade-play" aria-hidden="true">▶</span>
            <span class="media-facade-cta">Play album</span>
          </button>
        </div>
        <figcaption><strong>Un-Belonging</strong> &mdash; my debut album on 577 Records (2025).</figcaption>
      </figure>
      <figure class="media">
        <div class="media-frame yt">
          <button
            type="button"
            class="media-facade media-facade-yt"
            aria-label="Play performance footage on YouTube"
            data-facade="yt"
          >
            <span class="media-facade-eyebrow">YouTube</span>
            <span class="media-facade-title">Performance footage</span>
            <span class="media-facade-sub">Clips from recent shows &amp; sessions</span>
            <span class="media-facade-play" aria-hidden="true">▶</span>
            <span class="media-facade-cta">Play playlist</span>
          </button>
        </div>
        <figcaption><strong>Performance footage</strong> &mdash; clips from recent shows and sessions.</figcaption>
      </figure>
    </div>
    <p class="epk-link">More about me at <a href="https://www.jva-music.com" target="_blank" rel="noopener">jva-music.com</a>.</p>
  </div>
</section>

<!-- FAQ -->
<section aria-labelledby="faqTitle">
  <div class="wrap">
    <div class="section-head">
      <span class="section-tag">Good to know</span>
      <h2 id="faqTitle">Frequently asked questions.</h2>
      <span class="section-rule" aria-hidden="true"></span>
    </div>
    <div class="faq-list">
      <details>
        <summary>What's your cancellation policy?</summary>
        <div class="faq-body">24 hours notice, please. Bulk packs are non-refundable but fully reschedulable with 24h notice. Illness exceptions always apply, just let me know. If I have to cancel late on you, your next lesson is on me.</div>
      </details>
      <details>
        <summary>Do you teach beginners?</summary>
        <div class="faq-body">Yes: K&ndash;12 and adults. Most of my students start as beginners, and there's nothing to "catch up on" before lesson one.</div>
      </details>
      <details>
        <summary>Do you offer virtual lessons?</summary>
        <div class="faq-body">Yes, over Zoom. Same rate as in-person at my studio. It works great once we sort out a basic mic and camera setup, and I'll walk you through that on our first call.</div>
      </details>
      <details>
        <summary>What styles do you teach?</summary>
        <div class="faq-body">Rock, jazz, funk, Latin, and popular music more broadly. I cover reading and ear training, rudiments, technique, and sound on the kit. We'll shape the curriculum to your goals.</div>
      </details>
      <details>
        <summary>Where are you located?</summary>
        <div class="faq-body">Rochester, NY. The studio address is shared after booking. I also do house calls (see pricing) and virtual lessons over Zoom.</div>
      </details>
    </div>
  </div>
</section>
</main>

<!-- FINAL CTA BAND -->
<section class="cta-band" aria-label="Book your half-price first lesson">
  <div class="cta-band-inner">
    <h2>Ready to start?</h2>
    <p>Your first lesson is half off &mdash; just $25 for an hour. See if we click before committing further.</p>
    <a class="btn btn-primary" data-cta href="/book" onclick="gtag('event', 'lesson_booking_cta_click', { location: 'cta_band' })">Book Your Half-Price Lesson</a>
  </div>
</section>

<style>
  .hero-price {
    font-size: .9375rem;
    line-height: 1.4;
    color: rgba(245, 243, 238, 0.85);
    margin: -0.25rem 0 0.75rem;
    letter-spacing: .01em;
  }
  .hero-price strong {
    color: var(--cream);
    font-weight: 600;
  }
  .hero-price-promo {
    color: var(--orange-lt);
    font-weight: 500;
  }

  /* Iframe facades — replace YouTube + Bandcamp <iframe>s with a styled
     button until the user clicks. Defers ~1 MB of third-party JS and
     ~1 s of script eval to user intent. */
  .media-facade {
    appearance: none;
    -webkit-appearance: none;
    border: 0;
    margin: 0;
    padding: 1.5rem;
    cursor: pointer;
    color: var(--cream);
    text-align: center;
    font: inherit;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: .5rem;
    background:
      radial-gradient(ellipse 70% 90% at 50% 110%, rgba(26, 58, 138, .55), transparent 60%),
      linear-gradient(180deg, var(--navy) 0%, #051022 100%);
    transition: transform .2s, box-shadow .2s;
  }
  /* Match the slots the original <iframe>s lived in — YT is absolutely
     positioned inside a 16/9 frame, BC is a fixed 350×470 inline box. */
  .media-frame .media-facade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .media-frame.bc .media-facade {
    position: relative;
    width: 350px;
    max-width: 100%;
    height: 470px;
    inset: auto;
  }
  .media-facade-yt {
    background:
      radial-gradient(ellipse 60% 80% at 50% 100%, rgba(232, 101, 10, .25), transparent 60%),
      linear-gradient(180deg, var(--navy) 0%, #050a14 100%);
  }
  .media-facade:hover,
  .media-facade:focus-visible {
    transform: translateY(-1px);
    outline: none;
  }
  .media-facade:focus-visible {
    box-shadow: 0 0 0 2px var(--orange);
  }
  .media-facade-eyebrow {
    font-size: .6875rem;
    font-weight: 700;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--orange-lt);
  }
  .media-facade-title {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.25rem, 2.5vw, 1.625rem);
    line-height: 1.15;
    color: var(--cream);
  }
  .media-facade-sub {
    font-size: .8125rem;
    color: rgba(245, 243, 238, .65);
    margin-bottom: .25rem;
  }
  .media-facade-play {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--orange);
    color: var(--cream);
    font-size: 1.25rem;
    line-height: 1;
    padding-left: 4px;
    margin-top: .25rem;
    transition: background .2s, transform .2s;
  }
  .media-facade:hover .media-facade-play,
  .media-facade:focus-visible .media-facade-play {
    background: var(--orange-lt);
    transform: scale(1.05);
  }
  .media-facade-cta {
    font-size: .75rem;
    font-weight: 600;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: rgba(245, 243, 238, .8);
    margin-top: .25rem;
  }
</style>

<script is:inline>
  // Iframe facade — swap the placeholder button for the real iframe on
  // the user's first click. Until then, the third-party players never
  // load, saving ~1 MB of JS and ~1 s of script eval per page load.
  // The isTrusted guard rejects synthetic clicks (e.g. element.click()
  // calls from Lighthouse's accessibility audits or other automation),
  // which were otherwise booting the iframes during measurement.
  document.addEventListener('click', function (e) {
    if (!e.isTrusted) return;
    var btn = e.target && e.target.closest ? e.target.closest('.media-facade') : null;
    if (!btn) return;
    var kind = btn.getAttribute('data-facade');
    var iframe = document.createElement('iframe');
    iframe.setAttribute('frameborder', '0');
    if (kind === 'yt') {
      iframe.src = 'https://www.youtube.com/embed/videoseries?list=PLr4sdvgtCCMcfSZHuTscc1YX61tsUFaJt&autoplay=1';
      iframe.title = 'Performance footage on YouTube';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
    } else if (kind === 'bc') {
      iframe.src = 'https://bandcamp.com/EmbeddedPlayer/album=2556455061/size=large/bgcol=ffffff/linkcol=0687f5/tracklist=false/transparent=true/';
      iframe.title = 'Un-Belonging on Bandcamp';
      iframe.setAttribute('seamless', '');
    } else {
      return;
    }
    btn.replaceWith(iframe);
  });
</script>

</Layout>