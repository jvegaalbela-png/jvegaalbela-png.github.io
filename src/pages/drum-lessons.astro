---
import '../styles/lessons.css';
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import LessonForm from '../components/LessonForm.astro';
import JsonLd from '../components/JsonLd.astro';
import YouTubeFacade from '../components/YouTubeFacade.astro';
import BandcampFacade from '../components/BandcampFacade.astro';
import heroImg from '../assets/DSC04813.webp';
import albumArt from '../assets/album-art.jpg';
import {
  SITE_URL,
  PERSON,
  PERSON_ID,
  LOCAL_BUSINESS_ID,
  ROCHESTER_AREA,
} from '../data/schema';

const heroSocial = await getImage({
  src: heroImg,
  format: 'webp',
  width: 1200,
});
const heroSocialUrl = new URL(heroSocial.src, SITE_URL).toString();

const pageUrl = `${SITE_URL}/drum-lessons`;

const offers = [
  { name: '60-minute private drum lesson', price: '50' },
  { name: '30-minute private drum lesson', price: '30' },
  { name: '4-pack of 60-minute lessons', price: '180' },
  { name: '4-pack of 30-minute lessons', price: '100' },
  { name: 'Half-price first 60-minute lesson (new students)', price: '25' },
  { name: 'Half-price first 30-minute lesson (new students)', price: '15' },
];

const faqs = [
  {
    q: "What's your cancellation policy?",
    a: '24 hours notice, please. Bulk packs are non-refundable but fully reschedulable with 24h notice. Illness exceptions always apply, just let me know. If I have to cancel late on you, your next lesson is on me.',
  },
  {
    q: 'Do you teach beginners?',
    a: "Yes: K–12 and adults. Most of my students start as beginners, and there's nothing to catch up on before lesson one.",
  },
  {
    q: 'Do you offer virtual lessons?',
    a: "Yes, over Zoom. Same rate as in-person at my studio. It works great once we sort out a basic mic and camera setup, and I'll walk you through that on our first call.",
  },
  {
    q: 'What styles do you teach?',
    a: "Rock, jazz, funk, Latin, and popular music more broadly. I cover reading and ear training, rudiments, technique, and sound on the kit. We'll shape the curriculum to your goals.",
  },
  {
    q: 'Where are you located?',
    a: "My studio is in the South Wedge neighborhood of Rochester, NY (14620) — close to Park Ave, Highland Park, the East End, Mt. Hope, Swillburg, and a short drive from Pittsford and Brighton. The exact address is shared after booking. I also do house calls and virtual lessons over Zoom.",
  },
];

const testimonials = [
  {
    author: 'Will',
    role: 'college student',
    body: 'I had an audition for a jazz camp and decided to have a lesson with Jacobo. In one lesson he helped me improve so much, and I ended up getting into the camp. Highly recommended!',
  },
  {
    author: 'Annie',
    role: 'music school graduate',
    body: 'I got into the conservatory in Brussels! Thank you so much for all your support — I learned a lot from you.',
  },
  {
    author: 'Joseph',
    role: 'hobbyist',
    body: 'My experience working with Jacobo was great. The exercises he writes really helped me with my flow. He is a drummer first and a teacher second, so everything he teaches comes from a practical base of knowledge and mastery.',
    excerpt: 'He is a drummer first and a teacher second, so everything he teaches comes from a practical base of knowledge and mastery.',
  },
  {
    author: 'Patrick M.',
    role: 'via Google',
    source: 'Google',
    body: "Super down to earth guy that knows his stuff. He even figured out why my back pain. I've taken lessons from a few different people and he has been the best.",
    excerpt: "Super down to earth guy that knows his stuff. I've taken lessons from a few different people and he has been the best.",
  },
  {
    author: 'Naomi',
    role: 'via Google',
    source: 'Google',
    body: 'I had an awesome first drum lesson! Jacobo was thorough, covering everything from reading music to teaching me my first drum beat. We also went over technique, which was super helpful. Highly recommend!',
    excerpt: 'An awesome first drum lesson! Jacobo was thorough, covering everything from reading music to my first drum beat. Highly recommend!',
  },
  {
    author: 'Nisaa R.',
    role: 'via Google',
    source: 'Google',
    body: "I recently started drumming, and going into it, I was very anxious since this was something completely new to me. However, Jacob made me feel comfortable from the very first lesson. He was incredibly patient and understanding, knowing it was my first time ever playing the drums. If you're looking for a drum instructor who is kind, patient, and supportive, I highly recommend taking lessons with Jacabo!!!",
    excerpt: 'Jacobo made me feel comfortable from the very first lesson. He was incredibly patient and understanding. I highly recommend taking lessons with him!',
  },
];

const reviews = testimonials.map((t, i) => ({
  '@type': 'Review',
  '@id': `${pageUrl}#review-${i + 1}`,
  author: { '@type': 'Person', name: t.author },
  reviewBody: t.body,
  reviewRating: {
    '@type': 'Rating',
    ratingValue: '5',
    bestRating: '5',
    worstRating: '1',
  },
  itemReviewed: { '@id': LOCAL_BUSINESS_ID },
  ...(t.source && {
    publisher: { '@type': 'Organization', name: t.source },
  }),
}));

const localBusiness = {
  '@type': ['LocalBusiness', 'MusicSchool'],
  '@id': LOCAL_BUSINESS_ID,
  name: 'Jacobo Vega-Albela — Private Drum Lessons',
  description:
    'Private drum lessons in Rochester, NY with Eastman-trained jazz drummer Jacobo Vega-Albela. Studio in the South Wedge — convenient to Park Ave, Highland Park, the East End, Mt. Hope, Swillburg, Pittsford, and Brighton. By appointment only. K–12 and adults, beginners through advanced, in jazz, rock, funk, Latin, and popular styles. In-person at the South Wedge studio, house calls, or virtual over Zoom.',
  url: pageUrl,
  image: heroSocialUrl,
  telephone: '+1-585-802-4247',
  email: 'mailto:jacobovamusic@gmail.com',
  priceRange: '$$',
  currenciesAccepted: 'USD',
  paymentAccepted: 'Cash, Venmo, Zelle, PayPal',
  founder: { '@id': PERSON_ID },
  employee: { '@id': PERSON_ID },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Rochester',
    addressRegion: 'NY',
    postalCode: '14620',
    addressCountry: 'US',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 43.1413,
    longitude: -77.6097,
  },
  hasMap: 'https://www.google.com/maps/place/Mt+Hope+Ave+%26+Alexander+St,+Rochester,+NY+14620/',
  areaServed: [
    ROCHESTER_AREA,
    { '@type': 'Place', name: 'South Wedge, Rochester, NY' },
    { '@type': 'Place', name: 'Park Ave, Rochester, NY' },
    { '@type': 'Place', name: 'Highland Park, Rochester, NY' },
    { '@type': 'Place', name: 'East End, Rochester, NY' },
    { '@type': 'Place', name: 'Mt. Hope, Rochester, NY' },
    { '@type': 'Place', name: 'Swillburg, Rochester, NY' },
    { '@type': 'City', name: 'Pittsford, NY' },
    { '@type': 'City', name: 'Brighton, NY' },
    {
      '@type': 'AdministrativeArea',
      name: 'Worldwide (virtual lessons over Zoom)',
    },
  ],
  knowsAbout: [
    'Drum lessons',
    'Drumset',
    'Jazz drumming',
    'Rock drumming',
    'Funk drumming',
    'Latin drumming',
    'Drum rudiments',
    'Music reading',
    'Audition preparation',
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Drum lesson rates',
    itemListElement: offers.map((o) => ({
      '@type': 'Offer',
      name: o.name,
      price: o.price,
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
      url: `${SITE_URL}/book`,
      seller: { '@id': PERSON_ID },
    })),
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '5.0',
    bestRating: '5',
    worstRating: '1',
    ratingCount: testimonials.length,
    reviewCount: testimonials.length,
  },
};

const faqPage = {
  '@type': 'FAQPage',
  '@id': `${pageUrl}#faq`,
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
    },
  })),
};

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    PERSON,
    localBusiness,
    ...reviews,
    {
      '@type': 'WebPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: 'Drum Lessons in Rochester, NY — Jacobo Vega-Albela',
      about: { '@id': LOCAL_BUSINESS_ID },
      primaryImageOfPage: heroSocialUrl,
      breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
          { '@type': 'ListItem', position: 2, name: 'Drum Lessons', item: pageUrl },
        ],
      },
    },
    faqPage,
  ],
};
---

<Layout
  title="Drum Lessons in Rochester, NY — Jacobo Vega-Albela"
  description="Drum lessons in Rochester, NY with Jacobo Vega-Albela. Eastman MM, 10+ years teaching all ages and levels. Your first lesson is half off."
  themeColor="#091528"
  image={{
    url: heroSocial.src,
    width: 1200,
    height: 1800,
    type: 'image/webp',
    alt: 'Black-and-white portrait of Jacobo Vega-Albela holding a cymbal overhead',
  }}
>
  <JsonLd slot="head" data={graph} />
<main>
<!-- HERO -->
<section class="hero" aria-labelledby="heroTitle">
  <div class="wrap">
    <div class="hero-text">
      <p class="hero-eyebrow">Private drum instruction</p>
      <h1 id="heroTitle">Drum Lessons in<br /><em>Rochester, NY</em></h1>
      <p class="hero-sub">Personalized instruction for every age and skill level.</p>
      <a class="hero-rating" href="#testimonialsTitle">
        <span class="hero-rating-stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        <span class="hero-rating-text"><strong>5.0</strong> &middot; 6 Google reviews</span>
      </a>
      <p class="hero-promo">
        <span class="hero-promo-tag">New students</span>
        <span class="hero-promo-text">First lesson <strong>50% off</strong> &mdash; just $25 for an hour.</span>
      </p>
      <ul class="chips" aria-label="Credentials">
        <li class="chip"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M3 8.5l3.2 3.2L13 5"/></svg>Master's, Eastman School of Music</li>
        <li class="chip"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M3 8.5l3.2 3.2L13 5"/></svg>10+ years teaching</li>
        <li class="chip"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M3 8.5l3.2 3.2L13 5"/></svg>All ages &amp; levels</li>
      </ul>
      <p class="hero-price"><strong>$50</strong> <span class="hero-price-unit">/ 60 min</span> &nbsp;&middot;&nbsp; <strong>$30</strong> <span class="hero-price-unit">/ 30 min</span></p>
      <LessonForm
        formId="xjglgjjj"
        formIdSlug="hero-lesson-form"
        submitEvent="lesson_inquiry_submit"
        submitEventParams={{ form_location: 'lessons_hero', value: 25, currency: 'USD' }}
      />
      <a class="tel-link hero-tel" href="tel:+15858024247" aria-label="Text or call 5 8 5, 8 0 2, 4 2 4 7" onclick="gtag('event', 'cta_call_click', { location: 'lessons_hero' })">Text or call (585) 802-4247</a>
      <p class="trust-line">Google-screened &middot; Background-checked</p>
    </div>
    <figure class="hero-img">
      <Image
        src={heroImg}
        alt="Jacobo Vega-Albela holding a cymbal overhead — black-and-white portrait"
        widths={[400, 600, 800, 1000, 1200, 1600]}
        sizes="(max-width: 780px) 100vw, 45vw"
        loading="eager"
        fetchpriority="high"
        decoding="auto"
        quality={55}
      />
    </figure>
  </div>
</section>

<!-- TESTIMONIALS -->
<section aria-labelledby="testimonialsTitle">
  <div class="wrap">
    <div class="section-head">
      <span class="section-tag">What students say</span>
      <h2 id="testimonialsTitle">Real wins, real students.</h2>
      <span class="section-rule" aria-hidden="true"></span>
    </div>
    <div class="testimonials-grid">
      {testimonials.map((t) => (
        <figure class="tcard">
          <blockquote>{t.excerpt ?? t.body}</blockquote>
          <figcaption>&mdash; <strong>{t.author}</strong>, {t.role}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<!-- PRICING -->
<section aria-labelledby="pricingTitle">
  <div class="wrap">
    <div class="section-head">
      <span class="section-tag">Rates &amp; packages</span>
      <h2 id="pricingTitle">Transparent pricing, no surprises.</h2>
      <span class="section-rule" aria-hidden="true"></span>
    </div>
    <p class="pricing-note"><span class="pricing-note-dot" aria-hidden="true">●</span> New students get 50% off the first lesson &mdash; rates below are the standard ones.</p>
    <div class="pricing-grid">
      <div class="pcard featured">
        <span class="pcard-tag">Most popular</span>
        <h3>Standard rate</h3>
        <p class="price">$50 <small>/ 60 min</small></p>
        <p class="price">$30 <small>/ 30 min</small></p>
        <p>At my home studio in Rochester, or virtual over Zoom &mdash; same rate either way.</p>
      </div>
      <div class="pcard">
        <span class="pcard-tag">4-lesson pack</span>
        <h3>Save ~10%</h3>
        <p class="price">$180 <small>/ four 60-min</small></p>
        <p class="price">$100 <small>/ four 30-min</small></p>
        <p>Steady momentum, slightly better price. Reschedulable with 24h notice.</p>
      </div>
      <div class="pcard">
        <span class="pcard-tag">House calls</span>
        <h3>I come to you</h3>
        <p class="price-sub">Standard rate <small>+ $0.75/min round-trip travel</small></p>
        <p>Travel billed transparently &mdash; ideal for younger students who can't easily get to the studio.</p>
      </div>
    </div>
    <details class="pricing-more">
      <summary>More options &mdash; student, K&ndash;12, and referral discounts</summary>
      <ul class="pricing-rows">
        <li class="pricing-row">
          <span class="pricing-row-tag">Collegiate</span>
          <span class="pricing-row-title">Student discount</span>
          <span class="pricing-row-price">3 + 1 at 50% off</span>
          <span class="pricing-row-body">Book three at full price, the 4th is half off. Proof of enrollment.</span>
        </li>
        <li class="pricing-row">
          <span class="pricing-row-tag">K&ndash;12 special</span>
          <span class="pricing-row-title">Back-to-school</span>
          <span class="pricing-row-price">Buy 5, get 1 free</span>
          <span class="pricing-row-body">Runs Jul&ndash;Sep and Jan&ndash;Mar. Great for habit-building.</span>
        </li>
        <li class="pricing-row">
          <span class="pricing-row-tag">Referral bonus</span>
          <span class="pricing-row-title">Bring a friend</span>
          <span class="pricing-row-price">Both get 1 free lesson</span>
          <span class="pricing-row-body">Once they complete 3 lessons, you both get a free lesson on me.</span>
        </li>
      </ul>
    </details>
    <p class="pricing-fineprint">Bulk packs are non-refundable but fully reschedulable with 24 hours notice. Illness exceptions always apply.</p>
    <div class="mid-cta">
      <p><strong>Not sure which option fits?</strong> Try a half-price first lesson &mdash; drum with me, then decide.</p>
      <a class="btn btn-primary" data-cta href="/book" onclick="gtag('event', 'lesson_booking_cta_click', { location: 'pricing_mid' })">Request My Half-Price Lesson</a>
    </div>
  </div>
</section>

<!-- ABOUT -->
<section aria-labelledby="aboutTitle">
  <div class="wrap">
    <div class="section-head">
      <span class="section-tag">About me</span>
      <h2 id="aboutTitle">Why study with me.</h2>
      <span class="section-rule" aria-hidden="true"></span>
    </div>
    <div class="about-grid">
      <div class="about-text">
        <h3>Clarity, honest feedback, steady wins.</h3>
        <p>I help students find their voice with assignments tailored to their individual needs &mdash; and I get results. I teach K&ndash;12 and adults, beginners through advanced, in rock, jazz, funk, Latin, and other popular styles.</p>
        <p>Whether you're picking up sticks for the first time or preparing for a conservatory audition, the path forward is the same: clarity about what to practice, honest feedback, and steady wins. We figure out where you want to go, then build the habits to get you there.</p>
        <p>I'm a working drummer first and a teacher second. Everything I assign comes from a practical base of knowledge &mdash; the same things I'm using on stage and in the studio.</p>
      </div>
      <div class="about-bg">
        <h3>Background</h3>
        <ul class="bg-list">
          <li><strong>Education</strong>MM, Jazz Studies &amp; Contemporary Media &mdash; Eastman School of Music (2022, Schirmer Prize in Jazz Performance) &middot; BM, Classical Percussion Performance &mdash; New Mexico State University (2019, Crimson Scholar) &middot; Betty Carter's Jazz Ahead alumnus (2023)</li>
          <li><strong>Teaching</strong>Private instructor 2015&ndash;present &middot; Lecture-style classes on drumset styles at Eastman &middot; All ages and levels</li>
          <li><strong>Performance</strong>Western New York Big Band, Las Cruces Symphony Orchestra, The Swooners, Silver Arrow, Trio 55, Brendan Lanighan Octet &middot; Festivals: Rochester International Jazz Festival, Burlington Discover Jazz Festival, Las Cruces Juneteenth Jazz Festival</li>
        </ul>
        <p class="press-line"><strong>As featured in</strong>Rochester City Magazine &middot; Las Cruces Bulletin &middot; Bob Osborne's <em>Different Noises</em> &middot; WMSE, WFMU, KURU, KOWS-LP</p>
      </div>
    </div>
  </div>
</section>

<!-- LISTEN -->
<section aria-labelledby="listenTitle">
  <div class="wrap">
    <div class="section-head">
      <span class="section-tag">Hear me play</span>
      <h2 id="listenTitle">What my playing sounds like.</h2>
      <span class="section-rule" aria-hidden="true"></span>
    </div>
    <div class="listen-grid">
      <figure class="media media-bc">
        <BandcampFacade
          src="https://bandcamp.com/EmbeddedPlayer/album=2556455061/size=large/bgcol=ffffff/linkcol=0687f5/tracklist=false/transparent=true/"
          title="Un-Belonging on Bandcamp"
          cover={albumArt}
          coverAlt="Album cover for 'Un-Belonging' by Jacobo Vega-Albela"
          fallbackHref="https://577records.bandcamp.com/album/un-belonging"
          fallbackText="Un-Belonging by Jacobo Vega-Albela"
        />
        <figcaption><strong>Un-Belonging</strong> &mdash; my debut album on 577 Records (2025).</figcaption>
      </figure>
      <figure class="media">
        <div class="media-frame yt">
          <YouTubeFacade
            src="https://www.youtube.com/embed/videoseries?list=PLr4sdvgtCCMcfSZHuTscc1YX61tsUFaJt"
            title="Performance footage on YouTube"
          />
        </div>
        <figcaption><strong>Performance footage</strong> &mdash; clips from recent shows and sessions.</figcaption>
      </figure>
    </div>
    <p class="epk-link">More about me at <a href="https://www.jva-music.com" target="_blank" rel="noopener">jva-music.com</a>.</p>
  </div>
</section>

<!-- FAQ -->
<section aria-labelledby="faqTitle">
  <div class="wrap">
    <div class="section-head">
      <span class="section-tag">Good to know</span>
      <h2 id="faqTitle">Frequently asked questions.</h2>
      <span class="section-rule" aria-hidden="true"></span>
    </div>
    <div class="faq-list">
      <details>
        <summary>What's your cancellation policy?</summary>
        <div class="faq-body">24 hours notice, please. Bulk packs are non-refundable but fully reschedulable with 24h notice. Illness exceptions always apply, just let me know. If I have to cancel late on you, your next lesson is on me.</div>
      </details>
      <details>
        <summary>Do you teach beginners?</summary>
        <div class="faq-body">Yes: K&ndash;12 and adults. Most of my students start as beginners, and there's nothing to "catch up on" before lesson one.</div>
      </details>
      <details>
        <summary>Do you offer virtual lessons?</summary>
        <div class="faq-body">Yes, over Zoom. Same rate as in-person at my studio. It works great once we sort out a basic mic and camera setup, and I'll walk you through that on our first call.</div>
      </details>
      <details>
        <summary>What styles do you teach?</summary>
        <div class="faq-body">Rock, jazz, funk, Latin, and popular music more broadly. I cover reading and ear training, rudiments, technique, and sound on the kit. We'll shape the curriculum to your goals.</div>
      </details>
      <details>
        <summary>Where are you located?</summary>
        <div class="faq-body">My studio is in the South Wedge neighborhood of Rochester, NY (14620) &mdash; close to Park Ave, Highland Park, the East End, Mt. Hope, and Swillburg, and a short drive from Pittsford and Brighton. The exact address is shared after booking. I also do house calls (see pricing) and virtual lessons over Zoom.</div>
      </details>
    </div>
  </div>
</section>
</main>

<!-- FINAL CTA BAND -->
<section class="cta-band" aria-label="Request your half-price first lesson">
  <div class="cta-band-inner">
    <h2>Your first lesson, half off.</h2>
    <p>Just $25 for an hour. Try a real lesson before committing &mdash; see if we click.</p>
    <a class="btn btn-primary" data-cta href="/book" onclick="gtag('event', 'lesson_booking_cta_click', { location: 'cta_band' })">Request My Half-Price Lesson</a>
  </div>
</section>

</Layout>