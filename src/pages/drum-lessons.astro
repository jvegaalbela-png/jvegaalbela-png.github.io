---
import '../styles/lessons.css';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Drum Lessons in Rochester, NY — Jacobo Vega-Albela"
  description="Drum lessons in Rochester, NY with Jacobo Vega-Albela. Eastman MM, 10+ years teaching all ages and levels. Your first lesson is half off."
  themeColor="#091528"
>
<main>
<!-- HERO -->
<section class="hero" aria-labelledby="heroTitle">
  <div class="wrap">
    <div class="hero-text">
      <p class="hero-eyebrow">Private drum instruction</p>
      <h1 id="heroTitle">Drum Lessons in <em>Rochester, NY</em></h1>
      <p class="hero-sub">Personalized instruction for every age and skill level.</p>
      <ul class="chips" aria-label="Credentials">
        <li class="chip"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M3 8.5l3.2 3.2L13 5"/></svg>Master's, Eastman School of Music</li>
        <li class="chip"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M3 8.5l3.2 3.2L13 5"/></svg>10+ years teaching</li>
        <li class="chip"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M3 8.5l3.2 3.2L13 5"/></svg>All ages &amp; levels</li>
      </ul>
      <p class="hero-price"><strong>$50/hr</strong> &middot; <strong>$30/30min</strong> &nbsp;&middot;&nbsp; <span class="hero-price-promo">First lesson half off</span></p>
      <form id="lesson-form" class="hero-form" novalidate>
        <div class="hero-form-row">
          <div class="hero-form-field">
            <label for="hf-name">Name</label>
            <input type="text" id="hf-name" name="name" required data-fs-field />
            <span class="hero-form-error" data-fs-error="name"></span>
          </div>
          <div class="hero-form-field">
            <label for="hf-email">Email</label>
            <input type="email" id="hf-email" name="email" required data-fs-field />
            <span class="hero-form-error" data-fs-error="email"></span>
          </div>
        </div>
        <div class="hero-form-field">
          <label for="hf-message">Message <span class="optional">(optional)</span></label>
          <textarea id="hf-message" name="message" rows="2" data-fs-field></textarea>
          <span class="hero-form-error" data-fs-error="message"></span>
        </div>
        <div class="hero-form-actions">
          <button type="submit" class="btn btn-primary" data-fs-submit-btn>Book Your Half-Price Lesson</button>
          <a class="tel-link" href="tel:+15858024247" aria-label="Text or call 5 8 5, 8 0 2, 4 2 4 7">or text/call (585) 802-4247</a>
        </div>
        <div class="hero-form-success" data-fs-success>Thank you! I'll be in touch ASAP.</div>
        <div class="hero-form-error-summary" data-fs-error></div>
      </form>
      <p class="trust-line">Google Business Screened &nbsp;·&nbsp; Background-checked &amp; verified</p>
    </div>
    <figure class="hero-img">
      <img src="/DSC04813.webp" alt="Jacobo Vega-Albela holding a cymbal overhead — black-and-white portrait" width="1000" height="1500" fetchpriority="high">
    </figure>
  </div>
</section>

<!-- TESTIMONIALS -->
<section aria-labelledby="testimonialsTitle">
  <div class="wrap">
    <div class="section-head">
      <span class="section-tag">What students say</span>
      <h2 id="testimonialsTitle">Real wins, real students.</h2>
      <span class="section-rule" aria-hidden="true"></span>
    </div>
    <div class="testimonials-grid">
      <figure class="tcard">
        <blockquote>I had an audition for a jazz camp and decided to have a lesson with Jacobo. In one lesson he helped me improve so much, and I ended up getting into the camp. Highly recommended!</blockquote>
        <figcaption>&mdash; <strong>Will</strong>, college student</figcaption>
      </figure>
      <figure class="tcard">
        <blockquote>I got into the conservatory in Brussels! Thank you so much for all your support &mdash; I learned a lot from you.</blockquote>
        <figcaption>&mdash; <strong>Annie</strong>, music school graduate</figcaption>
      </figure>
      <figure class="tcard">
        <blockquote>My experience working with Jacobo was great. The exercises he writes really helped me with my flow. He is a drummer first and a teacher second, so everything he teaches comes from a practical base of knowledge and mastery.</blockquote>
        <figcaption>&mdash; <strong>Joseph</strong>, hobbyist</figcaption>
      </figure>
    </div>
  </div>
</section>

<!-- PRICING -->
<section aria-labelledby="pricingTitle">
  <div class="wrap">
    <div class="section-head">
      <span class="section-tag">Rates &amp; packages</span>
      <h2 id="pricingTitle">Transparent pricing, no surprises.</h2>
      <span class="section-rule" aria-hidden="true"></span>
    </div>
    <p class="promo-banner"><strong>New students</strong> 50% off your first lesson.</p>
    <div class="pricing-grid">
      <div class="pcard featured">
        <span class="pcard-tag">Most popular</span>
        <h3>Standard rate</h3>
        <p class="price">$50 <small>/ 60 min</small></p>
        <p class="price">$30 <small>/ 30 min</small></p>
        <p>At my home studio in Rochester, or virtual over Zoom &mdash; same rate either way.</p>
      </div>
      <div class="pcard">
        <span class="pcard-tag">4-lesson pack</span>
        <h3>Save ~10%</h3>
        <p class="price">$180 <small>/ four 60-min</small></p>
        <p class="price">$100 <small>/ four 30-min</small></p>
        <p>Steady momentum, slightly better price. Reschedulable with 24h notice.</p>
      </div>
      <div class="pcard">
        <span class="pcard-tag">House calls</span>
        <h3>I come to you</h3>
        <p class="price">Standard <small>+ $0.75/min commute</small></p>
        <p>Round-trip travel time billed transparently &mdash; ideal for younger students.</p>
      </div>
      <div class="pcard">
        <span class="pcard-tag">Collegiate</span>
        <h3>Student discount</h3>
        <p class="price">3 + 1<small> &nbsp;at 50% off</small></p>
        <p>Book three lessons at full price, get the 4th half off. Proof of enrollment required.</p>
      </div>
      <div class="pcard">
        <span class="pcard-tag">K&ndash;12 special</span>
        <h3>Back-to-school</h3>
        <p class="price">Buy 5, get 1<small> free</small></p>
        <p>Runs Jul&ndash;Sep and Jan&ndash;Mar. Great for kids building a habit around the school year.</p>
      </div>
      <div class="pcard">
        <span class="pcard-tag">Referral bonus</span>
        <h3>Bring a friend</h3>
        <p class="price">Both get 1<small> free lesson</small></p>
        <p>Refer a student. Once they complete 3 lessons, you both get a free lesson on me.</p>
      </div>
    </div>
    <p class="pricing-fineprint">Bulk packs are non-refundable but fully reschedulable with 24 hours notice. Illness exceptions always apply.</p>
    <div class="mid-cta">
      <p><strong>Not sure which option fits?</strong> Try a half-price first lesson &mdash; drum with me, then decide.</p>
      <a class="btn btn-outline" data-cta href="mailto:jacobovamusic@gmail.com?subject=Half-Price%20First%20Lesson&amp;body=Hi%20Jacobo%2C%0A%0AI%27d%20like%20to%20book%20my%20half-price%20first%20lesson.%20A%20bit%20about%20me%3A%0A%0A-%20Name%3A%20%0A-%20Age%2Flevel%3A%20%0A-%20Goals%3A%20%0A%0AThanks%21">Book Your Half-Price Lesson</a>
    </div>
  </div>
</section>

<!-- ABOUT -->
<section aria-labelledby="aboutTitle">
  <div class="wrap">
    <div class="section-head">
      <span class="section-tag">About me</span>
      <h2 id="aboutTitle">Why study with me.</h2>
      <span class="section-rule" aria-hidden="true"></span>
    </div>
    <div class="about-grid">
      <div class="about-text">
        <h3>Clarity, honest feedback, steady wins.</h3>
        <p>I help students find their voice with assignments tailored to their individual needs &mdash; and I get results. I teach K&ndash;12 and adults, beginners through advanced, in rock, jazz, funk, Latin, and other popular styles.</p>
        <p>Whether you're picking up sticks for the first time or preparing for a conservatory audition, the path forward is the same: clarity about what to practice, honest feedback, and steady wins. We figure out where you want to go, then build the habits to get you there.</p>
        <p>I'm a working drummer first and a teacher second. Everything I assign comes from a practical base of knowledge &mdash; the same things I'm using on stage and in the studio.</p>
      </div>
      <div class="about-bg">
        <h3>Background</h3>
        <ul class="bg-list">
          <li><strong>Education</strong>MM, Jazz Studies &amp; Contemporary Media &mdash; Eastman School of Music (2022, Schirmer Prize in Jazz Performance) &middot; BM, Classical Percussion Performance &mdash; New Mexico State University (2019, Crimson Scholar) &middot; Betty Carter's Jazz Ahead alumnus (2023)</li>
          <li><strong>Teaching</strong>Private instructor 2015&ndash;present &middot; Lecture-style classes on drumset styles at Eastman &middot; All ages and levels</li>
          <li><strong>Performance</strong>Western New York Big Band, Las Cruces Symphony Orchestra, The Swooners, Silver Arrow, Trio 55, Brendan Lanighan Octet &middot; Festivals: Rochester International Jazz Festival, Burlington Discover Jazz Festival, Las Cruces Juneteenth Jazz Festival</li>
        </ul>
        <p class="press-line"><strong>As featured in</strong>Rochester City Magazine &middot; Las Cruces Bulletin &middot; Bob Osborne's <em>Different Noises</em> &middot; WMSE, WFMU, KURU, KOWS-LP</p>
      </div>
    </div>
  </div>
</section>

<!-- LISTEN -->
<section aria-labelledby="listenTitle">
  <div class="wrap">
    <div class="section-head">
      <span class="section-tag">Hear me play</span>
      <h2 id="listenTitle">What my playing sounds like.</h2>
      <span class="section-rule" aria-hidden="true"></span>
    </div>
    <div class="listen-grid">
      <figure class="media media-bc">
        <div class="media-frame bc">
          <iframe loading="lazy" title="Un-Belonging on Bandcamp" src="https://bandcamp.com/EmbeddedPlayer/album=2556455061/size=large/bgcol=ffffff/linkcol=0687f5/tracklist=false/transparent=true/" seamless><a href="https://577records.bandcamp.com/album/un-belonging">Un-Belonging by Jacobo Vega-Albela</a></iframe>
        </div>
        <figcaption><strong>Un-Belonging</strong> &mdash; my debut album on 577 Records (2025).</figcaption>
      </figure>
      <figure class="media">
        <div class="media-frame yt">
          <iframe loading="lazy" title="Performance footage on YouTube" src="https://www.youtube.com/embed/videoseries?list=PLr4sdvgtCCMcfSZHuTscc1YX61tsUFaJt" allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        </div>
        <figcaption><strong>Performance footage</strong> &mdash; clips from recent shows and sessions.</figcaption>
      </figure>
    </div>
    <p class="epk-link">More about me at <a href="https://www.jva-music.com" target="_blank" rel="noopener">jva-music.com</a>.</p>
  </div>
</section>

<!-- FAQ -->
<section aria-labelledby="faqTitle">
  <div class="wrap">
    <div class="section-head">
      <span class="section-tag">Good to know</span>
      <h2 id="faqTitle">Frequently asked questions.</h2>
      <span class="section-rule" aria-hidden="true"></span>
    </div>
    <div class="faq-list">
      <details>
        <summary>What's your cancellation policy?</summary>
        <div class="faq-body">24 hours notice, please. Bulk packs are non-refundable but fully reschedulable with 24h notice. Illness exceptions always apply, just let me know. If I have to cancel late on you, your next lesson is on me.</div>
      </details>
      <details>
        <summary>Do you teach beginners?</summary>
        <div class="faq-body">Yes: K&ndash;12 and adults. Most of my students start as beginners, and there's nothing to "catch up on" before lesson one.</div>
      </details>
      <details>
        <summary>Do you offer virtual lessons?</summary>
        <div class="faq-body">Yes, over Zoom. Same rate as in-person at my studio. It works great once we sort out a basic mic and camera setup, and I'll walk you through that on our first call.</div>
      </details>
      <details>
        <summary>What styles do you teach?</summary>
        <div class="faq-body">Rock, jazz, funk, Latin, and popular music more broadly. I cover reading and ear training, rudiments, technique, and sound on the kit. We'll shape the curriculum to your goals.</div>
      </details>
      <details>
        <summary>Where are you located?</summary>
        <div class="faq-body">Rochester, NY. The studio address is shared after booking. I also do house calls (see pricing) and virtual lessons over Zoom.</div>
      </details>
    </div>
  </div>
</section>
</main>

<!-- FINAL CTA BAND -->
<section class="cta-band" aria-label="Book your half-price first lesson">
  <div class="cta-band-inner">
    <h2>Ready to start?</h2>
    <p>Your first lesson is half off &mdash; just $25 for an hour. See if we click before committing further.</p>
    <a class="btn btn-primary" data-cta href="mailto:jacobovamusic@gmail.com?subject=Half-Price%20First%20Lesson&amp;body=Hi%20Jacobo%2C%0A%0AI%27d%20like%20to%20book%20my%20half-price%20first%20lesson.%20A%20bit%20about%20me%3A%0A%0A-%20Name%3A%20%0A-%20Age%2Flevel%3A%20%0A-%20Goals%3A%20%0A%0AThanks%21">Book Your Half-Price Lesson</a>
  </div>
</section>

<style>
  .hero-price {
    font-size: .9375rem;
    line-height: 1.4;
    color: rgba(245, 243, 238, 0.85);
    margin: -0.25rem 0 0.75rem;
    letter-spacing: .01em;
  }
  .hero-price strong {
    color: var(--cream);
    font-weight: 600;
  }
  .hero-price-promo {
    color: var(--orange-lt);
    font-weight: 500;
  }

  .hero-form {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 480px;
    margin: 0.5rem 0 0.75rem;
  }
  .hero-form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .hero-form-field {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .hero-form-field label {
    font-size: .6875rem;
    font-weight: 600;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: rgba(245, 243, 238, 0.78);
  }
  .hero-form-field .optional {
    font-weight: 400;
    letter-spacing: .04em;
    text-transform: none;
    color: rgba(245, 243, 238, 0.5);
  }
  .hero-form-field input,
  .hero-form-field textarea {
    background: rgba(245, 243, 238, 0.06);
    border: 1px solid rgba(245, 243, 238, 0.22);
    color: var(--cream);
    font: 400 15px/1.5 var(--sans);
    padding: 10px 12px;
    border-radius: 2px;
    width: 100%;
    transition: border-color .18s, background .18s;
  }
  .hero-form-field textarea {
    resize: vertical;
    min-height: 56px;
  }
  .hero-form-field input:focus,
  .hero-form-field textarea:focus {
    outline: none;
    border-color: var(--orange-lt);
    background: rgba(245, 243, 238, 0.1);
  }
  .hero-form-field input[aria-invalid="true"],
  .hero-form-field textarea[aria-invalid="true"] {
    border-color: #e87a7a;
  }
  .hero-form-error {
    font-size: 12px;
    color: #ff9b9b;
    min-height: 1em;
    line-height: 1.3;
  }
  .hero-form-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-top: 4px;
  }
  .hero-form-success,
  .hero-form-error-summary {
    display: none;
    padding: 12px 14px;
    color: var(--cream);
    font-size: 14px;
    line-height: 1.5;
  }
  .hero-form-success[data-fs-active] {
    display: block;
    background: rgba(141, 184, 32, 0.16);
    border-left: 3px solid var(--lime);
  }
  .hero-form-error-summary[data-fs-active] {
    display: block;
    background: rgba(232, 101, 10, 0.16);
    border-left: 3px solid var(--orange);
  }
  @media (max-width: 560px) {
    .hero-form-row { grid-template-columns: 1fr; }
  }
</style>

<script is:inline>
  window.formspree = window.formspree || function () { (formspree.q = formspree.q || []).push(arguments); };
  formspree('initForm', { formElement: '#lesson-form', formId: 'xjglgjjj', useDefaultStyles: false });
</script>
<script is:inline src="https://unpkg.com/@formspree/ajax@1" defer></script>

</Layout>