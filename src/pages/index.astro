---
import '../styles/global.css';
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import JsonLd from '../components/JsonLd.astro';
import albumArt from '../assets/album-art.jpg';
import press04695 from '../assets/DSC04695.webp';
import press04717 from '../assets/DSC04717.webp';
import press04734 from '../assets/DSC04734.webp';
import press04790 from '../assets/DSC04790.webp';
import press04813 from '../assets/DSC04813.webp';
import press04880 from '../assets/DSC04880.webp';
import press05009 from '../assets/DSC05009.webp';
// ?url returns the hashed file URL after Vite processes the woff2,
// so we can preload it to avoid the FOUT swap reflow on body text.
import interLatinUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

const carouselSizes = '(max-width: 700px) 100vw, 680px';
const carouselWidths = [400, 540, 680, 800, 1080, 1360];
import {
  SITE_URL,
  PERSON,
  PERSON_ID,
  ORGANIZATION,
  ORGANIZATION_ID,
  WEBSITE,
  ALBUM_ID,
} from '../data/schema';

// Optimized JPG for OG/Twitter cards and JSON-LD — social scrapers want
// a stable URL in a widely-supported format.
const albumArtSocial = await getImage({
  src: albumArt,
  format: 'jpg',
  width: 1200,
  height: 1200,
});
const albumArtSocialUrl = new URL(albumArtSocial.src, SITE_URL).toString();

// Hero album-art display sizes. Quality dropped from default ~80 to 65
// since the image only displays at 280-560px, where the difference is
// imperceptible. Tried preloading via <link rel="preload" imagesrcset>
// but it competed with other early-load bytes and dropped Speed Index
// without helping LCP (image was already small enough that fetch time
// wasn't the bottleneck).
const lcpQuality = 65;
const lcpWidths = [280, 420, 480, 560];
const lcpImageSizes = '(max-width: 860px) 240px, 280px';

const tracks = [
  'Moonbeams',
  'To Hope',
  'Plonqs',
  '390S',
  'I Fall In Love Too Easily',
  'Carousel',
  'High Priest',
  'Birthday Week',
];

const album = {
  '@type': 'MusicAlbum',
  '@id': ALBUM_ID,
  name: 'Un-Belonging',
  alternateName: '"Un-Belonging"',
  url: 'https://577records.bandcamp.com/album/un-belonging',
  image: albumArtSocialUrl,
  datePublished: '2025-05',
  numTracks: tracks.length,
  albumProductionType: 'https://schema.org/StudioAlbum',
  albumReleaseType: 'https://schema.org/AlbumRelease',
  description:
    "Debut album from jazz drummer and composer Jacobo Vega-Albela. Released on 577 Records in May 2025 — nine tracks across trio, quartet, and quintet settings.",
  recordLabel: {
    '@type': 'Organization',
    name: '577 Records',
    url: 'https://www.577records.com/',
  },
  byArtist: {
    '@type': 'MusicGroup',
    name: 'Jacobo Vega-Albela',
    member: [
      {
        '@type': 'OrganizationRole',
        roleName: 'drums, composition & arrangement',
        member: { '@id': PERSON_ID },
      },
      {
        '@type': 'OrganizationRole',
        roleName: 'piano',
        member: { '@type': 'Person', name: 'Leon Hsu' },
      },
      {
        '@type': 'OrganizationRole',
        roleName: 'bass',
        member: { '@type': 'Person', name: 'Zach Walgren' },
      },
      {
        '@type': 'OrganizationRole',
        roleName: 'alto & tenor saxophones',
        member: { '@type': 'Person', name: 'Jordan Lerner' },
      },
      {
        '@type': 'OrganizationRole',
        roleName: 'tenor saxophone',
        member: { '@type': 'Person', name: 'Adam Aronesty' },
      },
    ],
  },
  track: tracks.map((name, i) => ({
    '@type': 'MusicRecording',
    position: i + 1,
    name,
    byArtist: { '@id': PERSON_ID },
    inAlbum: { '@id': ALBUM_ID },
  })),
};

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    PERSON,
    ORGANIZATION,
    {
      ...WEBSITE,
      mainEntity: { '@id': PERSON_ID },
    },
    {
      '@type': 'WebPage',
      '@id': `${SITE_URL}/#webpage`,
      url: SITE_URL,
      name: 'Jacobo Vega-Albela — Home',
      isPartOf: { '@id': WEBSITE['@id'] },
      about: { '@id': PERSON_ID },
      primaryImageOfPage: albumArtSocialUrl,
    },
    album,
  ],
};
---

<Layout title="Jacobo Vega-Albela — Home"
  description="Jacobo Vega-Albela — jazz drummer, composer, and music educator based in Rochester, NY. Debut album 'Un-Belonging' out on 577 Records (May 2025)."
  image={{
    url: albumArtSocial.src,
    width: 1200,
    height: 1200,
    type: 'image/jpeg',
    alt: "Album cover for 'Un-Belonging' by Jacobo Vega-Albela — released on 577 Records, May 2025",
  }}>
  <JsonLd slot="head" data={graph} />
  <link
    slot="head"
    rel="preload"
    as="font"
    type="font/woff2"
    href={interLatinUrl}
    crossorigin
  />
<main>
<!-- ══════════════════════════════════════════ HERO -->
<header class="hero">
  <div class="hero-left">
    <h1 class="hero-name">Jacobo <br><em>Vega-Albela</em></h1>
    <div class="hero-role">Jazz Drummer &nbsp;·&nbsp; Composer &nbsp;·&nbsp; Bandleader</div>
    <div class="hero-links">
      <a class="hero-link-btn primary" href="https://577records.bandcamp.com/album/un-belonging" target="_blank" rel="noopener">
        <span class="icon">▶</span><span class="label-full">Listen to the Album</span><span class="label-short">Listen</span>
      </a>
      <a class="hero-link-btn" href="https://youtube.com/playlist?list=PLr4sdvgtCCMcfSZHuTscc1YX61tsUFaJt" target="_blank" rel="noopener">
        <span class="icon">▶</span><span class="label-full">Watch on YouTube</span><span class="label-short">Watch</span>
      </a>
      <a class="hero-link-btn" href="https://linktr.ee/jvegaalbela" target="_blank" rel="noopener">
        <span class="icon">↗</span><span class="label-full">All Links · Linktree</span><span class="label-short">Links</span>
      </a>
    </div>
  </div>

  <div class="hero-right">
    <div class="album-art-wrap">
      <Image
        src={albumArt}
        alt="Un-Belonging — Album Art"
        width={560}
        height={560}
        widths={lcpWidths}
        sizes={lcpImageSizes}
        quality={lcpQuality}
        loading="eager"
        fetchpriority="high"
      />
      <div class="album-art-label">
        <span class="art-eyebrow">Debut Album</span>
        <span class="art-title">"Un-Belonging"</span>
        <span class="art-sub">577 Records · May 2025</span>
      </div>
    </div>
  </div>
</header>

<!-- ══════════════════════════════════════════ CONTACT STRIP -->
<div class="contact-strip">
  <a href="mailto:jacobovamusic@gmail.com">jacobovamusic@gmail.com</a>
  <span class="sep">|</span>
  <a href="tel:+15858024247">(585) 802-4247</a>
  <span class="sep cs-desktop">|</span>
  <a class="cs-desktop" href="https://music.apple.com/us/artist/jacobo-vega-albela/1503080956" target="_blank" rel="noopener">Apple Music</a>
  <span class="sep cs-desktop">|</span>
  <a class="cs-desktop" href="https://open.spotify.com/artist/6hX0MkgDOLuteSG1nsUqCV?si=kQrIwx_JTISp67Oe8KHd2g" target="_blank" rel="noopener">Spotify</a>
  <span class="sep cs-desktop">|</span>
  <a class="cs-desktop" href="https://www.instagram.com/jacobo.vegaalbela?igsh=MWQ1NnlzYXIzYzE4dw%3D%3D&amp;utm_source=qr" target="_blank" rel="noopener">@jacobo.vegaalbela</a>
</div>

<div class="wrapper">

  <!-- ════════════════════════════════════════ BIOGRAPHY -->
  <section>
    <div class="section-header">
      <span class="section-tag">Biography</span>
      <div class="section-rule"></div>
    </div>
    <div class="bio-text">
      <p>
        Based in Rochester, New York, Jacobo Vega-Albela is a jazz drummer and composer
        dedicated to bringing life to music — whether by composing new works, programming
        interesting pieces from the standard repertoire, or seeking out collaborators to
        create fresh and interesting musical chemistry.
      </p>
      <p>
        In 2025, he released his debut album
        <a href="https://577records.bandcamp.com/album/un-belonging" target="_blank" rel="noopener"><em>"Un-Belonging"</em></a>
        with <a href="https://www.577records.com/" target="_blank" rel="noopener">577 Records</a>.
        The album received press in
        <a href="https://donos.home.blog/2025/07/04/co-w-jazzie-piszczy-sezon-3-odcinek-24/" target="_blank" rel="noopener"><em>Donos Kulturalny</em></a>,
        Bob Osborne's
        <a href="https://www.allaboutjazz.com/new-releases-record-store-day-specials-and-ivo-perelman-on-leo-records-ivo-perelman" target="_blank" rel="noopener"><em>Different Noises</em></a>,
        the <a href="https://www.lascrucesbulletin.com/stories/las-cruces-high-school-alum-has-a-record,128983" target="_blank" rel="noopener"><em>Las Cruces Bulletin</em></a>,
        <a href="https://www.roccitymag.com/music/album-review-un-belonging/" target="_blank" rel="noopener"><em>Rochester City Magazine</em></a>,
        and <a href="https://jazzrochester.com/2025/08/04/new-roc-cds-jacobo-vega-albela-un-belonging/" target="_blank" rel="noopener"><em>Jazz Rochester</em></a>,
        and has been aired on 91.7 FM <a href="https://wmse.org/program/alternating-currents/" target="_blank" rel="noopener">WMSE</a>,
        91.1 FM <a href="https://www.wfmu.org/playlists/shows/151655" target="_blank" rel="noopener">WFMU</a>,
        89.1 FM <a href="https://kuru891.org" target="_blank" rel="noopener">KURU</a>, 92.5 FM <a href="https://kows92-5.org" target="_blank" rel="noopener">KOWS-LP</a>, and 93.1 FM
        <a href="https://cod.ckcufm.com/programs/639/71775.html" target="_blank" rel="noopener">CKCU</a>.
        A subsequent release tour expanded his audience to venues in New York City,
        Connecticut, and New Jersey.
      </p>
      <p>
        A multi-disciplinary background has earned Jacobo degrees in Classical Percussion
        (B.M., New Mexico State University) and Jazz Studies and Contemporary Media
        (M.M., Eastman School of Music). He was a 2023 participant in Betty Carter's Jazz Ahead,
        performing his original composition <em>"Birthday Week"</em> at the Kennedy Center's
        Millennium Stage and alongside Melissa Aldana at the Burlington Discover Jazz Festival.
      </p>
      <p>
        He has performed at the Rochester International Jazz Festival, the Burlington Vermont
        Discover Jazz Festival, the Geneva Jazz Festival, and the Las Cruces Juneteenth
        Jazz Festival. He performs regularly throughout Upstate New York at Pausa Art House,
        The Trestle, and The Little Theatre Cafe.
      </p>
    </div>

    <!-- Clean inline tags replace the old segmented sidebar cards -->
    <div class="bio-highlights">
      <span class="bio-tag c-blue"><span class="dot"></span>577 Records</span>
      <span class="bio-tag c-blue"><span class="dot"></span>Eastman School of Music</span>
      <span class="bio-tag c-blue"><span class="dot"></span>Jazz Ahead Alumnus</span>
      <span class="bio-tag"><span class="dot"></span>Rochester International Jazz Festival</span>
      <span class="bio-tag"><span class="dot"></span>Burlington Discover Jazz Festival</span>
      <span class="bio-tag"><span class="dot"></span>Geneva Jazz Festival</span>
      <span class="bio-tag"><span class="dot"></span>Las Cruces Juneteenth Jazz Festival</span>
      <span class="bio-tag lime"><span class="dot"></span>Pausa Art House</span>
      <span class="bio-tag lime"><span class="dot"></span>The Trestle</span>
      <span class="bio-tag lime"><span class="dot"></span>The Little Theatre Cafe</span>
      <span class="bio-tag lime"><span class="dot"></span>NYC · CT · NJ (touring)</span>
    </div>
  </section>

  <!-- ════════════════════════════════════════ PRESS & RADIO -->
  <section>
    <div class="section-header">
      <span class="section-tag">Press &amp; Radio</span>
      <div class="section-rule"></div>
    </div>
    <div class="press-grid">
      <div>
        <div class="press-col-label">Print &amp; Online Coverage</div>
        <ul class="press-list">
          <li><a href="https://donos.home.blog/2025/07/04/co-w-jazzie-piszczy-sezon-3-odcinek-24/" target="_blank" rel="noopener"><em>Donos Kulturalny</em></a></li>
          <li>Bob Osborne's <a href="https://www.allaboutjazz.com/new-releases-record-store-day-specials-and-ivo-perelman-on-leo-records-ivo-perelman" target="_blank" rel="noopener"><em>Different Noises</em></a></li>
          <li><a href="https://www.lascrucesbulletin.com/stories/las-cruces-high-school-alum-has-a-record,128983" target="_blank" rel="noopener"><em>Las Cruces Bulletin</em></a></li>
          <li><a href="https://www.roccitymag.com/music/album-review-un-belonging/" target="_blank" rel="noopener"><em>Rochester City Magazine</em></a></li>
