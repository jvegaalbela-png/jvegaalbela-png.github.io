<script is:inline>
  // ─── State ───────────────────────────────────────────────────────────────────
  const state = {
    bpm: 120,
    beatsPerMeasure: 4,
    beatUnit: 4,
    subdivision: 1,
    beats: [],        // 'accent' | 'normal' | 'soft' | 'mute'
    isPlaying: false,
    currentBeat: -1,
    currentSub: 0,
  };

  // ─── Advanced Mode State ──────────────────────────────────────────────────────
  const adv = {
    enabled: false,
    gapEnabled: false, gapPlay: 2, gapSilent: 2,
    randomMuteEnabled: false, randomMutePct: 30,
    formEnabled: false,
    form: [],   // [{ beats, unit, states[] }]
  };

  let soundMode = 'electronic'; // 'electronic' | 'clave'

  // Scheduler-side advanced state (runs SCHEDULE_AHEAD_S ahead of audio time)
  let advGapPhase = 'play';   // 'play' | 'silent'
  let advGapCount = 0;
  let advFormIdx = 0;

  // ─── Audio ───────────────────────────────────────────────────────────────────
  let audioCtx = null;
  let nextNoteTime = 0.0;
  let schedulerTimer = null;
  let schedulerBeat = 0;
  let schedulerSub = 0;
  const pendingVisuals = [];

  const LOOKAHEAD_MS = 25;
  const SCHEDULE_AHEAD_S = 0.1;

  function getAudioCtx() {
    if (!audioCtx) {
      audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    }
    if (audioCtx.state === 'suspended') audioCtx.resume();
    return audioCtx;
  }

  // iOS silent-switch bypass.
  //
  // Web Audio on iOS Safari outputs through the "ringer" audio channel,
  // which the physical silent switch mutes — so the click goes silent
  // even though media volume is up. HTML5 <audio> elements use the
  // "media" channel, which the silent switch doesn't affect. Playing
  // a tiny silent <audio> loop in parallel forces iOS to route the
  // entire page (Web Audio included) through the media channel, so
  // the metronome plays at media volume regardless of the switch.
  //
  // Scoped to iOS — Android Web Audio already uses the media channel.
  // The audio.play() call has to originate from a user gesture, which
  // is why this is called from startMetronome (the play button's click
  // handler) rather than from getAudioCtx (called by the scheduler).
  let iosSilentBypassEl = null;
  function ensureIOSSilentBypass() {
    const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) ||
      (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
    if (!isIOS) return;

    if (!iosSilentBypassEl) {
      // Construct a tiny silent WAV blob inline — 0.5 s of 16-bit mono
      // silence at 8 kHz. No external file needed, ~8 KB.
      const sampleRate = 8000;
      const numFrames = sampleRate / 2;
      const dataSize = numFrames * 2;
      const buf = new ArrayBuffer(44 + dataSize);
      const dv = new DataView(buf);
      const writeStr = (off, s) => {
        for (let i = 0; i < s.length; i++) dv.setUint8(off + i, s.charCodeAt(i));
      };
      writeStr(0, 'RIFF');                    dv.setUint32(4, 36 + dataSize, true);
      writeStr(8, 'WAVE');                    writeStr(12, 'fmt ');
      dv.setUint32(16, 16, true);             dv.setUint16(20, 1, true);
      dv.setUint16(22, 1, true);              dv.setUint32(24, sampleRate, true);
      dv.setUint32(28, sampleRate * 2, true); dv.setUint16(32, 2, true);
      dv.setUint16(34, 16, true);             writeStr(36, 'data');
      dv.setUint32(40, dataSize, true);
      // Data is already zeros — that's the silence.

      iosSilentBypassEl = document.createElement('audio');
      iosSilentBypassEl.loop = true;
      iosSilentBypassEl.preload = 'auto';
      iosSilentBypassEl.playsInline = true;
      iosSilentBypassEl.src = URL.createObjectURL(new Blob([buf], { type: 'audio/wav' }));
    }
    iosSilentBypassEl.play().catch(() => {});
  }

  // ─── Sound Library ───────────────────────────────────────────────────────────
  function scheduleClick(time, type) {
    if (type === 'mute') return;
    if (soundMode === 'clave') { scheduleClave(time, type); return; }
    scheduleElectronic(time, type);
  }

  function scheduleElectronic(time, type) {
    const ctx = getAudioCtx();
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    const filter = ctx.createBiquadFilter();
    osc.connect(filter); filter.connect(gain); gain.connect(ctx.destination);
    filter.type = 'bandpass';
    if (type === 'accent') {
      osc.frequency.value = 1050; filter.frequency.value = 1050; filter.Q.value = 0.6;
      gain.gain.setValueAtTime(0, time);
      gain.gain.linearRampToValueAtTime(1.0, time + 0.001);
      gain.gain.exponentialRampToValueAtTime(0.001, time + 0.12);
    } else if (type === 'beat') {
      osc.frequency.value = 800; filter.frequency.value = 800; filter.Q.value = 0.5;
      gain.gain.setValueAtTime(0, time);
      gain.gain.linearRampToValueAtTime(0.75, time + 0.001);
      gain.gain.exponentialRampToValueAtTime(0.001, time + 0.09);
    } else if (type === 'soft') {
      osc.frequency.value = 600; filter.frequency.value = 600; filter.Q.value = 0.5;
      gain.gain.setValueAtTime(0, time);
      gain.gain.linearRampToValueAtTime(0.32, time + 0.001);
      gain.gain.exponentialRampToValueAtTime(0.001, time + 0.07);
    } else {
      osc.frequency.value = 1600; filter.frequency.value = 1600; filter.Q.value = 1.2;
      gain.gain.setValueAtTime(0, time);
      gain.gain.linearRampToValueAtTime(0.3, time + 0.001);
      gain.gain.exponentialRampToValueAtTime(0.001, time + 0.05);
    }
    osc.start(time); osc.stop(time + 0.2);
  }

  function scheduleClave(time, type) {
    // 808-style clave: a single sine oscillator tuned high (the
    // common 808 clave sits at 2450 Hz, where it cuts through any
    // mix) with a 0.5 ms exponential attack and a fast exponential
    // decay. No noise body — that's what made the previous version
    // sound wet.
    const ctx = getAudioCtx();
    const freq  = type === 'accent' ? 2700  : type === 'sub' ? 3300  : type === 'soft' ? 1900 : 2450;
    const vol   = type === 'accent' ? 0.85  : type === 'beat' ? 0.55 : type === 'soft' ? 0.25 : 0.2;
    const decay = type === 'sub'    ? 0.025 : type === 'accent' ? 0.08 : type === 'soft' ? 0.04 : 0.06;

    const osc = ctx.createOscillator();
    osc.type = 'sine';
    osc.frequency.value = freq;
    const og = ctx.createGain();
    og.gain.setValueAtTime(0.00001, time);
    og.gain.exponentialRampToValueAtTime(vol, time + 0.0005);
    og.gain.exponentialRampToValueAtTime(0.00001, time + decay);
    osc.connect(og); og.connect(ctx.destination);
    osc.start(time); osc.stop(time + decay + 0.01);
  }

  function getAdvConfig() {
    if (adv.formEnabled && adv.form.length > 0) {
      const e = adv.form[advFormIdx];
      return { beatsPerMeasure: e.beats, beats: e.states, beatUnit: e.unit };
    }
    return { beatsPerMeasure: state.beatsPerMeasure, beats: state.beats, beatUnit: state.beatUnit };
  }

  function scheduler() {
    const ctx = getAudioCtx();

    while (nextNoteTime < ctx.currentTime + SCHEDULE_AHEAD_S) {
      const beat = schedulerBeat;
      const sub  = schedulerSub;
      const time = nextNoteTime;
      const cfg  = getAdvConfig();

      let clickType;
      if (sub === 0) {
        const s = cfg.beats[beat] || 'normal';
        clickType = s === 'mute' ? 'mute' : s === 'accent' ? 'accent' : s === 'soft' ? 'soft' : 'beat';
      } else {
        clickType = 'sub';
      }

      if (adv.gapEnabled && advGapPhase === 'silent') clickType = 'mute';

      if (adv.randomMuteEnabled && sub === 0 && clickType !== 'mute') {
        if (Math.random() < adv.randomMutePct / 100) clickType = 'mute';
      }

      scheduleClick(time, clickType);
      pendingVisuals.push({
        beat, sub, time, clickType,
        formIdx: advFormIdx,
        gapPhase: advGapPhase,
        gapCount: advGapCount,
      });

      // BPM is interpreted as quarter notes per minute (the standard
      // notation convention: ♩ = bpm). The actual tick rate scales by
      // (4 / beatUnit), so an x/8 meter ticks twice as fast as x/4 at
      // the same BPM, x/16 ticks four times as fast, x/2 ticks half as
      // fast, etc.
      nextNoteTime += (60.0 / state.bpm) * (4 / cfg.beatUnit) / state.subdivision;

      schedulerSub++;
      if (schedulerSub >= state.subdivision) {
        schedulerSub = 0;
        schedulerBeat++;
        if (schedulerBeat >= cfg.beatsPerMeasure) {
          schedulerBeat = 0;
          if (adv.gapEnabled) {
            advGapCount++;
            if (advGapPhase === 'play'   && advGapCount >= adv.gapPlay)   { advGapPhase = 'silent'; advGapCount = 0; }
            else if (advGapPhase === 'silent' && advGapCount >= adv.gapSilent) { advGapPhase = 'play';   advGapCount = 0; }
          }
          if (adv.formEnabled && adv.form.length > 0) {
            advFormIdx = (advFormIdx + 1) % adv.form.length;
          }
        }
      }
    }

    schedulerTimer = setTimeout(scheduler, LOOKAHEAD_MS);
  }

  // Screen Wake Lock — keep the device awake while the metronome is running,
  // otherwise the screen sleeping (and on most mobile browsers, the audio
  // context with it) would silence the click. Mobile browsers don't reliably
  // keep Web Audio scheduling alive once the screen is fully off, so the best
  // we can do is prevent the screen from auto-locking during playback.
  let wakeLock = null;
  async function requestWakeLock() {
    if (!('wakeLock' in navigator)) return;
    try {
      wakeLock = await navigator.wakeLock.request('screen');
      wakeLock.addEventListener('release', () => { wakeLock = null; });
    } catch (_) {
      wakeLock = null;
    }
  }
  async function releaseWakeLock() {
    if (!wakeLock) return;
    try { await wakeLock.release(); } catch (_) {}
    wakeLock = null;
  }
  // The OS releases the wake lock when the tab is hidden; re-request it when
  // we come back so the screen stays awake for a long practice session.
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible' && state.isPlaying && !wakeLock) {
      requestWakeLock();
    }
  });

  function startMetronome() {
    const ctx = getAudioCtx();
    ensureIOSSilentBypass();
    state.isPlaying = true;
    schedulerBeat = 0;
    schedulerSub  = 0;
    advGapPhase   = 'play';
    advGapCount   = 0;
    advFormIdx    = 0;
    nextNoteTime  = ctx.currentTime + 0.05;
    pendingVisuals.length = 0;
    scheduler();
    requestAnimationFrame(visualLoop);
    updatePlayButton();
    requestWakeLock();
  }

  function stopMetronome() {
    state.isPlaying = false;
    clearTimeout(schedulerTimer);
    pendingVisuals.length = 0;
    state.currentBeat = -1;
    state.currentSub  = 0;
    applyBeatVisuals(-1, 0, null, 0);
    updatePlayButton();
    updateGapVisual('idle', 0);
    updateFormVisual(-1);
    if (adv.formEnabled && adv.form.length > 0) renderBeatGridForEntry(adv.form[0]);
    releaseWakeLock();
  }

  function togglePlay() {
    state.isPlaying ? stopMetronome() : startMetronome();
  }

  // ─── Visual Loop ─────────────────────────────────────────────────────────────
  function visualLoop() {
    if (!state.isPlaying) return;
    const ctx = getAudioCtx();
    const now = ctx.currentTime;

    while (pendingVisuals.length && pendingVisuals[0].time <= now) {
      const v = pendingVisuals.shift();
      state.currentBeat = v.beat;
      state.currentSub  = v.sub;
      applyBeatVisuals(v.beat, v.sub, v.clickType, v.formIdx);
      if (v.beat === 0 && v.sub === 0) {
        updateGapVisual(v.gapPhase, v.gapCount);
        updateFormVisual(v.formIdx);
      }
    }

    requestAnimationFrame(visualLoop);
  }

  function applyBeatVisuals(beat, sub, clickType, formIdx) {
    document.querySelectorAll('.beat-btn').forEach((el, i) => {
      el.classList.toggle('active', i === beat && sub === 0);
    });

    document.querySelectorAll('.sub-dot').forEach((dot, i) => {
      dot.classList.remove('active', 'active-accent');
      if (i === sub) dot.classList.add(clickType === 'accent' ? 'active-accent' : 'active');
    });

    const flash1 = document.getElementById('beat-flash');
    const flash2 = document.getElementById('beat-flash-2');
    flash1.className = 'beat-flash';
    flash2.className = 'beat-flash';

    if (sub === 0 && clickType !== 'mute') {
      const cls = clickType === 'accent' ? 'on-accent' : clickType === 'soft' ? 'on-soft' : 'on-beat';
      flash1.classList.add(cls);
      flash2.classList.add(cls);
      setTimeout(() => { flash1.className = 'beat-flash'; flash2.className = 'beat-flash'; }, 120);
    }
  }

  // ─── BPM ─────────────────────────────────────────────────────────────────────
  const TEMPO_MARKS = [
    [24,  'Larghissimo'],
    [39,  'Grave'],
    [54,  'Largo'],
    [64,  'Larghetto'],
    [74,  'Adagio'],
    [79,  'Adagietto'],
    [93,  'Andante'],
    [107, 'Andantino'],
    [119, 'Moderato'],
    [129, 'Allegretto'],
    [167, 'Allegro'],
    [179, 'Vivace'],
    [199, 'Presto'],
    [500, 'Prestissimo'],
  ];

  function getTempoName(bpm) {
    for (const [max, name] of TEMPO_MARKS) if (bpm <= max) return name;
    return 'Prestissimo';
  }

  function setBPM(value) {
    state.bpm = Math.max(1, Math.min(500, Math.round(value)));
    document.getElementById('bpm-display').textContent = state.bpm;
    document.getElementById('bpm-slider').value = state.bpm;
    document.getElementById('tempo-name').textContent = getTempoName(state.bpm);
    persistState();
  }

  document.getElementById('bpm-slider').addEventListener('input', e => setBPM(+e.target.value));
  document.getElementById('bpm-minus1').addEventListener('click', () => setBPM(state.bpm - 1));
  document.getElementById('bpm-plus1').addEventListener('click', () => setBPM(state.bpm + 1));
  document.getElementById('bpm-minus5').addEventListener('click', () => setBPM(state.bpm - 5));
  document.getElementById('bpm-plus5').addEventListener('click', () => setBPM(state.bpm + 5));

  const bpmEl = document.getElementById('bpm-display');
  bpmEl.addEventListener('focus', () => {
    const range = document.createRange();
    range.selectNodeContents(bpmEl);
    const sel = window.getSelection();
    sel.removeAllRanges();
    sel.addRange(range);
  });
  bpmEl.addEventListener('blur', () => {
    const val = parseInt(bpmEl.textContent.replace(/\D/g, ''), 10);
    setBPM(isNaN(val) ? 120 : val);
  });
  bpmEl.addEventListener('keydown', e => {
    if (e.key === 'Enter') { e.preventDefault(); bpmEl.blur(); }
    if (e.key === ' ') { e.preventDefault(); togglePlay(); }
    if (!/^[0-9]$/.test(e.key) && !['Backspace','Delete','ArrowLeft','ArrowRight','Tab'].includes(e.key)) {
      e.preventDefault();
    }
  });

  // Tap Tempo — fire on pointerdown so the tap registers when the finger
  // contacts the screen (not on lift), which is what users intuitively time
  // to a beat. Combined with `touch-action: manipulation` on .btn, this also
  // sidesteps mobile double-tap zoom on rapid taps.
  let tapTimes = [];
  function registerTap() {
    const now = Date.now();
    tapTimes.push(now);
    tapTimes = tapTimes.filter(t => now - t < 4000).slice(-8);
    if (tapTimes.length >= 2) {
      const intervals = [];
      for (let i = 1; i < tapTimes.length; i++) intervals.push(tapTimes[i] - tapTimes[i - 1]);
      const avg = intervals.reduce((a, b) => a + b, 0) / intervals.length;
      setBPM(Math.round(60000 / avg));
    }
  }
  const tapBtn = document.getElementById('tap-tempo');
  tapBtn.addEventListener('pointerdown', e => {
    e.preventDefault();
    registerTap();
  });
  // Enter activates the tap button via keyboard. Space is reserved for the
  // global play/stop shortcut, so don't register a tap on Space here.
  tapBtn.addEventListener('keydown', e => {
    if (e.key === 'Enter') {
      e.preventDefault();
      registerTap();
    }
  });

  // ─── Time Signature ───────────────────────────────────────────────────────────
  // Denominators 2, 4, 8, and 16 are the everyday meters (half, quarter,
  // eighth, sixteenth notes). Everything else — whole-note beats (1),
  // 32nd-note beats, and the non-power-of-two "irrational" denominators
  // (3, 5, 6, 7, 9, …) used in contemporary classical and modern jazz —
  // lives under an "Advanced" optgroup so the everyday choices stay
  // un-cluttered at the top of the dropdown.
  const COMMON_UNITS = [2, 4, 8, 16];

  function buildUnitOptions(sel, currentVal) {
    sel.innerHTML = '';
    const common = document.createElement('optgroup');
    common.label = 'Common';
    for (const v of COMMON_UNITS) {
      const o = document.createElement('option');
      o.value = v; o.textContent = v;
      if (v === currentVal) o.selected = true;
      common.appendChild(o);
    }
    sel.appendChild(common);

    const advanced = document.createElement('optgroup');
    advanced.label = 'Advanced';
    for (let i = 1; i <= 32; i++) {
      if (COMMON_UNITS.includes(i)) continue;
      const o = document.createElement('option');
      o.value = i; o.textContent = i;
      if (i === currentVal) o.selected = true;
      advanced.appendChild(o);
    }
    sel.appendChild(advanced);
  }

  function populateUnitSelect(id, currentVal) {
    const sel = document.getElementById(id);
    if (!sel) return;
    buildUnitOptions(sel, currentVal);
  }

  // Compound and odd-meter defaults: the dotted-quarter pulse in 6/8,
  // 9/8, and 12/8, and the common claves in 5/4 (3+2), 5/8 (3+2),
  // 7/4 (4+3), and 7/8 (2+2+3). Beat 1 is the strongest accent; group
  // starts after that are normal; the rest are soft, so the listener
  // hears beat 1, the pulse, and the inner-beat feel layered together.
  // Returns null for meters that should fall back to the simple "accent
  // on 1, normal elsewhere" pattern.
  function defaultBeatsForSig(beats, unit) {
    if (unit === 4) {
      if (beats === 5) return ['accent','soft','soft','normal','soft'];                // 3+2
      if (beats === 7) return ['accent','soft','soft','soft','normal','soft','soft'];  // 4+3
    }
    if (unit === 8) {
      if (beats === 5)  return ['accent','soft','soft','normal','soft'];
      if (beats === 6)  return ['accent','soft','soft','normal','soft','soft'];
      if (beats === 7)  return ['accent','soft','normal','soft','normal','soft','soft'];
      if (beats === 9)  return ['accent','soft','soft','normal','soft','soft','normal','soft','soft'];
      if (beats === 12) return ['accent','soft','soft','normal','soft','soft','normal','soft','soft','normal','soft','soft'];
    }
    if (unit === 16) {
      // At 16th-note pulse, soft inner beats blur into a wash — mute them
      // so only the structural beats (accent + grouping pulse) are audible.
      if (beats === 3) return ['accent','mute','mute'];                                  // one fast group
      if (beats === 5) return ['accent','mute','mute','normal','mute'];                  // 3+2
      if (beats === 7) return ['accent','mute','normal','mute','normal','mute','mute'];  // 2+2+3
    }
    return null;
  }

  function setTimeSig(beats, unit, applyDefault = false) {
    beats = Math.max(1, Math.min(32, Math.round(beats)));
    const prev = state.beats;
    const sameSig = beats === state.beatsPerMeasure && unit === state.beatUnit;
    state.beatsPerMeasure = beats;
    state.beatUnit = unit;

    let newBeats;
    if (applyDefault && !sameSig) {
      // Preset-button click on a new meter: apply the common default
      // for known clave/compound meters, or a clean [accent, normal, ...]
      // for everything else. Wipe customizations from the previous meter
      // so 6/8 → 7/4 doesn't leave 6/8's soft beats hanging on the front.
      const preset = defaultBeatsForSig(beats, unit);
      if (preset) {
        newBeats = preset.slice();
      } else {
        newBeats = Array(beats).fill('normal');
        newBeats[0] = 'accent';
      }
    } else {
      // Custom-input edit or re-click on the active preset: preserve
      // the current pattern, padding any new slots with normal.
      newBeats = [];
      for (let i = 0; i < beats; i++) {
        newBeats.push(i < prev.length ? prev[i] : 'normal');
      }
      if (prev.length === 0) newBeats[0] = 'accent';
    }
    state.beats = newBeats;

    if (state.currentBeat >= beats) state.currentBeat = -1;

    document.getElementById('beats-input').value = beats;
    document.getElementById('unit-select').value = unit;

    document.querySelectorAll('#time-sig-presets .btn-sig').forEach(btn => {
      btn.classList.toggle('active',
        +btn.dataset.beats === beats && +btn.dataset.unit === unit);
    });

    renderBeatGrid();
    renderSubDots();
    persistState();
  }

  document.querySelectorAll('#time-sig-presets .btn-sig').forEach(btn => {
    btn.addEventListener('click', () => setTimeSig(+btn.dataset.beats, +btn.dataset.unit, true));
  });

  document.getElementById('beats-input').addEventListener('change', e => {
    setTimeSig(+e.target.value, state.beatUnit);
  });
  document.getElementById('unit-select').addEventListener('change', e => {
    setTimeSig(state.beatsPerMeasure, +e.target.value);
  });

  // ─── Subdivision ──────────────────────────────────────────────────────────────
  function setSubdivision(sub) {
    state.subdivision = sub;
    document.querySelectorAll('.btn-sub').forEach(btn => {
      btn.classList.toggle('active', +btn.dataset.sub === sub);
    });
    renderSubDots();
    persistState();
  }

  document.querySelectorAll('.btn-sub').forEach(btn => {
    btn.addEventListener('click', () => setSubdivision(+btn.dataset.sub));
  });

  // ─── Beat Grid ────────────────────────────────────────────────────────────────
  const STATE_CYCLE = { normal: 'accent', accent: 'soft', soft: 'mute', mute: 'normal' };
  const STATE_ICONS = { normal: '●', accent: '▲', soft: '○', mute: '✕' };

  function renderBeatGrid() {
    const grid = document.getElementById('beat-grid');
    grid.innerHTML = '';

    state.beats.forEach((beatState, i) => {
      const btn = document.createElement('button');
      const isActive = state.isPlaying && state.currentBeat === i && state.currentSub === 0;
      btn.className = 'beat-btn state-' + beatState + (isActive ? ' active' : '');
      btn.innerHTML = '<span class="beat-num">' + (i + 1) + '</span><span class="beat-icon">' + STATE_ICONS[beatState] + '</span>';
      btn.title = 'Beat ' + (i + 1) + ': ' + beatState + ' — click to change';

      btn.addEventListener('click', () => {
        state.beats[i] = STATE_CYCLE[state.beats[i]];
        btn.className = 'beat-btn state-' + state.beats[i] + (btn.classList.contains('active') ? ' active' : '');
        btn.querySelector('.beat-icon').textContent = STATE_ICONS[state.beats[i]];
        persistState();
      });

      grid.appendChild(btn);
    });
  }

  function renderSubDots() {
    const container = document.getElementById('sub-indicators');
    container.innerHTML = '';
    if (state.subdivision <= 1) return;
    for (let i = 0; i < state.subdivision; i++) {
      const dot = document.createElement('div');
      dot.className = 'sub-dot';
      container.appendChild(dot);
    }
  }

  // ─── Play Button ──────────────────────────────────────────────────────────────
  function updatePlayButton() {
    ['play-stop', 'play-stop-form'].forEach(id => {
      const btn = document.getElementById(id);
      if (!btn) return;
      btn.textContent = state.isPlaying ? '■ Stop' : '▶ Start';
      btn.classList.toggle('playing', state.isPlaying);
    });
  }

  document.getElementById('play-stop').addEventListener('click', togglePlay);
  document.getElementById('play-stop-form').addEventListener('click', togglePlay);

  document.addEventListener('keydown', e => {
    if (e.code === 'Space' && document.activeElement !== bpmEl) {
      const tag = document.activeElement && document.activeElement.tagName;
      if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
      e.preventDefault();
      togglePlay();
    }
  });

  // ─── Advanced Mode ────────────────────────────────────────────────────────────

  function updateGapVisual(phase, count) {
    const pill = document.getElementById('gap-phase-pill');
    const prog = document.getElementById('gap-phase-progress');
    if (!pill || !prog) return;
    if (phase === 'idle' || !adv.gapEnabled || !state.isPlaying) {
      pill.className = 'phase-pill';
      pill.textContent = '● Waiting';
      prog.textContent = '';
      return;
    }
    if (phase === 'play') {
      pill.className = 'phase-pill play';
      pill.textContent = '▶ Playing';
      const left = adv.gapPlay - count;
      prog.textContent = left + ' measure' + (left !== 1 ? 's' : '') + ' left';
    } else {
      pill.className = 'phase-pill silent';
      pill.textContent = '● Silent';
      const left = adv.gapSilent - count;
      prog.textContent = left + ' measure' + (left !== 1 ? 's' : '') + ' left';
    }
  }

  let lastRenderedFormIdx = -1;

  function updateFormVisual(formIdx) {
    if (!adv.formEnabled || adv.form.length === 0) return;
    document.querySelectorAll('.form-group-header').forEach(h => {
      h.classList.toggle('form-active', formIdx >= +h.dataset.start && formIdx <= +h.dataset.end);
    });
    document.querySelectorAll('.form-row[data-idx]').forEach(row => {
      row.classList.toggle('form-active', +row.dataset.idx === formIdx);
    });
    const active = document.querySelector('.form-group-header.form-active');
    if (active) active.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    updateFormCounter(formIdx);
    if (formIdx !== lastRenderedFormIdx && formIdx >= 0) {
      lastRenderedFormIdx = formIdx;
      renderBeatGridForEntry(adv.form[formIdx]);
    }
  }

  function updateFormCounter(formIdx) {
    const el = document.getElementById('form-counter');
    if (!el) return;
    if (adv.form.length === 0) { el.textContent = ''; return; }
    el.textContent = state.isPlaying && formIdx >= 0
      ? 'Measure ' + (formIdx + 1) + ' of ' + adv.form.length
      : adv.form.length + ' measure' + (adv.form.length !== 1 ? 's' : '');
  }

  function renderBeatGridForEntry(entry) {
    const grid = document.getElementById('beat-grid');
    grid.innerHTML = '';
    entry.states.forEach((beatState, i) => {
      const btn = document.createElement('button');
      const isActive = state.isPlaying && state.currentBeat === i && state.currentSub === 0;
      btn.className = 'beat-btn state-' + beatState + (isActive ? ' active' : '');
      btn.innerHTML = '<span class="beat-num">' + (i + 1) + '</span><span class="beat-icon">' + STATE_ICONS[beatState] + '</span>';
      btn.addEventListener('click', () => {
        entry.states[i] = STATE_CYCLE[entry.states[i]];
        btn.className = 'beat-btn state-' + entry.states[i] + (btn.classList.contains('active') ? ' active' : '');
        btn.querySelector('.beat-icon').textContent = STATE_ICONS[entry.states[i]];
      });
      grid.appendChild(btn);
    });
  }

  const expandedGroups = new Set();

  function groupForm() {
    const groups = [];
    let i = 0;
    while (i < adv.form.length) {
      const start = i;
      const { beats, unit } = adv.form[i];
      while (i < adv.form.length && adv.form[i].beats === beats && adv.form[i].unit === unit) i++;
      groups.push({ beats, unit, start, end: i - 1, count: i - start });
    }
    return groups;
  }

  function makeFormRow(entry, idx) {
    const row = document.createElement('div');
    row.className = 'form-row';
    row.dataset.idx = idx;

    const numSpan = document.createElement('span');
    numSpan.className = 'form-row-num';
    numSpan.textContent = idx + 1;

    const beatsIn = document.createElement('input');
    beatsIn.type = 'number'; beatsIn.min = 1; beatsIn.max = 32;
    beatsIn.value = entry.beats;
    beatsIn.className = 'form-beats-input';

    const slash = document.createElement('span');
    slash.className = 'form-slash';
    slash.textContent = '/';

    const unitSel = document.createElement('select');
    unitSel.className = 'form-unit-select';
    buildUnitOptions(unitSel, entry.unit);

    const delBtn = document.createElement('button');
    delBtn.className = 'form-delete-btn';
    delBtn.textContent = '✕';
    delBtn.title = 'Remove this measure';

    beatsIn.addEventListener('change', () => {
      const b = Math.max(1, Math.min(32, +beatsIn.value));
      beatsIn.value = b;
      saveFormHistory();
      const prev = entry.states.slice();
      entry.beats = b;
      entry.states = Array(b).fill('normal').map((_, i) => i < prev.length ? prev[i] : 'normal');
      if (prev.length === 0) entry.states[0] = 'accent';
      expandedGroups.clear();
      renderFormList(); updateFormCounter(advFormIdx);
    });
    unitSel.addEventListener('change', () => {
      saveFormHistory(); entry.unit = +unitSel.value;
      expandedGroups.clear(); renderFormList();
    });
    delBtn.addEventListener('click', () => {
      if (adv.form.length <= 1) return;
      saveFormHistory();
      adv.form.splice(idx, 1);
      if (advFormIdx >= adv.form.length) advFormIdx = adv.form.length - 1;
      expandedGroups.clear(); renderFormList(); updateFormCounter(advFormIdx);
    });

    row.append(numSpan, beatsIn, slash, unitSel, delBtn);
    return row;
  }

  function renderFormList() {
    const list = document.getElementById('form-list');
    if (!list) return;
    list.innerHTML = '';
    const groups = groupForm();

    groups.forEach(group => {
      const isExpanded = expandedGroups.has(group.start);

      const header = document.createElement('div');
      header.className = 'form-group-header';
      header.dataset.start = group.start;
      header.dataset.end   = group.end;
      if (state.isPlaying && advFormIdx >= group.start && advFormIdx <= group.end)
        header.classList.add('form-active');

      const rangeSpan = document.createElement('span');
      rangeSpan.className = 'form-group-range';
      rangeSpan.textContent = group.count === 1
        ? String(group.start + 1)
        : (group.start + 1) + '–' + (group.end + 1);

      const meterSpan = document.createElement('span');
      meterSpan.className = 'form-group-meter';
      meterSpan.textContent = group.beats + '/' + group.unit;

      const countSpan = document.createElement('span');
      countSpan.className = 'form-group-count';
      countSpan.textContent = '×' + group.count;

      const expandBtn = document.createElement('button');
      expandBtn.className = 'form-expand-btn';
      expandBtn.textContent = isExpanded ? '▲' : '▾';
      expandBtn.title = isExpanded ? 'Collapse' : 'Expand to edit individual measures';

      const delGroupBtn = document.createElement('button');
      delGroupBtn.className = 'form-delete-btn';
      delGroupBtn.title = 'Remove all ' + group.count + ' measure' + (group.count > 1 ? 's' : '');
      delGroupBtn.textContent = '✕';

      header.append(rangeSpan, meterSpan, countSpan, expandBtn, delGroupBtn);
      list.appendChild(header);

      if (isExpanded) {
        for (let idx = group.start; idx <= group.end; idx++) {
          const row = makeFormRow(adv.form[idx], idx);
          if (state.isPlaying && idx === advFormIdx) row.classList.add('form-active');
          list.appendChild(row);
        }
      }

      expandBtn.addEventListener('click', () => {
        if (expandedGroups.has(group.start)) expandedGroups.delete(group.start);
        else expandedGroups.add(group.start);
        renderFormList();
      });

      delGroupBtn.addEventListener('click', () => {
        saveFormHistory();
        adv.form.splice(group.start, group.count);
        if (adv.form.length === 0)
          adv.form.push({ beats: 4, unit: 4, states: ['accent','normal','normal','normal'] });
        if (advFormIdx >= adv.form.length) advFormIdx = adv.form.length - 1;
        expandedGroups.clear(); renderFormList(); updateFormCounter(advFormIdx);
      });
    });

    updateFormCounter(advFormIdx);
  }

  function addFormMeasure() {
    saveFormHistory();
    const last = adv.form[adv.form.length - 1] || { beats: 4, unit: 4 };
    const states = Array(last.beats).fill('normal');
    states[0] = 'accent';
    adv.form.push({ beats: last.beats, unit: last.unit, states });
    renderFormList();
    updateFormCounter(advFormIdx);
  }

  // ─── Sound Library UI ────────────────────────────────────────────────────────
  document.querySelectorAll('.btn-sound').forEach(btn => {
    btn.addEventListener('click', () => {
      soundMode = btn.dataset.sound;
      document.querySelectorAll('.btn-sound').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      persistState();
    });
  });

  // ─── Form Undo / Redo ─────────────────────────────────────────────────────────
  let formHistory = [];
  let formHistoryIdx = -1;

  function saveFormHistory() {
    formHistory = formHistory.slice(0, formHistoryIdx + 1);
    formHistory.push(JSON.parse(JSON.stringify(adv.form)));
    if (formHistory.length > 80) { formHistory.shift(); }
    formHistoryIdx = formHistory.length - 1;
    refreshUndoRedoBtns();
    persistState();
  }

  function refreshUndoRedoBtns() {
    const u = document.getElementById('form-undo');
    const r = document.getElementById('form-redo');
    if (u) u.disabled = formHistoryIdx <= 0;
    if (r) r.disabled = formHistoryIdx >= formHistory.length - 1;
  }

  document.getElementById('form-undo').addEventListener('click', () => {
    if (formHistoryIdx <= 0) return;
    formHistoryIdx--;
    adv.form = JSON.parse(JSON.stringify(formHistory[formHistoryIdx]));
    renderFormList(); updateFormCounter(advFormIdx); refreshUndoRedoBtns();
    persistState();
  });

  document.getElementById('form-redo').addEventListener('click', () => {
    if (formHistoryIdx >= formHistory.length - 1) return;
    formHistoryIdx++;
    adv.form = JSON.parse(JSON.stringify(formHistory[formHistoryIdx]));
    renderFormList(); updateFormCounter(advFormIdx); refreshUndoRedoBtns();
    persistState();
  });

  // ─── Form Save / Load ─────────────────────────────────────────────────────────
  document.getElementById('form-save').addEventListener('click', () => {
    const payload = {
      version: 1,
      form: adv.form.map(e => ({ beats: e.beats, unit: e.unit, states: e.states.slice() }))
    };
    const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
    const url  = URL.createObjectURL(blob);
    const a    = document.createElement('a');
    a.href = url; a.download = 'metronome-form.json'; a.click();
    URL.revokeObjectURL(url);
  });

  document.getElementById('form-load-input').addEventListener('change', e => {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = evt => {
      try {
        const data = JSON.parse(evt.target.result);
        if (data.version === 1 && Array.isArray(data.form) && data.form.length > 0) {
          saveFormHistory();
          adv.form = data.form.map(entry => {
            const b = Math.max(1, Math.min(32, +entry.beats || 4));
            const u = Math.max(1, Math.min(32, +entry.unit  || 4));
            const s = Array.isArray(entry.states) ? entry.states.slice() : Array(b).fill('normal');
            if (s.length < b) for (let i = s.length; i < b; i++) s.push('normal');
            return { beats: b, unit: u, states: s.slice(0, b) };
          });
          renderFormList(); updateFormCounter(0);
          lastRenderedFormIdx = -1;
          if (adv.formEnabled) renderBeatGridForEntry(adv.form[0]);
        } else {
          alert('Invalid metronome form file.');
        }
      } catch (_) { alert('Could not read file.'); }
    };
    reader.readAsText(file);
    e.target.value = '';
  });

  // ─── Form Bulk Add ────────────────────────────────────────────────────────────
  document.getElementById('bulk-add-btn').addEventListener('click', () => {
    const count = Math.max(1, +document.getElementById('bulk-count').value || 1);
    const beats = Math.max(1, Math.min(32, +document.getElementById('bulk-beats').value || 4));
    const unit  = Math.max(1, Math.min(32, +document.getElementById('bulk-unit').value  || 4));
    saveFormHistory();
    for (let i = 0; i < count; i++) {
      const states = Array(beats).fill('normal');
      states[0] = 'accent';
      adv.form.push({ beats, unit, states });
    }
    renderFormList(); updateFormCounter(advFormIdx);
  });

  document.getElementById('adv-toggle').addEventListener('change', e => {
    adv.enabled = e.target.checked;
    document.getElementById('adv-panel').classList.toggle('open', adv.enabled);
    document.getElementById('adv-toggle-row').classList.toggle('active', adv.enabled);
  });

  document.getElementById('gap-toggle').addEventListener('change', e => {
    adv.gapEnabled = e.target.checked;
    document.getElementById('gap-controls').classList.toggle('disabled', !adv.gapEnabled);
    if (!adv.gapEnabled) updateGapVisual('idle', 0);
    persistState();
  });

  document.getElementById('gap-play-slider').addEventListener('input', e => {
    adv.gapPlay = +e.target.value;
    document.getElementById('gap-play-val').textContent = adv.gapPlay;
    persistState();
  });

  document.getElementById('gap-silent-slider').addEventListener('input', e => {
    adv.gapSilent = +e.target.value;
    document.getElementById('gap-silent-val').textContent = adv.gapSilent;
    persistState();
  });

  document.getElementById('random-mute-toggle').addEventListener('change', e => {
    adv.randomMuteEnabled = e.target.checked;
    document.getElementById('random-mute-controls').classList.toggle('disabled', !adv.randomMuteEnabled);
    persistState();
  });

  document.getElementById('random-mute-slider').addEventListener('input', e => {
    adv.randomMutePct = +e.target.value;
    document.getElementById('random-mute-val').textContent = adv.randomMutePct;
    persistState();
  });

  document.getElementById('form-toggle').addEventListener('change', e => {
    adv.formEnabled = e.target.checked;
    document.getElementById('form-controls').classList.toggle('disabled', !adv.formEnabled);
    lastRenderedFormIdx = -1;
    if (adv.formEnabled && adv.form.length > 0) renderBeatGridForEntry(adv.form[0]);
    else renderBeatGrid();
    updateFormCounter(advFormIdx);
    persistState();
  });

  document.getElementById('add-measure-btn').addEventListener('click', addFormMeasure);

  // ─── Persistence ──────────────────────────────────────────────────────────────
  //
  // Two layers, layered on top of each other:
  //   - localStorage: silent auto-save of EVERYTHING (including custom forms).
  //     Survives a tab close. No user action required.
  //   - URL query string: encodes the basic state — BPM, time signature, beat
  //     pattern, subdivision, sound mode, gap click, random mute. Updated via
  //     history.replaceState so it doesn't pollute the back-button stack.
  //     Lets users bookmark a setup or share a link. Custom forms are not in
  //     the URL — they live in localStorage only (Phase 2 will encode them).
  //
  // On page load: URL params win if present, else localStorage, else defaults.
  // On state change: persistState() is called from each mutation handler; it
  // saves to localStorage immediately and updates the URL on a 250 ms debounce.

  const STORAGE_KEY = 'metronomeState_v1';
  const BEAT_TO_CHAR = { accent: 'A', normal: 'N', soft: 'S', mute: 'M' };
  const CHAR_TO_BEAT = { A: 'accent', N: 'normal', S: 'soft', M: 'mute' };
  const SOUND_TO_CHAR = { electronic: 'e', clave: 'c' };
  const CHAR_TO_SOUND = { e: 'electronic', c: 'clave' };

  function encodeURLState() {
    const params = new URLSearchParams();
    params.set('bpm', String(state.bpm));
    params.set('beats', String(state.beatsPerMeasure));
    params.set('unit', String(state.beatUnit));
    params.set('p', state.beats.map((b) => BEAT_TO_CHAR[b] || 'N').join(''));
    if (state.subdivision !== 1) params.set('sub', String(state.subdivision));
    if (soundMode !== 'electronic') params.set('snd', SOUND_TO_CHAR[soundMode]);
    if (adv.gapEnabled) params.set('gap', adv.gapPlay + '-' + adv.gapSilent);
    if (adv.randomMuteEnabled) params.set('rmute', String(adv.randomMutePct));
    return params.toString();
  }

  function applyURLState(search) {
    const params = new URLSearchParams(search);
    if (!params.has('bpm') && !params.has('beats') && !params.has('p')) return false;

    const bpm = +params.get('bpm');
    if (bpm >= 1 && bpm <= 500) state.bpm = Math.round(bpm);

    const beats = +params.get('beats');
    const unit = +params.get('unit');
    if (beats >= 1 && beats <= 32 && unit >= 1 && unit <= 32) {
      state.beatsPerMeasure = Math.round(beats);
      state.beatUnit = Math.round(unit);
    }

    const pattern = params.get('p') || '';
    if (pattern) {
      const decoded = pattern.split('').map((c) => CHAR_TO_BEAT[c] || 'normal');
      const n = state.beatsPerMeasure;
      state.beats = Array(n).fill('normal').map((_, i) => decoded[i] || 'normal');
    }

    const sub = +params.get('sub');
    if (sub >= 1 && sub <= 4) state.subdivision = Math.round(sub);

    const snd = params.get('snd');
    if (snd && CHAR_TO_SOUND[snd]) soundMode = CHAR_TO_SOUND[snd];

    const gap = params.get('gap');
    if (gap) {
      const [p, s] = gap.split('-').map(Number);
      if (p >= 1 && p <= 16 && s >= 1 && s <= 16) {
        adv.gapEnabled = true;
        adv.gapPlay = p;
        adv.gapSilent = s;
      }
    }
    const rmute = +params.get('rmute');
    if (rmute >= 0 && rmute <= 100 && params.has('rmute')) {
      adv.randomMuteEnabled = true;
      adv.randomMutePct = Math.round(rmute);
    }
    return true;
  }

  function saveLocalStorage() {
    try {
      const data = {
        bpm: state.bpm,
        beatsPerMeasure: state.beatsPerMeasure,
        beatUnit: state.beatUnit,
        beats: state.beats,
        subdivision: state.subdivision,
        soundMode,
        adv: {
          gapEnabled: adv.gapEnabled, gapPlay: adv.gapPlay, gapSilent: adv.gapSilent,
          randomMuteEnabled: adv.randomMuteEnabled, randomMutePct: adv.randomMutePct,
          formEnabled: adv.formEnabled,
          form: adv.form,
        },
      };
      localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
    } catch (e) { /* private mode or quota — ignore */ }
  }

  function loadLocalStorage() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return false;
      const d = JSON.parse(raw);
      if (d.bpm >= 1 && d.bpm <= 500) state.bpm = d.bpm;
      if (d.beatsPerMeasure >= 1 && d.beatsPerMeasure <= 32) state.beatsPerMeasure = d.beatsPerMeasure;
      if (d.beatUnit >= 1 && d.beatUnit <= 32) state.beatUnit = d.beatUnit;
      if (Array.isArray(d.beats) && d.beats.length > 0) {
        state.beats = d.beats.filter((b) => b in BEAT_TO_CHAR);
      }
      if (d.subdivision >= 1 && d.subdivision <= 4) state.subdivision = d.subdivision;
      if (d.soundMode === 'clave' || d.soundMode === 'electronic') soundMode = d.soundMode;
      if (d.adv) {
        adv.gapEnabled = !!d.adv.gapEnabled;
        if (d.adv.gapPlay >= 1 && d.adv.gapPlay <= 16) adv.gapPlay = d.adv.gapPlay;
        if (d.adv.gapSilent >= 1 && d.adv.gapSilent <= 16) adv.gapSilent = d.adv.gapSilent;
        adv.randomMuteEnabled = !!d.adv.randomMuteEnabled;
        if (d.adv.randomMutePct >= 0 && d.adv.randomMutePct <= 100) adv.randomMutePct = d.adv.randomMutePct;
        adv.formEnabled = !!d.adv.formEnabled;
        if (Array.isArray(d.adv.form) && d.adv.form.length > 0) adv.form = d.adv.form;
      }
      return true;
    } catch (e) { return false; }
  }

  let urlUpdateTimer = null;
  function persistState() {
    saveLocalStorage();
    clearTimeout(urlUpdateTimer);
    urlUpdateTimer = setTimeout(() => {
      const qs = encodeURLState();
      const target = window.location.pathname + (qs ? '?' + qs : '');
      if (target !== window.location.pathname + window.location.search) {
        history.replaceState(null, '', target);
      }
    }, 250);
  }

  // Copy-link button
  document.getElementById('copy-link-btn').addEventListener('click', async () => {
    const qs = encodeURLState();
    const url = window.location.origin + window.location.pathname + (qs ? '?' + qs : '');
    try {
      await navigator.clipboard.writeText(url);
    } catch (e) {
      // Fallback for older browsers / non-secure contexts
      const ta = document.createElement('textarea');
      ta.value = url; ta.style.position = 'fixed'; ta.style.opacity = '0';
      document.body.appendChild(ta); ta.select();
      try { document.execCommand('copy'); } catch (_) {}
      document.body.removeChild(ta);
    }
    const btn = document.getElementById('copy-link-btn');
    btn.classList.add('copied');
    setTimeout(() => btn.classList.remove('copied'), 1400);
  });

  // ─── Init ─────────────────────────────────────────────────────────────────────
  function init() {
    state.beats = Array(state.beatsPerMeasure).fill('normal');
    state.beats[0] = 'accent';
    adv.form = [{ beats: 4, unit: 4, states: ['accent','normal','normal','normal'] }];

    // Restore: URL params win, else localStorage, else defaults already in place.
    const usedURL = applyURLState(window.location.search);
    if (!usedURL) loadLocalStorage();

    // Reflect restored state into the DOM.
    document.getElementById('bpm-display').textContent = state.bpm;
    document.getElementById('bpm-slider').value = state.bpm;
    document.getElementById('beats-input').value = state.beatsPerMeasure;
    document.querySelectorAll('.btn-sub').forEach((b) => {
      b.classList.toggle('active', +b.dataset.sub === state.subdivision);
    });
    document.querySelectorAll('.btn-sound').forEach((b) => {
      b.classList.toggle('active', b.dataset.sound === soundMode);
    });
    document.querySelectorAll('#time-sig-presets .btn-sig').forEach((btn) => {
      btn.classList.toggle('active',
        +btn.dataset.beats === state.beatsPerMeasure && +btn.dataset.unit === state.beatUnit);
    });
    document.getElementById('gap-toggle').checked = adv.gapEnabled;
    document.getElementById('gap-controls').classList.toggle('disabled', !adv.gapEnabled);
    document.getElementById('gap-play-slider').value = adv.gapPlay;
    document.getElementById('gap-play-val').textContent = adv.gapPlay;
    document.getElementById('gap-silent-slider').value = adv.gapSilent;
    document.getElementById('gap-silent-val').textContent = adv.gapSilent;
    document.getElementById('random-mute-toggle').checked = adv.randomMuteEnabled;
    document.getElementById('random-mute-controls').classList.toggle('disabled', !adv.randomMuteEnabled);
    document.getElementById('random-mute-slider').value = adv.randomMutePct;
    document.getElementById('random-mute-val').textContent = adv.randomMutePct;

    populateUnitSelect('unit-select', state.beatUnit);
    populateUnitSelect('bulk-unit', 4);
    renderBeatGrid();
    renderSubDots();
    renderFormList();
    formHistory = [JSON.parse(JSON.stringify(adv.form))];
    formHistoryIdx = 0;
    refreshUndoRedoBtns();
    document.getElementById('tempo-name').textContent = getTempoName(state.bpm);

    // If URL had state and localStorage didn't (or was different), sync now.
    if (usedURL) saveLocalStorage();
  }

  // ─── Custom Form Editor (preview) ─────────────────────────────────────────────
  // Notation-flavored bar grid. Reads + writes the same adv.form structure the
  // existing scheduler consumes. Each entry: { beats, unit, states[], breakAfter? }
  // where breakAfter (optional) forces a new line in the grid layout.
  //
  // Interactions:
  //   - Tap a beat: cycle accent → soft → mute → normal
  //   - +/- inputs: change beats-per-measure or beat unit for that bar
  //   - Up / down: reorder bars
  //   - X: delete bar (disabled when only one bar remains)
  //   - "Add bar" plus button at the end: appends a new bar (clones the
  //     previous bar's beats/unit so adding a 5/8 bar after a 5/8 bar
  //     gives you another 5/8 bar)
  //   - Hover gap between bars: "↵" cue to insert a line break after
  //   - Click "BREAK" badge on an existing line: remove that break

  const formEditorModal = document.getElementById('form-editor-modal');
  const formEditorGrid  = document.getElementById('form-editor-grid');
  const formEditorBpmEl = document.getElementById('form-editor-bpm');
  const formEditorPlayBtns = [
    document.getElementById('form-editor-play'),
    document.getElementById('form-editor-mobile-play-btn'),
  ];

  function openFormEditor() {
    // Turn the form mode on if not already (the editor only makes sense
    // when the scheduler is using adv.form).
    if (!adv.formEnabled) {
      adv.formEnabled = true;
      const toggle = document.getElementById('form-toggle');
      if (toggle) toggle.checked = true;
      document.getElementById('form-controls').classList.remove('disabled');
      persistState();
    }
    formEditorModal.setAttribute('aria-hidden', 'false');
    document.body.classList.add('form-editor-open');
    formEditorBpmEl.textContent = state.bpm;
    // Reflect persisted mode in the toolbar toggle UI
    document.getElementById('form-editor-mode-beat').classList.toggle('active', editorMode === 'beat');
    document.getElementById('form-editor-mode-beat').setAttribute('aria-pressed', editorMode === 'beat');
    document.getElementById('form-editor-mode-chart').classList.toggle('active', editorMode === 'chart');
    document.getElementById('form-editor-mode-chart').setAttribute('aria-pressed', editorMode === 'chart');
    renderFormEditor();
    refreshFormEditorPlayButtons();
  }

  function closeFormEditor() {
    if (selectMode) exitSelectMode();
    formEditorModal.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('form-editor-open');
  }

  document.getElementById('open-form-editor').addEventListener('click', openFormEditor);
  document.getElementById('form-editor-close').addEventListener('click', closeFormEditor);

  // BPM controls inside the editor — wire +/- and contenteditable to the
  // shared setBPM() so the change cascades to the slider, scheduler, and
  // persistence layer just like a change on the main page would.
  document.getElementById('form-editor-bpm-minus').addEventListener('click', () => {
    setBPM(state.bpm - 1);
    formEditorBpmEl.textContent = state.bpm;
  });
  document.getElementById('form-editor-bpm-plus').addEventListener('click', () => {
    setBPM(state.bpm + 1);
    formEditorBpmEl.textContent = state.bpm;
  });
  formEditorBpmEl.addEventListener('blur', () => {
    const v = parseInt(formEditorBpmEl.textContent.replace(/[^\d]/g, ''), 10);
    if (v >= 1 && v <= 500) setBPM(v);
    formEditorBpmEl.textContent = state.bpm;
  });
  formEditorBpmEl.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      formEditorBpmEl.blur();
    }
  });
  // Highlight the whole BPM value on click so a keystroke replaces it.
  // It's a contenteditable, so select its contents via a Range rather
  // than input.select(). setTimeout defers past the browser's own
  // click-caret placement.
  formEditorBpmEl.addEventListener('click', () => {
    setTimeout(() => {
      const range = document.createRange();
      range.selectNodeContents(formEditorBpmEl);
      const sel = window.getSelection();
      sel.removeAllRanges();
      sel.addRange(range);
    }, 0);
  });

  // Esc closes the modal.
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && formEditorModal.getAttribute('aria-hidden') === 'false') {
      closeFormEditor();
    }
  });

  // Editor view mode: 'beat' (rich, tap-to-edit per beat) or 'chart' (a
  // sequence of compact tiles showing just the time signatures, for
  // structural overview). Persisted in its own localStorage key so the
  // user's last mode survives reloads.
  let editorMode = 'beat';
  try {
    const m = localStorage.getItem('metronomeFormEditorMode_v1');
    if (m === 'beat' || m === 'chart') editorMode = m;
  } catch (e) {}

  // Per-row cap for beat mode. Portrait gets 8, landscape gets 16.
  function maxBeatsPerRow() {
    const portrait = window.matchMedia('(orientation: portrait)').matches;
    return portrait ? 8 : 16;
  }

  function renderFormEditor() {
    formEditorGrid.className = 'form-editor-grid'
      + (editorMode === 'chart' ? ' chart-mode' : '')
      + (selectMode ? ' select-mode' : '');
    formEditorGrid.innerHTML = '';
    if (editorMode === 'chart') {
      renderFormEditorChart();
    } else {
      renderFormEditorBeat();
    }

    // Update the "Add bar" button label to show the clone target.
    const last = adv.form[adv.form.length - 1];
    const addLabel = document.getElementById('form-editor-add-bar-label');
    if (addLabel) addLabel.textContent = 'Add a ' + last.beats + '/' + last.unit + ' bar';
  }

  // Beat mode — auto-packed rows of bars with beat circles, no manual breaks.
  function renderFormEditorBeat() {
    const cap = maxBeatsPerRow();
    let row = document.createElement('div');
    row.className = 'form-editor-row';
    let rowBeats = 0;
    const flushRow = () => {
      if (row.childNodes.length > 0) formEditorGrid.appendChild(row);
      row = document.createElement('div');
      row.className = 'form-editor-row';
      rowBeats = 0;
    };
    adv.form.forEach((entry, idx) => {
      const wouldExceed = rowBeats + entry.beats > cap;
      if (rowBeats > 0 && wouldExceed) flushRow();
      row.appendChild(buildFormBarCard(entry, idx));
      rowBeats += entry.beats;
    });
    flushRow();
  }

  // Chart mode — uniform tiles.
  //   - No manual line breaks: a fixed N-column auto-flow grid.
  //   - At least one manual break: the form is treated as deliberately
  //     laid out — each line (a run between breaks, capped at the
  //     per-row tile limit) becomes a flex row whose tiles stretch to
  //     fill the full width.
  function maxTilesPerRow() {
    return window.matchMedia('(orientation: portrait)').matches ? 4 : 8;
  }

  function renderFormEditorChart() {
    const hasBreaks = adv.form.some((e) => e.breakAfter);
    if (!hasBreaks) {
      adv.form.forEach((entry, idx) => {
        formEditorGrid.appendChild(buildFormChartTile(entry, idx));
      });
      return;
    }
    // Explicit line layout — only the line right before a manual break
    // stretches its tiles to fill the width. Cap-wrapped lines and the
    // trailing line keep fixed-width tiles (a partial line leaves a gap).
    formEditorGrid.classList.add('chart-lines');
    const cap = maxTilesPerRow();
    let line = document.createElement('div');
    line.className = 'form-chart-line';
    let count = 0;
    const flushLine = (endedByBreak) => {
      if (line.childNodes.length > 0) {
        if (endedByBreak) line.classList.add('stretch');
        formEditorGrid.appendChild(line);
      }
      line = document.createElement('div');
      line.className = 'form-chart-line';
      count = 0;
    };
    adv.form.forEach((entry, idx) => {
      line.appendChild(buildFormChartTile(entry, idx));
      count++;
      if (entry.breakAfter) flushLine(true);
      else if (count >= cap) flushLine(false);
    });
    flushLine(false);
  }

  function buildFormChartTile(entry, idx) {
    const tile = document.createElement('button');
    tile.type = 'button';
    tile.dataset.idx = idx;
    let cls = 'form-chart-tile';
    if (idx === advFormIdx && state.isPlaying) cls += ' active';
    if (isBarSelected(idx)) cls += ' selected';
    tile.className = cls;
    tile.textContent = entry.beats + '/' + entry.unit;
    tile.setAttribute('aria-label', 'Bar ' + (idx + 1) + ' (' + entry.beats + '/' + entry.unit + '). Tap to edit in beat mode.');
    tile.addEventListener('click', (e) => {
      // Only switch modes if the click wasn't on a child control
      if (e.target.closest('.form-chart-tile-delete') || e.target.closest('.form-chart-tile-break')) return;
      formEditingIdx = idx;
      setEditorMode('beat');
      // Land the user right on the bar they tapped — beat mode just
      // re-rendered the whole grid, so scroll the now-editing bar into
      // the center of the scroll area instead of making them hunt.
      requestAnimationFrame(() => {
        const editingBar = formEditorGrid.querySelector('.form-bar.editing');
        if (editingBar) editingBar.scrollIntoView({ block: 'center' });
      });
    });

    // Delete
    const del = document.createElement('button');
    del.type = 'button';
    del.className = 'form-chart-tile-delete';
    del.textContent = '✕';
    del.title = 'Delete this bar';
    del.disabled = adv.form.length <= 1;
    del.addEventListener('click', (e) => {
      e.stopPropagation();
      if (adv.form.length <= 1) return;
      saveFormHistory();
      adv.form.splice(idx, 1);
      renderFormEditor();
    });
    tile.appendChild(del);

    // Line-break toggle (chart mode only)
    const brk = document.createElement('button');
    brk.type = 'button';
    brk.className = 'form-chart-tile-break' + (entry.breakAfter ? ' on' : '');
    brk.textContent = '↵';
    brk.title = entry.breakAfter ? 'Remove line break after this bar' : 'Add a line break after this bar';
    brk.disabled = idx === adv.form.length - 1;  // no break needed after the last bar
    brk.addEventListener('click', (e) => {
      e.stopPropagation();
      saveFormHistory();
      entry.breakAfter = !entry.breakAfter;
      renderFormEditor();
    });
    tile.appendChild(brk);

    return tile;
  }

  function setEditorMode(mode) {
    if (mode !== 'beat' && mode !== 'chart') return;
    editorMode = mode;
    // Switching to chart mode dismisses any open beat-mode edit chrome —
    // it shouldn't linger (and reopen) across a round trip. Blurring also
    // dismisses the mobile keyboard if a sig input was focused.
    if (mode === 'chart') {
      formEditingIdx = -1;
      if (document.activeElement && document.activeElement.blur) {
        document.activeElement.blur();
      }
    }
    try { localStorage.setItem('metronomeFormEditorMode_v1', mode); } catch (e) {}
    document.getElementById('form-editor-mode-beat').classList.toggle('active', mode === 'beat');
    document.getElementById('form-editor-mode-beat').setAttribute('aria-pressed', mode === 'beat');
    document.getElementById('form-editor-mode-chart').classList.toggle('active', mode === 'chart');
    document.getElementById('form-editor-mode-chart').setAttribute('aria-pressed', mode === 'chart');
    renderFormEditor();
  }

  document.getElementById('form-editor-mode-beat').addEventListener('click', () => setEditorMode('beat'));
  document.getElementById('form-editor-mode-chart').addEventListener('click', () => setEditorMode('chart'));

  // Clear-all — confirm before wiping
  document.getElementById('form-editor-clear').addEventListener('click', () => {
    if (adv.form.length > 1 && !confirm('Clear all bars and start over?')) return;
    saveFormHistory();
    adv.form = [{ beats: 4, unit: 4, states: ['accent','normal','normal','normal'], breakAfter: false }];
    formEditingIdx = -1;
    if (selectMode) { exitSelectMode(); } else { renderFormEditor(); }
  });

  // Re-pack rows on viewport resize so the cap matches the orientation.
  let resizeTimer = null;
  window.addEventListener('resize', () => {
    if (formEditorModal.getAttribute('aria-hidden') !== 'false') return;
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(renderFormEditor, 150);
  });

  let formEditingIdx = -1;  // which bar's edit chrome is currently revealed

  // ─── Multi-select ─────────────────────────────────────────────────────────────
  // Select a contiguous range of bars, then duplicate or delete the range.
  // Flow: tap a bar (its chrome opens — that's the anchor), tap "Select
  // bars", then tap the last bar of the range. While selectMode is on, a
  // tap anywhere on a bar/tile sets the range end (the capture-phase
  // listener on the grid intercepts before the normal bar handlers).
  let selectMode = false;
  let selectionAnchor = -1;
  let selectionEnd = -1;

  function isBarSelected(idx) {
    if (!selectMode || selectionAnchor < 0) return false;
    if (selectionEnd < 0) return idx === selectionAnchor;
    const lo = Math.min(selectionAnchor, selectionEnd);
    const hi = Math.max(selectionAnchor, selectionEnd);
    return idx >= lo && idx <= hi;
  }

  function updateSelectBar() {
    const status = document.getElementById('form-select-status');
    const dup = document.getElementById('form-select-duplicate');
    const del = document.getElementById('form-select-delete');
    const hasRange = selectionAnchor >= 0 && selectionEnd >= 0;
    if (selectionAnchor < 0) {
      status.textContent = 'Tap the first bar of the range';
    } else if (selectionEnd < 0) {
      status.textContent = 'Tap the last bar of the range';
    } else {
      const n = Math.abs(selectionEnd - selectionAnchor) + 1;
      status.textContent = n + ' bar' + (n !== 1 ? 's' : '') + ' selected';
    }
    dup.disabled = !hasRange;
    del.disabled = !hasRange;
  }

  function enterSelectMode() {
    if (selectMode) return;
    selectMode = true;
    // Honor "tap the first bar, then the toggle": if a bar's chrome is
    // open, seed the anchor with it. Otherwise the first tap sets it.
    selectionAnchor = formEditingIdx >= 0 ? formEditingIdx : -1;
    selectionEnd = -1;
    document.getElementById('form-select-bar').setAttribute('aria-hidden', 'false');
    updateSelectBar();
    renderFormEditor();
  }

  function exitSelectMode() {
    selectMode = false;
    selectionAnchor = -1;
    selectionEnd = -1;
    document.getElementById('form-select-bar').setAttribute('aria-hidden', 'true');
    renderFormEditor();
  }

  function handleSelectionTap(idx) {
    if (selectionAnchor < 0) {
      selectionAnchor = idx;
    } else {
      // Anchor is set — every subsequent tap (re)picks the range end.
      selectionEnd = idx;
    }
    updateSelectBar();
    renderFormEditor();
  }

  function duplicateSelection() {
    if (selectionAnchor < 0 || selectionEnd < 0) return;
    const lo = Math.min(selectionAnchor, selectionEnd);
    const hi = Math.max(selectionAnchor, selectionEnd);
    saveFormHistory();
    const slice = adv.form.slice(lo, hi + 1).map((e) => ({
      beats: e.beats,
      unit: e.unit,
      states: e.states.slice(),
      breakAfter: e.breakAfter || false,
    }));
    adv.form.splice(hi + 1, 0, ...slice);
    exitSelectMode();
  }

  function deleteSelection() {
    if (selectionAnchor < 0 || selectionEnd < 0) return;
    const lo = Math.min(selectionAnchor, selectionEnd);
    const hi = Math.max(selectionAnchor, selectionEnd);
    const count = hi - lo + 1;
    saveFormHistory();
    if (count >= adv.form.length) {
      // Deleting every bar — reset to a single default bar instead.
      adv.form = [{ beats: 4, unit: 4, states: ['accent','normal','normal','normal'], breakAfter: false }];
    } else {
      adv.form.splice(lo, count);
    }
    formEditingIdx = -1;
    exitSelectMode();
  }

  // Capture-phase listener: while in select mode, a tap anywhere on a bar
  // or chart tile sets the selection point and is blocked from reaching
  // the normal bar handlers (sig tag, beat circles, tile navigation).
  formEditorGrid.addEventListener('click', (e) => {
    if (!selectMode) return;
    const bar = e.target.closest('.form-bar, .form-chart-tile');
    if (!bar) return;
    e.stopPropagation();
    e.preventDefault();
    handleSelectionTap(+bar.dataset.idx);
  }, true);

  document.getElementById('form-editor-select-btn').addEventListener('click', enterSelectMode);
  document.getElementById('form-select-cancel').addEventListener('click', exitSelectMode);
  document.getElementById('form-select-duplicate').addEventListener('click', duplicateSelection);
  document.getElementById('form-select-delete').addEventListener('click', deleteSelection);

  // When a form bar's time signature changes, apply the meter's clave
  // default if one exists (e.g., 6/8 → A·s·s·N·s·s); otherwise preserve
  // the user's previous accent pattern as far as it fits and pad with
  // normal. Matches the behavior of the main metronome's preset buttons.
  function applyClaveOrPreserveStates(entry, prevStates) {
    const preset = defaultBeatsForSig(entry.beats, entry.unit);
    if (preset) {
      entry.states = preset.slice();
      return;
    }
    entry.states = Array(entry.beats).fill('normal').map((_, i) =>
      i < prevStates.length ? prevStates[i] : 'normal'
    );
    if (prevStates.length === 0) entry.states[0] = 'accent';
  }

  function buildFormBarCard(entry, idx) {
    const card = document.createElement('div');
    let cls = 'form-bar';
    if (idx === advFormIdx && state.isPlaying) cls += ' active';
    if (idx === formEditingIdx) cls += ' editing';
    if (isBarSelected(idx)) cls += ' selected';
    card.className = cls;
    card.dataset.idx = idx;
    // Proportional width: row flex-grow tracks the beat count, so a 7-beat
    // bar takes more space than a 3-beat bar on the same line. Capped at
    // the per-row beat limit — a bar wider than a full row (e.g. 12/8 in
    // portrait) takes a full-width row and wraps its beat circles onto a
    // second line inside the card rather than shrinking the dots.
    const rowCap = maxBeatsPerRow();
    const growth = Math.min(entry.beats, rowCap);
    card.style.flexGrow = String(growth);
    card.style.flexShrink = String(growth);

    // Compact sig tag — tap to toggle edit chrome
    const sigTag = document.createElement('button');
    sigTag.type = 'button';
    sigTag.className = 'form-bar-sig-tag';
    sigTag.textContent = entry.beats + '/' + entry.unit;
    sigTag.setAttribute('aria-label', 'Bar ' + (idx + 1) + ' (' + entry.beats + '/' + entry.unit + '). Tap to edit time signature.');
    sigTag.addEventListener('click', (e) => {
      e.stopPropagation();
      const willEnter = (formEditingIdx !== idx);
      formEditingIdx = willEnter ? idx : -1;
      renderFormEditor();
      // Focus the beats input SYNCHRONOUSLY here — renderFormEditor() is
      // synchronous so the new input already exists in the DOM, and
      // staying inside the click gesture is what makes iOS Safari open
      // the numeric keypad. A setTimeout would break the gesture chain
      // and iOS would focus the input visually but leave the keypad
      // closed. The focus also triggers the highlight-on-focus handler.
      if (willEnter) {
        const input = formEditorGrid.querySelector('.form-bar.editing .form-bar-sig-input');
        if (input) input.focus();
      }
    });
    card.appendChild(sigTag);

    // Edit chrome — sig inputs only (no reorder, no delete; delete is in
    // its own corner button)
    const edit = document.createElement('div');
    edit.className = 'form-bar-edit';
    const sig = document.createElement('div');
    sig.className = 'form-bar-sig';
    const beatsIn = document.createElement('input');
    beatsIn.type = 'number';
    beatsIn.min = 1; beatsIn.max = 32;
    beatsIn.value = entry.beats;
    beatsIn.className = 'form-bar-sig-input';
    beatsIn.inputMode = 'numeric';
    beatsIn.setAttribute('aria-label', 'Beats per measure for bar ' + (idx + 1));
    // Highlight the value on focus so a keystroke replaces it. Fires for
    // both a direct tap and the chrome-open auto-focus — both desired.
    beatsIn.addEventListener('focus', () => {
      setTimeout(() => beatsIn.select(), 0);
    });
    beatsIn.addEventListener('change', () => {
      const b = Math.max(1, Math.min(32, +beatsIn.value || entry.beats));
      beatsIn.value = b;
      if (b === entry.beats) return;  // no-op
      saveFormHistory();
      const prev = entry.states.slice();
      entry.beats = b;
      applyClaveOrPreserveStates(entry, prev);
      renderFormEditor();
    });
    sig.appendChild(beatsIn);
    const slash = document.createElement('span');
    slash.className = 'form-bar-sig-slash';
    slash.textContent = '/';
    sig.appendChild(slash);
    const unitSel = document.createElement('select');
    unitSel.className = 'form-bar-sig-unit';
    unitSel.setAttribute('aria-label', 'Beat unit for bar ' + (idx + 1));
    buildUnitOptions(unitSel, entry.unit);
    unitSel.addEventListener('change', () => {
      const newUnit = +unitSel.value;
      if (newUnit === entry.unit) return;
      saveFormHistory();
      const prev = entry.states.slice();
      entry.unit = newUnit;
      applyClaveOrPreserveStates(entry, prev);
      sigTag.textContent = entry.beats + '/' + entry.unit;
      renderFormEditor();
    });
    sig.appendChild(unitSel);
    edit.appendChild(sig);

    // Insert-after — clones this bar and drops the copy in right after it.
    const insertBtn = document.createElement('button');
    insertBtn.type = 'button';
    insertBtn.className = 'form-bar-insert';
    insertBtn.textContent = '+ Insert after';
    insertBtn.title = 'Insert a copy of this bar right after it';
    insertBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      saveFormHistory();
      adv.form.splice(idx + 1, 0, {
        beats: entry.beats,
        unit: entry.unit,
        states: entry.states.slice(),
        breakAfter: false,
      });
      formEditingIdx = idx + 1;  // keep the freshly-inserted bar selected
      renderFormEditor();
    });
    edit.appendChild(insertBtn);

    card.appendChild(edit);

    // Always-visible delete in the top-right
    const delBtn = document.createElement('button');
    delBtn.type = 'button';
    delBtn.className = 'form-bar-delete';
    delBtn.textContent = '✕';
    delBtn.title = 'Delete this bar';
    delBtn.setAttribute('aria-label', 'Delete bar ' + (idx + 1));
    delBtn.disabled = adv.form.length <= 1;
    delBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      if (adv.form.length <= 1) return;
      saveFormHistory();
      adv.form.splice(idx, 1);
      if (idx > 0 && adv.form[idx - 1].breakAfter && idx === adv.form.length) {
        adv.form[idx - 1].breakAfter = false;
      }
      formEditingIdx = -1;
      renderFormEditor();
    });
    card.appendChild(delBtn);

    // Beat row (always visible). Spaced evenly within the bar so the
    // beats fill the stretched width gracefully.
    const beats = document.createElement('div');
    beats.className = 'form-bar-beats';
    entry.states.forEach((s, i) => {
      const beat = document.createElement('button');
      beat.type = 'button';
      beat.className = 'form-beat state-' + s;
      beat.textContent = STATE_ICONS[s];
      beat.setAttribute('aria-label', 'Beat ' + (i + 1) + ' of bar ' + (idx + 1) + ', ' + s + '. Tap to cycle.');
      beat.addEventListener('click', () => {
        saveFormHistory();
        entry.states[i] = STATE_CYCLE[entry.states[i]];
        beat.className = 'form-beat state-' + entry.states[i];
        beat.textContent = STATE_ICONS[entry.states[i]];
      });
      beats.appendChild(beat);
    });
    card.appendChild(beats);

    return card;
  }

  function buildLineBreak(afterIdx) {
    const wrap = document.createElement('div');
    wrap.className = 'form-line-break';
    const toggle = document.createElement('button');
    toggle.type = 'button';
    toggle.className = 'form-line-break-toggle';
    toggle.textContent = 'BREAK ✕';
    toggle.title = 'Remove this line break';
    toggle.addEventListener('click', () => {
      saveFormHistory();
      adv.form[afterIdx].breakAfter = false;
      renderFormEditor();
    });
    wrap.appendChild(toggle);
    return wrap;
  }

  function buildBreakCue(afterIdx) {
    const cue = document.createElement('div');
    cue.className = 'form-bar-break-cue';
    cue.title = 'Add a line break after this bar';
    cue.addEventListener('click', () => {
      saveFormHistory();
      adv.form[afterIdx].breakAfter = true;
      renderFormEditor();
    });
    return cue;
  }

  document.getElementById('form-editor-add-bar').addEventListener('click', () => {
    saveFormHistory();
    // Clone the previous bar's time signature and accent pattern as a sensible default.
    const prev = adv.form[adv.form.length - 1];
    adv.form.push({
      beats: prev.beats,
      unit: prev.unit,
      states: prev.states.slice(),
      breakAfter: false,
    });
    renderFormEditor();
  });

  // ─── Form code: portable save / load ──────────────────────────────────────────
  // A compact single-token encoding of the whole form. Format:
  //   JVAFORM1;<beats>/<unit>:<states>[!];<beats>/<unit>:<states>[!];...
  // states are A/N/S/M chars (accent/normal/soft/mute); a trailing "!" on
  // a bar means breakAfter. The user copies this string and saves it
  // wherever they like, then pastes it back to reload the form. The
  // JVAFORM1 prefix is a version marker so the format can evolve later.
  function encodeFormCode() {
    const bars = adv.form.map((e) => {
      const chars = e.states.map((s) => BEAT_TO_CHAR[s] || 'N').join('');
      return e.beats + '/' + e.unit + ':' + chars + (e.breakAfter ? '!' : '');
    });
    return 'JVAFORM1;' + bars.join(';');
  }

  function decodeFormCode(str) {
    const parts = (str || '').trim().split(';');
    if (parts[0] !== 'JVAFORM1') {
      return { error: 'That doesn’t look like a form code (missing the JVAFORM1 header).' };
    }
    const barStrs = parts.slice(1).filter((p) => p.length > 0);
    if (barStrs.length === 0) return { error: 'That form code has no bars in it.' };
    const form = [];
    for (let i = 0; i < barStrs.length; i++) {
      const m = barStrs[i].match(/^(\d+)\/(\d+):([ANSM]+)(!?)$/);
      if (!m) return { error: 'Bar ' + (i + 1) + ' is malformed: “' + barStrs[i] + '”' };
      const beats = +m[1], unit = +m[2], chars = m[3];
      if (beats < 1 || beats > 32) return { error: 'Bar ' + (i + 1) + ': beats must be 1–32.' };
      if (unit < 1 || unit > 32) return { error: 'Bar ' + (i + 1) + ': unit must be 1–32.' };
      if (chars.length !== beats) {
        return { error: 'Bar ' + (i + 1) + ': has ' + chars.length + ' beat states but the time signature says ' + beats + '.' };
      }
      form.push({
        beats, unit,
        states: chars.split('').map((c) => CHAR_TO_BEAT[c]),
        breakAfter: m[4] === '!',
      });
    }
    return { form };
  }

  document.getElementById('form-code-copy').addEventListener('click', async () => {
    const code = encodeFormCode();
    try {
      await navigator.clipboard.writeText(code);
    } catch (e) {
      const ta = document.createElement('textarea');
      ta.value = code; ta.style.position = 'fixed'; ta.style.opacity = '0';
      document.body.appendChild(ta); ta.select();
      try { document.execCommand('copy'); } catch (_) {}
      document.body.removeChild(ta);
    }
    const btn = document.getElementById('form-code-copy');
    btn.classList.add('copied');
    setTimeout(() => btn.classList.remove('copied'), 1400);
  });

  document.getElementById('form-code-load').addEventListener('click', () => {
    const input = document.getElementById('form-code-input');
    const msg = document.getElementById('form-code-msg');
    const result = decodeFormCode(input.value);
    if (result.error) {
      msg.textContent = result.error;
      msg.className = 'form-code-msg error';
      return;
    }
    saveFormHistory();
    adv.form = result.form;
    formEditingIdx = -1;
    renderFormEditor();
    input.value = '';
    const n = result.form.length;
    msg.textContent = 'Loaded ' + n + ' bar' + (n !== 1 ? 's' : '') + '.';
    msg.className = 'form-code-msg success';
  });

  // Sync the editor's play buttons with the existing transport.
  function refreshFormEditorPlayButtons() {
    const label = state.isPlaying ? '■ Stop' : '▶ Start';
    formEditorPlayBtns.forEach((b) => { if (b) b.textContent = label; });
    // Don't clobber the BPM field while the user is typing into it — this
    // refresh runs on a 200ms interval. When the field isn't focused,
    // keep it synced to state.bpm so +/- and main-page changes show up.
    if (document.activeElement !== formEditorBpmEl) {
      formEditorBpmEl.textContent = state.bpm;
    }
  }
  formEditorPlayBtns.forEach((b) => {
    if (!b) return;
    b.addEventListener('click', () => {
      if (state.isPlaying) stopMetronome(); else startMetronome();
      refreshFormEditorPlayButtons();
      // Re-render the grid so the active-bar highlight kicks in.
      if (formEditorModal.getAttribute('aria-hidden') === 'false') renderFormEditor();
    });
  });

  // When the scheduler advances to a new bar, refresh the active highlight.
  // Hook into the existing form-counter update site by polling lightly while
  // the editor is open.
  let formEditorActiveIdx = -1;
  setInterval(() => {
    if (formEditorModal.getAttribute('aria-hidden') !== 'false') return;
    if (advFormIdx !== formEditorActiveIdx) {
      formEditorActiveIdx = advFormIdx;
      formEditorGrid.querySelectorAll('.form-bar').forEach((card) => {
        card.classList.toggle('active', +card.dataset.idx === advFormIdx && state.isPlaying);
      });
      refreshFormEditorPlayButtons();
    } else {
      refreshFormEditorPlayButtons();
    }
  }, 200);

  init();
</script>
</Layout>
