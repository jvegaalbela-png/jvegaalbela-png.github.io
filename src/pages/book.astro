---
// Unlisted booking page (noindex). Linked from the secondary
// "Book Your Half-Price Lesson" CTAs on /drum-lessons. Uses the
// shared LessonForm component with the lesson-type and location
// radio fieldsets enabled so we collect a bit more detail than
// the slim hero form does.
import '../styles/lessons.css';
import Layout from '../layouts/Layout.astro';
import LessonForm from '../components/LessonForm.astro';
---

<Layout
  title="Book Your Half-Price Lesson — Jacobo Vega-Albela"
  description="Book your half-price first drum lesson with Jacobo Vega-Albela in Rochester, NY. Tell me a few details and I'll be in touch ASAP."
  themeColor="#091528"
  noindex={true}
>

<section class="book-hero">
  <div class="book-wrap">
    <p class="hero-eyebrow">Half-Price First Lesson</p>
    <h1>Let's set up your <em>first lesson</em>.</h1>
    <p class="hero-sub">Fill out a few details and I'll be in touch ASAP. Your first lesson is half off — just <strong>$25</strong> for an hour or <strong>$15</strong> for thirty minutes.</p>

    <LessonForm
      formId="xjglgjjj"
      formIdSlug="book-lesson-form"
      showLessonType={true}
      showLocation={true}
      submitEvent="lesson_inquiry_submit"
      submitEventParams={{ form_location: 'book_page' }}
    />

    <div class="book-aside">
      <a class="tel-link" href="tel:+15858024247" aria-label="Text or call 5 8 5, 8 0 2, 4 2 4 7">Text or call (585) 802-4247</a>
      <p class="trust-line">Google Business Screened &nbsp;·&nbsp; Background-checked &amp; verified</p>
      <p class="book-back"><a href="/drum-lessons">&larr; Back to drum lessons</a></p>
    </div>
  </div>
</section>

</Layout>

<style>
  .book-hero {
    background: var(--navy);
    color: var(--cream);
    padding: calc(var(--header-h) + clamp(1.5rem, 4vw, 3rem)) 0 clamp(2.5rem, 6vw, 4.5rem);
    min-height: calc(100vh - 0px);
    position: relative;
    overflow: hidden;
  }
  .book-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 60% 80% at 85% 110%, rgba(26,58,138,.45), transparent 60%),
      radial-gradient(ellipse 40% 50% at 5% -10%, rgba(232,101,10,.16), transparent 55%);
  }
  .book-wrap {
    position: relative;
    max-width: 560px;
    margin: 0 auto;
    padding: 0 var(--pad);
  }
  .book-hero h1 {
    font-family: var(--serif);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -.01em;
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 0.75rem;
  }
  .book-hero h1 em {
    font-style: italic;
    color: var(--blue-lt);
  }
  .book-hero .hero-sub {
    font-size: clamp(1rem, 1.5vw, 1.0625rem);
    line-height: 1.55;
    color: rgba(245, 243, 238, .82);
    max-width: 48ch;
    margin-bottom: 1.5rem;
  }
  .book-hero .hero-sub strong {
    color: var(--cream);
    font-weight: 600;
  }
  .book-aside {
    display: flex;
    flex-direction: column;
    gap: .875rem;
    margin-top: 1rem;
  }
  .book-aside .trust-line {
    margin-top: 0;
  }
  .book-back {
    margin-top: 0.5rem;
    font-size: .8125rem;
  }
  .book-back a {
    color: rgba(245, 243, 238, 0.65);
    text-decoration: none;
    border-bottom: 1px solid rgba(245, 243, 238, 0.2);
    padding-bottom: 1px;
    transition: color .15s, border-color .15s;
  }
  .book-back a:hover {
    color: var(--cream);
    border-color: var(--cream);
  }
  @media (max-width: 600px) {
    .book-hero { padding-top: calc(var(--header-h) + 16px); padding-bottom: 2.5rem; }
    .book-hero h1 { font-size: 2rem; }
  }
</style>
