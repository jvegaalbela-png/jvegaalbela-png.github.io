    </div><!-- /.card.card-form -->

    <div class="form-editor-shell" id="form-editor-shell">
      <div class="card form-select-bar" id="form-select-bar" aria-hidden="true">
        <span class="form-select-status" id="form-select-status">Tap the first bar of the range</span>
