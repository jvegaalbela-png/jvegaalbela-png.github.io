<!-- ══════════════════════════════════════════ PRACTICE GUIDE
     Body content is CMS-editable via Sveltia (src/content/metronome-guide/
     practice-guide.mdx) — edit the article's copy there, not here. Section
     headings keep their explicit ids as raw HTML in that file (Astro's
     markdown pipeline doesn't auto-slug headings), since the FAQ/HowTo
     JSON-LD above and in-page links (e.g. #odd-meters) depend on them. -->
<article class="metronome-prose" aria-labelledby="guide-intro" id="practice-guide">
  <div class="metronome-prose-inner">
    <p class="prose-eyebrow" id="guide-intro">Practice guide</p>

    <GuideContent />
  </div>
</article>

<!-- Floating play pill. Auto-hides when the main Pulse-tab play button
     (#play-stop) is visible in the viewport — so it only appears when
     play access from the current scroll/tab needs a shortcut. -->
<button class="metronome-play-pill is-hidden" id="play-pill" type="button" aria-label="Start metronome">
  <span class="metronome-play-pill-icon" aria-hidden="true">▶</span>
  <span class="metronome-play-pill-label">Start</span>
</button>

<!-- Floating toast: visible from any carousel tab while background audio is rendering -->
<div class="bg-render-toast" id="bg-render-status-bar" hidden aria-live="polite">
  <span class="bg-render-toast-dot"></span>
  <span class="bg-render-toast-text">Preparing background audio&hellip;</span>
</div>


<script>
  // ─── State ───────────────────────────────────────────────────────────────────
  const state = {
    bpm: 120,
    beatsPerMeasure: 4,
    beatUnit: 4,
    subdivision: 1,
    subCustom: false,   // true when the "Custom" subdivision option is active
    subPattern: [],     // booleans, length = subdivision; index 0 is the beat (always on)
    subFollowMute: false, // when true, subdivisions go silent on muted beats
    customCount: 4,     // remembered Custom count, so toggling presets ↔ custom is stable
    swingPct: 50,
    beats: [],        // 'accent' | 'normal' | 'soft' | 'mute'
    isPlaying: false,
    currentBeat: -1,
    currentSub: 0,
  };

  // ─── Advanced Mode State ──────────────────────────────────────────────────────
  const adv = {
    enabled: false,
    gapEnabled: false, gapPlay: 2, gapSilent: 2, gapUnit: 'measure',
    randomMuteEnabled: false, randomMutePct: 30, randomMuteSubPct: 0,
    formEnabled: false,
    form: [],   // [{ beats, unit, states[] }]
  };

  let soundMode = 'electronic'; // 'electronic' | 'clave'

  // Scheduler-side advanced state (runs SCHEDULE_AHEAD_S ahead of audio time)
  let advGapPhase = 'play';   // 'play' | 'silent'
  let advGapCount = 0;
  let advFormIdx = 0;
  // When set ({ lo, hi }), the scheduler loops only that bar range
  // instead of the whole form — drives "loop selection".
  let loopRange = null;

  // ─── Audio ───────────────────────────────────────────────────────────────────
  let audioCtx = null;
  let nextNoteTime = 0.0;
  let schedulerTimer = null;
  let schedulerBeat = 0;
  let schedulerSub = 0;
  // The subdivision the scheduler is actually playing right now. These are
  // committed from state at each beat boundary (not the instant the user
  // clicks), so changing the subdivision mid-beat lets the current beat
  // finish on its existing grid and the new subdivision takes over from the
  // next downbeat. The primary pulse never gets nudged.
  let schedulerSubdivision = 1;
  let schedulerSubCustom = false;
  let schedulerSubPattern = [];
  const pendingVisuals = [];

  // ─── Background Mode state ────────────────────────────────────────────────────
  //
  // Hybrid playback. In the foreground the realtime Web Audio scheduler runs as
  // always. iOS suspends Web Audio rendering whenever the page is hidden (screen
  // lock, app switch) no matter how far ahead nodes are scheduled — the only
  // audio pipeline it keeps alive is an <audio> element playing real media. So
  // when the page hides, playback hot-swaps to a pre-rendered WAV in a looping
  // <audio> element, phase-matched to the realtime position; when the page is
  // visible again it swaps back.
  // iOS (including iPadOS, which reports as MacIntel with touch) is the only
  // platform that suspends page audio while hidden; everywhere else the
  // realtime scheduler keeps running with the screen off and none of this
  // machinery is needed — so background mode is simply automatic on iOS.
  const IS_IOS = /iPad|iPhone|iPod/.test(navigator.userAgent) ||
    (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
  const bgModeEnabled = IS_IOS;
  let wakeLockUserEnabled = true;      // user toggle
  let bgSilentEl = null;               // <audio loop> near-silence keep-alive (holds the
                                       // iOS audio session + gives ~2 s JS wakes while hidden)
  // Two click elements alternate A→B→A… for gapless looping. Each plays the
  // same WAV: BG_LEAD_S of silence, then the rendered pattern. While one
  // plays the pattern's tail, the watchdog starts the other somewhere in its
  // silent lead, then trims it into sample alignment by seeking during the
  // silence — so the exact moment clicks resume is decided by the media
  // clock, not by iOS's throttled JS timers.
  let bgClickEls = [null, null];
  let bgClickIdx = 0;                  // index of the active element
  let bgBlobUrl = null;                // object URL of the current rendered WAV
  let bgPatternDur = 0;                // rendered pattern length (seconds, excludes lead)
  let bgLeadDur = 0;                   // silent lead baked into the current WAV
  let bgPlayOnce = false;              // over-cap form: play once and stop, no handoff
  let bgEventTimeline = [];            // [{time,beat,sub,clickType,formIdx,gapPhase,gapCount}]
  let bgLoopBase = 0;                  // formIdx offset when rendering a loop-selection slice
  let bgRerenderTimer = null;          // debounce timer for settings-change re-render
  let bgRenderGeneration = 0;          // incremented each render; stale renders self-cancel
  let bgRenderInFlight = false;        // a render is currently running
  let bgRenderReady = false;           // the click elements' src matches the latest settings
  let bgLastCfgKey = '';               // settings fingerprint of the last completed render
  let bgActiveMode = 'realtime';       // 'realtime' | 'element'
  let bgWaitingForRender = false;      // page hid before the render finished
  let bgWatchdogTimer = null;          // background self-heal interval

  const LOOKAHEAD_MS = 25;
  const SCHEDULE_AHEAD_S = 0.1;
  const BG_TARGET_SECS = 300;          // min render length: keeps handoffs ~5 min apart and
                                       // makes random-mute repetition imperceptible
  const BG_MAX_RENDER_S = 600;         // hard cap; over-long forms play once and stop
  const BG_RERENDER_DEBOUNCE_MS = 400;
  const BG_WATCHDOG_MS = 1000;         // iOS throttles this to ~2 s in background — fine
  const BG_LEAD_S = 10;                // silent lead on each render for handoff pre-roll
  const BG_HANDOFF_WINDOW_S = 8;       // start pre-rolling when this close to the end;
                                       // must comfortably exceed the throttled wake gap
  const BG_RENDER_SR = 22050;          // render sample rate: highest click component is
                                       // the 3.3 kHz clave ping, so half rate loses nothing
                                       // audible and halves render/encode/blob size

  // Master gain for every realtime click. At the hand-off to background
  // playback it ramps to silence in a few ms, so the ≤125 ms of already-
  // scheduled clicks neither double up with the <audio> element nor get
  // chopped mid-waveform when iOS suspends the context (an abrupt cut is
  // audible as a crunch/crackle).
  let rtMasterGain = null;

  function getAudioCtx() {
    if (!audioCtx) {
      audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      rtMasterGain = audioCtx.createGain();
      rtMasterGain.connect(audioCtx.destination);
    }
    // iOS Safari can drop the context into 'interrupted' (a phone call,
    // the device locking, sometimes a rotation) as well as 'suspended';
    // both need a resume() to get audio flowing again.
    if (audioCtx.state === 'suspended' || audioCtx.state === 'interrupted') {
      audioCtx.resume();
    }
    return audioCtx;
  }

  // iOS silent-switch bypass.
  //
  // Web Audio on iOS Safari outputs through the "ringer" audio channel,
  // which the physical silent switch mutes — so the click goes silent
  // even though media volume is up. HTML5 <audio> elements use the
  // "media" channel, which the silent switch doesn't affect. Playing
  // a tiny silent <audio> loop in parallel forces iOS to route the
  // entire page (Web Audio included) through the media channel, so
  // the metronome plays at media volume regardless of the switch.
  //
  // Scoped to iOS — Android Web Audio already uses the media channel.
  // The audio.play() call has to originate from a user gesture, which
  // is why this is called from startMetronome (the play button's click
  // handler) rather than from getAudioCtx (called by the scheduler).
  let iosSilentBypassEl = null;
  function ensureIOSSilentBypass() {
    if (!IS_IOS) return;

    if (!iosSilentBypassEl) {
      // Construct a tiny silent WAV blob inline — 0.5 s of 16-bit mono
      // silence at 8 kHz. No external file needed, ~8 KB.
      const sampleRate = 8000;
      const numFrames = sampleRate / 2;
      const dataSize = numFrames * 2;
      const buf = new ArrayBuffer(44 + dataSize);
      const dv = new DataView(buf);
      const writeStr = (off, s) => {
        for (let i = 0; i < s.length; i++) dv.setUint8(off + i, s.charCodeAt(i));
      };
      writeStr(0, 'RIFF');                    dv.setUint32(4, 36 + dataSize, true);
      writeStr(8, 'WAVE');                    writeStr(12, 'fmt ');
      dv.setUint32(16, 16, true);             dv.setUint16(20, 1, true);
      dv.setUint16(22, 1, true);              dv.setUint32(24, sampleRate, true);
      dv.setUint32(28, sampleRate * 2, true); dv.setUint16(32, 2, true);
      dv.setUint16(34, 16, true);             writeStr(36, 'data');
      dv.setUint32(40, dataSize, true);
      // Data is already zeros — that's the silence.

      iosSilentBypassEl = document.createElement('audio');
      iosSilentBypassEl.loop = true;
      iosSilentBypassEl.preload = 'auto';
      iosSilentBypassEl.playsInline = true;
      iosSilentBypassEl.src = URL.createObjectURL(new Blob([buf], { type: 'audio/wav' }));
    }
    iosSilentBypassEl.play().catch(() => {});
  }

  // ─── Sound Library ───────────────────────────────────────────────────────────
  function scheduleClick(time, type) {
    if (type === 'mute') return;
    if (soundMode === 'clave') { scheduleClave(time, type); return; }
    scheduleElectronic(time, type);
  }

  // Thin wrappers used by the realtime scheduler — delegate to the
  // context-agnostic versions defined further below so both the live
  // scheduler and the offline render use identical synthesis code.
  function scheduleElectronic(time, type) {
    const ctx = getAudioCtx();
    scheduleElectronicCtx(ctx, time, type, rtMasterGain);
  }

  function scheduleClave(time, type) {
    const ctx = getAudioCtx();
    scheduleClaveCtx(ctx, time, type, rtMasterGain);
  }

  function getAdvConfig() {
    if (adv.formEnabled && adv.form.length > 0) {
      // Clamp advFormIdx — the form can shrink (delete, clear, undo,
      // form-code load) while playing, leaving advFormIdx pointing past
      // the end. An out-of-range read here used to throw and kill the
      // scheduler loop entirely (no more audio until restart).
      if (advFormIdx < 0 || advFormIdx >= adv.form.length) advFormIdx = 0;
      const e = adv.form[advFormIdx];
      return { beatsPerMeasure: e.beats, beats: e.states, beatUnit: e.unit };
    }
    return { beatsPerMeasure: state.beatsPerMeasure, beats: state.beats, beatUnit: state.beatUnit };
  }

  function scheduler() {
    // While hidden in background mode, the <audio> element owns playback.
    if (bgActiveMode === 'element') return;
    // The whole body is guarded so a transient error in one tick can't
    // permanently stop the loop — the reschedule below always runs.
    try {
    const ctx = getAudioCtx();

    while (nextNoteTime < ctx.currentTime + SCHEDULE_AHEAD_S) {
      const beat = schedulerBeat;
      const sub  = schedulerSub;
      const time = nextNoteTime;
      const cfg  = getAdvConfig();

      // Commit the live subdivision settings at each beat boundary. Within a
      // beat the scheduler keeps using the values it started the beat with,
      // so a mid-beat change can't shorten or stretch the current beat.
      if (sub === 0) {
        schedulerSubdivision = state.subdivision;
        schedulerSubCustom   = state.subCustom;
        schedulerSubPattern  = state.subPattern.slice();
      }

      let clickType;
      if (sub === 0) {
        const s = cfg.beats[beat] || 'normal';
        clickType = s === 'mute' ? 'mute' : s === 'accent' ? 'accent' : s === 'soft' ? 'soft' : 'beat';
      } else {
        clickType = 'sub';
        // Custom subdivision pattern: silence the inner steps the user
        // toggled off, so rhythmic patterns can be baked into the beat.
        if (schedulerSubCustom && schedulerSubPattern[sub] === false) clickType = 'mute';
      }

      // Follow-beat-mute: when on, a muted beat also silences its
      // subdivisions instead of leaving the inner pulses ticking.
      if (sub !== 0 && state.subFollowMute && (cfg.beats[beat] || 'normal') === 'mute') {
        clickType = 'mute';
      }

      if (adv.gapEnabled && advGapPhase === 'silent') clickType = 'mute';

      if (adv.randomMuteEnabled && clickType !== 'mute') {
        const p = sub === 0 ? adv.randomMutePct : adv.randomMuteSubPct;
        if (p > 0 && Math.random() < p / 100) clickType = 'mute';
      }

      scheduleClick(time, clickType);
      const vis = {
        beat, sub, time, clickType,
        formIdx: advFormIdx,
        gapPhase: advGapPhase,
        gapCount: advGapCount,
      };
      // Carry the beat's committed subdivision on its downbeat so the visual
      // loop can swap the sub-dot indicator exactly when the audio swaps.
      if (sub === 0) {
        vis.subdivision = schedulerSubdivision;
        vis.subCustom = schedulerSubCustom;
        vis.subPattern = schedulerSubPattern;
      }
      pendingVisuals.push(vis);

      // BPM is interpreted as quarter notes per minute (the standard
      // notation convention: ♩ = bpm). The actual tick rate scales by
      // (4 / beatUnit), so an x/8 meter ticks twice as fast as x/4 at
      // the same BPM, x/16 ticks four times as fast, x/2 ticks half as
      // fast, etc.
      // Per-step duration. For duplet subdivision (sub=2) with swing != 50,
      // the two halves of the beat are uneven: sub 0 is followed by a gap of
      // (S/100)·beat, sub 1 by (1 - S/100)·beat — keeping the total beat
      // length constant. Other subdivisions stay even.
      {
        const beatDur = (60.0 / state.bpm) * (4 / cfg.beatUnit);
        let stepDur;
        if (schedulerSubdivision === 2 && !schedulerSubCustom && state.swingPct !== 50) {
          const s = state.swingPct / 100;
          stepDur = schedulerSub === 0 ? beatDur * s : beatDur * (1 - s);
        } else {
          stepDur = beatDur / schedulerSubdivision;
        }
        nextNoteTime += stepDur;
      }

      schedulerSub++;
      if (schedulerSub >= schedulerSubdivision) {
        schedulerSub = 0;
        schedulerBeat++;
        // Beats-mode gap counter: tick once per beat (fires on every
        // beat rollover, not just at the bar line).
        if (adv.gapEnabled && adv.gapUnit === 'beat') {
          advGapCount++;
          if (advGapPhase === 'play'   && advGapCount >= adv.gapPlay)   { advGapPhase = 'silent'; advGapCount = 0; }
          else if (advGapPhase === 'silent' && advGapCount >= adv.gapSilent) { advGapPhase = 'play';   advGapCount = 0; }
        }
        if (schedulerBeat >= cfg.beatsPerMeasure) {
          schedulerBeat = 0;
          // Measures-mode gap counter: ticks once per measure (the original behavior).
          if (adv.gapEnabled && adv.gapUnit !== 'beat') {
            advGapCount++;
            if (advGapPhase === 'play'   && advGapCount >= adv.gapPlay)   { advGapPhase = 'silent'; advGapCount = 0; }
            else if (advGapPhase === 'silent' && advGapCount >= adv.gapSilent) { advGapPhase = 'play';   advGapCount = 0; }
          }
          if (adv.formEnabled && adv.form.length > 0) {
            // Drop a stale loop range if the form shrank under it.
            if (loopRange && (loopRange.hi >= adv.form.length || loopRange.lo > loopRange.hi)) {
              loopRange = null;
            }
            if (loopRange) {
              advFormIdx = advFormIdx >= loopRange.hi ? loopRange.lo : advFormIdx + 1;
            } else {
              advFormIdx = (advFormIdx + 1) % adv.form.length;
            }
          }
        }
      }
    }
    } catch (e) {
      console.error('metronome scheduler error', e);
    }

    schedulerTimer = setTimeout(scheduler, LOOKAHEAD_MS);
  }

  // Screen Wake Lock — keep the device awake while the metronome is running,
  // otherwise the screen sleeping (and on most mobile browsers, the audio
  // context with it) would silence the click. Mobile browsers don't reliably
  // keep Web Audio scheduling alive once the screen is fully off, so the best
  // we can do is prevent the screen from auto-locking during playback.
  let wakeLock = null;
  async function requestWakeLock() {
    if (!('wakeLock' in navigator)) return;
    if (!wakeLockUserEnabled) return;
    try {
      wakeLock = await navigator.wakeLock.request('screen');
      wakeLock.addEventListener('release', () => { wakeLock = null; });
    } catch (_) {
      wakeLock = null;
    }
  }
  async function releaseWakeLock() {
    if (!wakeLock) return;
    try { await wakeLock.release(); } catch (_) {}
    wakeLock = null;
  }
  // Hide → hand playback to the pre-rendered <audio> element (the only audio
  // pipeline iOS keeps alive with the screen off). Show → hand it back to the
  // realtime Web Audio scheduler, phase-matched. Also re-request the wake lock,
  // which the OS releases whenever the tab hides.
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'hidden') {
      if (state.isPlaying && bgModeEnabled) enterBgPlayback();
    } else if (state.isPlaying) {
      if (!wakeLock) requestWakeLock();
      if (bgModeEnabled) exitBgPlayback();
    }
  });

  // pageshow fires on iOS when returning from a cached page (back/forward cache).
  window.addEventListener('pageshow', (e) => {
    if (e.persisted && state.isPlaying && bgModeEnabled) {
      exitBgPlayback();
    }
  });

  function startMetronome(fromFormIdx) {
    const ctx = getAudioCtx();
    // A stop while hidden can leave the master gain faded out — reset it.
    if (rtMasterGain) {
      rtMasterGain.gain.cancelScheduledValues(ctx.currentTime);
      rtMasterGain.gain.setValueAtTime(1, ctx.currentTime);
    }
    ensureIOSSilentBypass();
    state.isPlaying = true;
    schedulerBeat = 0;
    schedulerSub  = 0;
    schedulerSubdivision = state.subdivision;
    schedulerSubCustom   = state.subCustom;
    schedulerSubPattern  = state.subPattern.slice();
    advGapPhase   = 'play';
    advGapCount   = 0;
    // Normal play starts at bar 0; "play from selection" / "loop
    // selection" pass the bar to start on.
    advFormIdx    = (typeof fromFormIdx === 'number' && fromFormIdx >= 0) ? fromFormIdx : 0;
    nextNoteTime  = ctx.currentTime + 0.05;
    pendingVisuals.length = 0;
    bgActiveMode = 'realtime';
    scheduler();
    requestAnimationFrame(visualLoop);
    updatePlayButton();
    requestWakeLock();

    if (bgModeEnabled) {
      // Arm both <audio> elements inside this user gesture so iOS allows the
      // async play() calls that happen later without a gesture (screen lock,
      // lock-screen controls, watchdog recovery).
      armBgElements();
      startBgRender();
      startBgWatchdog();
      updateMediaSession();
    }
  }

  function stopMetronome() {
    state.isPlaying = false;
    const hadLoop = !!loopRange;
    loopRange = null;  // any range-loop ends when playback stops

    // Stop the background elements and cancel any in-flight render.
    for (const el of bgClickEls) {
      if (el) { el.pause(); try { el.currentTime = 0; } catch (_) {} }
    }
    if (bgSilentEl) bgSilentEl.pause();
    updateBgRenderStatus(false);
    bgActiveMode = 'realtime';
    bgRenderGeneration++;
    bgRenderReady = false;     // settings can change while stopped; re-render on next start
    bgWaitingForRender = false;
    clearTimeout(bgRerenderTimer);
    stopBgWatchdog();

    clearTimeout(schedulerTimer);
    pendingVisuals.length = 0;
    state.currentBeat = -1;
    state.currentSub  = 0;
    applyBeatVisuals(-1, 0, null, 0);
    // A subdivision change made mid-beat is deferred during playback; once
    // stopped, settle the dots onto the current selection right away.
    renderSubDots();
    updatePlayButton();
    updateGapVisual('idle', 0);
    updateFormVisual(-1);
    if (adv.formEnabled && adv.form.length > 0) renderBeatGridForEntry(adv.form[0]);
    // Drop the looping-range highlight now that the loop has ended.
    if (hadLoop && formEditorModal.getAttribute('aria-hidden') === 'false') renderFormEditor();
    releaseWakeLock();
  }

  function togglePlay() {
    state.isPlaying ? stopMetronome() : startMetronome();
  }

  // ─── Visual Loop ─────────────────────────────────────────────────────────────
  function visualLoop() {
    if (!state.isPlaying) return;
    // While hidden in background mode the <audio> element owns playback;
    // exitBgPlayback re-arms this loop when the page is visible again.
    if (bgActiveMode === 'element') return;
    const ctx = getAudioCtx();
    const now = ctx.currentTime;

    while (pendingVisuals.length && pendingVisuals[0].time <= now) {
      const v = pendingVisuals.shift();
      state.currentBeat = v.beat;
      state.currentSub  = v.sub;
      // Repaint the sub-dot indicator on the downbeat to match the
      // subdivision this beat is actually playing, so a deferred change
      // appears in sync with the audio (not the instant it was clicked).
      if (v.sub === 0 && v.subdivision != null) {
        renderSubDots(v.subdivision, v.subCustom, v.subPattern);
      }
      applyBeatVisuals(v.beat, v.sub, v.clickType, v.formIdx);
      if (v.beat === 0 && v.sub === 0) {
        updateGapVisual(v.gapPhase, v.gapCount);
        updateFormVisual(v.formIdx);
      }
    }

    requestAnimationFrame(visualLoop);
  }

  function applyBeatVisuals(beat, sub, clickType, formIdx) {
    document.querySelectorAll('.beat-btn').forEach((el, i) => {
      el.classList.toggle('active', i === beat && sub === 0);
    });

    document.querySelectorAll('.sub-dot').forEach((dot, i) => {
      dot.classList.remove('active', 'active-accent');
      if (i === sub) dot.classList.add(clickType === 'accent' ? 'active-accent' : 'active');
    });

    const flash1 = document.getElementById('beat-flash');
    const flash2 = document.getElementById('beat-flash-2');
    flash1.className = 'beat-flash';
    flash2.className = 'beat-flash';

    if (sub === 0 && clickType !== 'mute') {
      const cls = clickType === 'accent' ? 'on-accent' : clickType === 'soft' ? 'on-soft' : 'on-beat';
      flash1.classList.add(cls);
      flash2.classList.add(cls);
      setTimeout(() => { flash1.className = 'beat-flash'; flash2.className = 'beat-flash'; }, 120);
    }
  }

  // ─── BPM ─────────────────────────────────────────────────────────────────────
  const TEMPO_MARKS = [
    [24,  'Larghissimo'],
    [39,  'Grave'],
    [54,  'Largo'],
    [64,  'Larghetto'],
    [74,  'Adagio'],
    [79,  'Adagietto'],
    [93,  'Andante'],
    [107, 'Andantino'],
    [119, 'Moderato'],
    [129, 'Allegretto'],
    [167, 'Allegro'],
    [179, 'Vivace'],
    [199, 'Presto'],
    [500, 'Prestissimo'],
  ];

  function getTempoName(bpm) {
    for (const [max, name] of TEMPO_MARKS) if (bpm <= max) return name;
    return 'Prestissimo';
  }

  // Wire a span/element to behave like a tap-to-edit number: tap selects
  // all (so the next keypress replaces), Enter or blur commits, Escape
  // reverts. inputmode triggers the iOS numeric/decimal keypad. Used by
  // every slider's value readout so they're directly editable in addition
  // to the slider/preset controls.
  function wireEditableNumber(el, opts) {
    if (!el) return;
    const { min, max, isFloat = false, format = (v) => String(v), current, onCommit } = opts;
    el.addEventListener('click', () => {
      setTimeout(() => {
        const r = document.createRange();
        r.selectNodeContents(el);
        const s = window.getSelection();
        s.removeAllRanges();
        s.addRange(r);
      }, 0);
    });
    el.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') { e.preventDefault(); el.blur(); }
      else if (e.key === 'Escape') { e.preventDefault(); el.textContent = format(current()); el.blur(); }
    });
    el.addEventListener('blur', () => {
      let raw = el.textContent.replace(isFloat ? /[^\d.]/g : /\D/g, '');
      let v = isFloat ? parseFloat(raw) : parseInt(raw, 10);
      if (!isFinite(v)) v = current();
      v = Math.max(min, Math.min(max, v));
      el.textContent = format(v);
      onCommit(v);
    });
  }

  // Render a bpm as "120" when integer, "120.5" when fractional. Used
  // wherever state.bpm gets pushed to the DOM, so trailing .0 never
  // shows up uselessly.
  function formatBpm(bpm) {
    return Number.isInteger(bpm) ? String(bpm) : bpm.toFixed(1);
  }

  function setBPM(value) {
    // Snap to 0.1 precision — fine enough to be useful for typing a
    // decimal BPM, coarse enough that float drift doesn't accumulate
    // weird trailing-digit displays.
    const snapped = Math.round(value * 10) / 10;
    state.bpm = Math.max(1, Math.min(500, snapped));
    document.getElementById('bpm-display').textContent = formatBpm(state.bpm);
    // Slider's visual position rounds to the nearest int (the slider
    // itself has integer step). When state.bpm is fractional from a
    // typed value, the slider sits at the nearest int rather than
    // showing the same float (which different browsers would handle
    // inconsistently with a step=1 input).
    document.getElementById('bpm-slider').value = Math.round(state.bpm);
    document.getElementById('tempo-name').textContent = getTempoName(state.bpm);
    persistState();
  }

  // Slider and ±1 / ±5 buttons stay strictly integer — decimal BPMs are
  // only reachable by typing into the bpm-display. When the current
  // state is fractional (e.g. user typed 120.5), nudging discards the
  // fraction and snaps to the nearest integer in the chosen direction,
  // so the UI stays clean for incidental clicks.
  document.getElementById('bpm-slider').addEventListener('input', e => setBPM(Math.round(+e.target.value)));
  document.getElementById('bpm-minus1').addEventListener('click', () => setBPM(Math.ceil(state.bpm) - 1));
  document.getElementById('bpm-plus1').addEventListener('click', () => setBPM(Math.floor(state.bpm) + 1));
  document.getElementById('bpm-minus5').addEventListener('click', () => setBPM(Math.ceil(state.bpm) - 5));
  document.getElementById('bpm-plus5').addEventListener('click', () => setBPM(Math.floor(state.bpm) + 5));

  const bpmEl = document.getElementById('bpm-display');
  bpmEl.addEventListener('focus', () => {
    const range = document.createRange();
    range.selectNodeContents(bpmEl);
    const sel = window.getSelection();
    sel.removeAllRanges();
    sel.addRange(range);
  });
  bpmEl.addEventListener('blur', () => {
    const val = parseFloat(bpmEl.textContent.replace(/[^\d.]/g, ''));
    setBPM(isNaN(val) ? 120 : val);
  });
  bpmEl.addEventListener('keydown', e => {
    if (e.key === 'Enter') { e.preventDefault(); bpmEl.blur(); }
    if (e.key === ' ') { e.preventDefault(); togglePlay(); }
    // Allow digits, one decimal point, and editing keys. Block a
    // second '.' so the field can't end up with multiple periods.
    if (e.key === '.') {
      if (bpmEl.textContent.includes('.')) e.preventDefault();
      return;
    }
    if (!/^[0-9]$/.test(e.key) && !['Backspace','Delete','ArrowLeft','ArrowRight','Tab'].includes(e.key)) {
      e.preventDefault();
    }
  });

  // Tap Tempo — fire on pointerdown so the tap registers when the finger
  // contacts the screen (not on lift), which is what users intuitively time
  // to a beat. Combined with `touch-action: manipulation` on .btn, this also
  // sidesteps mobile double-tap zoom on rapid taps.
  let tapTimes = [];
  function registerTap() {
    const now = Date.now();
    tapTimes.push(now);
    tapTimes = tapTimes.filter(t => now - t < 4000).slice(-8);
    if (tapTimes.length >= 2) {
      const intervals = [];
      for (let i = 1; i < tapTimes.length; i++) intervals.push(tapTimes[i] - tapTimes[i - 1]);
      const avg = intervals.reduce((a, b) => a + b, 0) / intervals.length;
      setBPM(Math.round(60000 / avg));
    }
  }
  const tapBtn = document.getElementById('tap-tempo');
  tapBtn.addEventListener('pointerdown', e => {
    e.preventDefault();
    registerTap();
  });
  // Enter activates the tap button via keyboard. Space is reserved for the
  // global play/stop shortcut, so don't register a tap on Space here.
  tapBtn.addEventListener('keydown', e => {
    if (e.key === 'Enter') {
      e.preventDefault();
      registerTap();
    }
  });

  // ─── Time Signature ───────────────────────────────────────────────────────────
  // Denominators 2, 4, 8, and 16 are the everyday meters (half, quarter,
  // eighth, sixteenth notes). Everything else — whole-note beats (1),
  // 32nd-note beats, and the non-power-of-two "irrational" denominators
  // (3, 5, 6, 7, 9, …) used in contemporary classical and modern jazz —
  // lives under an "Advanced" optgroup so the everyday choices stay
  // un-cluttered at the top of the dropdown.
  const COMMON_UNITS = [2, 4, 8, 16];

  function buildUnitOptions(sel, currentVal) {
    sel.innerHTML = '';
    const common = document.createElement('optgroup');
    common.label = 'Common';
    for (const v of COMMON_UNITS) {
      const o = document.createElement('option');
      o.value = v; o.textContent = v;
      if (v === currentVal) o.selected = true;
      common.appendChild(o);
    }
    sel.appendChild(common);

    const advanced = document.createElement('optgroup');
    advanced.label = 'Advanced';
    for (let i = 1; i <= 32; i++) {
      if (COMMON_UNITS.includes(i)) continue;
      const o = document.createElement('option');
      o.value = i; o.textContent = i;
      if (i === currentVal) o.selected = true;
      advanced.appendChild(o);
    }
    sel.appendChild(advanced);
  }

  function populateUnitSelect(id, currentVal) {
    const sel = document.getElementById(id);
    if (!sel) return;
    buildUnitOptions(sel, currentVal);
  }

  // Compound and odd-meter defaults: the dotted-quarter pulse in 6/8,
  // 9/8, and 12/8, and the common claves in 5/4 (3+2), 5/8 (3+2),
  // 7/4 (4+3), and 7/8 (2+2+3). Beat 1 is the strongest accent; group
  // starts after that are normal; the rest are soft, so the listener
  // hears beat 1, the pulse, and the inner-beat feel layered together.
  // Returns null for meters that should fall back to the simple "accent
  // on 1, normal elsewhere" pattern.
  function defaultBeatsForSig(beats, unit) {
    if (unit === 4) {
      if (beats === 5) return ['accent','soft','soft','normal','soft'];                // 3+2
      if (beats === 7) return ['accent','soft','soft','soft','normal','soft','soft'];  // 4+3
    }
    if (unit === 8) {
      if (beats === 5)  return ['accent','soft','soft','normal','soft'];
      if (beats === 6)  return ['accent','soft','soft','normal','soft','soft'];
      if (beats === 7)  return ['accent','soft','normal','soft','normal','soft','soft'];
      if (beats === 9)  return ['accent','soft','soft','normal','soft','soft','normal','soft','soft'];
      if (beats === 12) return ['accent','soft','soft','normal','soft','soft','normal','soft','soft','normal','soft','soft'];
    }
    if (unit === 16) {
      // At 16th-note pulse, soft inner beats blur into a wash — mute them
      // so only the structural beats (accent + grouping pulse) are audible.
      if (beats === 3) return ['accent','mute','mute'];                                  // one fast group
      if (beats === 5) return ['accent','mute','mute','normal','mute'];                  // 3+2
      if (beats === 7) return ['accent','mute','normal','mute','normal','mute','mute'];  // 2+2+3
    }
    return null;
  }

  function setTimeSig(beats, unit, applyDefault = false) {
    beats = Math.max(1, Math.min(32, Math.round(beats)));
    const prev = state.beats;
    const sameSig = beats === state.beatsPerMeasure && unit === state.beatUnit;
    state.beatsPerMeasure = beats;
    state.beatUnit = unit;

    let newBeats;
    if (applyDefault && !sameSig) {
      // Preset-button click on a new meter: apply the common default
      // for known clave/compound meters, or a clean [accent, normal, ...]
      // for everything else. Wipe customizations from the previous meter
      // so 6/8 → 7/4 doesn't leave 6/8's soft beats hanging on the front.
      const preset = defaultBeatsForSig(beats, unit);
      if (preset) {
        newBeats = preset.slice();
      } else {
        newBeats = Array(beats).fill('normal');
        newBeats[0] = 'accent';
      }
    } else {
      // Custom-input edit or re-click on the active preset: preserve
      // the current pattern, padding any new slots with normal.
      newBeats = [];
      for (let i = 0; i < beats; i++) {
        newBeats.push(i < prev.length ? prev[i] : 'normal');
      }
      if (prev.length === 0) newBeats[0] = 'accent';
    }
    state.beats = newBeats;

    if (state.currentBeat >= beats) state.currentBeat = -1;

    document.getElementById('beats-input').value = beats;
    document.getElementById('unit-select').value = unit;

    document.querySelectorAll('#time-sig-presets .btn-sig').forEach(btn => {
      btn.classList.toggle('active',
        +btn.dataset.beats === beats && +btn.dataset.unit === unit);
    });
    syncCustomSigButton(beats, unit);

    renderBeatGrid();
    renderSubDots();
    persistState();
  }

  // The Custom button (and its fields) light up whenever the current
  // signature doesn't match any preset, so it's always clear which mode
  // is engaged — preset or custom.
  function syncCustomSigButton(beats, unit) {
    const isPreset = [...document.querySelectorAll('#time-sig-presets .btn-sig')]
      .some(btn => +btn.dataset.beats === beats && +btn.dataset.unit === unit);
    document.getElementById('time-sig-custom-btn').classList.toggle('active', !isPreset);
    document.querySelector('.custom-sig').classList.toggle('custom-active', !isPreset);
  }

  document.querySelectorAll('#time-sig-presets .btn-sig').forEach(btn => {
    btn.addEventListener('click', () => setTimeSig(+btn.dataset.beats, +btn.dataset.unit, true));
  });

  document.getElementById('beats-input').addEventListener('change', e => {
    setTimeSig(+e.target.value, state.beatUnit);
  });
  document.getElementById('unit-select').addEventListener('change', e => {
    setTimeSig(state.beatsPerMeasure, +e.target.value);
  });
  // Clicking Custom applies whatever the fields hold and drops focus into
  // the beats input (which select-alls itself) so the user can type the
  // meter straight away.
  document.getElementById('time-sig-custom-btn').addEventListener('click', () => {
    const bi = document.getElementById('beats-input');
    setTimeSig(+bi.value, +document.getElementById('unit-select').value);
    bi.focus();
  });

  // ─── Subdivision ──────────────────────────────────────────────────────────────
  const SUB_NAMES = {
    2: 'Duplet', 3: 'Triplet', 4: 'Quadruplet', 5: 'Quintuplet', 6: 'Sextuplet',
    7: 'Septuplet', 8: 'Octuplet', 9: 'Nonuplet',
  };
  function subdivisionName(n) { return SUB_NAMES[n] || (n + ' per beat'); }

  // Keep state.subPattern sized to n. Index 0 is the beat itself (always on —
  // its sound is governed by the Beats menu); new inner steps default to on.
  function ensureSubPattern(n) {
    const prev = state.subPattern || [];
    const next = [];
    for (let i = 0; i < n; i++) next[i] = i === 0 ? true : (prev[i] === undefined ? true : !!prev[i]);
    state.subPattern = next;
  }

  // sub: a preset count (1,2,3,4,6); custom: true selects the Custom option,
  // which uses state.customCount and the programmable on/off pattern.
  function setSubdivision(sub, custom) {
    custom = !!custom;
    state.subCustom = custom;
    if (custom) {
      const n = Math.max(2, Math.min(32, state.customCount || 4));
      state.customCount = n;
      state.subdivision = n;
      ensureSubPattern(n);
    } else {
      state.subdivision = sub;
    }
    document.querySelectorAll('.btn-sub').forEach(btn => {
      const isCustomBtn = btn.dataset.sub === 'custom';
      btn.classList.toggle('active', custom ? isCustomBtn : (!isCustomBtn && +btn.dataset.sub === state.subdivision));
    });
    document.getElementById('sub-custom-panel').hidden = !custom;
    // Swing only affects the duplet *preset*; dim it for everything else.
    document.getElementById('swing-controls').classList.toggle('inactive', !(state.subdivision === 2 && !custom));
    // Follow-beat-mute only matters when there are subdivisions to silence.
    document.getElementById('sub-followmute').classList.toggle('inactive', state.subdivision <= 1);
    if (custom) renderSubCountUI();
    renderSubPatternGrid();
    refreshSubDots();
    persistState();
  }

  function renderSubCountUI() {
    const slider = document.getElementById('sub-count-slider');
    if (+slider.value !== state.subdivision) slider.value = state.subdivision;
    document.getElementById('sub-count-val').textContent = String(state.subdivision);
    document.getElementById('sub-count-name').textContent = subdivisionName(state.subdivision);
  }

  function renderSubPatternGrid() {
    const grid = document.getElementById('sub-pattern-grid');
    if (!grid) return;
    grid.innerHTML = '';
    if (!state.subCustom) return;
    ensureSubPattern(state.subdivision);
    state.subPattern.forEach((on, i) => {
      const cell = document.createElement('button');
      cell.type = 'button';
      if (i === 0) {
        cell.className = 'sub-cell sub-cell-beat';
        cell.textContent = '◆';
        cell.title = 'Beat — set its sound in the Beats menu';
        cell.setAttribute('aria-label', 'Beat (controlled by the Beats menu)');
        cell.tabIndex = -1;
      } else {
        cell.className = 'sub-cell ' + (on ? 'on' : 'off');
        cell.textContent = on ? '●' : '○';
        cell.title = 'Subdivision ' + (i + 1) + ' — ' + (on ? 'on (tap to mute)' : 'off (tap to play)');
        cell.setAttribute('aria-pressed', on ? 'true' : 'false');
        cell.addEventListener('click', () => {
          state.subPattern[i] = !state.subPattern[i];
          renderSubPatternGrid();
          refreshSubDots();
          persistState();
        });
      }
      grid.appendChild(cell);
    });
  }

  document.querySelectorAll('.btn-sub').forEach(btn => {
    btn.addEventListener('click', () => {
      if (btn.dataset.sub === 'custom') setSubdivision(state.customCount, true);
      else setSubdivision(+btn.dataset.sub, false);
    });
  });

  document.getElementById('sub-count-slider').addEventListener('input', (e) => {
    const n = Math.max(2, Math.min(32, parseInt(e.target.value, 10) || 4));
    state.customCount = n;
    state.subdivision = n;
    ensureSubPattern(n);
    renderSubCountUI();
    renderSubPatternGrid();
    refreshSubDots();
    persistState();
  });
  wireEditableNumber(document.getElementById('sub-count-val'), {
    min: 2, max: 32,
    current: () => state.subdivision,
    onCommit: (v) => {
      state.customCount = v;
      state.subdivision = v;
      ensureSubPattern(v);
      renderSubCountUI();
      renderSubPatternGrid();
      refreshSubDots();
      persistState();
    },
  });
  document.getElementById('sub-followmute-toggle').addEventListener('change', (e) => {
    state.subFollowMute = e.target.checked;
    persistState();
  });

  // ─── Swing ────────────────────────────────────────────────────────────────────
  // Pure UI sync — used by both preset clicks, slider drags, and init().
  // Caller decides whether to persist.
  function setSwingPct(v) {
    v = Math.max(50, Math.min(75, +v || 50));
    state.swingPct = v;
    const slider = document.getElementById('swing-slider');
    if (Math.abs(+slider.value - v) > 0.001) slider.value = v;
    document.getElementById('swing-val').textContent = String(Math.round(v * 10) / 10);
    document.querySelectorAll('.swing-preset').forEach((b) => {
      const pv = +b.dataset.swing;
      b.classList.toggle('active', Math.abs(pv - v) < 0.01);
    });
  }
  document.getElementById('swing-slider').addEventListener('input', (e) => {
    setSwingPct(+e.target.value);
    persistState();
  });
  document.querySelectorAll('.swing-preset').forEach((btn) => {
    btn.addEventListener('click', () => {
      setSwingPct(+btn.dataset.swing);
      persistState();
    });
  });

  // ─── Beat Grid ────────────────────────────────────────────────────────────────
  const STATE_CYCLE = { normal: 'accent', accent: 'soft', soft: 'mute', mute: 'normal' };
  const STATE_ICONS = { normal: '●', accent: '▲', soft: '○', mute: '✕' };

  function renderBeatGrid() {
    const grid = document.getElementById('beat-grid');
    grid.innerHTML = '';

    state.beats.forEach((beatState, i) => {
      const btn = document.createElement('button');
      const isActive = state.isPlaying && state.currentBeat === i && state.currentSub === 0;
      btn.className = 'beat-btn state-' + beatState + (isActive ? ' active' : '');
      btn.innerHTML = '<span class="beat-num">' + (i + 1) + '</span><span class="beat-icon">' + STATE_ICONS[beatState] + '</span>';
      btn.title = 'Beat ' + (i + 1) + ': ' + beatState + ' — click to change';

      btn.addEventListener('click', () => {
        state.beats[i] = STATE_CYCLE[state.beats[i]];
        btn.className = 'beat-btn state-' + state.beats[i] + (btn.classList.contains('active') ? ' active' : '');
        btn.querySelector('.beat-icon').textContent = STATE_ICONS[state.beats[i]];
        persistState();
      });

      grid.appendChild(btn);
    });
  }

  // Defaults to the live state, but the visual loop passes the beat's
  // committed snapshot so the dots track the audio through a deferred change.
  function renderSubDots(count, custom, pattern) {
    if (count == null) count = state.subdivision;
    if (custom == null) custom = state.subCustom;
    if (pattern == null) pattern = state.subPattern;
    const container = document.getElementById('sub-indicators');
    container.innerHTML = '';
    if (count <= 1) return;
    for (let i = 0; i < count; i++) {
      const dot = document.createElement('div');
      dot.className = 'sub-dot';
      if (custom && i > 0 && pattern[i] === false) dot.classList.add('off');
      container.appendChild(dot);
    }
  }

  // While playing, the dots are driven by the scheduler at each beat
  // boundary (see visualLoop), so a control change shouldn't repaint them
  // mid-beat — that would jump ahead of the audio. When stopped, repaint now.
  function refreshSubDots() {
    if (!state.isPlaying) renderSubDots();
  }

  // ─── Play Button ──────────────────────────────────────────────────────────────
  function updatePlayButton() {
    ['play-stop', 'play-stop-form'].forEach(id => {
      const btn = document.getElementById(id);
      if (!btn) return;
      btn.textContent = state.isPlaying ? '■ Stop' : '▶ Start';
      btn.classList.toggle('playing', state.isPlaying);
    });
    // Floating play pill (persists across all carousel screens)
    const pill = document.getElementById('play-pill');
    if (pill) {
      const playing = state.isPlaying;
      pill.querySelector('.metronome-play-pill-icon').textContent = playing ? '■' : '▶';
      pill.querySelector('.metronome-play-pill-label').textContent = playing ? 'Stop' : 'Start';
      pill.classList.toggle('is-playing', playing);
      pill.setAttribute('aria-label', playing ? 'Stop metronome' : 'Start metronome');
    }
  }

  document.getElementById('play-stop').addEventListener('click', togglePlay);
  document.getElementById('play-stop-form').addEventListener('click', togglePlay);

  document.addEventListener('keydown', e => {
    if (e.code === 'Space' && document.activeElement !== bpmEl) {
      const tag = document.activeElement && document.activeElement.tagName;
      if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
      // Don't start/stop the click underneath the reset-confirm dialog.
      const resetOverlay = document.getElementById('reset-confirm');
      if (resetOverlay && !resetOverlay.hidden) return;
      e.preventDefault();
      togglePlay();
    }
  });

  // ─── Reset to defaults ──────────────────────────────────────────────────────
  // The ↺ button in the Tempo header opens a confirm dialog; confirming wipes
  // the persisted settings (but NOT the saved-forms library) and reloads the
  // page bare — location.replace drops any share-link params from the URL so
  // they don't re-import the state that was just cleared.
  (() => {
    const overlay = document.getElementById('reset-confirm');
    const openBtn = document.getElementById('reset-defaults-btn');
    if (!overlay || !openBtn) return;
    const close = () => { overlay.hidden = true; };
    openBtn.addEventListener('click', () => {
      overlay.hidden = false;
      document.getElementById('reset-cancel-btn').focus();
    });
    document.getElementById('reset-cancel-btn').addEventListener('click', close);
    overlay.addEventListener('click', (e) => { if (e.target === overlay) close(); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !overlay.hidden) close();
    });
    document.getElementById('reset-confirm-btn').addEventListener('click', () => {
      if (state.isPlaying) togglePlay();
      [STORAGE_KEY, 'metronomeCarouselScreen_v1', 'metronomeFormEditorMode_v1', 'metronomeBgPrefs_v1']
        .forEach((k) => { try { localStorage.removeItem(k); } catch (_) {} });
      location.replace(location.pathname);
    });
  })();

  // ─── Advanced Mode ────────────────────────────────────────────────────────────

  function updateGapVisual(phase, count) {
    const pill = document.getElementById('gap-phase-pill');
    const prog = document.getElementById('gap-phase-progress');
    if (!pill || !prog) return;
    if (phase === 'idle' || !adv.gapEnabled || !state.isPlaying) {
      pill.className = 'phase-pill';
      pill.textContent = '● Waiting';
      prog.textContent = '';
      return;
    }
    const unitWord = adv.gapUnit === 'beat' ? 'beat' : 'measure';
    if (phase === 'play') {
      pill.className = 'phase-pill play';
      pill.textContent = '▶ Playing';
      const left = adv.gapPlay - count;
      prog.textContent = left + ' ' + unitWord + (left !== 1 ? 's' : '') + ' left';
    } else {
      pill.className = 'phase-pill silent';
      pill.textContent = '● Silent';
      const left = adv.gapSilent - count;
      prog.textContent = left + ' ' + unitWord + (left !== 1 ? 's' : '') + ' left';
    }
  }

  let lastRenderedFormIdx = -1;

  function updateFormVisual(formIdx) {
    if (!adv.formEnabled || adv.form.length === 0) return;
    document.querySelectorAll('.form-group-header').forEach(h => {
      h.classList.toggle('form-active', formIdx >= +h.dataset.start && formIdx <= +h.dataset.end);
    });
    document.querySelectorAll('.form-row[data-idx]').forEach(row => {
      row.classList.toggle('form-active', +row.dataset.idx === formIdx);
    });
    const active = document.querySelector('.form-group-header.form-active');
    if (active) active.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    updateFormCounter(formIdx);
    if (formIdx !== lastRenderedFormIdx && formIdx >= 0) {
      lastRenderedFormIdx = formIdx;
      renderBeatGridForEntry(adv.form[formIdx]);
    }
  }

  function updateFormCounter(formIdx) {
    const el = document.getElementById('form-counter');
    if (!el) return;
    if (adv.form.length === 0) { el.textContent = ''; return; }
    el.textContent = state.isPlaying && formIdx >= 0
      ? 'Measure ' + (formIdx + 1) + ' of ' + adv.form.length
      : adv.form.length + ' measure' + (adv.form.length !== 1 ? 's' : '');
  }

  function renderBeatGridForEntry(entry) {
    const grid = document.getElementById('beat-grid');
    grid.innerHTML = '';
    entry.states.forEach((beatState, i) => {
      const btn = document.createElement('button');
      const isActive = state.isPlaying && state.currentBeat === i && state.currentSub === 0;
      btn.className = 'beat-btn state-' + beatState + (isActive ? ' active' : '');
      btn.innerHTML = '<span class="beat-num">' + (i + 1) + '</span><span class="beat-icon">' + STATE_ICONS[beatState] + '</span>';
      btn.addEventListener('click', () => {
        entry.states[i] = STATE_CYCLE[entry.states[i]];
        btn.className = 'beat-btn state-' + entry.states[i] + (btn.classList.contains('active') ? ' active' : '');
        btn.querySelector('.beat-icon').textContent = STATE_ICONS[entry.states[i]];
      });
      grid.appendChild(btn);
    });
  }

  const expandedGroups = new Set();

  function groupForm() {
    const groups = [];
    let i = 0;
    while (i < adv.form.length) {
      const start = i;
      const { beats, unit } = adv.form[i];
      while (i < adv.form.length && adv.form[i].beats === beats && adv.form[i].unit === unit) i++;
      groups.push({ beats, unit, start, end: i - 1, count: i - start });
    }
    return groups;
  }

  function makeFormRow(entry, idx) {
    const row = document.createElement('div');
    row.className = 'form-row';
    row.dataset.idx = idx;

    const numSpan = document.createElement('span');
    numSpan.className = 'form-row-num';
    numSpan.textContent = idx + 1;

    const beatsIn = document.createElement('input');
    beatsIn.type = 'number'; beatsIn.min = 1; beatsIn.max = 32;
    beatsIn.value = entry.beats;
    beatsIn.className = 'form-beats-input';

    const slash = document.createElement('span');
    slash.className = 'form-slash';
    slash.textContent = '/';

    const unitSel = document.createElement('select');
    unitSel.className = 'form-unit-select';
    buildUnitOptions(unitSel, entry.unit);

    const delBtn = document.createElement('button');
    delBtn.className = 'form-delete-btn';
    delBtn.textContent = '✕';
    delBtn.title = 'Remove this measure';

    beatsIn.addEventListener('change', () => {
      const b = Math.max(1, Math.min(32, +beatsIn.value));
      beatsIn.value = b;
      saveFormHistory();
      const prev = entry.states.slice();
      entry.beats = b;
      entry.states = Array(b).fill('normal').map((_, i) => i < prev.length ? prev[i] : 'normal');
      if (prev.length === 0) entry.states[0] = 'accent';
      expandedGroups.clear();
      renderFormList(); updateFormCounter(advFormIdx);
    });
    unitSel.addEventListener('change', () => {
      saveFormHistory(); entry.unit = +unitSel.value;
      expandedGroups.clear(); renderFormList();
    });
    delBtn.addEventListener('click', () => {
      if (adv.form.length <= 1) return;
      saveFormHistory();
      adv.form.splice(idx, 1);
      if (advFormIdx >= adv.form.length) advFormIdx = adv.form.length - 1;
      expandedGroups.clear(); renderFormList(); updateFormCounter(advFormIdx);
    });

    row.append(numSpan, beatsIn, slash, unitSel, delBtn);
    return row;
  }

  function renderFormList() {
    const list = document.getElementById('form-list');
    if (!list) return;
    list.innerHTML = '';
    const groups = groupForm();

    groups.forEach(group => {
      const isExpanded = expandedGroups.has(group.start);

      const header = document.createElement('div');
      header.className = 'form-group-header';
      header.dataset.start = group.start;
      header.dataset.end   = group.end;
      if (state.isPlaying && advFormIdx >= group.start && advFormIdx <= group.end)
        header.classList.add('form-active');

      const rangeSpan = document.createElement('span');
      rangeSpan.className = 'form-group-range';
      rangeSpan.textContent = group.count === 1
        ? String(group.start + 1)
        : (group.start + 1) + '–' + (group.end + 1);

      const meterSpan = document.createElement('span');
      meterSpan.className = 'form-group-meter';
      meterSpan.textContent = group.beats + '/' + group.unit;

      const countSpan = document.createElement('span');
      countSpan.className = 'form-group-count';
      countSpan.textContent = '×' + group.count;

      const expandBtn = document.createElement('button');
      expandBtn.className = 'form-expand-btn';
      expandBtn.textContent = isExpanded ? '▲' : '▾';
      expandBtn.title = isExpanded ? 'Collapse' : 'Expand to edit individual measures';

      const delGroupBtn = document.createElement('button');
      delGroupBtn.className = 'form-delete-btn';
      delGroupBtn.title = 'Remove all ' + group.count + ' measure' + (group.count > 1 ? 's' : '');
      delGroupBtn.textContent = '✕';

      header.append(rangeSpan, meterSpan, countSpan, expandBtn, delGroupBtn);
      list.appendChild(header);

      if (isExpanded) {
        for (let idx = group.start; idx <= group.end; idx++) {
          const row = makeFormRow(adv.form[idx], idx);
          if (state.isPlaying && idx === advFormIdx) row.classList.add('form-active');
          list.appendChild(row);
        }
      }

      expandBtn.addEventListener('click', () => {
        if (expandedGroups.has(group.start)) expandedGroups.delete(group.start);
        else expandedGroups.add(group.start);
        renderFormList();
      });

      delGroupBtn.addEventListener('click', () => {
        saveFormHistory();
        adv.form.splice(group.start, group.count);
        if (adv.form.length === 0)
          adv.form.push({ beats: 4, unit: 4, states: ['accent','normal','normal','normal'] });
        if (advFormIdx >= adv.form.length) advFormIdx = adv.form.length - 1;
        expandedGroups.clear(); renderFormList(); updateFormCounter(advFormIdx);
      });
    });

    updateFormCounter(advFormIdx);
  }

  function addFormMeasure() {
    saveFormHistory();
    const last = adv.form[adv.form.length - 1] || { beats: 4, unit: 4 };
    const states = Array(last.beats).fill('normal');
    states[0] = 'accent';
    adv.form.push({ beats: last.beats, unit: last.unit, states });
    renderFormList();
    updateFormCounter(advFormIdx);
  }

  // ─── Sound Library UI ────────────────────────────────────────────────────────
  document.querySelectorAll('.btn-sound').forEach(btn => {
    btn.addEventListener('click', () => {
      soundMode = btn.dataset.sound;
      document.querySelectorAll('.btn-sound').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      persistState();
    });
  });

  // ─── Form Undo / Redo ─────────────────────────────────────────────────────────
  let formHistory = [];
  let formHistoryIdx = -1;

  // formHistory is a stack of JSON snapshots of adv.form; formHistory
  // [formHistoryIdx] always mirrors the current form. The editor's
  // mutation handlers call saveFormHistory() BEFORE they mutate, so the
  // actual snapshot is deferred to a microtask — by the time it runs the
  // handler has finished and adv.form holds the post-mutation state.
  // Identical snapshots are skipped so a no-op edit leaves no dead entry
  // (and doesn't clobber the redo branch).
  function saveFormHistory() {
    queueMicrotask(() => {
      const snapshot = JSON.stringify(adv.form);
      if (formHistory[formHistoryIdx] === snapshot) return;
      formHistory = formHistory.slice(0, formHistoryIdx + 1);
      formHistory.push(snapshot);
      if (formHistory.length > 80) formHistory.shift();
      formHistoryIdx = formHistory.length - 1;
      refreshUndoRedoBtns();
      persistState();
    });
  }

  function refreshUndoRedoBtns() {
    const u = document.getElementById('form-editor-undo');
    const r = document.getElementById('form-editor-redo');
    if (u) u.disabled = formHistoryIdx <= 0;
    if (r) r.disabled = formHistoryIdx >= formHistory.length - 1;
  }

  // Shared by the toolbar buttons and the keyboard shortcuts.
  function applyHistoryState() {
    adv.form = JSON.parse(formHistory[formHistoryIdx]);
    // The bar that was being edited / the selection range may not exist
    // in the restored form — clear that transient UI state.
    formEditingIdx = -1;
    selectMode = false;
    selectionAnchor = -1;
    selectionEnd = -1;
    const selBar = document.getElementById('form-select-bar');
    if (selBar) selBar.setAttribute('aria-hidden', 'true');
    renderFormEditor();
    refreshUndoRedoBtns();
    persistState();
  }

  function doFormUndo() {
    if (formHistoryIdx <= 0) return;
    formHistoryIdx--;
    applyHistoryState();
  }

  function doFormRedo() {
    if (formHistoryIdx >= formHistory.length - 1) return;
    formHistoryIdx++;
    applyHistoryState();
  }

  document.getElementById('form-editor-undo').addEventListener('click', doFormUndo);
  document.getElementById('form-editor-redo').addEventListener('click', doFormRedo);

  // Ctrl/Cmd+Z to undo, Ctrl/Cmd+Y (or Ctrl/Cmd+Shift+Z) to redo — only
  // while the editor is open, and not while a text field is focused so
  // inputs keep their own native text undo.
  document.addEventListener('keydown', (e) => {
    if (formEditorModal.getAttribute('aria-hidden') !== 'false') return;
    if (!(e.ctrlKey || e.metaKey)) return;
    const t = e.target;
    if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)) return;
    const k = e.key.toLowerCase();
    if (k === 'z' && !e.shiftKey) { e.preventDefault(); doFormUndo(); }
    else if (k === 'y' || (k === 'z' && e.shiftKey)) { e.preventDefault(); doFormRedo(); }
  });

  // ─── Form Save / Load ─────────────────────────────────────────────────────────
  document.getElementById('form-save').addEventListener('click', () => {
    const payload = {
      version: 1,
      form: adv.form.map(e => ({ beats: e.beats, unit: e.unit, states: e.states.slice() }))
    };
    const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
    const url  = URL.createObjectURL(blob);
    const a    = document.createElement('a');
    a.href = url; a.download = 'metronome-form.json'; a.click();
    URL.revokeObjectURL(url);
  });

  document.getElementById('form-load-input').addEventListener('change', e => {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = evt => {
      try {
        const data = JSON.parse(evt.target.result);
        if (data.version === 1 && Array.isArray(data.form) && data.form.length > 0) {
          saveFormHistory();
          adv.form = data.form.map(entry => {
            const b = Math.max(1, Math.min(32, +entry.beats || 4));
            const u = Math.max(1, Math.min(32, +entry.unit  || 4));
            const s = Array.isArray(entry.states) ? entry.states.slice() : Array(b).fill('normal');
            if (s.length < b) for (let i = s.length; i < b; i++) s.push('normal');
            return { beats: b, unit: u, states: s.slice(0, b) };
          });
          renderFormList(); updateFormCounter(0);
          lastRenderedFormIdx = -1;
          if (adv.formEnabled) renderBeatGridForEntry(adv.form[0]);
        } else {
          alert('Invalid metronome form file.');
        }
      } catch (_) { alert('Could not read file.'); }
    };
    reader.readAsText(file);
    e.target.value = '';
  });

  // ─── Form Bulk Add ────────────────────────────────────────────────────────────
  document.getElementById('bulk-add-btn').addEventListener('click', () => {
    const count = Math.max(1, +document.getElementById('bulk-count').value || 1);
    const beats = Math.max(1, Math.min(32, +document.getElementById('bulk-beats').value || 4));
    const unit  = Math.max(1, Math.min(32, +document.getElementById('bulk-unit').value  || 4));
    saveFormHistory();
    for (let i = 0; i < count; i++) {
      const states = Array(beats).fill('normal');
      states[0] = 'accent';
      adv.form.push({ beats, unit, states });
    }
    renderFormList(); updateFormCounter(advFormIdx);
  });

  // ─── Carousel navigation ─────────────────────────────────────────────────────
  // Three horizontally-snapping screens: Pulse / Practice / Forms. Tabs at the
  // top reflect the active screen as the user swipes; clicking a tab scrolls
  // smoothly to that screen. Active screen index is persisted to localStorage
  // so a reload lands on the same tab. The returned API lets init() jump to a
  // specific screen — e.g. share-link arrival should land on Forms.
  const Carousel = (() => {
    const track = document.getElementById('carousel-track');
    if (!track) return { setScreen() {} };
    const carouselEl = track.parentElement; // .metronome-carousel (holds the sticky tabs)
    const screens = Array.from(track.querySelectorAll('.carousel-screen'));
    const tabs = Array.from(document.querySelectorAll('.carousel-tab'));
    const KEY = 'metronomeCarouselScreen_v1';

    function setActive(idx) {
      tabs.forEach((t, i) => {
        const on = i === idx;
        t.classList.toggle('active', on);
        t.setAttribute('aria-selected', String(on));
      });
      try { localStorage.setItem(KEY, String(idx)); } catch (_) {}
    }
    // Horizontal-only scroll to a screen. Element.scrollIntoView() touches
    // BOTH axes (it'll yank the page vertically to align the screen's top
    // with the viewport when you tap a tab) — we only want the carousel
    // track to slide left/right, leaving the vertical scroll to us.
    function scrollToScreen(idx, smooth) {
      const target = screens[idx];
      if (!target) return;
      // offsetLeft inside the flex track gives us the screen's start
      // position; scrollTo on the track moves only the track's content.
      track.scrollTo({ left: target.offsetLeft, behavior: smooth ? 'smooth' : 'instant' });
    }

    // ── Per-screen vertical scroll memory ──────────────────────────────
    // All three screens stretch to the tallest one's height (Pulse), so
    // scrolling down on Pulse and swiping to Practice/Forms leaves you
    // staring at their empty lower halves. We remember each screen's
    // vertical scroll position: leaving a screen stashes its scrollY,
    // arriving at a screen restores it (0 until the user has scrolled it).
    // Net effect: Practice/Forms snap to their top, and returning to Pulse
    // lands you back where you were.
    let currentScreen = 0;
    const scrollMemory = screens.map(() => 0);
    // Suppress the swipe-sync observer while WE drive the track (tab
    // clicks, load restore, setScreen) so screens we pass over don't fire
    // spurious scroll saves/restores.
    let programmatic = false;

    // The document scroll position at which the sticky tabs pin to the top
    // of the viewport — i.e. the carousel container's own offset from the
    // top of the document (the H1 header sits above it). The container box
    // stays put while only its sticky child pins, so rect.top + scrollY is
    // invariant and safe to read at any scroll position.
    function tabsPinnedScroll() {
      const rect = carouselEl.getBoundingClientRect();
      return Math.max(0, Math.round(rect.top + window.scrollY));
    }
    // The scroll target for a screen: its remembered position, but never
    // less than the tabs-pinned baseline. Keeps the tab selector at a
    // fixed spot across switches (the H1 stays tucked above) instead of
    // bouncing between "below the H1" and "pinned to top".
    function targetScrollFor(idx) {
      return Math.max(scrollMemory[idx] || 0, tabsPinnedScroll());
    }

    function applyScreenScroll(idx) {
      window.scrollTo({ top: targetScrollFor(idx), left: 0, behavior: 'instant' });
    }
    // Central transition: stash the outgoing screen's scroll, flip the
    // active tab, restore the incoming screen's scroll. `outgoingY` lets
    // tab clicks pass a scrollY captured before the browser's focus-scroll
    // perturbs it; swipes omit it and use the live value.
    function changeScreen(idx, outgoingY) {
      if (idx === currentScreen) return;
      scrollMemory[currentScreen] = (outgoingY != null) ? outgoingY : window.scrollY;
      currentScreen = idx;
      setActive(idx);
      // Defer the vertical restore one frame so a swipe's horizontal
      // scroll-snap has settled and the long prose article's
      // content-visibility heights are final before we set scrollY —
      // otherwise the target can drift a few dozen px.
      requestAnimationFrame(() => applyScreenScroll(idx));
    }

    // Tab clicks: capture scrollY on mousedown (before focus fires), slide
    // the carousel, then re-assert the incoming screen's scroll across the
    // next frame + timeouts to override the browser's sticky-button
    // focus-scroll. Mouse/touch clicks blur the tab so it stops stealing
    // focus; keyboard activations (e.detail === 0) keep focus.
    let preTapY = 0;
    function capturePreTap() { preTapY = window.scrollY; }
    tabs.forEach((t, i) => {
      t.addEventListener('mousedown', capturePreTap);
      t.addEventListener('touchstart', capturePreTap, { passive: true });
      t.addEventListener('click', (e) => {
        const outgoingY = preTapY;
        if (e.detail !== 0) t.blur();
        programmatic = true;
        scrollToScreen(i, true);
        changeScreen(i, outgoingY);
        const targetY = targetScrollFor(i);
        const snap = () => { if (window.scrollY !== targetY) window.scrollTo({ top: targetY, left: 0 }); };
        snap();
        requestAnimationFrame(snap);
        setTimeout(snap, 100);
        setTimeout(() => { snap(); programmatic = false; }, 400);
      });
    });
    // Sync the active tab (and apply scroll memory) as the user swipes.
    const io = new IntersectionObserver((entries) => {
      if (programmatic) return;
      // Pick the screen whose center is closest to the track's center.
      let best = null, bestRatio = 0;
      entries.forEach((e) => {
        if (e.intersectionRatio > bestRatio) { best = e; bestRatio = e.intersectionRatio; }
      });
      if (best && bestRatio > 0.5) changeScreen(screens.indexOf(best.target));
    }, { root: track, threshold: [0.5, 0.75, 1.0] });
    screens.forEach((s) => io.observe(s));

    // Restore the last-active screen on load (default = Pulse). The page
    // loads at scrollY 0, so there's nothing to stash — set currentScreen
    // directly and just slide the track.
    let restore = 0;
    try { const v = parseInt(localStorage.getItem(KEY), 10); if (v >= 0 && v < screens.length) restore = v; } catch (_) {}
    if (restore !== 0) {
      currentScreen = restore;
      requestAnimationFrame(() => {
        programmatic = true;
        scrollToScreen(restore, false);
        setActive(restore);
        setTimeout(() => { programmatic = false; }, 120);
      });
    }

    return {
      setScreen(idx) {
        if (idx < 0 || idx >= screens.length) return;
        requestAnimationFrame(() => {
          programmatic = true;
          scrollToScreen(idx, false);
          changeScreen(idx);
          setTimeout(() => { programmatic = false; }, 120);
        });
      },
    };
  })();

  // ─── Floating play pill ──────────────────────────────────────────────────────
  // Persistent play/stop affordance in the bottom-right. Auto-hides whenever
  // the Pulse-tab's main play button (#play-stop) is visible in the viewport
  // — so it only appears when the primary control isn't reachable (user is
  // scrolled past it OR is on Practice / Forms tab, where #play-stop is
  // off-screen horizontally inside the carousel).
  (() => {
    const pill = document.getElementById('play-pill');
    if (!pill) return;
    pill.addEventListener('click', () => togglePlay());
    const primary = document.getElementById('play-stop');
    if (primary && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          pill.classList.toggle('is-hidden', e.isIntersecting);
        }
      }, { threshold: 0.1 });
      io.observe(primary);
    } else {
      // No IO: just always show the pill.
      pill.classList.remove('is-hidden');
    }
  })();

  document.getElementById('gap-toggle').addEventListener('change', e => {
    adv.gapEnabled = e.target.checked;
    document.getElementById('gap-controls').classList.toggle('disabled', !adv.gapEnabled);
    if (!adv.gapEnabled) updateGapVisual('idle', 0);
    persistState();
  });

  // Pure UI sync for the gap-unit pill — used by both the user-initiated
  // click handlers and by init()'s DOM reflection. Caller decides whether
  // to also reset playback state / persist.
  function setGapUnit(unit) {
    if (unit !== 'measure' && unit !== 'beat') return;
    adv.gapUnit = unit;
    const isBeat = unit === 'beat';
    document.getElementById('gap-unit-measure').classList.toggle('active', !isBeat);
    document.getElementById('gap-unit-measure').setAttribute('aria-pressed', String(!isBeat));
    document.getElementById('gap-unit-beat').classList.toggle('active', isBeat);
    document.getElementById('gap-unit-beat').setAttribute('aria-pressed', String(isBeat));
    const word = isBeat ? 'beats' : 'measures';
    document.getElementById('gap-play-unit').textContent = word;
    document.getElementById('gap-silent-unit').textContent = word;
  }
  function pickGapUnit(unit) {
    setGapUnit(unit);
    // Flipping mid-playback: reset the phase + count so we don't apply a
    // stale measure-count to a beat threshold (or vice versa).
    advGapPhase = 'play';
    advGapCount = 0;
    persistState();
  }
  document.getElementById('gap-unit-measure').addEventListener('click', () => pickGapUnit('measure'));
  document.getElementById('gap-unit-beat').addEventListener('click', () => pickGapUnit('beat'));

  document.getElementById('gap-play-slider').addEventListener('input', e => {
    adv.gapPlay = +e.target.value;
    document.getElementById('gap-play-val').textContent = adv.gapPlay;
    persistState();
  });

  document.getElementById('gap-silent-slider').addEventListener('input', e => {
    adv.gapSilent = +e.target.value;
    document.getElementById('gap-silent-val').textContent = adv.gapSilent;
    persistState();
  });

  document.getElementById('random-mute-toggle').addEventListener('change', e => {
    adv.randomMuteEnabled = e.target.checked;
    document.getElementById('random-mute-controls').classList.toggle('disabled', !adv.randomMuteEnabled);
    persistState();
  });

  document.getElementById('random-mute-slider').addEventListener('input', e => {
    adv.randomMutePct = +e.target.value;
    document.getElementById('random-mute-val').textContent = adv.randomMutePct;
    persistState();
  });

  document.getElementById('random-mute-sub-slider').addEventListener('input', e => {
    adv.randomMuteSubPct = +e.target.value;
    document.getElementById('random-mute-sub-val').textContent = adv.randomMuteSubPct;
    persistState();
  });

  document.getElementById('form-toggle').addEventListener('change', e => {
    adv.formEnabled = e.target.checked;
    document.getElementById('form-controls').classList.toggle('disabled', !adv.formEnabled);
    lastRenderedFormIdx = -1;
    if (adv.formEnabled && adv.form.length > 0) renderBeatGridForEntry(adv.form[0]);
    else renderBeatGrid();
    updateFormCounter(advFormIdx);
    persistState();
  });

  document.getElementById('add-measure-btn').addEventListener('click', addFormMeasure);

  // ─── Persistence ──────────────────────────────────────────────────────────────
  //
  // Two layers, layered on top of each other:
  //   - localStorage: silent auto-save of EVERYTHING (including custom forms).
  //     Survives a tab close. No user action required.
  //   - URL query string: encodes the basic state — BPM, time signature, beat
  //     pattern, subdivision, sound mode, gap click, random mute. Updated via
  //     history.replaceState so it doesn't pollute the back-button stack.
  //     Lets users bookmark a setup or share a link. Custom forms are not in
  //     the URL — they live in localStorage only (Phase 2 will encode them).
  //
  // On page load: URL params win if present, else localStorage, else defaults.
  // On state change: persistState() is called from each mutation handler; it
  // saves to localStorage immediately and updates the URL on a 250 ms debounce.

  const STORAGE_KEY = 'metronomeState_v1';
  const BEAT_TO_CHAR = { accent: 'A', normal: 'N', soft: 'S', mute: 'M' };
  const CHAR_TO_BEAT = { A: 'accent', N: 'normal', S: 'soft', M: 'mute' };
  const SOUND_TO_CHAR = { electronic: 'e', clave: 'c' };
  const CHAR_TO_SOUND = { e: 'electronic', c: 'clave' };
  // Set from localStorage on load — re-opens the form editor on refresh
  // if it was open when the page was left.
  let restoreEditorOpen = false;

  function encodeURLState() {
    const params = new URLSearchParams();
    params.set('bpm', String(state.bpm));
    params.set('beats', String(state.beatsPerMeasure));
    params.set('unit', String(state.beatUnit));
    params.set('p', state.beats.map((b) => BEAT_TO_CHAR[b] || 'N').join(''));
    if (state.subdivision !== 1) params.set('sub', String(state.subdivision));
    if (state.subCustom) params.set('subp', state.subPattern.map((on, i) => (i === 0 || on) ? '1' : '0').join(''));
    if (state.subFollowMute) params.set('subfm', '1');
    if (state.swingPct !== 50) params.set('sw', String(state.swingPct));
    if (soundMode !== 'electronic') params.set('snd', SOUND_TO_CHAR[soundMode]);
    if (adv.gapEnabled) {
      let v = adv.gapPlay + '-' + adv.gapSilent;
      if (adv.gapUnit === 'beat') v += '-b';
      params.set('gap', v);
    }
    if (adv.randomMuteEnabled) {
      params.set('rmute', String(adv.randomMutePct));
      if (adv.randomMuteSubPct > 0) params.set('rsub', String(adv.randomMuteSubPct));
    }
    return params.toString();
  }

  function applyURLState(search) {
    const params = new URLSearchParams(search);
    if (!params.has('bpm') && !params.has('beats') && !params.has('p')) return false;

    const bpm = +params.get('bpm');
    if (bpm >= 1 && bpm <= 500) state.bpm = Math.round(bpm * 10) / 10;

    const beats = +params.get('beats');
    const unit = +params.get('unit');
    if (beats >= 1 && beats <= 32 && unit >= 1 && unit <= 32) {
      state.beatsPerMeasure = Math.round(beats);
      state.beatUnit = Math.round(unit);
    }

    const pattern = params.get('p') || '';
    if (pattern) {
      const decoded = pattern.split('').map((c) => CHAR_TO_BEAT[c] || 'normal');
      const n = state.beatsPerMeasure;
      state.beats = Array(n).fill('normal').map((_, i) => decoded[i] || 'normal');
    }

    const sub = +params.get('sub');
    if (sub >= 1 && sub <= 32) state.subdivision = Math.round(sub);
    const subp = params.get('subp');
    if (subp && /^[01]+$/.test(subp)) {
      state.subCustom = true;
      state.customCount = state.subdivision >= 2 ? state.subdivision : subp.length;
      if (state.subdivision < 2) state.subdivision = subp.length;
      state.subPattern = subp.split('').map((c, i) => i === 0 ? true : c === '1');
      ensureSubPattern(state.subdivision);
    }
    state.subFollowMute = params.get('subfm') === '1';

    const sw = +params.get('sw');
    if (sw >= 50 && sw <= 75 && params.has('sw')) state.swingPct = sw;

    const snd = params.get('snd');
    if (snd && CHAR_TO_SOUND[snd]) soundMode = CHAR_TO_SOUND[snd];

    const gap = params.get('gap');
    if (gap) {
      const parts = gap.split('-');
      const p = +parts[0], s = +parts[1];
      if (p >= 1 && p <= 16 && s >= 1 && s <= 16) {
        adv.gapEnabled = true;
        adv.gapPlay = p;
        adv.gapSilent = s;
        adv.gapUnit = parts[2] === 'b' ? 'beat' : 'measure';
      }
    }
    const rmute = +params.get('rmute');
    if (rmute >= 0 && rmute <= 100 && params.has('rmute')) {
      adv.randomMuteEnabled = true;
      adv.randomMutePct = Math.round(rmute);
    }
    const rsub = +params.get('rsub');
    if (rsub >= 0 && rsub <= 100 && params.has('rsub')) {
      adv.randomMuteSubPct = Math.round(rsub);
    }
    return true;
  }

  function saveLocalStorage() {
    try {
      const data = {
        bpm: state.bpm,
        beatsPerMeasure: state.beatsPerMeasure,
        beatUnit: state.beatUnit,
        beats: state.beats,
        subdivision: state.subdivision,
        subCustom: state.subCustom,
        subPattern: state.subPattern,
        subFollowMute: state.subFollowMute,
        customCount: state.customCount,
        swingPct: state.swingPct,
        soundMode,
        adv: {
          gapEnabled: adv.gapEnabled, gapPlay: adv.gapPlay, gapSilent: adv.gapSilent, gapUnit: adv.gapUnit,
          randomMuteEnabled: adv.randomMuteEnabled, randomMutePct: adv.randomMutePct, randomMuteSubPct: adv.randomMuteSubPct,
          formEnabled: adv.formEnabled,
          form: adv.form,
        },
      };
      localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
    } catch (e) { /* private mode or quota — ignore */ }
  }

  function loadLocalStorage() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return false;
      const d = JSON.parse(raw);
      if (d.bpm >= 1 && d.bpm <= 500) state.bpm = d.bpm;
      if (d.beatsPerMeasure >= 1 && d.beatsPerMeasure <= 32) state.beatsPerMeasure = d.beatsPerMeasure;
      if (d.beatUnit >= 1 && d.beatUnit <= 32) state.beatUnit = d.beatUnit;
      if (Array.isArray(d.beats) && d.beats.length > 0) {
        state.beats = d.beats.filter((b) => b in BEAT_TO_CHAR);
      }
      if (d.subdivision >= 1 && d.subdivision <= 32) state.subdivision = d.subdivision;
      state.subCustom = !!d.subCustom;
      if (d.customCount >= 2 && d.customCount <= 32) state.customCount = d.customCount;
      if (Array.isArray(d.subPattern)) state.subPattern = d.subPattern.map((x, i) => i === 0 ? true : !!x);
      state.subFollowMute = !!d.subFollowMute;
      if (d.swingPct >= 50 && d.swingPct <= 75) state.swingPct = d.swingPct;
      if (d.soundMode === 'clave' || d.soundMode === 'electronic') soundMode = d.soundMode;
      if (d.adv) {
        adv.gapEnabled = !!d.adv.gapEnabled;
        if (d.adv.gapPlay >= 1 && d.adv.gapPlay <= 16) adv.gapPlay = d.adv.gapPlay;
        if (d.adv.gapSilent >= 1 && d.adv.gapSilent <= 16) adv.gapSilent = d.adv.gapSilent;
        if (d.adv.gapUnit === 'beat' || d.adv.gapUnit === 'measure') adv.gapUnit = d.adv.gapUnit;
        adv.randomMuteEnabled = !!d.adv.randomMuteEnabled;
        if (d.adv.randomMutePct >= 0 && d.adv.randomMutePct <= 100) adv.randomMutePct = d.adv.randomMutePct;
        if (d.adv.randomMuteSubPct >= 0 && d.adv.randomMuteSubPct <= 100) adv.randomMuteSubPct = d.adv.randomMuteSubPct;
        adv.formEnabled = !!d.adv.formEnabled;
        if (Array.isArray(d.adv.form) && d.adv.form.length > 0) adv.form = d.adv.form;
      }
      // Note: the Forms-tab position used to be persisted (formEditorOpen)
      // and restored here, making returning visitors land on Forms instead
      // of Pulse. The page now always opens on Pulse; only an explicit
      // share link (?f=...&open=1) lands on Forms.
      return true;
    } catch (e) { return false; }
  }

  let urlUpdateTimer = null;
  function persistState() {
    saveLocalStorage();
    triggerBgRerender(); // re-render background buffer when settings change
    clearTimeout(urlUpdateTimer);
    urlUpdateTimer = setTimeout(() => {
      const qs = encodeURLState();
      const target = window.location.pathname + (qs ? '?' + qs : '');
      if (target !== window.location.pathname + window.location.search) {
        history.replaceState(null, '', target);
      }
    }, 250);
  }

  // Copy-link button
  document.getElementById('copy-link-btn').addEventListener('click', async () => {
    const qs = encodeURLState();
    const url = window.location.origin + window.location.pathname + (qs ? '?' + qs : '');
    try {
      await navigator.clipboard.writeText(url);
    } catch (e) {
      // Fallback for older browsers / non-secure contexts
      const ta = document.createElement('textarea');
      ta.value = url; ta.style.position = 'fixed'; ta.style.opacity = '0';
      document.body.appendChild(ta); ta.select();
      try { document.execCommand('copy'); } catch (_) {}
      document.body.removeChild(ta);
    }
    const btn = document.getElementById('copy-link-btn');
    btn.classList.add('copied');
    setTimeout(() => btn.classList.remove('copied'), 1400);
  });

  // ─── Init ─────────────────────────────────────────────────────────────────────
  async function init() {
    state.beats = Array(state.beatsPerMeasure).fill('normal');
    state.beats[0] = 'accent';
    adv.form = [{ beats: 4, unit: 4, states: ['accent','normal','normal','normal'] }];

    // Restore: localStorage is the base — it holds everything, including
    // the custom form, which the shareable URL doesn't encode. URL params,
    // when present, then override the shareable subset on top.
    loadLocalStorage();
    loadBgPrefs();
    const usedURL = applyURLState(window.location.search);

    // Share-link path: if the URL carries ?f=..., decompress it and load it
    // as the active form (overriding localStorage). ?open=1 pops the editor
    // open on arrival so a recipient lands inside the form they were sent.
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.has('f')) {
      try {
        const code = await inflateText(base64UrlToBytes(urlParams.get('f')));
        const decoded = decodeFormCode(code);
        if (decoded && !decoded.error && decoded.form.length > 0) {
          adv.form = decoded.form;
          adv.formEnabled = true;
          if (urlParams.get('open') === '1') restoreEditorOpen = true;
        }
      } catch (e) { /* malformed share link — fall back to defaults / localStorage */ }
    }

    // Reflect restored state into the DOM.
    document.getElementById('bpm-display').textContent = formatBpm(state.bpm);
    document.getElementById('bpm-slider').value = Math.round(state.bpm);
    document.getElementById('beats-input').value = state.beatsPerMeasure;
    setSwingPct(state.swingPct);
    document.getElementById('sub-followmute-toggle').checked = state.subFollowMute;
    // Reflect the restored subdivision through setSubdivision so the active
    // button, custom panel, count picker, pattern grid, swing/follow-mute
    // dimming, and sub-dots all sync from one place.
    if (state.subCustom) {
      if (!(state.customCount >= 2 && state.customCount <= 32)) {
        state.customCount = Math.max(2, Math.min(32, state.subdivision || 4));
      }
      setSubdivision(state.customCount, true);
    } else {
      setSubdivision(state.subdivision, false);
    }
    document.querySelectorAll('.btn-sound').forEach((b) => {
      b.classList.toggle('active', b.dataset.sound === soundMode);
    });
    document.querySelectorAll('#time-sig-presets .btn-sig').forEach((btn) => {
      btn.classList.toggle('active',
        +btn.dataset.beats === state.beatsPerMeasure && +btn.dataset.unit === state.beatUnit);
    });
    syncCustomSigButton(state.beatsPerMeasure, state.beatUnit);
    document.getElementById('gap-toggle').checked = adv.gapEnabled;
    document.getElementById('gap-controls').classList.toggle('disabled', !adv.gapEnabled);
    document.getElementById('gap-play-slider').value = adv.gapPlay;
    document.getElementById('gap-play-val').textContent = adv.gapPlay;
    document.getElementById('gap-silent-slider').value = adv.gapSilent;
    document.getElementById('gap-silent-val').textContent = adv.gapSilent;
    setGapUnit(adv.gapUnit);  // syncs pill state + the two "measures/beats" unit labels
    document.getElementById('random-mute-toggle').checked = adv.randomMuteEnabled;
    document.getElementById('random-mute-controls').classList.toggle('disabled', !adv.randomMuteEnabled);
    document.getElementById('random-mute-slider').value = adv.randomMutePct;
    document.getElementById('random-mute-val').textContent = adv.randomMutePct;
    document.getElementById('random-mute-sub-slider').value = adv.randomMuteSubPct;
    document.getElementById('random-mute-sub-val').textContent = adv.randomMuteSubPct;
    document.getElementById('form-toggle').checked = adv.formEnabled;
    document.getElementById('form-controls').classList.toggle('disabled', !adv.formEnabled);

    populateUnitSelect('unit-select', state.beatUnit);
    populateUnitSelect('bulk-unit', 4);
    renderBeatGrid();
    renderSubDots();
    renderFormList();
    formHistory = [JSON.stringify(adv.form)];
    formHistoryIdx = 0;
    refreshUndoRedoBtns();
    document.getElementById('tempo-name').textContent = getTempoName(state.bpm);

    // If URL had state and localStorage didn't (or was different), sync now.
    if (usedURL) saveLocalStorage();

    // The editor is now a tab in the carousel, not a popped-over modal.
    // Sync its initial state once. The page always opens on Pulse; only a
    // share link (?f=...&open=1) lands on Forms.
    syncFormEditorOnLoad();
    if (restoreEditorOpen) Carousel.setScreen(2);

    // Device card: the background-play note is informational and iOS-only —
    // background mode is automatic there and unnecessary elsewhere.
    // (style.display, not the hidden attribute: these rows are display:flex.)
    if (IS_IOS) {
      const bgRow = document.getElementById('bg-play-row');
      if (bgRow) bgRow.style.display = '';
    }
    const wlToggleEl = document.getElementById('wake-lock-toggle');
    if (wlToggleEl) {
      if (!('wakeLock' in navigator)) {
        const row = document.getElementById('wake-lock-row');
        if (row) row.style.display = 'none';
      } else {
        wlToggleEl.checked = wakeLockUserEnabled;
      }
    }
  }

  // ─── Custom Form Editor ───────────────────────────────────────────────────────
  // Notation-flavored bar grid. Reads + writes the same adv.form structure the
  // existing scheduler consumes. Each entry: { beats, unit, states[], breakAfter? }
  // where breakAfter (optional) forces a new line in the grid layout.
  //
  // Interactions:
  //   - Tap a beat: cycle accent → soft → mute → normal
  //   - +/- inputs: change beats-per-measure or beat unit for that bar
  //   - Up / down: reorder bars
  //   - X: delete bar (disabled when only one bar remains)
  //   - "Add bar" plus button at the end: appends a new bar (clones the
  //     previous bar's beats/unit so adding a 5/8 bar after a 5/8 bar
  //     gives you another 5/8 bar)
  //   - Hover gap between bars: "↵" cue to insert a line break after
  //   - Click "BREAK" badge on an existing line: remove that break

  // The editor used to live in a popped-over modal; it's now a tab page
  // (Forms in the carousel). Existing code still asks "is the editor open?"
  // via formEditorModal.getAttribute('aria-hidden'). The editor is always
  // mounted now, so the dummy always reports 'false' (= not hidden).
  const formEditorModal = { getAttribute: () => 'false', setAttribute: () => {} };
  const formEditorGrid  = document.getElementById('form-editor-grid');
  const formEditorBpmEl = document.getElementById('form-editor-bpm');
  const formEditorPlayBtns = [
    document.getElementById('form-editor-play'),
    document.getElementById('form-editor-mobile-play-btn'),
  ];

  // The editor is no longer a modal — it's the Forms tab on the carousel.
  // Initial editor-state sync happens once after the DOM is ready: reflect
  // the persisted editor mode (beat/chart) in the toolbar, paint the grid,
  // and sync the editor's play buttons. Subsequent updates happen via the
  // normal handlers (mode-toggle clicks, mutation handlers, the 200ms poll).
  function syncFormEditorOnLoad() {
    formEditorBpmEl.textContent = formatBpm(state.bpm);
    document.getElementById('form-editor-mode-beat').classList.toggle('active', editorMode === 'beat');
    document.getElementById('form-editor-mode-beat').setAttribute('aria-pressed', editorMode === 'beat');
    document.getElementById('form-editor-mode-chart').classList.toggle('active', editorMode === 'chart');
    document.getElementById('form-editor-mode-chart').setAttribute('aria-pressed', editorMode === 'chart');
    renderFormEditor();
    refreshFormEditorPlayButtons();
  }

  // BPM controls inside the editor — wire +/- and contenteditable to the
  // shared setBPM() so the change cascades to the slider, scheduler, and
  // persistence layer just like a change on the main page would.
  document.getElementById('form-editor-bpm-minus').addEventListener('click', () => {
    setBPM(Math.ceil(state.bpm) - 1);
    formEditorBpmEl.textContent = formatBpm(state.bpm);
  });
  document.getElementById('form-editor-bpm-plus').addEventListener('click', () => {
    setBPM(Math.floor(state.bpm) + 1);
    formEditorBpmEl.textContent = formatBpm(state.bpm);
  });
  formEditorBpmEl.addEventListener('blur', () => {
    const v = parseFloat(formEditorBpmEl.textContent.replace(/[^\d.]/g, ''));
    if (v >= 1 && v <= 500) setBPM(v);
    formEditorBpmEl.textContent = formatBpm(state.bpm);
  });
  formEditorBpmEl.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      formEditorBpmEl.blur();
    }
  });
  // Highlight the whole BPM value on click so a keystroke replaces it.
  // It's a contenteditable, so select its contents via a Range rather
  // than input.select(). setTimeout defers past the browser's own
  // click-caret placement.
  formEditorBpmEl.addEventListener('click', () => {
    setTimeout(() => {
      const range = document.createRange();
      range.selectNodeContents(formEditorBpmEl);
      const sel = window.getSelection();
      sel.removeAllRanges();
      sel.addRange(range);
    }, 0);
  });

  // (The editor used to have an Escape-closes-modal handler here; the
  // editor is now a tab, not a modal, so Esc no longer has a job to do.)

  // Editor view mode: 'beat' (rich, tap-to-edit per beat) or 'chart' (a
  // sequence of compact tiles showing just the time signatures, for
  // structural overview). Persisted in its own localStorage key so the
  // user's last mode survives reloads.
  let editorMode = 'beat';
  try {
    const m = localStorage.getItem('metronomeFormEditorMode_v1');
    if (m === 'beat' || m === 'chart') editorMode = m;
  } catch (e) {}

  // Per-row cap for beat mode. Portrait gets 8, landscape gets 16.
  function maxBeatsPerRow() {
    const portrait = window.matchMedia('(orientation: portrait)').matches;
    return portrait ? 8 : 16;
  }

  function renderFormEditor() {
    formEditorGrid.className = 'form-editor-grid'
      + (editorMode === 'chart' ? ' chart-mode' : '')
      + (selectMode ? ' select-mode' : '');
    formEditorGrid.innerHTML = '';
    if (editorMode === 'chart') {
      renderFormEditorChart();
    } else {
      renderFormEditorBeat();
    }

    // Update the "Add bar" button label to show the clone target.
    const last = adv.form[adv.form.length - 1];
    const addLabel = document.getElementById('form-editor-add-bar-label');
    if (addLabel && last) addLabel.textContent = 'Add a ' + last.beats + '/' + last.unit + ' bar';
  }

  // Beat mode — auto-packed rows of bars with beat circles, no manual breaks.
  function renderFormEditorBeat() {
    const cap = maxBeatsPerRow();
    let row = document.createElement('div');
    row.className = 'form-editor-row';
    let rowBeats = 0;
    const flushRow = () => {
      if (row.childNodes.length > 0) formEditorGrid.appendChild(row);
      row = document.createElement('div');
      row.className = 'form-editor-row';
      rowBeats = 0;
    };
    adv.form.forEach((entry, idx) => {
      const wouldExceed = rowBeats + entry.beats > cap;
      if (rowBeats > 0 && wouldExceed) flushRow();
      row.appendChild(buildFormBarCard(entry, idx));
      rowBeats += entry.beats;
    });
    flushRow();
  }

  // Chart mode — uniform tiles.
  //   - No manual line breaks: a fixed N-column auto-flow grid.
  //   - At least one manual break: the form is treated as deliberately
  //     laid out — each line (a run between breaks, capped at the
  //     per-row tile limit) becomes a flex row whose tiles stretch to
  //     fill the full width.
  function maxTilesPerRow() {
    return window.matchMedia('(orientation: portrait)').matches ? 4 : 8;
  }

  function renderFormEditorChart() {
    const hasBreaks = adv.form.some((e) => e.breakAfter);
    if (!hasBreaks) {
      adv.form.forEach((entry, idx) => {
        formEditorGrid.appendChild(buildFormChartTile(entry, idx));
      });
      return;
    }
    // Explicit line layout — only the line right before a manual break
    // stretches its tiles to fill the width. Cap-wrapped lines and the
    // trailing line keep fixed-width tiles (a partial line leaves a gap).
    formEditorGrid.classList.add('chart-lines');
    const cap = maxTilesPerRow();
    let line = document.createElement('div');
    line.className = 'form-chart-line';
    let count = 0;
    const flushLine = (endedByBreak) => {
      if (line.childNodes.length > 0) {
        if (endedByBreak) line.classList.add('stretch');
        formEditorGrid.appendChild(line);
      }
      line = document.createElement('div');
      line.className = 'form-chart-line';
      count = 0;
    };
    adv.form.forEach((entry, idx) => {
      line.appendChild(buildFormChartTile(entry, idx));
      count++;
      if (entry.breakAfter) flushLine(true);
      else if (count >= cap) flushLine(false);
    });
    flushLine(false);
  }

  function buildFormChartTile(entry, idx) {
    const tile = document.createElement('button');
    tile.type = 'button';
    tile.dataset.idx = idx;
    let cls = 'form-chart-tile';
    if (idx === advFormIdx && state.isPlaying) cls += ' active';
    if (isBarSelected(idx)) cls += ' selected';
    if (isBarInLoop(idx)) cls += ' looping';
    tile.className = cls;
    tile.textContent = entry.beats + '/' + entry.unit;
    tile.setAttribute('aria-label', 'Bar ' + (idx + 1) + ' (' + entry.beats + '/' + entry.unit + '). Tap to edit in beat mode.');
    tile.addEventListener('click', (e) => {
      // Only switch modes if the click wasn't on a child control
      if (e.target.closest('.form-chart-tile-delete') || e.target.closest('.form-chart-tile-break')) return;
      formEditingIdx = idx;
      setEditorMode('beat');
      // Land the user right on the bar they tapped — beat mode just
      // re-rendered the whole grid, so scroll the now-editing bar into
      // the center of the scroll area instead of making them hunt.
      requestAnimationFrame(() => {
        const editingBar = formEditorGrid.querySelector('.form-bar.editing');
        if (editingBar) editingBar.scrollIntoView({ block: 'center' });
      });
    });

    // Delete
    const del = document.createElement('button');
    del.type = 'button';
    del.className = 'form-chart-tile-delete';
    del.textContent = '✕';
    del.title = 'Delete this bar';
    del.disabled = adv.form.length <= 1;
    del.addEventListener('click', (e) => {
      e.stopPropagation();
      if (adv.form.length <= 1) return;
      saveFormHistory();
      adv.form.splice(idx, 1);
      renderFormEditor();
    });
    tile.appendChild(del);

    // Line-break toggle (chart mode only)
    const brk = document.createElement('button');
    brk.type = 'button';
    brk.className = 'form-chart-tile-break' + (entry.breakAfter ? ' on' : '');
    brk.textContent = '↵';
    brk.title = entry.breakAfter ? 'Remove line break after this bar' : 'Add a line break after this bar';
    brk.disabled = idx === adv.form.length - 1;  // no break needed after the last bar
    brk.addEventListener('click', (e) => {
      e.stopPropagation();
      saveFormHistory();
      entry.breakAfter = !entry.breakAfter;
      renderFormEditor();
    });
    tile.appendChild(brk);

    return tile;
  }

  function setEditorMode(mode) {
    if (mode !== 'beat' && mode !== 'chart') return;
    editorMode = mode;
    // Switching to chart mode dismisses any open beat-mode edit chrome —
    // it shouldn't linger (and reopen) across a round trip. Blurring also
    // dismisses the mobile keyboard if a sig input was focused.
    if (mode === 'chart') {
      formEditingIdx = -1;
      if (document.activeElement && document.activeElement.blur) {
        document.activeElement.blur();
      }
    }
    try { localStorage.setItem('metronomeFormEditorMode_v1', mode); } catch (e) {}
    document.getElementById('form-editor-mode-beat').classList.toggle('active', mode === 'beat');
    document.getElementById('form-editor-mode-beat').setAttribute('aria-pressed', mode === 'beat');
    document.getElementById('form-editor-mode-chart').classList.toggle('active', mode === 'chart');
    document.getElementById('form-editor-mode-chart').setAttribute('aria-pressed', mode === 'chart');
    renderFormEditor();
  }

  document.getElementById('form-editor-mode-beat').addEventListener('click', () => setEditorMode('beat'));
  document.getElementById('form-editor-mode-chart').addEventListener('click', () => setEditorMode('chart'));

  // Clear-all — confirm before wiping
  document.getElementById('form-editor-clear').addEventListener('click', () => {
    if (adv.form.length > 1 && !confirm('Clear all bars and start over?')) return;
    saveFormHistory();
    adv.form = [{ beats: 4, unit: 4, states: ['accent','normal','normal','normal'], breakAfter: false }];
    formEditingIdx = -1;
    if (selectMode) { exitSelectMode(); } else { renderFormEditor(); }
  });

  // Re-pack rows when the orientation actually flips. Listening to the
  // orientation media query (rather than 'resize') means we don't
  // re-render on every iOS URL-bar show/hide — those fire 'resize'
  // constantly and re-rendering mid-edit on each one was a source of
  // glitches. Wrapped in try/catch so a render hiccup during a rotation
  // can't leave the editor blank.
  window.matchMedia('(orientation: portrait)').addEventListener('change', () => {
    if (formEditorModal.getAttribute('aria-hidden') !== 'false') return;
    try { renderFormEditor(); } catch (e) { console.error('form re-render failed', e); }
  });

  let formEditingIdx = -1;  // which bar's edit chrome is currently revealed

  // ─── Multi-select ─────────────────────────────────────────────────────────────
  // Select a contiguous range of bars, then duplicate or delete the range.
  // Flow: tap a bar (its chrome opens — that's the anchor), tap "Select
  // bars", then tap the last bar of the range. While selectMode is on, a
  // tap anywhere on a bar/tile sets the range end (the capture-phase
  // listener on the grid intercepts before the normal bar handlers).
  let selectMode = false;
  let selectionAnchor = -1;
  let selectionEnd = -1;

  function isBarSelected(idx) {
    if (!selectMode || selectionAnchor < 0) return false;
    if (selectionEnd < 0) return idx === selectionAnchor;
    const lo = Math.min(selectionAnchor, selectionEnd);
    const hi = Math.max(selectionAnchor, selectionEnd);
    return idx >= lo && idx <= hi;
  }

  // True for bars inside an active "loop selection" range — keeps the
  // looped range highlighted while it plays.
  function isBarInLoop(idx) {
    return !!loopRange && idx >= loopRange.lo && idx <= loopRange.hi;
  }

  function updateSelectBar() {
    const status = document.getElementById('form-select-status');
    const hasRange = selectionAnchor >= 0 && selectionEnd >= 0;
    if (selectionAnchor < 0) {
      status.textContent = 'Tap the first bar of the range';
    } else if (selectionEnd < 0) {
      status.textContent = 'Tap the last bar of the range';
    } else {
      const n = Math.abs(selectionEnd - selectionAnchor) + 1;
      status.textContent = n + ' bar' + (n !== 1 ? 's' : '') + ' selected';
    }
    ['form-select-play-from', 'form-select-loop', 'form-select-duplicate', 'form-select-delete']
      .forEach((id) => {
        const el = document.getElementById(id);
        if (el) el.disabled = !hasRange;
      });
  }

  function enterSelectMode() {
    if (selectMode) return;
    selectMode = true;
    // Honor "tap the first bar, then the toggle": if a bar's chrome is
    // open, seed the anchor with it. Otherwise the first tap sets it.
    selectionAnchor = formEditingIdx >= 0 ? formEditingIdx : -1;
    selectionEnd = -1;
    document.getElementById('form-select-bar').setAttribute('aria-hidden', 'false');
    updateSelectBar();
    renderFormEditor();
  }

  function exitSelectMode() {
    selectMode = false;
    selectionAnchor = -1;
    selectionEnd = -1;
    document.getElementById('form-select-bar').setAttribute('aria-hidden', 'true');
    renderFormEditor();
  }

  function handleSelectionTap(idx) {
    if (selectionAnchor < 0) {
      selectionAnchor = idx;
    } else {
      // Anchor is set — every subsequent tap (re)picks the range end.
      selectionEnd = idx;
    }
    updateSelectBar();
    renderFormEditor();
  }

  function duplicateSelection() {
    if (selectionAnchor < 0 || selectionEnd < 0) return;
    const lo = Math.min(selectionAnchor, selectionEnd);
    const hi = Math.max(selectionAnchor, selectionEnd);
    saveFormHistory();
    const slice = adv.form.slice(lo, hi + 1).map((e) => ({
      beats: e.beats,
      unit: e.unit,
      states: e.states.slice(),
      breakAfter: e.breakAfter || false,
    }));
    adv.form.splice(hi + 1, 0, ...slice);
    exitSelectMode();
  }

  function deleteSelection() {
    if (selectionAnchor < 0 || selectionEnd < 0) return;
    const lo = Math.min(selectionAnchor, selectionEnd);
    const hi = Math.max(selectionAnchor, selectionEnd);
    const count = hi - lo + 1;
    saveFormHistory();
    if (count >= adv.form.length) {
      // Deleting every bar — reset to a single default bar instead.
      adv.form = [{ beats: 4, unit: 4, states: ['accent','normal','normal','normal'], breakAfter: false }];
    } else {
      adv.form.splice(lo, count);
    }
    formEditingIdx = -1;
    exitSelectMode();
  }

  // Start playback at the selection's first bar and continue through the
  // whole form (looping the whole form as usual).
  function playFromSelection() {
    if (selectionAnchor < 0 || selectionEnd < 0) return;
    const lo = Math.min(selectionAnchor, selectionEnd);
    exitSelectMode();
    if (state.isPlaying) stopMetronome();  // also clears any loopRange
    startMetronome(lo);
    refreshFormEditorPlayButtons();
  }

  // Loop just the selected bar range over and over.
  function loopSelection() {
    if (selectionAnchor < 0 || selectionEnd < 0) return;
    const lo = Math.min(selectionAnchor, selectionEnd);
    const hi = Math.max(selectionAnchor, selectionEnd);
    exitSelectMode();
    if (state.isPlaying) stopMetronome();  // clears loopRange first
    loopRange = { lo, hi };                // set AFTER stop
    startMetronome(lo);
    renderFormEditor();  // paint the looping-range highlight
    refreshFormEditorPlayButtons();
  }

  // Capture-phase listener: while in select mode, a tap anywhere on a bar
  // or chart tile sets the selection point and is blocked from reaching
  // the normal bar handlers (sig tag, beat circles, tile navigation).
  formEditorGrid.addEventListener('click', (e) => {
    if (!selectMode) return;
    const bar = e.target.closest('.form-bar, .form-chart-tile');
    if (!bar) return;
    e.stopPropagation();
    e.preventDefault();
    handleSelectionTap(+bar.dataset.idx);
  }, true);

  document.getElementById('form-editor-select-btn').addEventListener('click', enterSelectMode);
  document.getElementById('form-select-cancel').addEventListener('click', exitSelectMode);
  document.getElementById('form-select-duplicate').addEventListener('click', duplicateSelection);
  document.getElementById('form-select-delete').addEventListener('click', deleteSelection);
  document.getElementById('form-select-play-from').addEventListener('click', playFromSelection);
  document.getElementById('form-select-loop').addEventListener('click', loopSelection);

  // When a form bar's time signature changes, apply the meter's clave
  // default if one exists (e.g., 6/8 → A·s·s·N·s·s); otherwise preserve
  // the user's previous accent pattern as far as it fits and pad with
  // normal. Matches the behavior of the main metronome's preset buttons.
  function applyClaveOrPreserveStates(entry, prevStates) {
    const preset = defaultBeatsForSig(entry.beats, entry.unit);
    if (preset) {
      entry.states = preset.slice();
      return;
    }
    entry.states = Array(entry.beats).fill('normal').map((_, i) =>
      i < prevStates.length ? prevStates[i] : 'normal'
    );
    if (prevStates.length === 0) entry.states[0] = 'accent';
  }

  function buildFormBarCard(entry, idx) {
    const card = document.createElement('div');
    let cls = 'form-bar';
    if (idx === advFormIdx && state.isPlaying) cls += ' active';
    if (idx === formEditingIdx) cls += ' editing';
    if (isBarSelected(idx)) cls += ' selected';
    if (isBarInLoop(idx)) cls += ' looping';
    card.className = cls;
    card.dataset.idx = idx;
    // Proportional width: row flex-grow tracks the beat count, so a 7-beat
    // bar takes more space than a 3-beat bar on the same line. Capped at
    // the per-row beat limit — a bar wider than a full row (e.g. 12/8 in
    // portrait) takes a full-width row and wraps its beat circles onto a
    // second line inside the card rather than shrinking the dots.
    const rowCap = maxBeatsPerRow();
    const growth = Math.min(entry.beats, rowCap);
    card.style.flexGrow = String(growth);
    card.style.flexShrink = String(growth);

    // Compact sig tag — tap to toggle edit chrome
    const sigTag = document.createElement('button');
    sigTag.type = 'button';
    sigTag.className = 'form-bar-sig-tag';
    sigTag.textContent = entry.beats + '/' + entry.unit;
    sigTag.setAttribute('aria-label', 'Bar ' + (idx + 1) + ' (' + entry.beats + '/' + entry.unit + '). Tap to edit time signature.');
    sigTag.addEventListener('click', (e) => {
      e.stopPropagation();
      const willEnter = (formEditingIdx !== idx);
      formEditingIdx = willEnter ? idx : -1;
      renderFormEditor();
      // Focus the beats input SYNCHRONOUSLY here — renderFormEditor() is
      // synchronous so the new input already exists in the DOM, and
      // staying inside the click gesture is what makes iOS Safari open
      // the numeric keypad. A setTimeout would break the gesture chain
      // and iOS would focus the input visually but leave the keypad
      // closed. The focus also triggers the highlight-on-focus handler.
      if (willEnter) {
        const input = formEditorGrid.querySelector('.form-bar.editing .form-bar-sig-input');
        if (input) input.focus();
      }
    });
    card.appendChild(sigTag);

    // Edit chrome — sig inputs only (no reorder, no delete; delete is in
    // its own corner button)
    const edit = document.createElement('div');
    edit.className = 'form-bar-edit';
    const sig = document.createElement('div');
    sig.className = 'form-bar-sig';
    const beatsIn = document.createElement('input');
    beatsIn.type = 'number';
    beatsIn.min = 1; beatsIn.max = 32;
    beatsIn.value = entry.beats;
    beatsIn.className = 'form-bar-sig-input';
    beatsIn.inputMode = 'numeric';
    beatsIn.setAttribute('aria-label', 'Beats per measure for bar ' + (idx + 1));
    // Highlight the value on focus so a keystroke replaces it. Fires for
    // both a direct tap and the chrome-open auto-focus — both desired.
    beatsIn.addEventListener('focus', () => {
      setTimeout(() => beatsIn.select(), 0);
    });
    beatsIn.addEventListener('change', () => {
      const b = Math.max(1, Math.min(32, +beatsIn.value || entry.beats));
      beatsIn.value = b;
      if (b === entry.beats) return;  // no-op
      saveFormHistory();
      const prev = entry.states.slice();
      entry.beats = b;
      applyClaveOrPreserveStates(entry, prev);
      renderFormEditor();
    });
    sig.appendChild(beatsIn);
    const slash = document.createElement('span');
    slash.className = 'form-bar-sig-slash';
    slash.textContent = '/';
    sig.appendChild(slash);
    const unitSel = document.createElement('select');
    unitSel.className = 'form-bar-sig-unit';
    unitSel.setAttribute('aria-label', 'Beat unit for bar ' + (idx + 1));
    buildUnitOptions(unitSel, entry.unit);
    unitSel.addEventListener('change', () => {
      const newUnit = +unitSel.value;
      if (newUnit === entry.unit) return;
      saveFormHistory();
      const prev = entry.states.slice();
      entry.unit = newUnit;
      applyClaveOrPreserveStates(entry, prev);
      sigTag.textContent = entry.beats + '/' + entry.unit;
      renderFormEditor();
    });
    sig.appendChild(unitSel);
    edit.appendChild(sig);

    // Insert-after — clones this bar and drops the copy in right after it.
    const insertBtn = document.createElement('button');
    insertBtn.type = 'button';
    insertBtn.className = 'form-bar-insert';
    insertBtn.textContent = '+ Insert after';
    insertBtn.title = 'Insert a copy of this bar right after it';
    insertBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      saveFormHistory();
      adv.form.splice(idx + 1, 0, {
        beats: entry.beats,
        unit: entry.unit,
        states: entry.states.slice(),
        breakAfter: false,
      });
      formEditingIdx = idx + 1;  // keep the freshly-inserted bar selected
      renderFormEditor();
    });
    edit.appendChild(insertBtn);

    card.appendChild(edit);

    // Always-visible delete in the top-right
    const delBtn = document.createElement('button');
    delBtn.type = 'button';
    delBtn.className = 'form-bar-delete';
    delBtn.textContent = '✕';
    delBtn.title = 'Delete this bar';
    delBtn.setAttribute('aria-label', 'Delete bar ' + (idx + 1));
    delBtn.disabled = adv.form.length <= 1;
    delBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      if (adv.form.length <= 1) return;
      saveFormHistory();
      adv.form.splice(idx, 1);
      if (idx > 0 && adv.form[idx - 1].breakAfter && idx === adv.form.length) {
        adv.form[idx - 1].breakAfter = false;
      }
      formEditingIdx = -1;
      renderFormEditor();
    });
    card.appendChild(delBtn);

    // Beat row (always visible). Spaced evenly within the bar so the
    // beats fill the stretched width gracefully.
    const beats = document.createElement('div');
    beats.className = 'form-bar-beats';
    entry.states.forEach((s, i) => {
      const beat = document.createElement('button');
      beat.type = 'button';
      beat.className = 'form-beat state-' + s;
      beat.textContent = STATE_ICONS[s];
      beat.setAttribute('aria-label', 'Beat ' + (i + 1) + ' of bar ' + (idx + 1) + ', ' + s + '. Tap to cycle.');
      beat.addEventListener('click', () => {
        saveFormHistory();
        entry.states[i] = STATE_CYCLE[entry.states[i]];
        beat.className = 'form-beat state-' + entry.states[i];
        beat.textContent = STATE_ICONS[entry.states[i]];
      });
      beats.appendChild(beat);
    });
    card.appendChild(beats);

    return card;
  }

  function buildLineBreak(afterIdx) {
    const wrap = document.createElement('div');
    wrap.className = 'form-line-break';
    const toggle = document.createElement('button');
    toggle.type = 'button';
    toggle.className = 'form-line-break-toggle';
    toggle.textContent = 'BREAK ✕';
    toggle.title = 'Remove this line break';
    toggle.addEventListener('click', () => {
      saveFormHistory();
      adv.form[afterIdx].breakAfter = false;
      renderFormEditor();
    });
    wrap.appendChild(toggle);
    return wrap;
  }

  function buildBreakCue(afterIdx) {
    const cue = document.createElement('div');
    cue.className = 'form-bar-break-cue';
    cue.title = 'Add a line break after this bar';
    cue.addEventListener('click', () => {
      saveFormHistory();
      adv.form[afterIdx].breakAfter = true;
      renderFormEditor();
    });
    return cue;
  }

  document.getElementById('form-editor-add-bar').addEventListener('click', () => {
    saveFormHistory();
    // Clone the previous bar's time signature and accent pattern as a sensible default.
    const prev = adv.form[adv.form.length - 1];
    adv.form.push({
      beats: prev.beats,
      unit: prev.unit,
      states: prev.states.slice(),
      breakAfter: false,
    });
    renderFormEditor();
  });

  // ─── Form code: portable save / load ──────────────────────────────────────────
  // A compact single-token encoding of the whole form. Format:
  //   JVAFORM1;<beats>/<unit>:<states>[!];<beats>/<unit>:<states>[!];...
  // states are A/N/S/M chars (accent/normal/soft/mute); a trailing "!" on
  // a bar means breakAfter. The user copies this string and saves it
  // wherever they like, then pastes it back to reload the form. The
  // JVAFORM1 prefix is a version marker so the format can evolve later.
  function encodeFormCode() {
    const bars = adv.form.map((e) => {
      const chars = e.states.map((s) => BEAT_TO_CHAR[s] || 'N').join('');
      return e.beats + '/' + e.unit + ':' + chars + (e.breakAfter ? '!' : '');
    });
    return 'JVAFORM1;' + bars.join(';');
  }

  function decodeFormCode(str) {
    const parts = (str || '').trim().split(';');
    if (parts[0] !== 'JVAFORM1') {
      return { error: 'That doesn’t look like a form code (missing the JVAFORM1 header).' };
    }
    const barStrs = parts.slice(1).filter((p) => p.length > 0);
    if (barStrs.length === 0) return { error: 'That form code has no bars in it.' };
    const form = [];
    for (let i = 0; i < barStrs.length; i++) {
      const m = barStrs[i].match(/^(\d+)\/(\d+):([ANSM]+)(!?)$/);
      if (!m) return { error: 'Bar ' + (i + 1) + ' is malformed: “' + barStrs[i] + '”' };
      const beats = +m[1], unit = +m[2], chars = m[3];
      if (beats < 1 || beats > 32) return { error: 'Bar ' + (i + 1) + ': beats must be 1–32.' };
      if (unit < 1 || unit > 32) return { error: 'Bar ' + (i + 1) + ': unit must be 1–32.' };
      if (chars.length !== beats) {
        return { error: 'Bar ' + (i + 1) + ': has ' + chars.length + ' beat states but the time signature says ' + beats + '.' };
      }
      form.push({
        beats, unit,
        states: chars.split('').map((c) => CHAR_TO_BEAT[c]),
        breakAfter: m[4] === '!',
      });
    }
    return { form };
  }

  // ─── Share links ──────────────────────────────────────────────────────────────
  // The form is gzipped (via DecompressionStream — universal modern-browser
  // support) and base64url-encoded into ?f=... in the URL. A typical form
  // compresses to ~30% of the raw code length and the result is URL-safe (no
  // % escapes for slashes/semicolons that ballooned the raw code).
  async function deflateText(text) {
    const stream = new Blob([text]).stream().pipeThrough(new CompressionStream('deflate-raw'));
    const buf = await new Response(stream).arrayBuffer();
    return new Uint8Array(buf);
  }
  async function inflateText(bytes) {
    const stream = new Blob([bytes]).stream().pipeThrough(new DecompressionStream('deflate-raw'));
    return new Response(stream).text();
  }
  function bytesToBase64Url(bytes) {
    let s = '';
    for (let i = 0; i < bytes.length; i++) s += String.fromCharCode(bytes[i]);
    return btoa(s).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
  }
  function base64UrlToBytes(s) {
    s = s.replace(/-/g, '+').replace(/_/g, '/');
    while (s.length % 4) s += '=';
    const bin = atob(s);
    const out = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
    return out;
  }
  async function generateShareLink() {
    const compressed = bytesToBase64Url(await deflateText(encodeFormCode()));
    const params = new URLSearchParams();
    params.set('bpm', String(state.bpm));
    params.set('open', '1');
    params.set('f', compressed);
    return window.location.origin + window.location.pathname + '?' + params.toString();
  }
  document.getElementById('form-code-copy').addEventListener('click', async () => {
    const btn = document.getElementById('form-code-copy');
    let copied = false;

    // iOS Safari quirk: an `await` before navigator.clipboard.writeText()
    // breaks the user-activation context, so the call silently no-ops and
    // nothing lands on the clipboard. The workaround: navigator.clipboard
    // .write() accepts a Promise<Blob> inside a ClipboardItem — the
    // .write() call itself happens synchronously inside the click handler
    // (still inside the gesture), and Safari resolves the promise from
    // within that gesture so the clipboard actually gets written.
    if (typeof ClipboardItem !== 'undefined' && navigator.clipboard && navigator.clipboard.write) {
      try {
        const blobP = generateShareLink().then((t) => new Blob([t], { type: 'text/plain' }));
        await navigator.clipboard.write([new ClipboardItem({ 'text/plain': blobP })]);
        copied = true;
      } catch (_) { /* fall through to writeText */ }
    }

    // Non-Safari path (Chrome / Firefox) — generate, then writeText.
    if (!copied) {
      try {
        const link = await generateShareLink();
        await navigator.clipboard.writeText(link);
        copied = true;
      } catch (_) { /* fall through to legacy fallback */ }
    }

    // Last-resort fallback: legacy textarea + execCommand('copy').
    if (!copied) {
      try {
        const link = await generateShareLink();
        const ta = document.createElement('textarea');
        ta.value = link; ta.style.position = 'fixed'; ta.style.opacity = '0';
        document.body.appendChild(ta); ta.select();
        try { document.execCommand('copy'); copied = true; } catch (_) {}
        document.body.removeChild(ta);
      } catch (_) {}
    }

    if (copied) {
      btn.classList.add('copied');
      setTimeout(() => btn.classList.remove('copied'), 1400);
    }
  });

  // ─── Saved forms library ────────────────────────────────────────────────────
  // localStorage-backed list of named form snapshots. Each entry stores the
  // JVAFORM1-encoded form (compact) plus the BPM it was saved at, so loading
  // a saved chart restores both the bars and the tempo it was meant for.
  // localStorage works in iOS PWAs (storage persists across sessions in
  // installed mode), so this gives iPad/iPhone users a "my charts" library
  // without needing native code.
  const SAVED_FORMS_KEY = 'metronomeSavedForms_v1';

  function loadSavedForms() {
    try {
      const raw = localStorage.getItem(SAVED_FORMS_KEY);
      if (!raw) return [];
      const list = JSON.parse(raw);
      if (!Array.isArray(list)) return [];
      return list.filter((e) =>
        e && typeof e.id === 'string' && typeof e.name === 'string' && typeof e.code === 'string'
      );
    } catch (_) { return []; }
  }

  function writeSavedForms(list) {
    try { localStorage.setItem(SAVED_FORMS_KEY, JSON.stringify(list)); } catch (_) {}
  }

  function renderSavedForms() {
    const container = document.getElementById('form-saved-list');
    const empty = document.getElementById('form-saved-empty');
    if (!container) return;
    for (const el of container.querySelectorAll('.form-saved-chip')) el.remove();
    const list = loadSavedForms();
    if (list.length === 0) {
      empty.style.display = '';
      return;
    }
    empty.style.display = 'none';
    // Newest first so the latest save is at the front of the strip.
    const sorted = list.slice().sort((a, b) => (b.savedAt || 0) - (a.savedAt || 0));
    for (const entry of sorted) {
      const chip = document.createElement('button');
      chip.type = 'button';
      chip.className = 'form-saved-chip';
      chip.dataset.id = entry.id;
      chip.setAttribute('aria-label', 'Load ' + entry.name);

      const decoded = decodeFormCode(entry.code);
      const barCount = (decoded && !decoded.error) ? decoded.form.length : 0;

      const name = document.createElement('span');
      name.className = 'form-saved-chip-name';
      name.textContent = entry.name;

      const meta = document.createElement('span');
      meta.className = 'form-saved-chip-meta';
      const bpmTxt = entry.bpm ? (' · ' + entry.bpm + ' bpm') : '';
      meta.textContent = barCount + ' bar' + (barCount === 1 ? '' : 's') + bpmTxt;

      const del = document.createElement('span');
      del.className = 'form-saved-chip-del';
      del.setAttribute('role', 'button');
      del.setAttribute('aria-label', 'Delete ' + entry.name);
      del.tabIndex = 0;
      del.textContent = '×';

      chip.append(name, meta, del);
      container.append(chip);
    }
  }

  function saveCurrentForm() {
    if (!adv.form || adv.form.length === 0) {
      alert('Add at least one bar before saving.');
      return;
    }
    const name = prompt('Name this form:');
    if (!name || !name.trim()) return;
    const list = loadSavedForms();
    list.push({
      id: 'f_' + Date.now().toString(36) + '_' + Math.random().toString(36).slice(2, 6),
      name: name.trim().slice(0, 60),
      code: encodeFormCode(),
      bpm: state.bpm,
      savedAt: Date.now(),
    });
    writeSavedForms(list);
    renderSavedForms();
  }

  // Apply a decoded JVAFORM1 form (+ optional bpm) as the current working
  // form. Shared by "load a saved form" and "import a share link".
  function applyFormCode(code, bpm) {
    const decoded = decodeFormCode(code);
    if (!decoded || decoded.error || !decoded.form || decoded.form.length === 0) {
      return decoded && decoded.error ? decoded.error : 'That form code is empty or unreadable.';
    }
    adv.form = decoded.form;
    adv.formEnabled = true;
    if (bpm && bpm >= 1 && bpm <= 500) setBPM(bpm);
    document.getElementById('form-toggle').checked = true;
    document.getElementById('form-controls').classList.toggle('disabled', false);
    lastRenderedFormIdx = -1;
    renderBeatGridForEntry(adv.form[0]);
    renderFormEditor();
    updateFormCounter(advFormIdx);
    persistState();
    return null;
  }

  function applySavedForm(id) {
    const entry = loadSavedForms().find((e) => e.id === id);
    if (!entry) return;
    const err = applyFormCode(entry.code, entry.bpm);
    if (err) alert('That saved form looks corrupted and couldn’t be loaded.');
  }

  // Parse pasted input — accepts a full share URL, just the query string,
  // or a raw JVAFORM1 code. Returns { code, bpm } on success, throws on
  // failure. Async because URL-shaped inputs require deflate decompression.
  async function parseShareInput(raw) {
    const s = (raw || '').trim();
    if (!s) throw new Error('Nothing to import — paste a share link or form code first.');

    // Raw form code path — no decompression needed.
    if (s.startsWith('JVAFORM1;')) return { code: s, bpm: null };

    // URL or query-string path — pull ?f= and (optional) ?bpm=.
    let qs;
    if (s.startsWith('http')) {
      try { qs = new URL(s).search; } catch (_) { throw new Error('That URL didn’t parse.'); }
    } else if (s.startsWith('?')) {
      qs = s;
    } else {
      throw new Error('That doesn’t look like a JVA Music share link or form code.');
    }
    const params = new URLSearchParams(qs);
    const f = params.get('f');
    if (!f) throw new Error('No form found in that link (missing ?f= parameter).');
    const code = await inflateText(base64UrlToBytes(f));
    const bpmStr = params.get('bpm');
    const bpm = bpmStr ? parseFloat(bpmStr) : null;
    return { code, bpm };
  }

  async function importShareLink() {
    const raw = prompt('Paste a JVA Music share link (or a form code) to import:');
    if (raw === null) return;
    let parsed;
    try {
      parsed = await parseShareInput(raw);
    } catch (e) {
      alert(e && e.message ? e.message : 'Couldn’t parse that input.');
      return;
    }
    const err = applyFormCode(parsed.code, parsed.bpm);
    if (err) { alert(err); return; }
  }

  function deleteSavedForm(id) {
    const list = loadSavedForms();
    const entry = list.find((e) => e.id === id);
    if (!entry) return;
    if (!confirm('Delete “' + entry.name + '”?')) return;
    writeSavedForms(list.filter((e) => e.id !== id));
    renderSavedForms();
  }

  document.getElementById('form-saved-save-btn').addEventListener('click', saveCurrentForm);
  document.getElementById('form-saved-import-btn').addEventListener('click', importShareLink);

  // Single delegated click on the chips list: chip body loads, the × inside
  // it deletes. stopPropagation on the delete prevents both firing.
  document.getElementById('form-saved-list').addEventListener('click', (e) => {
    const chip = e.target.closest('.form-saved-chip');
    if (!chip) return;
    if (e.target.closest('.form-saved-chip-del')) {
      e.stopPropagation();
      deleteSavedForm(chip.dataset.id);
      return;
    }
    applySavedForm(chip.dataset.id);
  });

  renderSavedForms();

  // Sync the editor's play buttons with the existing transport.
  function refreshFormEditorPlayButtons() {
    const label = state.isPlaying ? '■ Stop' : '▶ Start';
    formEditorPlayBtns.forEach((b) => { if (b) b.textContent = label; });
    // Don't clobber the BPM field while the user is typing into it — this
    // refresh runs on a 200ms interval. When the field isn't focused,
    // keep it synced to state.bpm so +/- and main-page changes show up.
    if (document.activeElement !== formEditorBpmEl) {
      formEditorBpmEl.textContent = formatBpm(state.bpm);
    }
  }
  formEditorPlayBtns.forEach((b) => {
    if (!b) return;
    b.addEventListener('click', () => {
      if (state.isPlaying) stopMetronome(); else startMetronome();
      refreshFormEditorPlayButtons();
      // Re-render the grid so the active-bar highlight kicks in.
      if (formEditorModal.getAttribute('aria-hidden') === 'false') renderFormEditor();
    });
  });

  // When the scheduler advances to a new bar, refresh the active highlight.
  // Hook into the existing form-counter update site by polling lightly while
  // the editor is open.
  let formEditorActiveIdx = -1;
  setInterval(() => {
    if (formEditorModal.getAttribute('aria-hidden') !== 'false') return;
    if (advFormIdx !== formEditorActiveIdx) {
      formEditorActiveIdx = advFormIdx;
      formEditorGrid.querySelectorAll('.form-bar, .form-chart-tile').forEach((card) => {
        const idx = +card.dataset.idx;
        card.classList.toggle('active', idx === advFormIdx && state.isPlaying);
        card.classList.toggle('looping', isBarInLoop(idx));
      });
      refreshFormEditorPlayButtons();
    } else {
      refreshFormEditorPlayButtons();
    }
  }, 200);

  // Wire every slider's value readout for tap-to-edit. Each one stays in
  // sync with its slider (slider handler also updates the textContent),
  // these handlers just add a direct edit path: tap → numpad → type → Enter.
  wireEditableNumber(document.getElementById('gap-play-val'), {
    min: 1, max: 16,
    current: () => adv.gapPlay,
    onCommit: (v) => {
      adv.gapPlay = v;
      document.getElementById('gap-play-slider').value = v;
      persistState();
    },
  });
  wireEditableNumber(document.getElementById('gap-silent-val'), {
    min: 1, max: 16,
    current: () => adv.gapSilent,
    onCommit: (v) => {
      adv.gapSilent = v;
      document.getElementById('gap-silent-slider').value = v;
      persistState();
    },
  });
  wireEditableNumber(document.getElementById('random-mute-val'), {
    min: 0, max: 100,
    current: () => adv.randomMutePct,
    onCommit: (v) => {
      adv.randomMutePct = v;
      document.getElementById('random-mute-slider').value = v;
      persistState();
    },
  });
  wireEditableNumber(document.getElementById('random-mute-sub-val'), {
    min: 0, max: 100,
    current: () => adv.randomMuteSubPct,
    onCommit: (v) => {
      adv.randomMuteSubPct = v;
      document.getElementById('random-mute-sub-slider').value = v;
      persistState();
    },
  });
  wireEditableNumber(document.getElementById('swing-val'), {
    min: 50, max: 75, isFloat: true,
    format: (v) => String(Math.round(v * 10) / 10),
    current: () => state.swingPct,
    onCommit: (v) => { setSwingPct(v); persistState(); },
  });

  // Make the beats-per-measure <input type=number> select-all on tap, so
  // the typed digit replaces instead of inserting next to the existing one.
  (() => {
    const bi = document.getElementById('beats-input');
    if (!bi) return;
    bi.addEventListener('focus', () => setTimeout(() => bi.select(), 0));
  })();

  // ─── Background Mode: implementation ─────────────────────────────────────────
  //
  // Offline render pipeline + MediaSession + visual resync.
  // Context-agnostic synthesizers (accept any AudioContext) live here so the
  // same code drives both the realtime scheduler and the OfflineAudioContext.

  // ── GCD / LCM helpers ─────────────────────────────────────────────────────────
  function gcdOf(a, b) { return b === 0 ? a : gcdOf(b, a % b); }
  function lcmOf(a, b) { return Math.round((a / gcdOf(a, b)) * b); }

  // ── Silent-WAV helper ─────────────────────────────────────────────────────────
  // Creates a tiny silent WAV blob URL used to arm <audio> elements for later
  // async play() calls without a user gesture. Created once and reused.
  let _silentWavUrl = null;
  function getSilentWavUrl() {
    if (_silentWavUrl) return _silentWavUrl;
    const sr = 8000, frames = sr / 2, ds = frames * 2;
    const buf = new ArrayBuffer(44 + ds);
    const dv = new DataView(buf);
    const ws = (o, s) => { for (let i = 0; i < s.length; i++) dv.setUint8(o + i, s.charCodeAt(i)); };
    ws(0,'RIFF'); dv.setUint32(4, 36+ds, true); ws(8,'WAVE'); ws(12,'fmt ');
    dv.setUint32(16,16,true); dv.setUint16(20,1,true); dv.setUint16(22,1,true);
    dv.setUint32(24,sr,true); dv.setUint32(28,sr*2,true);
    dv.setUint16(32,2,true); dv.setUint16(34,16,true);
    ws(36,'data'); dv.setUint32(40,ds,true);
    // ±2 LSB noise (≈ -84 dBFS — dither level, genuinely inaudible) so the
    // session carries a nonzero signal without any audible hiss. A previous
    // -60 dBFS version was faintly audible as white noise in quiet rooms.
    for (let i = 0; i < frames; i++) {
      dv.setInt16(44 + i * 2, Math.round((Math.random() * 2 - 1) * 2), true);
    }
    _silentWavUrl = URL.createObjectURL(new Blob([buf], { type: 'audio/wav' }));
    return _silentWavUrl;
  }

  // ── Near-silence keep-alive element ──────────────────────────────────────────
  // A looping near-silence <audio> (~-60 dBFS noise) keeps the page's iOS audio
  // session alive while hidden. It does NOT keep the AudioContext rendering —
  // iOS suspends Web Audio regardless — but it prevents the page from being
  // fully frozen, granting the ~2 s JS wakes the background watchdog relies on,
  // and it smooths the audio-session handoff at the moment the screen locks.
  function ensureBgSilentEl() {
    if (bgSilentEl) return bgSilentEl;
    bgSilentEl = document.createElement('audio');
    bgSilentEl.loop = true;
    bgSilentEl.playsInline = true;
    bgSilentEl.setAttribute('playsinline', '');
    bgSilentEl.style.display = 'none';
    bgSilentEl.src = getSilentWavUrl();
    document.body.appendChild(bgSilentEl);
    bgSilentEl.addEventListener('pause', () => {
      if (bgModeEnabled && state.isPlaying) updatePlayButton();
    });
    bgSilentEl.addEventListener('play', () => {
      if (bgModeEnabled && state.isPlaying) updatePlayButton();
    });
    return bgSilentEl;
  }

  // ── Background click elements ─────────────────────────────────────────────────
  // The pair of <audio> elements that play the rendered WAV while the page is
  // hidden. HTMLMediaElement playback is the only audio pipeline iOS keeps
  // running with the screen off. Native loop=true turned out to seek at the
  // wrap point (~30 ms stutter), so looping is done by alternating the two
  // elements with a silence-pre-rolled handoff instead (see the watchdog).
  function ensureBgClickEls() {
    if (bgClickEls[0]) return bgClickEls;
    for (let i = 0; i < 2; i++) {
      const el = document.createElement('audio');
      el.playsInline = true;
      el.setAttribute('playsinline', '');
      el.preload = 'auto';
      el.style.display = 'none';
      document.body.appendChild(el);
      el.addEventListener('ended', () => {
        if (!state.isPlaying || bgActiveMode !== 'element') return;
        if (bgPlayOnce) { stopMetronome(); return; }
        // The active element finished its pattern: the pre-rolled standby is
        // (ideally already) carrying the clicks — promote it. If the standby
        // was never primed (every wake in the window was missed), start it at
        // the pattern top; a small gap, but playback survives.
        if (bgClickEls[bgClickIdx] === el) {
          bgClickIdx = 1 - bgClickIdx;
          const next = bgClickEls[bgClickIdx];
          if (next.paused) {
            try { next.currentTime = bgLeadDur; } catch (_) {}
            next.play().catch(() => {});
          }
        }
      });
      bgClickEls[i] = el;
    }
    return bgClickEls;
  }

  // Called inside a user gesture (Start button / toggle tap). Playing each
  // element once marks it user-activated, so every later programmatic play()
  // — from visibilitychange, the watchdog, or lock-screen controls — is
  // allowed without a fresh gesture.
  function armBgElements() {
    ensureBgSilentEl().play().catch(e => console.warn('[bg] keepalive play failed:', e));
    for (const el of ensureBgClickEls()) {
      if (!el.src) el.src = getSilentWavUrl();
      el.muted = true;
      const p = el.play();
      if (p) p.then(() => {
        // Keep playing only if the hand-off already made this the live element.
        if (!(bgActiveMode === 'element' && el === bgClickEls[bgClickIdx])) el.pause();
        el.muted = false;
      }).catch(() => { el.muted = false; });
    }
  }

  // ── Context-agnostic synthesizers ─────────────────────────────────────────────
  // Accept any AudioContext so the identical synthesis drives both realtime
  // (scheduleElectronic/scheduleClave delegate here) and OfflineAudioContext.

  function scheduleElectronicCtx(ctx, time, type, dest) {
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    const filter = ctx.createBiquadFilter();
    osc.connect(filter); filter.connect(gain); gain.connect(dest || ctx.destination);
    filter.type = 'bandpass';
    if (type === 'accent') {
      osc.frequency.value = 1050; filter.frequency.value = 1050; filter.Q.value = 0.6;
      gain.gain.setValueAtTime(0, time);
      gain.gain.linearRampToValueAtTime(1.0, time + 0.001);
      gain.gain.exponentialRampToValueAtTime(0.001, time + 0.12);
    } else if (type === 'beat') {
      osc.frequency.value = 800; filter.frequency.value = 800; filter.Q.value = 0.5;
      gain.gain.setValueAtTime(0, time);
      gain.gain.linearRampToValueAtTime(0.75, time + 0.001);
      gain.gain.exponentialRampToValueAtTime(0.001, time + 0.09);
    } else if (type === 'soft') {
      osc.frequency.value = 600; filter.frequency.value = 600; filter.Q.value = 0.5;
      gain.gain.setValueAtTime(0, time);
      gain.gain.linearRampToValueAtTime(0.32, time + 0.001);
      gain.gain.exponentialRampToValueAtTime(0.001, time + 0.07);
    } else {
      // 'sub' and any unrecognised type → high-frequency sweep click.
      osc.frequency.value = 1600; filter.frequency.value = 1600; filter.Q.value = 1.2;
      gain.gain.setValueAtTime(0, time);
      gain.gain.linearRampToValueAtTime(0.3, time + 0.001);
      gain.gain.exponentialRampToValueAtTime(0.001, time + 0.05);
    }
    osc.start(time); osc.stop(time + 0.2);
    return osc;
  }

  function scheduleClaveCtx(ctx, time, type, dest) {
    const freq  = type === 'accent' ? 2700  : type === 'sub' ? 3300  : type === 'soft' ? 1900 : 2450;
    const vol   = type === 'accent' ? 0.85  : type === 'beat' ? 0.55 : type === 'soft' ? 0.25 : 0.2;
    const decay = type === 'sub'    ? 0.025 : type === 'accent' ? 0.08 : type === 'soft' ? 0.04 : 0.06;
    const osc = ctx.createOscillator();
    osc.type = 'sine';
    osc.frequency.value = freq;
    const og = ctx.createGain();
    og.gain.setValueAtTime(0.00001, time);
    og.gain.exponentialRampToValueAtTime(vol, time + 0.0005);
    og.gain.exponentialRampToValueAtTime(0.00001, time + decay);
    osc.connect(og); og.connect(dest || ctx.destination);
    osc.start(time); osc.stop(time + decay + 0.01);
    return osc;
  }

  function scheduleClickCtx(ctx, time, type, mode) {
    if (type === 'mute') return;
    if (mode === 'clave') { scheduleClaveCtx(ctx, time, type); return; }
    scheduleElectronicCtx(ctx, time, type);
  }

  // ── Settings snapshot ─────────────────────────────────────────────────────────
  function snapshotBgSettings() {
    let form = adv.form.map(e => ({ beats: e.beats, unit: e.unit, states: e.states.slice() }));
    let loopBase = 0;
    // Loop-selection: render just the looped bar range; loopBase maps the
    // timeline's slice-relative formIdx back to the absolute form index.
    if (adv.formEnabled && loopRange &&
        loopRange.lo <= loopRange.hi && loopRange.hi < form.length) {
      form = form.slice(loopRange.lo, loopRange.hi + 1);
      loopBase = loopRange.lo;
    }
    return {
      loopBase,
      bpm: state.bpm,
      beatsPerMeasure: state.beatsPerMeasure,
      beatUnit: state.beatUnit,
      beats: state.beats.slice(),
      subdivision: state.subdivision,
      subCustom: state.subCustom,
      subPattern: state.subPattern.slice(),
      subFollowMute: state.subFollowMute,
      swingPct: state.swingPct,
      soundMode,
      gapEnabled: adv.gapEnabled,
      gapPlay: adv.gapPlay,
      gapSilent: adv.gapSilent,
      gapUnit: adv.gapUnit,
      randomMuteEnabled: adv.randomMuteEnabled,
      randomMutePct: adv.randomMutePct,
      randomMuteSubPct: adv.randomMuteSubPct,
      formEnabled: adv.formEnabled,
      form,
    };
  }

  // ── Buffer plan ────────────────────────────────────────────────────────────────
  // Returns { total, cycle }: the full pattern length, and the repeating unit
  // that can be rendered once and tiled out byte-for-byte (a huge render/encode
  // speedup — 2 rendered cycles instead of 5 synthesized minutes). Random mute
  // is intentionally non-repeating, so its cycle is the whole render.
  function bgBufferPlan(cfg) {
    let cycle;
    const beatDur = (60 / cfg.bpm) * (4 / cfg.beatUnit);
    const measDur = beatDur * cfg.beatsPerMeasure;

    if (cfg.formEnabled && cfg.form && cfg.form.length > 0) {
      // The realtime scheduler cycles the form indefinitely; one cycle = one
      // full pass of the form.
      cycle = Math.max(1, cfg.form.reduce((sum, bar) => {
        return sum + (60 / cfg.bpm) * (4 / bar.unit) * bar.beats;
      }, 0));
      if (cycle > BG_MAX_RENDER_S) return { total: cycle, cycle }; // → play-once clamp
    } else if (cfg.gapEnabled) {
      // The cycle must end on a gap-cycle boundary to avoid seam state mismatch.
      if (cfg.gapUnit === 'beat') {
        // Align to LCM(gap-cycle beats, beats-per-measure) for whole-measure cycles.
        const cycleBeats = cfg.gapPlay + cfg.gapSilent;
        cycle = beatDur * lcmOf(cycleBeats, cfg.beatsPerMeasure);
      } else {
        cycle = measDur * (cfg.gapPlay + cfg.gapSilent);
      }
    } else {
      // Plain pattern: every measure is identical.
      cycle = measDur;
    }

    const total = cycle * Math.max(1, Math.ceil(BG_TARGET_SECS / cycle));
    if (cfg.randomMuteEnabled) return { total, cycle: total };
    return { total, cycle };
  }

  // ── Event timeline builder ─────────────────────────────────────────────────────
  // Mirrors the realtime scheduler logic exactly; feeds the OfflineAudioContext
  // render and the phase-mapping that hands playback between the realtime
  // scheduler and the <audio> element. Events carry the same per-event state
  // (beat, sub, formIdx, gapPhase, gapCount) the realtime scheduler tracks so a
  // position in one clock maps unambiguously onto the other.
  function buildBgTimeline(cfg, durationSecs) {
    const events = [];
    let t = 0;
    let beat = 0, sub = 0;
    let curSub = cfg.subdivision, curSubCustom = cfg.subCustom;
    let curSubPattern = cfg.subPattern.slice();
    let gapPhase = 'play', gapCount = 0;
    let formIdx = 0;

    function cfgForForm() {
      if (cfg.formEnabled && cfg.form && cfg.form.length > 0) {
        const e = cfg.form[Math.min(formIdx, cfg.form.length - 1)];
        return { beatsPerMeasure: e.beats, beats: e.states, beatUnit: e.unit };
      }
      return { beatsPerMeasure: cfg.beatsPerMeasure, beats: cfg.beats, beatUnit: cfg.beatUnit };
    }

    const maxT = Math.min(durationSecs + 0.001, BG_MAX_RENDER_S + 1);
    const maxEvents = 2_000_000;

    while (t < maxT && events.length < maxEvents) {
      const c = cfgForForm();
      if (sub === 0) {
        curSub = cfg.subdivision;
        curSubCustom = cfg.subCustom;
        curSubPattern = cfg.subPattern.slice();
      }

      let clickType;
      if (sub === 0) {
        const s = c.beats[beat] || 'normal';
        clickType = s === 'mute' ? 'mute' : s === 'accent' ? 'accent' : s === 'soft' ? 'soft' : 'beat';
      } else {
        clickType = 'sub';
        if (curSubCustom && curSubPattern[sub] === false) clickType = 'mute';
      }
      if (sub !== 0 && cfg.subFollowMute && (c.beats[beat] || 'normal') === 'mute') clickType = 'mute';
      if (cfg.gapEnabled && gapPhase === 'silent') clickType = 'mute';
      if (cfg.randomMuteEnabled && clickType !== 'mute') {
        const p = sub === 0 ? cfg.randomMutePct : cfg.randomMuteSubPct;
        if (p > 0 && Math.random() < p / 100) clickType = 'mute';
      }

      events.push({ time: t, beat, sub, clickType, formIdx, gapPhase, gapCount });

      const beatDur = (60.0 / cfg.bpm) * (4 / c.beatUnit);
      let stepDur;
      if (curSub === 2 && !curSubCustom && cfg.swingPct !== 50) {
        const s = cfg.swingPct / 100;
        stepDur = sub === 0 ? beatDur * s : beatDur * (1 - s);
      } else {
        stepDur = beatDur / curSub;
      }
      t += stepDur;

      sub++;
      if (sub >= curSub) {
        sub = 0;
        beat++;
        if (cfg.gapEnabled && cfg.gapUnit === 'beat') {
          gapCount++;
          if (gapPhase === 'play'   && gapCount >= cfg.gapPlay)   { gapPhase = 'silent'; gapCount = 0; }
          else if (gapPhase === 'silent' && gapCount >= cfg.gapSilent) { gapPhase = 'play';   gapCount = 0; }
        }
        if (beat >= c.beatsPerMeasure) {
          beat = 0;
          if (cfg.gapEnabled && cfg.gapUnit !== 'beat') {
            gapCount++;
            if (gapPhase === 'play'   && gapCount >= cfg.gapPlay)   { gapPhase = 'silent'; gapCount = 0; }
            else if (gapPhase === 'silent' && gapCount >= cfg.gapSilent) { gapPhase = 'play';   gapCount = 0; }
          }
          if (cfg.formEnabled && cfg.form && cfg.form.length > 0) {
            formIdx = (formIdx + 1) % cfg.form.length;
          }
        }
      }
    }
    return events;
  }

  // ── Offline render ─────────────────────────────────────────────────────────────
  // Building the node graph and encoding the WAV are the only heavy main-thread
  // jobs in the pipeline; both are sliced with bgYield() so the realtime
  // scheduler's 25 ms timer keeps firing and foreground playback never starves.
  // While hidden there is no foreground audio to protect — and throttled timers
  // would make yielding crawl — so the work runs straight through.
  function bgYield() {
    if (document.visibilityState === 'hidden') return null;
    return new Promise(r => setTimeout(r, 0));
  }

  // Renders the first renderSecs of the timeline (the timeline itself may be
  // longer when the result will be tiled).
  async function renderBgAudio(cfg, timeline, renderSecs, numFrames) {
    const offCtx = new OfflineAudioContext(1, numFrames, BG_RENDER_SR);
    let n = 0;
    for (const evt of timeline) {
      if (evt.time >= renderSecs) break; // timeline is time-sorted
      scheduleClickCtx(offCtx, evt.time, evt.clickType, cfg.soundMode);
      if (++n % 250 === 0) await bgYield();
    }
    return offCtx.startRendering();
  }

  // ── WAV encoder ────────────────────────────────────────────────────────────────
  // 16-bit PCM mono, with leadSeconds of silence prepended (no codec
  // priming/padding samples, so positions in the file are sample-exact).
  // The silent lead is the handoff pre-roll: the standby element starts
  // somewhere inside it, where seeks are inaudible.
  //
  // Tiling: when tiles > 1, audioBuffer holds two rendered cycles of
  // cycleFrames each. Tile 0 is cycle 1 (a clean start); tiles 1..n-1 are
  // cycle 2, which carries the ring-over tails from cycle 1 — i.e. the
  // steady state — so consecutive copies butt together continuously. The
  // copies are raw byte memcpys, orders of magnitude cheaper than
  // synthesizing and quantizing the full five minutes.
  //
  // Async + chunked: quantizing millions of samples in one synchronous loop
  // starved the realtime scheduler; bgYield() keeps it fed.
  async function encodeWavBlob(audioBuffer, leadSeconds, tiles, cycleFrames) {
    const data = audioBuffer.getChannelData(0);
    const sr = audioBuffer.sampleRate;
    const lead = Math.round((leadSeconds || 0) * sr);
    const quantFrames = tiles > 1 ? Math.min(data.length, cycleFrames * 2) : data.length;
    const n = lead + (tiles > 1 ? cycleFrames * tiles : data.length);
    const buf = new ArrayBuffer(44 + n * 2);
    const dv = new DataView(buf);
    const ws = (o, s) => { for (let i = 0; i < s.length; i++) dv.setUint8(o + i, s.charCodeAt(i)); };
    ws(0,'RIFF'); dv.setUint32(4, 36 + n*2, true); ws(8,'WAVE'); ws(12,'fmt ');
    dv.setUint32(16,16,true); dv.setUint16(20,1,true); dv.setUint16(22,1,true);
    dv.setUint32(24,sr,true); dv.setUint32(28,sr*2,true);
    dv.setUint16(32,2,true); dv.setUint16(34,16,true);
    ws(36,'data'); dv.setUint32(40, n*2, true);
    // Lead samples are already zeros — that's the silence.
    const CHUNK = 262144; // ~ a few ms of work per slice
    for (let start = 0; start < quantFrames; start += CHUNK) {
      const end = Math.min(start + CHUNK, quantFrames);
      for (let i = start; i < end; i++) {
        const s = Math.max(-1, Math.min(1, data[i]));
        dv.setInt16(44 + (lead + i) * 2, s < 0 ? s * 0x8000 : s * 0x7FFF, true);
      }
      if (end < quantFrames) await bgYield();
    }
    if (tiles > 1) {
      const bytes = new Uint8Array(buf);
      const srcOff = 44 + (lead + cycleFrames) * 2; // cycle 2 = steady state
      const len = cycleFrames * 2;
      for (let k = 2; k < tiles; k++) {
        bytes.set(bytes.subarray(srcOff, srcOff + len), 44 + (lead + k * cycleFrames) * 2);
        if (k % 16 === 0) await bgYield();
      }
    }
    return new Blob([buf], { type: 'audio/wav' });
  }

  // ── Render pipeline ────────────────────────────────────────────────────────────
  function updateBgRenderStatus(active) {
    const bar = document.getElementById('bg-render-status-bar');
    if (bar) bar.hidden = !active;
  }

  // The page hid before a render finished and one just became available —
  // start background playback from the pattern top.
  function bgStartIfWaiting() {
    if (bgWaitingForRender && document.visibilityState === 'hidden' &&
        state.isPlaying && bgClickEls[0]) {
      bgWaitingForRender = false;
      const act = bgClickEls[bgClickIdx];
      try { act.currentTime = bgLeadDur; } catch (_) {}
      act.play().catch(() => {});
    }
  }

  // Renders the current settings to a WAV and loads it (paused) into the
  // click elements.
  // Foreground sound is unaffected — the realtime scheduler keeps playing — so
  // this just keeps the background buffer warm for the next screen lock.
  async function startBgRender() {
    if (!bgModeEnabled) return;

    const cfg = snapshotBgSettings();
    const cfgKey = JSON.stringify(cfg);
    // Settings unchanged since the last completed render (the common case on
    // a plain stop/start): reuse the existing blob — no preparing delay at all.
    if (cfgKey === bgLastCfgKey && bgBlobUrl && bgEventTimeline.length > 0) {
      bgRenderGeneration++; // cancels any in-flight render of older settings
      bgRenderInFlight = false;
      bgRenderReady = true;
      updateBgRenderStatus(false);
      bgStartIfWaiting();
      return;
    }

    const gen = ++bgRenderGeneration;
    bgRenderInFlight = true;
    bgRenderReady = false;
    updateBgRenderStatus(state.isPlaying);

    try {
      const { total, cycle } = bgBufferPlan(cfg);
      const playOnce = total > BG_MAX_RENDER_S;
      const dur = Math.min(total, BG_MAX_RENDER_S);
      const lead = playOnce ? 0 : BG_LEAD_S;
      const tiles = (!playOnce && cycle < dur) ? Math.round(dur / cycle) : 1;
      const cycleFrames = Math.round(cycle * BG_RENDER_SR);
      // Tiled: render two cycles (cycle 2 = steady state, see encodeWavBlob);
      // the +2 frames absorb rounding so the encoder never reads short.
      const renderFrames = tiles > 1 ? cycleFrames * 2 + 2 : Math.ceil(dur * BG_RENDER_SR);
      const renderSecs = renderFrames / BG_RENDER_SR;

      const timeline = buildBgTimeline(cfg, dur);
      const audioBuffer = await renderBgAudio(cfg, timeline, renderSecs, renderFrames);
      if (gen !== bgRenderGeneration) return;
      const blob = await encodeWavBlob(audioBuffer, lead, tiles, cycleFrames);
      if (gen !== bgRenderGeneration) return;

      const oldUrl = bgBlobUrl;
      bgBlobUrl = URL.createObjectURL(blob);
      // Exact pattern length as encoded — the handoff math keys off this.
      bgPatternDur = (tiles > 1 ? cycleFrames * tiles : Math.ceil(dur * BG_RENDER_SR)) / BG_RENDER_SR;
      bgLeadDur = lead;
      bgPlayOnce = playOnce;
      bgEventTimeline = timeline;
      bgLoopBase = cfg.loopBase;
      bgLastCfgKey = cfgKey;

      // Both elements load the same WAV; looping is the alternating handoff.
      for (const el of ensureBgClickEls()) {
        el.loop = false;
        el.src = bgBlobUrl;
      }
      if (oldUrl) URL.revokeObjectURL(oldUrl);
      bgRenderReady = true;
      bgStartIfWaiting();
    } catch (e) {
      console.error('bg render failed:', e);
    } finally {
      if (gen === bgRenderGeneration) {
        bgRenderInFlight = false;
        updateBgRenderStatus(false);
      }
    }
  }

  // ── Settings-change re-render ──────────────────────────────────────────────────
  // Debounced so slider drags don't hammer the offline renderer.
  function triggerBgRerender() {
    if (!state.isPlaying || !bgModeEnabled) return;
    clearTimeout(bgRerenderTimer);
    bgRerenderTimer = setTimeout(() => {
      bgRerenderTimer = null;
      startBgRender();
      updateMediaSession();
    }, BG_RERENDER_DEBOUNCE_MS);
  }

  // ── Realtime ⇄ element hand-off ────────────────────────────────────────────────
  // Maps the realtime scheduler's position onto the rendered buffer's clock.
  // The scheduler runs ≤ ~125 ms ahead of the audible click; its state
  // (schedulerBeat/Sub, gap phase/count, form index) describes the event due at
  // nextNoteTime, so find that event in the timeline and back off the lookahead.
  function realtimeToBufferPos(ctx) {
    const tl = bgEventTimeline;
    if (!tl.length || !bgPatternDur) return 0;
    const isForm = adv.formEnabled && adv.form.length > 0;
    const targetForm = isForm ? advFormIdx - bgLoopBase : -1;
    let evt = null;
    for (const e of tl) {
      if (e.beat !== schedulerBeat || e.sub !== schedulerSub) continue;
      if (isForm && e.formIdx !== targetForm) continue;
      if (adv.gapEnabled && (e.gapPhase !== advGapPhase || e.gapCount !== advGapCount)) continue;
      evt = e;
      break;
    }
    if (!evt) return 0;
    let pos = evt.time - Math.max(0, nextNoteTime - ctx.currentTime);
    if (pos < 0) pos += bgPatternDur;
    return Math.max(0, Math.min(pos, bgPatternDur - 0.01));
  }

  // Inverse mapping: resume the realtime scheduler from a buffer position.
  function bufferPosToScheduler(pos, ctx) {
    const tl = bgEventTimeline;
    schedulerSubdivision = state.subdivision;
    schedulerSubCustom   = state.subCustom;
    schedulerSubPattern  = state.subPattern.slice();
    if (!tl.length || !bgPatternDur) {
      schedulerBeat = 0; schedulerSub = 0;
      advGapPhase = 'play'; advGapCount = 0;
      nextNoteTime = ctx.currentTime + 0.05;
      return;
    }
    // Last event at or before pos; the scheduler resumes from the one after it.
    let lo = 0, hi = tl.length - 1, idx = 0;
    while (lo <= hi) {
      const mid = (lo + hi) >> 1;
      if (tl[mid].time <= pos) { idx = mid; lo = mid + 1; }
      else hi = mid - 1;
    }
    const nIdx = (idx + 1) % tl.length;
    const nev = tl[nIdx];
    let delta = (nIdx === 0 ? bgPatternDur + tl[0].time : nev.time) - pos;
    if (!(delta > 0.01)) delta = 0.01;
    schedulerBeat = nev.beat;
    schedulerSub  = nev.sub;
    advGapPhase   = nev.gapPhase;
    advGapCount   = nev.gapCount;
    const isForm = adv.formEnabled && adv.form.length > 0;
    advFormIdx = isForm ? Math.min(bgLoopBase + nev.formIdx, adv.form.length - 1) : 0;
    nextNoteTime = ctx.currentTime + delta;
  }

  // Page hidden: the realtime scheduler stops and the pre-rendered <audio>
  // element takes over, phase-matched. iOS will suspend the AudioContext
  // moments later; the element (plus the near-silence keep-alive) plays on.
  function enterBgPlayback() {
    if (bgActiveMode === 'element') return;
    const ctx = getAudioCtx();
    // Fade the realtime engine out in a few ms: its ≤125 ms of already-
    // scheduled clicks must neither double up with the element nor be
    // chopped mid-waveform when iOS suspends the context.
    if (rtMasterGain) {
      const g = rtMasterGain.gain;
      g.cancelScheduledValues(ctx.currentTime);
      g.setValueAtTime(g.value, ctx.currentTime);
      g.linearRampToValueAtTime(0, ctx.currentTime + 0.008);
    }
    // A settings change is still waiting on its debounce — render it now so
    // the background audio reflects what the user last set.
    if (bgRerenderTimer) {
      clearTimeout(bgRerenderTimer);
      bgRerenderTimer = null;
      startBgRender();
    }
    let pos = bgRenderReady ? realtimeToBufferPos(ctx) : 0;
    clearTimeout(schedulerTimer);
    schedulerTimer = null;
    pendingVisuals.length = 0;
    bgActiveMode = 'element';
    if (bgRenderReady && bgClickEls[0]) {
      // Play-once renders (over-cap forms) must not start in the final
      // moments of the buffer, where 'ended' would fire immediately.
      if (bgPlayOnce && bgPatternDur - pos < 0.25) pos = 0;
      const act = bgClickEls[bgClickIdx];
      const stb = bgClickEls[1 - bgClickIdx];
      if (stb && !stb.paused) stb.pause(); // park the standby; the watchdog re-primes it
      try { act.currentTime = bgLeadDur + pos; } catch (_) {}
      act.play().catch(() => {});
    } else {
      bgWaitingForRender = true; // startBgRender will begin playback when done
    }
  }

  // Page visible: pause the element and resume the realtime scheduler from the
  // element's position. The context resume is async on iOS; map the position
  // after it settles so nextNoteTime lands on a live clock.
  function exitBgPlayback() {
    bgWaitingForRender = false;
    if (bgSilentEl && bgSilentEl.paused && state.isPlaying) bgSilentEl.play().catch(() => {});
    if (bgActiveMode !== 'element') return;
    let pos = 0;
    if (bgClickEls[0]) {
      // Mid-handoff the active element may already have ended; read the
      // position from whichever element is carrying (or about to carry) the
      // clicks. A standby still inside its silent lead maps to the pattern
      // tail (the lead pre-rolls the *next* cycle).
      const act = bgClickEls[bgClickIdx];
      const stb = bgClickEls[1 - bgClickIdx];
      const src = ((act.ended || act.paused) && !stb.paused) ? stb : act;
      if (bgPatternDur > 0) {
        pos = src.currentTime - bgLeadDur;
        if (pos < 0) pos += bgPatternDur;
        pos = Math.max(0, pos % bgPatternDur);
      }
      act.pause();
      stb.pause();
    }
    bgActiveMode = 'realtime';
    const ctx = getAudioCtx();
    const resumed = ctx.state === 'running' ? Promise.resolve() : ctx.resume();
    resumed.catch(() => {}).then(() => {
      if (!state.isPlaying || bgActiveMode !== 'realtime') return;
      // Restore the realtime engine's master gain (faded out at enter).
      // Nothing is scheduled through it yet, so an instant reset is silent.
      if (rtMasterGain) {
        rtMasterGain.gain.cancelScheduledValues(ctx.currentTime);
        rtMasterGain.gain.setValueAtTime(1, ctx.currentTime);
      }
      bufferPosToScheduler(pos, ctx);
      scheduler();
      requestAnimationFrame(visualLoop);
    });
  }

  // ── Background watchdog ────────────────────────────────────────────────────────
  // The keep-alive element grants ~2 s JS wakes while hidden; use them to
  // self-heal (catch a missed visibilitychange, restart elements that an
  // interruption paused, kick a stalled render) and — the core of gapless
  // looping — to run the element handoff:
  //
  //   1. When the active element is within BG_HANDOFF_WINDOW_S of its end,
  //      start the standby inside its silent lead at target = active − pattern,
  //      so both media clocks will meet exactly when the clicks wrap.
  //   2. On later wakes, measure the clock offset between the two playing
  //      elements and trim the standby by seeking it — still in silence, so
  //      the correction is inaudible. The handoff instant itself is then
  //      decided by the media pipeline, not by throttled JS timing.
  //   3. When the active element ends, the 'ended' handler promotes the
  //      standby and this cycle repeats with roles swapped.
  function startBgWatchdog() {
    if (bgWatchdogTimer) return;
    bgWatchdogTimer = setInterval(() => {
      if (!state.isPlaying || !bgModeEnabled) return;
      if (document.visibilityState !== 'hidden') return;
      if (bgActiveMode === 'realtime') {
        enterBgPlayback();
        return;
      }
      if (bgSilentEl && bgSilentEl.paused) bgSilentEl.play().catch(() => {});
      if (bgWaitingForRender && !bgRenderInFlight) {
        // The render this hand-off was waiting on died (e.g. it errored, or
        // iOS froze the page mid-render) — kick off a fresh one.
        startBgRender();
        return;
      }
      if (!bgRenderReady || bgWaitingForRender || !bgClickEls[0]) return;

      let act = bgClickEls[bgClickIdx];
      const stb = bgClickEls[1 - bgClickIdx];

      // 'ended' can be delayed while throttled — detect a completed handoff
      // here too and swap roles.
      if (act.ended && !bgPlayOnce) {
        bgClickIdx = 1 - bgClickIdx;
        act = stb;
      }

      // Interruption recovery (phone call, Siri): resume the active element.
      // ended-elements are excluded — for play-once that's the natural stop,
      // and post-handoff the other element already took over.
      if (act.paused && !act.ended) {
        if (act.currentTime < bgLeadDur) {
          try { act.currentTime = bgLeadDur; } catch (_) {}
        }
        act.play().catch(() => {});
        return;
      }

      // Handoff pre-roll + trim.
      if (!bgPlayOnce && !act.paused && bgPatternDur > 0) {
        const remaining = (bgLeadDur + bgPatternDur) - act.currentTime;
        if (remaining <= BG_HANDOFF_WINDOW_S) {
          const target = act.currentTime - bgPatternDur; // inside the silent lead
          if (stb.paused) {
            try { stb.currentTime = Math.max(0, target); } catch (_) {}
            stb.play().catch(() => {});
          } else if (!stb.seeking && stb.currentTime < bgLeadDur) {
            const err = stb.currentTime - (act.currentTime - bgPatternDur);
            if (Math.abs(err) > 0.005) {
              try { stb.currentTime = stb.currentTime - err; } catch (_) {}
            }
          }
        } else if (!stb.paused) {
          // Out of the window with the standby somehow running — park it.
          stb.pause();
        }
      }
    }, BG_WATCHDOG_MS);
  }

  function stopBgWatchdog() {
    if (bgWatchdogTimer) { clearInterval(bgWatchdogTimer); bgWatchdogTimer = null; }
  }

  // ── MediaSession ───────────────────────────────────────────────────────────────
  function updateMediaSession() {
    if (!('mediaSession' in navigator)) return;
    try {
      const sig = `${state.beatsPerMeasure}/${state.beatUnit}`;
      const subStr = state.subdivision > 1
        ? (state.subCustom
            ? `, Custom ${state.subdivision}`
            : `, ${subdivisionName(state.subdivision)}`)
        : '';
      navigator.mediaSession.metadata = new MediaMetadata({
        title: `${formatBpm(state.bpm)} BPM — ${sig}${subStr}`,
        artist: 'JVA Music Metronome',
        album: '',
        artwork: [
          { src: '/icons/icon-192.png', sizes: '192x192', type: 'image/png' },
          { src: '/icons/icon-512.png', sizes: '512x512', type: 'image/png' },
        ],
      });
      navigator.mediaSession.setActionHandler('play', () => {
        if (state.isPlaying) {
          // Resume after an interruption (phone call, other audio).
          if (bgSilentEl && bgSilentEl.paused) bgSilentEl.play().catch(() => {});
          if (bgActiveMode === 'element') {
            const _act = bgClickEls[bgClickIdx];
            if (_act && _act.paused && !_act.ended) _act.play().catch(() => {});
          } else {
            const _ctx = getAudioCtx();
            if (_ctx.state !== 'running') _ctx.resume().catch(() => {});
          }
          requestWakeLock();
          updatePlayButton();
        } else {
          // Restart from the lock screen / control center. The elements were
          // armed in the original Start gesture, so play() is allowed here.
          startMetronome();
          if (document.visibilityState === 'hidden') enterBgPlayback();
        }
      });
      navigator.mediaSession.setActionHandler('pause', () => {
        if (state.isPlaying) stopMetronome();
      });
      navigator.mediaSession.setActionHandler('stop', () => {
        if (state.isPlaying) stopMetronome();
      });
    } catch (_) {}
  }

  // ── Preferences persistence ────────────────────────────────────────────────────
  const BG_PREFS_KEY = 'metronomeBgPrefs_v1';

  function saveBgPrefs() {
    try {
      localStorage.setItem(BG_PREFS_KEY, JSON.stringify({ wakeLockUserEnabled }));
    } catch (_) {}
  }

  function loadBgPrefs() {
    try {
      const d = JSON.parse(localStorage.getItem(BG_PREFS_KEY) || '{}');
      if (typeof d.wakeLockUserEnabled === 'boolean') wakeLockUserEnabled = d.wakeLockUserEnabled;
    } catch (_) {}
  }

  // ── Toggle event handlers ──────────────────────────────────────────────────────
  (() => {
    const el = document.getElementById('wake-lock-toggle');
    if (!el) return;
    el.addEventListener('change', e => {
      wakeLockUserEnabled = e.target.checked;
      saveBgPrefs();
      if (state.isPlaying) {
        wakeLockUserEnabled ? requestWakeLock() : releaseWakeLock();
      }
    });
  })();

  // ─── End Background Mode ──────────────────────────────────────────────────────

  init().catch((e) => console.error('init failed', e));
</script>

<script is:inline>
  // Register the metronome service worker. Scoped to /metronome/ because
  // the SW lives at /metronome/sw.js — the rest of the site is not
  // intercepted. Skipped on localhost so dev builds aren't cached.
  if ('serviceWorker' in navigator && location.hostname !== 'localhost' && location.protocol === 'https:') {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/metronome/sw.js').catch((err) => {
        console.warn('SW registration failed:', err);
      });
    });
  }
</script>

<script is:inline>
  // ─── Return-to-top pill ──────────────────────────────────────────────────────
  // Watches a sentinel placed right before the practice guide article.
  // The ▲ pill appears only when the sentinel is at least one full viewport
  // above the viewport top (rootMargin), meaning the user has scrolled well
  // past the metronome tool UI into the guide content.
  (function(){
    var sentinel = document.getElementById('top-of-content');
    var pill = document.getElementById('return-top');
    if (!sentinel || !pill) return;
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        pill.classList.toggle('is-visible', !e.isIntersecting);
      });
    }, { threshold: 0, rootMargin: '100% 0px 0px 0px' });
    observer.observe(sentinel);
  })();
</script>

