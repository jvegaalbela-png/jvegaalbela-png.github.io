      .metronome-shell .basic-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr) minmax(0, 1fr);
        grid-template-areas:
          "tempo  timesig  timesig"
          "tempo  subdiv   sound"
          "beats  beats    beats";
        gap: 0.75rem;
        align-items: stretch;
      }

      .metronome-shell .basic-grid > .card {
        margin-bottom: 0;
