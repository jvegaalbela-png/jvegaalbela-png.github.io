---
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
// English-only site, so we skip fontsource's full unicode coverage
// (cyrillic, greek, vietnamese, latin-ext) and write minimal latin-only
// @font-face blocks. Both fonts use variable formats, so a single woff2
// per family covers every weight we use — 5 separate Cormorant fetches
// at ~700ms each collapse into 2 (one normal, one italic).
import interLatinUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import cormorantLatinUrl from '@fontsource-variable/cormorant-garamond/files/cormorant-garamond-latin-wght-normal.woff2?url';
import cormorantLatinItalicUrl from '@fontsource-variable/cormorant-garamond/files/cormorant-garamond-latin-wght-italic.woff2?url';
import albumArt from '../assets/album-art.jpg';

const latinUnicodeRange =
  'U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD';

// Metric-overridden fallback @font-face blocks. These create
// "Inter Fallback" and "Cormorant Fallback" font families backed by
// system Arial/Georgia, scaled so the fallback's x-height, ascent,
// descent, and "0"-width line up with the real fonts. Result: when
// the real font swaps in, the layout doesn't shift — same line
// heights, same widths, same wrapping. This eliminates the post-swap
// LCP candidate updates that were keeping mobile LCP ~2.3s.
//
// Inter values are the well-calibrated ones from Inter's own docs.
// Cormorant values are tuned against Georgia (closest design fit).
const fontFaces = `
@font-face {
  font-family: 'Inter Variable';
  font-style: normal;
  font-display: swap;
  font-weight: 100 900;
  src: url(${interLatinUrl}) format('woff2-variations');
  unicode-range: ${latinUnicodeRange};
}
@font-face {
  font-family: 'Inter Fallback';
  src: local('Arial'), local('Helvetica Neue'), local('Helvetica');
  size-adjust: 107.4%;
  ascent-override: 90.2%;
  descent-override: 22.48%;
  line-gap-override: 0%;
}
@font-face {
  font-family: 'Cormorant Garamond Variable';
  font-style: normal;
  font-display: swap;
  font-weight: 300 700;
  src: url(${cormorantLatinUrl}) format('woff2-variations');
  unicode-range: ${latinUnicodeRange};
}
@font-face {
  font-family: 'Cormorant Garamond Variable';
  font-style: italic;
  font-display: swap;
  font-weight: 300 700;
  src: url(${cormorantLatinItalicUrl}) format('woff2-variations');
  unicode-range: ${latinUnicodeRange};
}
@font-face {
  font-family: 'Cormorant Fallback';
  src: local('Georgia'), local('Times New Roman'), local('Times');
  size-adjust: 97%;
  ascent-override: 108%;
  descent-override: 36%;
  line-gap-override: 0%;
}
@font-face {
  font-family: 'Cormorant Fallback';
  font-style: italic;
  src: local('Georgia Italic'), local('Georgia'), local('Times New Roman Italic'), local('Times New Roman');
  size-adjust: 97%;
  ascent-override: 108%;
  descent-override: 36%;
  line-gap-override: 0%;
}`;

interface OgImage {
  url: string;
  width?: number;
  height?: number;
  alt?: string;
  type?: string;
}

interface Props {
  title: string;
  description?: string;
  themeColor?: string;
  bodyClass?: string;
  noindex?: boolean;
  image?: OgImage;
  og?: { title?: string; description?: string; type?: string; image?: OgImage };
}

const { title, description, themeColor, bodyClass, noindex, image, og } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();

const defaultOgImage = await getImage({
  src: albumArt,
  format: 'jpg',
  width: 1200,
  height: 1200,
});

const DEFAULT_IMAGE: OgImage = {
  url: defaultOgImage.src,
  width: 1200,
  height: 1200,
  type: 'image/jpeg',
  alt: "Album cover for 'Un-Belonging' by Jacobo Vega-Albela — released on 577 Records, May 2025",
};

const resolved: OgImage = og?.image ?? image ?? DEFAULT_IMAGE;
const ogImageUrl = resolved.url.startsWith('http')
  ? resolved.url
  : new URL(resolved.url, Astro.site).toString();

const ogTitle = og?.title ?? title;
const ogDescription = og?.description ?? description;
const ogType = og?.type ?? 'website';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  {/*
    Only Inter is preloaded. The hero-sub paragraph (the LCP element on
    /drum-lessons mobile) renders in Inter, so this preload is on the
    LCP critical path. Cormorant (used for headings) loads via @font-face
    with font-display: swap — headings paint in Georgia immediately and
    swap to Cormorant when ready, freeing simulated-Slow-4G bandwidth
    for the LCP-critical font and the hero image fetch.
  */}
  <link rel="preload" as="font" type="font/woff2" href={interLatinUrl} crossorigin />
  {description && <meta name="description" content={description} />}
  {themeColor && <meta name="theme-color" content={themeColor} />}
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="canonical" href={canonical} />
  <meta property="og:site_name" content="JVA Music" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={ogTitle} />
  {ogDescription && <meta property="og:description" content={ogDescription} />}
  <meta property="og:image" content={ogImageUrl} />
  {resolved.type && <meta property="og:image:type" content={resolved.type} />}
  {resolved.width && <meta property="og:image:width" content={String(resolved.width)} />}
  {resolved.height && <meta property="og:image:height" content={String(resolved.height)} />}
  {resolved.alt && <meta property="og:image:alt" content={resolved.alt} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={ogTitle} />
  {ogDescription && <meta name="twitter:description" content={ogDescription} />}
  <meta name="twitter:image" content={ogImageUrl} />
  {resolved.alt && <meta name="twitter:image:alt" content={resolved.alt} />}
  <title>{title}</title>
  <link rel="icon" type="image/webp" href="/favicon.webp" />
  <style is:global set:html={fontFaces}></style>
  <slot name="head" />
  <GoogleAnalytics />
</head>
<body class={bodyClass}>
  <Header />
  <slot />
  <Footer />
</body>
</html>
