---
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import albumArt from '../assets/album-art.jpg';

interface OgImage {
  url: string;
  width?: number;
  height?: number;
  alt?: string;
  type?: string;
}

interface Props {
  title: string;
  description?: string;
  themeColor?: string;
  bodyClass?: string;
  noindex?: boolean;
  image?: OgImage;
  og?: { title?: string; description?: string; type?: string; image?: OgImage };
}

const { title, description, themeColor, bodyClass, noindex, image, og } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();

const defaultOgImage = await getImage({
  src: albumArt,
  format: 'jpg',
  width: 1200,
  height: 1200,
});

const DEFAULT_IMAGE: OgImage = {
  url: defaultOgImage.src,
  width: 1200,
  height: 1200,
  type: 'image/jpeg',
  alt: "Album cover for 'Un-Belonging' by Jacobo Vega-Albela — released on 577 Records, May 2025",
};

const resolved: OgImage = og?.image ?? image ?? DEFAULT_IMAGE;
const ogImageUrl = resolved.url.startsWith('http')
  ? resolved.url
  : new URL(resolved.url, Astro.site).toString();

const ogTitle = og?.title ?? title;
const ogDescription = og?.description ?? description;
const ogType = og?.type ?? 'website';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  {description && <meta name="description" content={description} />}
  {themeColor && <meta name="theme-color" content={themeColor} />}
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="canonical" href={canonical} />
  <meta property="og:site_name" content="JVA Music" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={ogTitle} />
  {ogDescription && <meta property="og:description" content={ogDescription} />}
  <meta property="og:image" content={ogImageUrl} />
  {resolved.type && <meta property="og:image:type" content={resolved.type} />}
  {resolved.width && <meta property="og:image:width" content={String(resolved.width)} />}
  {resolved.height && <meta property="og:image:height" content={String(resolved.height)} />}
  {resolved.alt && <meta property="og:image:alt" content={resolved.alt} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={ogTitle} />
  {ogDescription && <meta name="twitter:description" content={ogDescription} />}
  <meta name="twitter:image" content={ogImageUrl} />
  {resolved.alt && <meta name="twitter:image:alt" content={resolved.alt} />}
  <title>{title}</title>
  <link rel="icon" type="image/webp" href="/favicon.webp" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <slot name="head" />
  <GoogleAnalytics />
</head>
<body class={bodyClass}>
  <Header />
  <slot />
  <Footer />
</body>
</html>
