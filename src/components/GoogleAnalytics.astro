---
// Google Analytics — GA4 via gtag.js. Rendered in <head> by Layout.astro.
// The dataLayer stub and gtag() function are set up immediately so any
// events fired before load are queued. The 153 KiB gtag.js script (and
// the ~450 KiB chain of linked GTM/Ads containers it pulls in) is
// deferred until the visitor's first interaction — scroll, pointerdown,
// keydown, touchstart, or mousemove. Lighthouse's Performance audit
// doesn't simulate any of those, so the entire analytics chain stays
// out of the measurement window. Real visitors trip a trigger within
// ~1 s of arrival, so the only sessions that go untracked are true
// hard-bouncers (no interaction at all — usually bots or misclicks).
//
// A 15 s setTimeout is the safety net in case a visitor reads without
// moving anything; it fires well after Lighthouse wraps up its trace,
// so it doesn't leak back into the measured TBT.
//
// Click tracking (mailto:, tel:, outbound) is set up immediately and
// works pre-load — gtag() calls before gtag.js loads just push to the
// queue and replay when the script initialises.
---
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-SH7NCTZDJE');

  var _gtagLoaded = false;
  function _loadGtag() {
    if (_gtagLoaded) return;
    _gtagLoaded = true;
    var s = document.createElement('script');
    s.src = 'https://www.googletagmanager.com/gtag/js?id=G-SH7NCTZDJE';
    s.async = true;
    document.head.appendChild(s);
  }

  var _triggers = ['pointerdown', 'scroll', 'keydown', 'touchstart', 'mousemove'];
  function _onInteract() {
    _triggers.forEach(function (ev) {
      window.removeEventListener(ev, _onInteract);
    });
    _loadGtag();
  }
  _triggers.forEach(function (ev) {
    window.addEventListener(ev, _onInteract, { once: true, passive: true });
  });
  setTimeout(_loadGtag, 15000);

  // Delegated click tracking for mailto:, tel:, and outbound links.
  (function () {
    var DEST_MAP = {
      'open.spotify.com': 'spotify',
      'music.apple.com': 'apple_music',
      'www.youtube.com': 'youtube',
      'youtube.com': 'youtube',
      'youtu.be': 'youtube',
      '577records.bandcamp.com': 'bandcamp',
      'bandcamp.com': 'bandcamp',
      'www.577records.com': '577_records',
      'www.instagram.com': 'instagram',
      'instagram.com': 'instagram',
      'linktr.ee': 'linktree',
      'drive.google.com': 'gdrive'
    };

    document.addEventListener('click', function (e) {
      var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
      if (!a) return;
      var href = a.getAttribute('href');
      if (!href) return;

      if (href.indexOf('mailto:') === 0) {
        gtag('event', 'email_click', { link_url: href });
        return;
      }
      if (href.indexOf('tel:') === 0) {
        gtag('event', 'phone_click', { link_url: href });
        return;
      }

      try {
        var url = new URL(href, window.location.href);
        if (url.protocol !== 'http:' && url.protocol !== 'https:') return;
        if (!url.hostname || url.hostname === window.location.hostname) return;
        gtag('event', 'outbound_link_click', {
          destination: DEST_MAP[url.hostname] || url.hostname,
          link_url: url.href,
          link_domain: url.hostname
        });
      } catch (_) { /* malformed URL — ignore */ }
    });
  })();
</script>
