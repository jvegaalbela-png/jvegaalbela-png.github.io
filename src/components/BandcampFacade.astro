---
// Click-to-load Bandcamp facade. Renders the album cover with a play
// button overlay. On click, replaces itself with the real Bandcamp
// embedded player. Saves ~260 ms of main-thread CPU on initial load
// (bcbits embedded_player.js + bandcamp.com chrome).

import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** Full https://bandcamp.com/EmbeddedPlayer/... URL to load on click. */
  src: string;
  /** Iframe title (also used in the click-to-load button's aria-label). */
  title: string;
  /** Album-cover image (imported from src/assets/...). */
  cover: ImageMetadata;
  /** Alt text for the cover image. */
  coverAlt: string;
  /** Fallback link shown to crawlers / no-JS users. */
  fallbackHref: string;
  /** Fallback link text. */
  fallbackText: string;
}

const { src, title, cover, coverAlt, fallbackHref, fallbackText } = Astro.props;
---

<button
  type="button"
  class="bc-facade"
  data-bc-facade
  data-src={src}
  data-title={title}
  aria-label={`Play: ${title}`}
>
  <Image
    src={cover}
    alt={coverAlt}
    widths={[280, 350, 700]}
    sizes="(max-width: 600px) 100vw, 350px"
    loading="lazy"
    quality={70}
    class="bc-facade-cover"
  />
  <span class="bc-facade-play" aria-hidden="true">
    <svg viewBox="0 0 64 64" focusable="false">
      <circle cx="32" cy="32" r="30" fill="rgba(0,0,0,0.55)" />
      <path d="M 26,20 26,44 46,32 z" fill="#fff" />
    </svg>
  </span>
  <noscript>
    <a href={fallbackHref}>{fallbackText}</a>
  </noscript>
</button>

<style>
  .bc-facade {
    position: relative;
    display: block;
    width: 350px;
    max-width: 100%;
    margin: 0 auto;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    line-height: 0;
  }
  .bc-facade-cover {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 2px;
  }
  .bc-facade-play {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 72px;
    height: 72px;
    transform: translate(-50%, -50%);
    transition: transform .18s ease;
    pointer-events: none;
  }
  .bc-facade:hover .bc-facade-play,
  .bc-facade:focus-visible .bc-facade-play {
    transform: translate(-50%, -50%) scale(1.08);
  }
  .bc-facade:focus-visible {
    outline: 2px solid var(--orange-lt);
    outline-offset: 4px;
  }
  .bc-facade-play svg {
    width: 100%;
    height: 100%;
    display: block;
    filter: drop-shadow(0 4px 12px rgba(0,0,0,.4));
  }
</style>

<script is:inline>
  (function () {
    function activate(btn) {
      if (!btn || btn.dataset.bcLoaded === '1') return;
      btn.dataset.bcLoaded = '1';
      var src = btn.getAttribute('data-src');
      var title = btn.getAttribute('data-title') || '';
      var iframe = document.createElement('iframe');
      iframe.src = src;
      iframe.title = title;
      iframe.loading = 'eager';
      iframe.setAttribute('seamless', '');
      iframe.style.position = 'relative';
      iframe.style.width = '350px';
      iframe.style.maxWidth = '100%';
      iframe.style.height = '470px';
      iframe.style.border = '0';
      iframe.style.display = 'block';
      iframe.style.background = 'transparent';
      btn.replaceWith(iframe);
    }
    document.querySelectorAll('[data-bc-facade]').forEach(function (btn) {
      btn.addEventListener('click', function () { activate(btn); }, { once: true });
    });
  })();
</script>
