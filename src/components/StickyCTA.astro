---
// Persistent contact affordance — a full-width band on mobile and
// a compact pill anchored bottom-right on desktop. Hidden while
// the hero, the page's final cta-band, or the footer is on screen
// so it never overlaps a more contextual CTA.
---

<aside class="sticky-cta" id="stickyCta" aria-label="Contact Jacobo">
  <div class="sticky-cta-inner">
    <a
      class="sticky-cta-btn sticky-cta-email"
      href="mailto:jacobovamusic@gmail.com"
      onclick="gtag('event', 'cta_email_click', { location: 'sticky_cta' })"
    >
      <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" d="M3 5h14a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm0 1 7 5 7-5"/></svg>
      <span>Email</span>
    </a>
    <a
      class="sticky-cta-btn sticky-cta-call"
      href="tel:+15858024247"
      aria-label="Text or call 5 8 5, 8 0 2, 4 2 4 7"
      onclick="gtag('event', 'cta_call_click', { location: 'sticky_cta' })"
    >
      <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" d="M5.5 3h2.4a1 1 0 0 1 1 .8l.6 2.4a1 1 0 0 1-.27.95L7.7 8.6a11 11 0 0 0 4.7 4.7l1.45-1.53a1 1 0 0 1 .95-.27l2.4.6a1 1 0 0 1 .8 1V15.5A2.5 2.5 0 0 1 15.5 18 14 14 0 0 1 2 4.5 2.5 2.5 0 0 1 4.5 2"/></svg>
      <span class="sticky-cta-call-label">Call or text</span>
    </a>
  </div>
</aside>

<style>
  .sticky-cta {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 90;
    pointer-events: none;
    padding: 0 12px calc(env(safe-area-inset-bottom, 0px) + 10px);
    transform: translateY(0);
    transition: transform .26s ease, opacity .2s ease;
  }
  .sticky-cta.is-hidden {
    transform: translateY(140%);
    opacity: 0;
  }
  .sticky-cta-inner {
    pointer-events: auto;
    max-width: 520px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    background: rgba(9, 21, 40, 0.94);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(91, 141, 232, 0.18);
    border-radius: 8px;
    padding: 8px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.32);
  }
  .sticky-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    text-decoration: none;
    font: 600 13px/1 var(--sans);
    letter-spacing: .08em;
    text-transform: uppercase;
    padding: 12px 14px;
    min-height: 44px;
    border-radius: 6px;
    transition: background .18s, transform .18s;
  }
  .sticky-cta-btn svg {
    width: 16px;
    height: 16px;
    flex: none;
  }
  .sticky-cta-email {
    background: rgba(245, 243, 238, 0.08);
    color: var(--cream);
    border: 1px solid rgba(245, 243, 238, 0.28);
  }
  .sticky-cta-email:hover,
  .sticky-cta-email:focus-visible {
    background: rgba(245, 243, 238, 0.14);
  }
  .sticky-cta-call {
    background: var(--orange);
    color: var(--navy);
    border: 1px solid var(--orange);
  }
  .sticky-cta-call:hover,
  .sticky-cta-call:focus-visible {
    background: var(--orange-lt);
    border-color: var(--orange-lt);
    transform: translateY(-1px);
  }

  /* Desktop: shrink to a compact pill in the bottom-right. The
     email button collapses to an icon-only square; the call
     button stays labeled because tap-to-call still works on
     laptops with iPhone Continuity / FaceTime. */
  @media (min-width: 781px) {
    .sticky-cta {
      left: auto;
      right: 16px;
      bottom: 16px;
      padding: 0;
    }
    .sticky-cta-inner {
      max-width: none;
      grid-template-columns: auto auto;
      gap: 4px;
      padding: 4px;
      border-radius: 999px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.28);
    }
    .sticky-cta-btn {
      padding: 8px 14px;
      min-height: 36px;
      font-size: 12px;
      letter-spacing: .1em;
      border-radius: 999px;
    }
    .sticky-cta-email {
      padding: 8px;
      width: 36px;
      gap: 0;
    }
    .sticky-cta-email span {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  }

  @media print { .sticky-cta { display: none; } }
  @media (prefers-reduced-motion: reduce) {
    .sticky-cta { transition: none; }
  }
</style>

<script>
  // Hide the band while ANY "blocker" element is on screen — the
  // hero (so we don't compete with its tel-link), the final
  // cta-band, or the footer (where the page already shows email
  // and phone). Falls back to a scroll threshold if there's no
  // hero element on the page.
  (function () {
    function init() {
      const band = document.getElementById('stickyCta');
      if (!band) return;
      band.classList.add('is-hidden');
      const blockers = document.querySelectorAll('.hero, .cta-band, footer');
      if (blockers.length && 'IntersectionObserver' in window) {
        const visible = new Set();
        const obs = new IntersectionObserver(function (entries) {
          for (const e of entries) {
            if (e.isIntersecting) visible.add(e.target);
            else visible.delete(e.target);
          }
          if (visible.size > 0) band.classList.add('is-hidden');
          else band.classList.remove('is-hidden');
        }, { threshold: 0 });
        blockers.forEach(function (el) { obs.observe(el); });
        return;
      }
      const SHOW_AFTER = 320;
      let ticking = false;
      function update() {
        if (window.scrollY < SHOW_AFTER) band.classList.add('is-hidden');
        else band.classList.remove('is-hidden');
        ticking = false;
      }
      update();
      window.addEventListener('scroll', function () {
        if (!ticking) {
          window.requestAnimationFrame(update);
          ticking = true;
        }
      }, { passive: true });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
