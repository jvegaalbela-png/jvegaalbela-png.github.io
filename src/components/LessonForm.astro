---
// Reusable Formspree-powered lead form. Used in the drum-lessons
// hero, on the dedicated /book page, in the group-classes hero,
// and on /join. Optional fields are toggled via props so each page
// can collect just what it needs.

interface Props {
  formId: string;
  /** Unique slug for element IDs and the form's id attribute.
   *  Required when more than one form ever appears on the same page. */
  formIdSlug?: string;
  /** Submit button label. */
  submitLabel?: string;
  /** Show the "I want lessons for" radio fieldset. */
  showLessonType?: boolean;
  /** Show the "I want" location radio fieldset. */
  showLocation?: boolean;
  /** Show the time zone dropdown. */
  showTimezone?: boolean;
  /** Show the drumming experience dropdown
   *  (with a soft pre-qualifying warning for intermediate/advanced). */
  showExperience?: boolean;
  /** GA4 event name to fire on Formspree success. Omit to skip tracking. */
  submitEvent?: string;
  /** Parameters to attach to the GA4 event. */
  submitEventParams?: Record<string, unknown>;
}

const {
  formId,
  formIdSlug = 'lesson-form',
  submitLabel = 'Book Your Half-Price Lesson',
  showLessonType = false,
  showLocation = false,
  showTimezone = false,
  showExperience = false,
  submitEvent,
  submitEventParams = {},
} = Astro.props;

const id = (suffix: string) => `${formIdSlug}-${suffix}`;
---

<form id={formIdSlug} class="lesson-form" novalidate>
  <div class="lesson-form-row">
    <div class="lesson-form-field">
      <label for={id('name')}>Name</label>
      <input type="text" id={id('name')} name="name" required data-fs-field />
      <span class="lesson-form-error" data-fs-error="name"></span>
    </div>
    <div class="lesson-form-field">
      <label for={id('email')}>Email</label>
      <input type="email" id={id('email')} name="email" required data-fs-field />
      <span class="lesson-form-error" data-fs-error="email"></span>
    </div>
  </div>

  {showLessonType && (
    <fieldset class="lesson-form-radios">
      <legend>I want lessons for</legend>
      <div class="lesson-form-radios-row">
        <label class="radio-pill"><input type="radio" name="lesson_for" value="An adult" /><span>An adult</span></label>
        <label class="radio-pill"><input type="radio" name="lesson_for" value="A college student" /><span>A college student</span></label>
        <label class="radio-pill"><input type="radio" name="lesson_for" value="A K-12 student" /><span>A K&ndash;12 student</span></label>
      </div>
    </fieldset>
  )}

  {showLocation && (
    <fieldset class="lesson-form-radios">
      <legend>I want</legend>
      <div class="lesson-form-radios-row">
        <label class="radio-pill"><input type="radio" name="lesson_location" value="Lessons at your home studio" /><span>Lessons at your home studio</span></label>
        <label class="radio-pill"><input type="radio" name="lesson_location" value="House calls" /><span>House calls</span></label>
        <label class="radio-pill"><input type="radio" name="lesson_location" value="Online lessons" /><span>Online lessons</span></label>
      </div>
    </fieldset>
  )}

  {(showTimezone || showExperience) && (
    <div class="lesson-form-row">
      {showTimezone && (
        <div class="lesson-form-field">
          <label for={id('timezone')}>Time zone</label>
          <select id={id('timezone')} name="timezone" required data-fs-field>
            <option value="" disabled selected>Choose one&hellip;</option>
            <option value="Eastern (ET)">Eastern (ET)</option>
            <option value="Central (CT)">Central (CT)</option>
            <option value="Mountain (MT)">Mountain (MT)</option>
            <option value="Pacific (PT)">Pacific (PT)</option>
            <option value="Outside the US">Outside the US</option>
          </select>
          <span class="lesson-form-error" data-fs-error="timezone"></span>
        </div>
      )}
      {showExperience && (
        <div class="lesson-form-field">
          <label for={id('experience')}>Drumming experience</label>
          <select id={id('experience')} name="experience" required data-fs-field data-fs-experience-select>
            <option value="" disabled selected>Choose one&hellip;</option>
            <option value="No experience">No experience</option>
            <option value="Beginner">Beginner</option>
            <option value="Intermediate">Intermediate</option>
            <option value="Advanced">Advanced</option>
          </select>
          <span class="lesson-form-error" data-fs-error="experience"></span>
        </div>
      )}
    </div>
  )}

  {showExperience && (
    <div class="lesson-form-notice" data-fs-experience-notice hidden>
      Heads up &mdash; this class focuses on the basics of technique and reading rhythms. If you already have a solid foundation in those areas, private lessons might be a better fit.
    </div>
  )}

  <div class="lesson-form-field">
    <label for={id('message')}>Message <span class="optional">(optional)</span></label>
    <textarea id={id('message')} name="message" rows="2" data-fs-field></textarea>
    <span class="lesson-form-error" data-fs-error="message"></span>
  </div>

  <div class="lesson-form-actions">
    <button type="submit" class="btn btn-primary" data-fs-submit-btn>{submitLabel}</button>
  </div>
  <div class="lesson-form-success" data-fs-success>Thank you! I'll be in touch ASAP.</div>
  <div class="lesson-form-error-summary" data-fs-error></div>
</form>

<style>
  .lesson-form {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 480px;
    margin: 0.5rem 0 0;
  }
  .lesson-form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .lesson-form-field {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .lesson-form-field label {
    font-size: .6875rem;
    font-weight: 600;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: rgba(245, 243, 238, 0.78);
  }
  .lesson-form-field .optional {
    font-weight: 400;
    letter-spacing: .04em;
    text-transform: none;
    color: rgba(245, 243, 238, 0.5);
  }
  .lesson-form-field input,
  .lesson-form-field textarea,
  .lesson-form-field select {
    background: rgba(245, 243, 238, 0.06);
    border: 1px solid rgba(245, 243, 238, 0.22);
    color: var(--cream);
    font: 400 15px/1.5 var(--sans);
    padding: 10px 12px;
    border-radius: 2px;
    width: 100%;
    transition: border-color .18s, background .18s;
  }
  .lesson-form-field textarea {
    resize: vertical;
    min-height: 56px;
  }
  .lesson-form-field select {
    appearance: none;
    -webkit-appearance: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 8' fill='none' stroke='%23f5f3ee' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><path d='M1.5 1.75 6 6.25l4.5-4.5'/></svg>");
    background-repeat: no-repeat;
    background-position: right 12px center;
    background-size: 12px 8px;
    padding-right: 34px;
    cursor: pointer;
  }
  .lesson-form-field select option {
    color: #0e0d0b;
    background: #f5f3ee;
  }
  .lesson-form-field input:focus,
  .lesson-form-field textarea:focus,
  .lesson-form-field select:focus {
    outline: none;
    border-color: var(--orange-lt);
    background: rgba(245, 243, 238, 0.1);
  }
  .lesson-form-field input[aria-invalid="true"],
  .lesson-form-field textarea[aria-invalid="true"],
  .lesson-form-field select[aria-invalid="true"] {
    border-color: #e87a7a;
  }
  .lesson-form-notice {
    padding: 10px 14px;
    border-left: 3px solid var(--orange-lt);
    background: rgba(232, 101, 10, 0.12);
    color: rgba(245, 243, 238, 0.92);
    font-size: 13.5px;
    line-height: 1.5;
    border-radius: 2px;
  }
  .lesson-form-notice[hidden] { display: none; }
  .lesson-form-error {
    font-size: 12px;
    color: #ff9b9b;
    min-height: 1em;
    line-height: 1.3;
  }

  /* Radio pill fieldsets */
  .lesson-form-radios {
    border: 0;
    padding: 0;
    margin: 6px 0 2px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .lesson-form-radios legend {
    font-size: .6875rem;
    font-weight: 600;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: rgba(245, 243, 238, 0.78);
    padding: 0;
    margin-bottom: 2px;
  }
  .lesson-form-radios-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .radio-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border: 1px solid rgba(245, 243, 238, 0.22);
    border-radius: 999px;
    background: rgba(245, 243, 238, 0.04);
    color: var(--cream);
    font-size: 14px;
    line-height: 1.2;
    cursor: pointer;
    transition: border-color .15s, background .15s;
  }
  .radio-pill:hover {
    border-color: rgba(245, 243, 238, 0.4);
    background: rgba(245, 243, 238, 0.08);
  }
  .radio-pill input[type="radio"] {
    width: 14px;
    height: 14px;
    margin: 0;
    accent-color: var(--orange);
    flex: none;
  }
  .radio-pill:has(input:checked) {
    border-color: var(--orange-lt);
    background: rgba(232, 101, 10, 0.14);
  }

  .lesson-form-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-top: 4px;
  }
  .lesson-form-success,
  .lesson-form-error-summary {
    display: none;
    padding: 12px 14px;
    color: var(--cream);
    font-size: 14px;
    line-height: 1.5;
  }
  .lesson-form-success[data-fs-active] {
    display: block;
    background: rgba(141, 184, 32, 0.16);
    border-left: 3px solid var(--lime);
  }
  .lesson-form-error-summary[data-fs-active] {
    display: block;
    background: rgba(232, 101, 10, 0.16);
    border-left: 3px solid var(--orange);
  }
  @media (max-width: 600px) {
    .lesson-form-row { grid-template-columns: 1fr; }
    .lesson-form { gap: 6px; }
    .lesson-form-field { gap: 2px; }
    .lesson-form-field input,
    .lesson-form-field textarea { padding: 9px 11px; }
    .lesson-form-field textarea { min-height: 48px; }
    .lesson-form-actions {
      flex-direction: column;
      align-items: stretch;
      gap: 0.625rem;
    }
    .lesson-form-actions .btn { width: 100%; }
    .radio-pill { padding: 7px 12px; font-size: 13.5px; }
  }
</style>

<script is:inline define:vars={{ formId, formIdSlug, submitEvent, submitEventParams }}>
  window.formspree = window.formspree || function () { (formspree.q = formspree.q || []).push(arguments); };
  formspree('initForm', { formElement: '#' + formIdSlug, formId: formId, useDefaultStyles: false });

  (function () {
    const form = document.getElementById(formIdSlug);
    if (!form) return;
    const select = form.querySelector('[data-fs-experience-select]');
    const notice = form.querySelector('[data-fs-experience-notice]');
    if (!select || !notice) return;
    const update = () => {
      const v = select.value;
      notice.hidden = !(v === 'Intermediate' || v === 'Advanced');
    };
    select.addEventListener('change', update);
    update();
  })();

  // Fire GA4 event when Formspree marks the form as successfully submitted.
  // Formspree adds [data-fs-active] to the [data-fs-success] element on
  // success — that's the only state that distinguishes a real submission
  // from a network/validation failure.
  (function () {
    if (!submitEvent || typeof window === 'undefined') return;
    const form = document.getElementById(formIdSlug);
    if (!form) return;
    const successEl = form.querySelector('[data-fs-success]');
    if (!successEl) return;
    const observer = new MutationObserver(function () {
      if (successEl.hasAttribute('data-fs-active')) {
        if (typeof gtag === 'function') {
          gtag('event', submitEvent, submitEventParams || {});
        }
        observer.disconnect();
      }
    });
    observer.observe(successEl, { attributes: true, attributeFilter: ['data-fs-active'] });
  })();
</script>
<script is:inline src="/formspree-ajax.min.js" defer></script>
