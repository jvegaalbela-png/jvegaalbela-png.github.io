<style is:global>
  /* Footer — self-contained styles. is:global so they apply to the
     <footer> markup above without Astro's automatic scoping. Uses
     CSS variables defined in each page's stylesheet (--navy, --cream,
     --cobalt, --blue-lt, --orange-lt, --serif). */

  footer {
    background: var(--navy);
    color: rgba(245,243,238,0.45);
    padding: 52px 56px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 40px;
    align-items: center;
    border-top: 2px solid var(--cobalt);
  }

  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: center;
    justify-self: center;
  }

  .footer-nav a {
    color: rgba(245,243,238,0.7);
    text-decoration: none;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 500;
    transition: color 0.2s;
  }

  .footer-nav a:hover { color: var(--orange-lt); }

  .footer-name {
    font-family: var(--serif);
    font-size: 30px;
    font-weight: 300;
    font-style: italic;
    color: var(--cream);
    margin-bottom: 6px;
  }

  .footer-label {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--blue-lt);
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: flex-end;
  }

  .footer-links a {
    color: rgba(245,243,238,0.55);
    text-decoration: none;
    font-size: 12px;
    letter-spacing: 0.03em;
    transition: color 0.2s;
  }

  .footer-links a:hover { color: var(--orange-lt); }

  @media (max-width: 760px) {
    footer { grid-template-columns: 1fr; padding: 40px 28px; }
    .footer-links { align-items: flex-start; }
    .footer-nav { align-items: flex-start; justify-self: start; }
  }
</style>