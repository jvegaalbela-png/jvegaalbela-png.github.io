{
  "expo": {
    "name": "Metronome",
    "slug": "metronome",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "metronome",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0e0e12",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jva.metronome"
    },
    "android": {
      "package": "com.jva.metronome",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": true,
          "androidForegroundService": true,
          "disableFFmpeg": true
        }
      ]
    ]
  }
}
